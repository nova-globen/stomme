<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <Version>10.74.1</Version>
    <Product>Nova Globen Stomme</Product>
    <Authors>Nova Globen AB</Authors>
    <Company>Nova Globen AB</Company>
    <Description>CMS and Application Framework for Blazor and .NET MAUI</Description>
    <Copyright>© 2026 Nova Globen AB</Copyright>
    <PackageProjectUrl>https://nova-globen.se/products/stomme</PackageProjectUrl>
    <!-- D115: the licence travels INSIDE every package as a file - nuget.org accepts an SPDX expression only for an OSI- or FSF-approved licence, and PolyForm is neither. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>https://github.com/nova-globen/stomme/releases/tag/v10.2.1</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/nova-globen/stomme</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every dotnet-pack'd project carries LICENSE + THIRD-PARTY-NOTICES.md at the package root (D98, D115). -->
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>