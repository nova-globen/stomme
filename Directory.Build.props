<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <Version>10.79.0</Version>
    <Product>Nova Globen Stomme</Product>
    <Authors>Nova Globen AB</Authors>
    <Company>Nova Globen AB</Company>
    <Description>CMS and Application Framework for Blazor and .NET MAUI</Description>
    <Copyright>© 2026 Nova Globen AB</Copyright>
    <PackageProjectUrl>https://nova-globen.se/products/stomme</PackageProjectUrl>
    <!-- The licence travels INSIDE every package as a file - nuget.org accepts an SPDX expression only for an OSI- or FSF-approved licence, and PolyForm is neither. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>https://github.com/nova-globen/stomme/releases/tag/v10.2.1</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/nova-globen/stomme</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <!-- A high or critical NuGet advisory in any project's restore fails the build, so every gate refuses it. An advisory
         (GHSA-rxg9-xrhp-64gj) reached the consumers of a published package once, which is why this is enforced here. What a
         CONSUMER restores is audited separately by scripts/release-dry-run.ps1 - a Web SDK project prunes what the shared
         framework carries and cannot see that. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every dotnet-pack'd project carries LICENSE + THIRD-PARTY-NOTICES.md at the package root. -->
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>