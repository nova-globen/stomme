<?xml version="1.0" encoding="utf-8"?>
<!--
  Where the solution restores from: nuget.org only. The solution takes Stomme.* by project reference; the examples
  outside it restore Stomme.* from examples/local-feed (each has its own nuget.config with a source mapping).

  IF RESTORE FAILS WITH `NU1301 ... Unexpected character <`, something between this machine and nuget.org answered
  with an HTML page instead of JSON (a proxy or a sign-in page) - check the network before the code.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
