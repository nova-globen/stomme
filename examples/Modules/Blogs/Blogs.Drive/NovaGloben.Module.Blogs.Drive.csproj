<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THE DRIVE HARNESS (NOT the module). This is the vehicle that installs the
    packaged SPLIT Blogs module (Client/Server/Shared in one nupkg) through the REAL InstallationManager and
    asserts it renders + persists, and that a WebAssembly site STREAMS the right subset of it (Client +
    Shared to the browser, Server never). Unlike the module, a test harness legitimately references the
    framework by ProjectReference (the render guard does too) — the "packages-only" bar is the MODULE's
    which the three NovaGloben.Module.Blogs.* projects meet.

    It lives beside the module under examples/Modules/Blogs so it has its OWN bin, separate from
    test/Stomme.Tests: InstallPackages extracts the module DLLs into the ENTRY-assembly bin, so keeping
    this out of the framework test project's bin is what prevents the installed module from leaking into the
    gated suite. NOT in Stomme.slnx.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <NoWarn>$(NoWarn);NU1701;NU1902;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stage the packaged module + theme beside the harness so the drives can copy them into a scratch
         Packages folder. They are DATA (pre-built .nupkg files), not references — the harness never links
         the module. Prerequisites: pwsh examples/Modules/Blogs/pack-blogs.ps1 and
         pwsh examples/Themes/pack-themes.ps1 (both after pwsh examples/pack-sdk.ps1). The Aurora theme
         nupkg is what the WASM streaming drive's theme-streaming pin (the InstallationController .Concat
         fix) is driven against. -->
    <None Include="..\Package\NovaGloben.Module.Blogs.2.0.0.nupkg"
          Link="NovaGloben.Module.Blogs.2.0.0.nupkg"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The copy item used to name Stomme.Theme.Aurora.1.0.0.nupkg, but the theme nuspec had moved to 1.1.0, so the
         harness could not build in a fresh checkout (MSB3030). The wildcard
         matches whatever version pack-themes.ps1 produced — same pattern the streaming drive stages by —
         and when no nupkg exists yet the build succeeds and the drive reports its own actionable miss. -->
    <None Include="..\..\..\Themes\Stomme.Theme.Aurora\Package\Stomme.Theme.Aurora.*.nupkg"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Stomme.Server\Stomme.Server.csproj" />
    <ProjectReference Include="..\..\..\..\src\Stomme.Shared\Stomme.Shared.csproj" />
  </ItemGroup>

</Project>
