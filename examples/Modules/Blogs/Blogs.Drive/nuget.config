<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The drive harness restores its xUnit/TestHost packages from nuget.org and Stomme from source
       (ProjectReference). It does NOT use the local SDK feed — only the module under test is packages-only. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
