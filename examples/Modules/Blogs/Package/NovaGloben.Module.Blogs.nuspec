<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <id>NovaGloben.Module.Blogs</id>
        <version>2.0.2</version>
        <authors>Nova Globen AB</authors>
        <owners>Nova Globen AB</owners>
        <title>Blogs</title>
        <description>An independent, storage-blind Blogs module for Stomme (DDD + CQRS), split Client/Server/Shared for WebAssembly, built against the Stomme.Sdk NuGet packages only.</description>
        <copyright>Nova Globen AB</copyright>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <license type="file">LICENSE</license>
        <projectUrl>https://github.com/nova-globen/stomme</projectUrl>
        <icon>icon.png</icon>
        <tags>stomme module blogs storage-blind cqrs ddd webassembly</tags>
        <releaseNotes>2.0.0 splits the module Client/Server/Shared (a breaking layout change from the 1.0.0 single assembly) so a WebAssembly site can stream the Client + Shared assemblies to the browser while the Server assembly stays server-side.</releaseNotes>
        <!--
            The Stomme.Framework packageType (with the minimum framework version) is how
            InstallationManager.InstallPackages recognises this as a Stomme module and gates it on the running
            framework version (Constants.Version >= this). 10.2.2 matches the feed this module was built against.
        -->
        <packageTypes>
            <packageType name="Dependency" />
            <packageType name="Stomme.Framework" version="10.2.2" />
        </packageTypes>
    </metadata>
    <files>
        <!-- The LICENSE file (PolyForm Noncommercial OR Small Business) at the package root, as every Stomme.* package carries it. No target attribute: dotnet pack over a nuspec gives an empty entry name for ANY explicit target, empty included (measured). -->
        <file src="..\..\..\..\LICENSE" />
        <!--
            The three .Stomme-suffixed assemblies under lib/net10.0 (the External template layout).
            InstallationManager extracts lib/net*/ into the host /bin, where the convention loader (assembly
            name contains "Stomme") loads all three and discovery reflects over them: ModuleInfo + Index.razor
            live in Client, the controller/handlers/persistence wiring in Server, the wire contract in Shared.
            On a WebAssembly site only Client + Shared stream to the browser (ModuleDefinition.AssemblyName +
            .Dependencies); Server never leaves the host. No staticwebassets: the module's UI uses inline
            styles + the theme's db-* classes, so it ships no CSS/JS. NO framework DLLs are shipped — they are
            the running host's own assemblies.
        -->
        <file src="..\NovaGloben.Module.Blogs.Client\bin\Release\net10.0\NovaGloben.Module.Blogs.Client.Stomme.dll" target="lib\net10.0" />
        <file src="..\NovaGloben.Module.Blogs.Client\bin\Release\net10.0\NovaGloben.Module.Blogs.Client.Stomme.pdb" target="lib\net10.0" />
        <file src="..\NovaGloben.Module.Blogs.Server\bin\Release\net10.0\NovaGloben.Module.Blogs.Server.Stomme.dll" target="lib\net10.0" />
        <file src="..\NovaGloben.Module.Blogs.Server\bin\Release\net10.0\NovaGloben.Module.Blogs.Server.Stomme.pdb" target="lib\net10.0" />
        <file src="..\NovaGloben.Module.Blogs.Shared\bin\Release\net10.0\NovaGloben.Module.Blogs.Shared.Stomme.dll" target="lib\net10.0" />
        <file src="..\NovaGloben.Module.Blogs.Shared\bin\Release\net10.0\NovaGloben.Module.Blogs.Shared.Stomme.pdb" target="lib\net10.0" />
        <file src="icon.png" target="" />
    </files>
</package>
