<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    BL-13 (was THE FINALE). The three Blogs module projects (Client/Server/Shared) restore Stomme.*
    from the LOCAL FEED only (examples/local-feed, the packages produced by examples/pack-sdk.ps1), plus
    nuget.org for the third-party transitive closure (ASP.NET runtime packages, RavenDB.Client, FluentUI,
    ...). ZERO project/source references to Stomme — this is what "INDEPENDENT" means (owner's bar #1).
    One config at the module root covers all three projects; Blogs.Drive keeps its own (it is the test
    harness, framework-by-ProjectReference by design).
  -->
  <packageSources>
    <clear />
    <add key="stomme-local" value="../../local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!--
    The root NuGet.config enables packageSourceMapping, and mappings MERGE down the config
    walk (only packageSources is cleared above) — without this section, Stomme.* maps to the root's
    "*" -> nuget.org rule and stomme-local is ignored (NU1101). NovaGloben.* keeps any framework-published
    dependency (e.g. the D92 stock themes on the fat Stomme.Server package) off nuget.org.
  -->
  <packageSourceMapping>
    <clear />
    <packageSource key="stomme-local">
      <package pattern="Stomme.*" />
      <package pattern="NovaGloben.*" />
    </packageSource>
    <!-- Stomme.* from nuget.org as well (2026-10-02, the first preview's publish): this project references the STABLE
         minimum it supports, and a run that packs a preview leaves only prerelease Stomme.* in the local feed, which
         NuGet never uses for a stable minimum (NU1103) - measured, the nuget-v10.5.0-preview.1 run failed there. With
         both sources the lowest published stable at or above the minimum is used, so the pack is built against a
         framework already published. -->
    <packageSource key="nuget.org">
      <package pattern="Stomme.*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
