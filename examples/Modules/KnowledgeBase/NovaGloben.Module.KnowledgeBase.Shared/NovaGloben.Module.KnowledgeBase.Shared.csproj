<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BL-86: the SHARED layer of the exemplar module - the wire models, the permission keys and the service contract, and
    NOTHING else. Both the Client and the Server reference it, and on a WebAssembly site it STREAMS to the browser (the
    Client's ModuleDefinition.Dependencies names this assembly), so it must stay free of any server-only surface.
    INDEPENDENT (D81/D82): Stomme arrives only through the slim SDK meta-package from examples/local-feed.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NovaGloben.Module.KnowledgeBase.Shared.Stomme</AssemblyName>
    <RootNamespace>NovaGloben.Module.KnowledgeBase</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Nova Globen AB</Authors>
    <Company>Nova Globen AB</Company>
    <Product>NovaGloben.Module.KnowledgeBase</Product>
    <Description>Wire models, permission keys and the service contract of the KnowledgeBase exemplar module.</Description>
    <Copyright>Nova Globen AB</Copyright>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stomme.Sdk.Slim" Version="10.74.1" />
  </ItemGroup>

  <!--
    WASM-safety (measured, BL-13): the Microsoft.AspNetCore.OpenApi SOURCE GENERATOR arrives transitively and injects
    interceptor types that force server-only references, which make Assembly.GetTypes() throw in the browser. A
    browser-bound assembly removes the analyzer from its compilation (ExcludeAssets does not stop a transitive analyzer).
  -->
  <Target Name="RemoveOpenApiSourceGenerator" AfterTargets="ResolveReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Analyzer.Identity)').Contains('Microsoft.AspNetCore.OpenApi.SourceGenerators'))" />
    </ItemGroup>
  </Target>

</Project>
