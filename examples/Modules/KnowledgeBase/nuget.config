<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The local feed's packages carry the framework's release version numbers, but they are this tree's bytes, not the
    published ones: restored into a folder of their own, so the machine-wide NuGet cache only ever holds what the public
    feed publishes under a version.
  -->
  <config>
    <add key="globalPackagesFolder" value="../../.nuget-local" />
  </config>
  <!--
    The KnowledgeBase module projects (Client/Server/Shared) restore Stomme.*
    from the LOCAL FEED only (examples/local-feed, the packages produced by examples/pack-sdk.ps1), plus
    nuget.org for the third-party transitive closure (ASP.NET runtime packages, RavenDB.Client, FluentUI,
    ...). ZERO project/source references to Stomme, which is what an independent module means.
    One config at the module root covers every project here, the drive and the tests included (a harness
    references the framework by project, which restores nothing from this feed).
  -->
  <packageSources>
    <clear />
    <add key="stomme-local" value="../../local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!--
    The root NuGet.config enables packageSourceMapping, and mappings MERGE down the config
    walk (only packageSources is cleared above) — without this section, Stomme.* maps to the root's
    "*" -> nuget.org rule and stomme-local is ignored (NU1101). NovaGloben.* keeps any framework-published
    dependency (e.g. the stock themes on the fat Stomme.Server package) off nuget.org.
  -->
  <packageSourceMapping>
    <clear />
    <packageSource key="stomme-local">
      <package pattern="Stomme.*" />
      <package pattern="NovaGloben.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
