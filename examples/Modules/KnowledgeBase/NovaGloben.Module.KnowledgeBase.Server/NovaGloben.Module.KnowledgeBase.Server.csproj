<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The SERVER layer of the exemplar - the domain, the storage-blind persistence wiring, the commands and queries,
    the server-side service and the API. The host's convention scan loads it from /bin like the other
    two assemblies, but it NEVER streams to a browser: a WebAssembly site is sent only the ModuleDefinition's AssemblyName
    (the Client) and its Dependencies (the Shared).
    INDEPENDENT: Stomme arrives only through the slim SDK meta-package from examples/local-feed.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NovaGloben.Module.KnowledgeBase.Server.Stomme</AssemblyName>
    <RootNamespace>NovaGloben.Module.KnowledgeBase</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Nova Globen AB</Authors>
    <Company>Nova Globen AB</Company>
    <Product>NovaGloben.Module.KnowledgeBase</Product>
    <Description>Domain, storage-blind persistence, commands, queries and API of the KnowledgeBase exemplar module.</Description>
    <Copyright>Nova Globen AB</Copyright>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stomme.Sdk.Slim" Version="10.75.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaGloben.Module.KnowledgeBase.Shared\NovaGloben.Module.KnowledgeBase.Shared.csproj" />
  </ItemGroup>

</Project>
