<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The local feed's packages carry the framework's release version numbers, but they are this tree's bytes, not the
    published ones: restored into a folder of their own, so the machine-wide NuGet cache only ever holds what the public
    feed publishes under a version.
  -->
  <config>
    <add key="globalPackagesFolder" value="../.nuget-local" />
  </config>
  <!--
    Independence proof. The smoke module restores Stomme.* from the LOCAL FEED only (the packages
    packed by `dotnet pack`), plus nuget.org for the third-party transitive closure (ASP.NET runtime
    packages, RavenDB.Client, FluentUI, Rebus, OpenIddict, ...). ZERO project/source references to
    Stomme, which is what an independent module means.
  -->
  <packageSources>
    <clear />
    <add key="stomme-local" value="../local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!--
    The root NuGet.config enables packageSourceMapping, and mappings MERGE down the config
    walk (only packageSources is cleared above) — without this section, Stomme.* maps to the root's
    "*" -> nuget.org rule and stomme-local is ignored (NU1101). NovaGloben.* covers the stock-theme
    dependencies the fat Stomme.Server package declares.
  -->
  <packageSourceMapping>
    <clear />
    <packageSource key="stomme-local">
      <package pattern="Stomme.*" />
      <package pattern="NovaGloben.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
