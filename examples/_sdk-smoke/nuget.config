<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    D81 independence proof. The smoke module restores Stomme.* from the LOCAL FEED only (the packages
    packed by `dotnet pack`), plus nuget.org for the third-party transitive closure (ASP.NET runtime
    packages, RavenDB.Client, FluentUI, Rebus, OpenIddict, ...). ZERO project/source references to
    Stomme — this is what "INDEPENDENT" means (the owner's bar #1).
  -->
  <packageSources>
    <clear />
    <add key="stomme-local" value="../local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!--
    BL-44: the root NuGet.config (D91) enables packageSourceMapping, and mappings MERGE down the config
    walk (only packageSources is cleared above) — without this section, Stomme.* maps to the root's
    "*" -> nuget.org rule and stomme-local is ignored (NU1101). NovaGloben.* covers the D92 stock-theme
    dependencies the fat Stomme.Server package declares.
  -->
  <packageSourceMapping>
    <clear />
    <packageSource key="stomme-local">
      <package pattern="Stomme.*" />
      <package pattern="NovaGloben.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
