<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The production-slim module SDK: the SERVER compile surface.

    A packaging SHIM: it compiles nothing and ships no assembly of its own (IncludeBuildOutput=false).
    It packs the ALREADY-BUILT src/Stomme.Server/bin/Release Stomme.Server.dll into lib/net10.0 so a
    downstream module can compile against the module-facing server types (IServerStartup,
    ModuleControllerBase, ILogManager, AddModuleAggregatePersistence) — WITHOUT the fat Stomme.Server
    package's 42-dependency closure (every EF provider, RavenDB.Client, OpenIddict x6, gRPC x3, Saml2,
    FusionCache x3, Redis, SkiaSharp, MailKit, AngleSharp, the stock theme packs...). Measured on
    examples/Modules/Blogs: the fat restore closure was 180 packages / ~1.2 GB in the global packages
    folder — and carried a known-critical System.Drawing.Common 4.7.0 via the Saml2 chain (NU1904),
    because the vulnerability pin protects the APP build but does not flow into the packed nuspec.

    Why a shim instead of re-packing Stomme.Server.csproj with different properties: `-p:PackageId=...`
    is a GLOBAL MSBuild property, so it renames every project in the reference graph ("Ambiguous project
    name" at restore), and SuppressDependenciesWhenPacking is all-or-nothing. The shim's OWN references
    below define the curated dependency surface natively.

    The dependency curation:
      - FrameworkReference Microsoft.AspNetCore.App -> flows into the nuspec frameworkReferences group,
        exactly as the fat package's Web-SDK pack does, so a module's controller/startup compiles against
        the shared framework (no packages downloaded — it is the installed runtime's targeting pack).
      - The Stomme.* assemblies a consumer sees in the module-facing signatures (Stomme.Shared,
        Stomme.SharedKernel) arrive via the Stomme.Sdk.Slim meta-package, which is the documented way
        to consume this (this package is not meant to be referenced standalone).

    COMPILE-ONLY by intent: at runtime the module DLL is dropped into a real Stomme host's /bin, where
    the full server closure already exists. Nothing from this package ships to production.

    Prerequisite: src/Stomme.Server was built in Release (examples/pack-sdk-slim.ps1 does this).
    Versioning: <Version> flows from examples/Directory.Build.props (mirroring the root), and the pack
    script's -SdkVersion parameter can rev the SDK packages independently of an app release.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>true</IsPackable>
    <PackageId>Stomme.Server.Sdk</PackageId>
    <Authors>Nova Globen AB</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/nova-globen/stomme</PackageProjectUrl>
    <PackageTags>stomme;module;sdk;server;compile-surface</PackageTags>
    <Description>Compile-time server surface for Stomme module authors: the Stomme.Server assembly (IServerStartup, ModuleControllerBase, ILogManager, AddModuleAggregatePersistence) without the full server dependency closure. Consume via the Stomme.Sdk.Slim meta-package; at runtime the module runs inside a full Stomme host.</Description>
    <!-- lib/net10.0 with no per-TFM dependency group is intentional (deps are curated, not inherited). -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\src\Stomme.Server\bin\Release\net10.0\Stomme.Server.dll"
          Pack="true" PackagePath="lib\net10.0\" />
  </ItemGroup>


  <!-- LICENSE and THIRD-PARTY-NOTICES.md at the package root, as the framework's own packages carry them. -->
  <ItemGroup>
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
