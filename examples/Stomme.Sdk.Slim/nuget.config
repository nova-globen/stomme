<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The local feed's packages carry the framework's release version numbers, but they are this tree's bytes, not the
    published ones: restored into a folder of their own, so the machine-wide NuGet cache only ever holds what the public
    feed publishes under a version.
  -->
  <config>
    <add key="globalPackagesFolder" value="../.nuget-local" />
  </config>
  <!-- The slim SDK projects restore Stomme.* from the local feed built by pack-sdk-slim.ps1. -->
  <packageSources>
    <clear />
    <add key="stomme-local" value="../local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!--
    The root NuGet.config enables packageSourceMapping, and mappings MERGE down the config walk
    (only packageSources is cleared above) — without this section, Stomme.* maps to the root's
    "*" -> nuget.org rule and stomme-local is ignored (NU1101).
  -->
  <packageSourceMapping>
    <clear />
    <packageSource key="stomme-local">
      <package pattern="Stomme.*" />
      <package pattern="NovaGloben.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
