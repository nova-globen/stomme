<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The local feed's packages carry the framework's release version numbers, but they are this tree's bytes, not the
    published ones: restored into a folder of their own, so the machine-wide NuGet cache only ever holds what the public
    feed publishes under a version.
  -->
  <config>
    <add key="globalPackagesFolder" value="../.nuget-local" />
  </config>
  <!-- The meta-package restores its Stomme.* dependencies from the local feed built by pack-sdk.ps1. -->
  <packageSources>
    <clear />
    <add key="stomme-local" value="../local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!--
    The root NuGet.config enables packageSourceMapping, and MAPPINGS MERGE across the config
    walk even though <packageSources><clear/> resets the sources — so without a mapping section HERE,
    Stomme.* resolves through the root's "*" -> nuget.org rule and stomme-local is "not considered"
    (NU1101; this silently broke the independence flow when a package-source change landed). Longest-pattern-wins: Stomme.* stays
    local, NovaGloben.* (the stock-theme deps the fat Stomme.Server package declares) stays on the
    store feed, everything else nuget.org.
  -->
  <packageSourceMapping>
    <clear />
    <packageSource key="stomme-local">
      <package pattern="Stomme.*" />
      <package pattern="NovaGloben.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
