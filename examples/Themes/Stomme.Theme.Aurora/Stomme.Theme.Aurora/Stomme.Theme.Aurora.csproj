<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    D87. An INDEPENDENT, packages-only external THEME for Stomme — the general/public UI theme (Aurora),
    the sibling of the Slate admin theme. Same shape as examples/Modules/Blogs (D82): references Stomme ONLY through
    the Stomme.Sdk meta-package from the local feed (examples/local-feed), ZERO project/source references.
    The assembly name MUST contain "Stomme" or the convention loader never loads it. Ships its Theme.css as a
    static web asset (wwwroot/Theme.css) which InstallationManager extracts to _content/<id>/ at install time.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Stomme.Theme.Aurora.Stomme</AssemblyName>
    <!-- D92: align the build-pipeline asset base path with the PACKAGE id (the InstallationManager
         extraction path and the ThemeInfo stylesheet URL) instead of the .Stomme assembly name -->
    <StaticWebAssetBasePath>_content/Stomme.Theme.Aurora</StaticWebAssetBasePath>
    <RootNamespace>Stomme.Themes.Aurora</RootNamespace>
    <!-- No <Version> of its own (BL-259): the framework's, from examples/Directory.Build.props, so every release moves it -
         1.0.0 kept its number while 10.74.1 changed its content, and machines that had it cached kept the old package. -->
    <Authors>Nova Globen AB</Authors>
    <Company>Nova Globen AB</Company>
    <Product>Stomme.Theme.Aurora</Product>
    <Description>An independent general/public UI theme for Stomme.</Description>
    <Copyright>Nova Globen AB</Copyright>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
    <!-- D115: the licence travels inside the package as a file. examples/Directory.Build.props stops the walk to the root
         props (D81), so this csproj - packed by scripts/pack-framework.ps1 as part of Stomme.Server's closure - states it. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- BL-70: Stomme.Client, NOT the Stomme.Sdk meta. The meta includes Stomme.Server, which since
         D92 depends on the theme PACKAGES — so packing this theme against the meta pulled the theme's own
         OLDER package into its static-web-asset graph (same SourceId as this project), and the generated
         pack props declared a stale second asset for the same target path. Every consumer building
         Stomme.Server against such a pack dies on 'Conflicting assets'. A theme is client-side; the
         Client package (plus its transitive Shared) is the whole surface it compiles against, and it has
         no edge back to the themes. Still packages-only - zero source references (D81). -->
    <ProjectReference Include="..\..\..\..\src\Stomme.Client\Stomme.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The folder's own restore configuration, not content of the theme: the host references both stock themes, and their two
         nuget.config files collided in its publish output (NETSDK1152, measured 2026-10-28). -->
    <Content Update="nuget.config" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="nuget.config" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
