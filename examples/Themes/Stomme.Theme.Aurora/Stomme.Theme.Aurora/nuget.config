<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restores Stomme.* from the LOCAL FEED only (examples/local-feed, produced by examples/pack-sdk.ps1),
    plus nuget.org for the third-party transitive closure. ZERO project/source references to Stomme.
  -->
  <packageSources>
    <clear />
    <add key="stomme-local" value="../../../local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!--
    Fix found by a cold-cache restore: the root NuGet.config enables
    packageSourceMapping, and mappings MERGE down the config walk even though <packageSources><clear/>
    resets the sources — without a mapping section HERE, Stomme.* maps to the root's "*" -> nuget.org
    rule and stomme-local is "not considered" (NU1101). It only ever restored locally because the warm
    global cache already held Stomme.Sdk. NovaGloben.* is mapped to the local feed too: the fat
    Stomme.Server package declares the stock themes (NovaGloben.*) as dependencies.
  -->
  <packageSourceMapping>
    <clear />
    <packageSource key="stomme-local">
      <package pattern="Stomme.*" />
      <package pattern="NovaGloben.*" />
    </packageSource>
    <!-- Stomme.* from nuget.org as well: this project references the STABLE
         minimum it supports, and a run that packs a preview leaves only prerelease Stomme.* in the local feed, which
         NuGet never uses for a stable minimum (NU1103) - measured, a preview release's pack run failed there. With
         both sources the lowest published stable at or above the minimum is used, so the pack is built against a
         framework already published. -->
    <packageSource key="nuget.org">
      <package pattern="Stomme.*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
