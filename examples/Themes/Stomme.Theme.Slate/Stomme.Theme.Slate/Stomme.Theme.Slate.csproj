<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    An INDEPENDENT, packages-only external THEME for Stomme — the admin theme (Slate),
    the sibling of the Slate admin theme. Same shape as examples/Modules/Blogs: references Stomme ONLY through
    the Stomme.Sdk meta-package from the local feed (examples/local-feed), ZERO project/source references.
    The assembly name MUST contain "Stomme" or the convention loader never loads it. Ships its Theme.css as a
    static web asset (wwwroot/Theme.css) which InstallationManager extracts to _content/<id>/ at install time.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Stomme.Theme.Slate.Stomme</AssemblyName>
    <!-- Align the build-pipeline asset base path with the PACKAGE id (the InstallationManager
         extraction path and the ThemeInfo stylesheet URL) instead of the .Stomme assembly name -->
    <StaticWebAssetBasePath>_content/Stomme.Theme.Slate</StaticWebAssetBasePath>
    <RootNamespace>Stomme.Themes.Slate</RootNamespace>
    <!-- No <Version> of its own: the framework's - see the Aurora csproj. -->
    <Authors>Nova Globen AB</Authors>
    <Company>Nova Globen AB</Company>
    <Product>Stomme.Theme.Slate</Product>
    <Description>An independent admin theme for Stomme.</Description>
    <Copyright>Nova Globen AB</Copyright>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
    <!-- The licence travels inside the package as a file - see the Aurora csproj (the root props do not reach examples/). -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stomme.Client, NOT the Stomme.Sdk meta — the meta's Stomme.Server depends on the
         theme packages, which poisoned the theme's own pack props with a stale self-asset. See the
         Aurora csproj for the full mechanism. Packages-only still holds. -->
    <ProjectReference Include="..\..\..\..\src\Stomme.Client\Stomme.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The folder's own restore configuration, not content of the theme: the host references both stock themes, and their two
         nuget.config files collided in its publish output (NETSDK1152). -->
    <Content Update="nuget.config" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="nuget.config" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
