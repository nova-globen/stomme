@namespace Stomme.Themes.Slate
@inherits ContainerBase

<div class="slate-module">
    @if (ModuleState.Title != "-")
    {
        <div class="slate-module-head">
            <ModuleActions /><h2><ModuleTitle /></h2>
        </div>
    }
    else
    {
        <ModuleActions />
    }
    <ModuleInstance />
</div>

@code {
    public override string Name => "Slate Container";
}
