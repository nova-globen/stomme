<Project>
  <!--
    D81. Isolates examples/ from the framework build. The SDK-feed consumers (the Stomme.Sdk
    meta-package packer and the _sdk-smoke proof module) are STANDALONE: they must restore + build
    against the published packages ONLY, exactly as a downstream module would. Stopping the upward
    Directory.Build.props / Directory.Packages.props walk here keeps the framework's central package
    management out of them, so the smoke module proves package independence for real.
  -->
  <PropertyGroup>
    <!-- Mirror the framework package version (root Directory.Build.props <Version>), so Stomme.Sdk
         is versioned in lock-step with the module-facing packages it depends on. -->
    <Version>10.74.0</Version>
  </PropertyGroup>
</Project>
