<Project>
  <!-- The vendored engine: elsa-core 3.7.1, deep-renamed to Stomme.Engine.* by
       scripts/vendor-engine.ps1. This file is GENERATED by that script — edit the script, not this file.
       It imports Stomme's root props (version, authors, licence packing) explicitly, because MSBuild only
       auto-imports the nearest Directory.Build.props. Nothing of upstream's props is imported. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The vendored tree's warnings are upstream's; they are not a build gate here. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0162;CS1591;CS0618</NoWarn>
    <NoWarn>$(NoWarn);IL2026;IL2046;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL2111</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Upstream carries these attributes throughout; MIT, private assets (never flows to a consumer). -->
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
  </ItemGroup>
</Project>