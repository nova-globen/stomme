<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Stomme</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <!-- Transport (brief 04 / D10): the .proto contracts are the single source of truth for the typed
       gRPC surface. Grpc.Tools generates client + server stubs at build time; the generated code only
       needs the lightweight Grpc.Core.Api + Google.Protobuf runtimes (no ASP.NET dependency), so both
       the WASM client and the server host consume the same contract assembly. Opt-in transport packages
       (Grpc.AspNetCore, SignalR) live in the host/client projects, not here. -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Transport\Protos\transport.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
