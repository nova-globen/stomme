<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Stomme.Persistence.EfCore</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Bare ADO driver for the PostgreSQL advisory-lock IDistributedLock (pg_try_advisory_lock). -->
    <PackageReference Include="Npgsql" />
    <!-- BL-78 (D100): the JSON collection column of ModuleAggregatesDbContext serializes with the SAME Newtonsoft
         contract the File and RavenDB module stores use, so a collection reconstructs identically on all three. MIT. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stomme.Persistence.Abstractions\Stomme.Persistence.Abstractions.csproj" />
    <ProjectReference Include="..\Stomme.Tenancy.Abstractions\Stomme.Tenancy.Abstractions.csproj" />
  </ItemGroup>

</Project>
