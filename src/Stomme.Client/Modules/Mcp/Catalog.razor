@namespace Stomme.Modules.Mcp
@inherits ModuleBase
@inject IMcpService McpService

@*
    What THIS install publishes over MCP - mcp:view.

    It is what the CURRENT USER may see: every descriptor listed here has already passed its own gates for this principal on
    this site, so the page cannot become a directory of what somebody else could use. The approval column shows the EFFECTIVE
    value, after any mcp.tool.{name}.approval site override - a site may tighten any tool, and can never open a Deny one nor
    make a mutating-named tool Auto.
*@

<PageTitle>MCP catalog</PageTitle>

<nav class="db-tablist" aria-label="MCP">
    @if (IsAuthorizedPermission(McpPermissions.Manage))
    {
        <span class="db-tab-item"><a class="db-tab" href="@NavigateUrl()">External servers</a></span>
    }
    @if (IsAuthorizedPermission(McpPermissions.View))
    {
        <span class="db-tab-item"><a class="db-tab active" href="@EditUrl("Catalog")" aria-current="page">What this site publishes</a></span>
    }
    @if (IsAuthorizedPermission(McpPermissions.ViewAudit))
    {
        <span class="db-tab-item"><a class="db-tab" href="@EditUrl("Audit")">Audit ledger</a></span>
    }
</nav>
@if (!IsAuthorizedPermission(McpPermissions.View))
{
    <p class="db-mcp-denied" style="color:var(--db-text-2);">You do not have access to the MCP catalog.</p>
}
else
{
    <div class="db-mcp-catalog" style="display:flex;flex-direction:column;gap:1rem;">
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;">
            <h3 style="margin:0;flex:1 1 auto;">What this site publishes</h3>
            <button id="mcp-catalog-refresh" type="button" class="db-btn" @onclick="LoadAsync">Refresh</button>
        </div>

        @if (_status?.Conflicts.Count > 0)
        {
            <section id="mcp-catalog-conflicts" class="db-message db-message-warn" role="status">
                <div class="db-message-body">
                    <p style="margin:0 0 0.35rem;">
                        These names were published by two modules, so neither is served. Remove or rename one of the
                        contributions and restart the site to restore the name.
                    </p>
                    <ul style="margin:0;padding-left:1.2rem;">
                        @foreach (var conflict in _status.Conflicts)
                        {
                            <li>@conflict.Kind <code>@conflict.Name</code> - @string.Join(" and ", conflict.Contributors)</li>
                        }
                    </ul>
                </div>
            </section>
        }

        @if (_status is { ServerEnabled: false })
        {
            <p id="mcp-server-off" style="margin:0;color:var(--db-text-2);">
                This install publishes nothing to MCP clients: the MCP server is switched off. A Host turns it on with the
                setting <code>Mcp:Server:Enabled</code> and restarts the site.
            </p>
        }
        else if (_items.Count == 0)
        {
            <p id="mcp-catalog-empty" style="margin:0;color:var(--db-text-2);">
                Nothing is published to you on this site: no module contributes an MCP resource or tool, or you do not hold
                the keys the contributions require.
            </p>
        }
        else
        {
            <table class="table db-mcp-catalog-table">
                <thead><tr><th>Kind</th><th>Name</th><th>Description</th><th>Approval</th></tr></thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td>@item.Kind</td>
                            <td style="word-break:break-all;">@item.Name</td>
                            <td>@item.Description</td>
                            <td>@(item.Approval ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <p style="margin:0;color:var(--db-text-2);font-size:0.9em;">
                <b>Confirm</b> means the tool is described but will not run: this release has no approval pipeline, and a call
                is denied with its own entry in the audit ledger. A tool set to <b>Deny</b> is not listed at all.
            </p>
        }
    </div>
}

@code {
    private List<McpPublishedItemView> _items = new();
    private McpStatusView? _status;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (IsAuthorizedPermission(McpPermissions.View))
        {
            // An empty list is also the answer when the server half is off: the route does not exist then, and the
            // service answers an empty list rather than an error, because "this install publishes nothing" is the truth.
            _items = await McpService.GetPublishedAsync();
            try
            {
                _status = await McpService.GetStatusAsync();
            }
            catch (Exception ex)
            {
                await logger.LogError(ex, "The MCP status could not be read.");
            }
        }
    }
}
