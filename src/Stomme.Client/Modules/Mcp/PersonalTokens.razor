@namespace Stomme.Modules.Mcp
@inject IMcpService McpService
@inject NavigationManager NavigationManager

@*
    A person's own personal MCP tokens (D101a, BL-101), on their profile: what lets an AI tool outside the browser - Claude
    Desktop, an agent on another machine - use this site's MCP server as them. A token works on this site only, can do only
    what its owner can, and only what it was allowed; it always expires; it is revoked at once. The secret is shown ONCE.
*@

<div id="mcp-tokens" style="display:flex;flex-direction:column;gap:1rem;">
    <p style="margin:0;">
        A personal MCP token lets an AI tool outside the browser use this site's MCP server as you - on this site only, and only
        for what you can do here and allow below. Give the tool the address <code id="mcp-tokens-endpoint">@Endpoint</code> and
        the token as <code>Authorization: Bearer &lt;token&gt;</code>.
    </p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div id="mcp-tokens-error" class="db-message db-message-warn" role="alert"><div class="db-message-body">@_error</div></div>
    }

    @if (_created is not null)
    {
        <section id="mcp-tokens-created" class="db-message db-message-ok" role="status">
            <div class="db-message-body" style="display:flex;flex-direction:column;gap:0.4rem;">
                <strong>Copy the token for '@_created.Token.Name' now - it is not shown again.</strong>
                <input id="mcp-tokens-secret" class="db-input db-mono" readonly value="@_created.Secret" aria-label="The new token" style="width:100%;" />
                <button type="button" class="db-btn db-btn-neutral" style="align-self:flex-start;" @onclick="() => _created = null">I have copied it</button>
            </div>
        </section>
    }

    @if (_tokens.Count == 0)
    {
        <p id="mcp-tokens-empty" style="margin:0;color:var(--db-text-2);">You have no personal MCP tokens on this site. Make one below for each tool you connect.</p>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="table" id="mcp-tokens-list">
                <thead><tr><th>Name</th><th>Token</th><th>May</th><th>Expires (UTC)</th><th>Last used (UTC)</th><th></th></tr></thead>
                <tbody>
                    @foreach (var token in _tokens)
                    {
                        <tr>
                            <td>@token.Name</td>
                            <td><code>@(token.Prefix)…</code></td>
                            <td>@string.Join(", ", token.Scopes.Select(Describe))</td>
                            <td>@token.ExpiresOnUtc.ToString("yyyy-MM-dd")</td>
                            <td>@(token.LastUsedOnUtc?.ToString("yyyy-MM-dd HH:mm") ?? "never")</td>
                            <td>
                                @if (token.RevokedOnUtc is not null)
                                {
                                    <span>Revoked</span>
                                }
                                else if (token.ExpiresOnUtc <= DateTime.UtcNow)
                                {
                                    <span>Expired</span>
                                }
                                else
                                {
                                    <ActionDialog Id="@($"mcp-token-revoke-{token.Id:N}")" Header="Revoke token" Message="@($"Revoke '{token.Name}'? The tool using it is refused from now on.")" Action="Revoke" Security="SecurityAccessLevel.Anonymous" Class="db-btn db-btn-danger" OnConfirm="@(() => RevokeAsync(token))" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <section class="db-card" style="padding:0.75rem 1rem;display:flex;flex-direction:column;gap:0.6rem;max-width:560px;">
        <h4 style="margin:0;">New token</h4>
        <label for="mcp-tokens-name">Name - the tool it is for</label>
        <input id="mcp-tokens-name" class="db-input" maxlength="100" placeholder="e.g. Claude Desktop on my laptop" @bind="_name" @bind:event="oninput" />
        <label for="mcp-tokens-days">Expires after</label>
        <select id="mcp-tokens-days" class="db-select" @bind="_days">
            <option value="7">7 days</option>
            <option value="30">30 days</option>
            <option value="90">90 days</option>
            <option value="365">a year</option>
        </select>
        <fieldset style="border:0;margin:0;padding:0;display:flex;flex-direction:column;gap:0.3rem;">
            <legend style="padding:0;margin-bottom:0.2rem;">It may</legend>
            <label><input id="mcp-tokens-resources" type="checkbox" @bind="_resources" /> read what this site publishes (resources)</label>
            <label><input id="mcp-tokens-tools" type="checkbox" @bind="_tools" /> call this site's tools (tools)</label>
        </fieldset>
        <button id="mcp-tokens-create" type="button" class="db-btn" style="align-self:flex-start;" @onclick="CreateAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_name) || !(_resources || _tools))">Make token</button>
    </section>
</div>

@code {
    private List<McpTokenView> _tokens = new();
    private McpTokenCreated _created;
    private string _error = "";
    private string _name = "";
    private int _days = 30;
    private bool _resources = true;
    private bool _tools;
    private bool _busy;

    /// <summary>The MCP endpoint's path on this site, from the status the profile read.</summary>
    [Parameter]
    public string Path { get; set; } = "/mcp/v1";

    private string Endpoint => NavigationManager.BaseUri.TrimEnd('/') + Path;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _tokens = await McpService.GetTokensAsync();
        }
        catch (Exception)
        {
            _tokens = new();
            _error = "Your tokens could not be read. Reload the page; if it keeps failing, ask an administrator to check the event log.";
        }
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _error = "";
        try
        {
            var scopes = new List<string>();
            if (_resources) scopes.Add(McpTokenScopes.Resources);
            if (_tools) scopes.Add(McpTokenScopes.Tools);
            _created = await McpService.CreateTokenAsync(new McpTokenRequest { Name = _name.Trim(), Days = _days, Scopes = scopes });
            _name = "";
            await LoadAsync();
        }
        catch (ServiceRefusalException ex)
        {
            _error = "The token was not made: " + ex.Message;
        }
        catch (Exception)
        {
            _error = "The token was not made. Try again; if it keeps failing, ask an administrator to check the event log.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokeAsync(McpTokenView token)
    {
        _error = "";
        try
        {
            await McpService.RevokeTokenAsync(token.Id);
            if (_created?.Token.Id == token.Id)
            {
                _created = null;
            }
        }
        catch (Exception)
        {
            _error = $"'{token.Name}' was not revoked. Try again; if it keeps failing, ask an administrator to check the event log.";
        }

        await LoadAsync();
    }

    private static string Describe(string scope) => scope == McpTokenScopes.Tools ? "call tools" : scope == McpTokenScopes.Resources ? "read resources" : scope;
}
