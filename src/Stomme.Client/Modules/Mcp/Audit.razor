@namespace Stomme.Modules.Mcp
@inherits ModuleBase
@inject IMcpService McpService

@*
    The site's MCP audit ledger - mcp:view-audit, a key of its OWN.

    These are EVERY principal's calls on this site, not the reader's own, which is why they are not behind mcp:view. That split
    is the same split Notifications makes, where one key gated a user's own inbox and the whole site's send log.

    The arguments are not here because they are not stored: the ledger keeps their SHA-256 and length, which is enough to say
    "these two were the same call" without becoming a copy of everything anyone sent.
*@

<PageTitle>MCP audit</PageTitle>

@if (!IsAuthorizedPermission(McpPermissions.ViewAudit))
{
    <p class="db-mcp-denied" style="color:var(--db-text-2);">You do not have access to the MCP audit ledger.</p>
}
else
{
    <div class="db-mcp-audit" style="display:flex;flex-direction:column;gap:1rem;">
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;">
            <h3 style="margin:0;flex:1 1 auto;">MCP audit ledger</h3>
            <label>
                Days
                <select id="mcp-audit-days" class="db-input" @bind="_days" @bind:after="LoadAsync">
                    <option value="1">1</option>
                    <option value="7">7</option>
                    <option value="30">30</option>
                    <option value="90">90</option>
                </select>
            </label>
            <button id="mcp-audit-refresh" type="button" class="db-btn" @onclick="LoadAsync">Refresh</button>
        </div>

        @if (_entries.Count == 0)
        {
            <p id="mcp-audit-empty" style="margin:0;color:var(--db-text-2);">No MCP call was made on this site in that window.</p>
        }
        else
        {
            <table class="table db-mcp-audit-table">
                <thead><tr><th>When (UTC)</th><th>User</th><th>Verb</th><th>Subject</th><th>Outcome</th><th>Args</th></tr></thead>
                <tbody>
                    @foreach (var entry in _entries)
                    {
                        <tr>
                            <td>@entry.OccurredOnUtc.ToString("u")</td>
                            <td>@entry.UserId</td>
                            <td>@entry.Verb</td>
                            <td style="word-break:break-all;">@entry.Subject</td>
                            <td>@entry.Outcome</td>
                            <td title="@entry.ArgumentsSha256">@entry.ArgumentsLength bytes</td>
                        </tr>
                    }
                </tbody>
            </table>

            <p style="margin:0;color:var(--db-text-2);font-size:0.9em;">
                <b>Denied</b> covers a caller without the key AND a tool that does not exist - they are one answer on the wire,
                so the ledger is where they are told apart. <b>ConfirmDenied</b> is a tool that needs an approval this release
                has no pipeline for.
            </p>
        }
    </div>
}

@code {
    private List<McpAuditEntryView> _entries = new();
    private int _days = 7;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (IsAuthorizedPermission(McpPermissions.ViewAudit))
        {
            _entries = await McpService.GetAuditAsync(_days);
        }
    }
}
