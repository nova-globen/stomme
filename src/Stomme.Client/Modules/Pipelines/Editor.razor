    // What each called sub-pipeline expects - its "When called by another pipeline"'s fields and required ones - read from
    // its graph once (null when it declares none); nothing while it loads. The calls are held to it in the problems.
    private readonly Dictionary<string, PipelineCallContract> _calledContracts = new(StringComparer.Ordinal);
    private readonly HashSet<string> _calledLoading = new(StringComparer.Ordinal);

    private List<PipelineField> CalledFields(string definitionId) => CalledContract(definitionId)?.Fields;

    private PipelineCallContract CalledContract(string definitionId)
    {
        if (_calledContracts.TryGetValue(definitionId, out var known))
        {
            return known;
        }

        if (_calledLoading.Add(definitionId))
        {
            _ = LoadCalledContractAsync(definitionId);
        }

        return null;
    }

    private async Task LoadCalledContractAsync(string definitionId)
    {
        PipelineCallContract contract = null;
        try
        {
            contract = PipelineCallContracts.Known(await PipelinesService.GetGraphAsync(definitionId)); // its fields, and who may call it
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading A Sub-Pipeline's Fields {Error}", ex.Message);
        }

        _calledContracts[definitionId] = contract;
        await InvokeAsync(() =>
        {
            CheckProblems(); // the calls to it are held to what it expects now it is known
            StateHasChanged();
        });
    }

    // The pipelines that call this one, asked for once the "When called" step is first shown; null while they load.
    private List<PipelineCallerView> _callers;
    private bool _callersAsked;

    private List<PipelineCallerView> Callers()
    {
        if (!_callersAsked && !string.IsNullOrEmpty(_definitionId))
        {
            _callersAsked = true;
            _ = LoadCallersAsync();
        }

        return _callers;
    }

    private async Task LoadCallersAsync()
    {
