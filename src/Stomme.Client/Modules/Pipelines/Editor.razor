    // D (n8n's deactivate): the selected steps switched off - or, when every one already is, back on - as one change.
    private void ToggleDisabled()
    {
        var chosen = SelectedNodes();
        if (chosen.Count == 0 || !CanManage)
        {
            return;
        }

        var off = chosen.Any(node => !node.Disabled);
        foreach (var node in chosen)
        {
            node.SetDisabled(off);
        }

        MarkDirty();
        _message = (off ? "Switched off: " : "Switched on: ") + string.Join(", ", chosen.Select(node => node.DisplayName)) + (off ? " - skipped when the pipeline runs." : ".");
    }

    private void SetSelectedDisabled(bool disabled)
