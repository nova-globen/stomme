    // n8n's time saved per run - a change like any other: saved, merged, undone. Empty, nought or less says nothing.
    private void SetMinutesSaved(string value)
    {
        var minutes = int.TryParse(value, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var typed) ? PipelineInsights.MinutesSaved(typed) : null;
        if (minutes == _graph.MinutesSavedPerRun)
        {
            return;
        }

        _graph.MinutesSavedPerRun = minutes;
        MarkDirty("minutes-saved");
    }

    // n8n's "Timeout Workflow" - how long a run may be busy before it is stopped; a change like any other: saved, merged,
    // undone. Empty, nought or less is no limit; more than a day is a day.
    private void SetTimeoutMinutes(string value)
    {
        var minutes = int.TryParse(value, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var typed) ? PipelineRunTimeout.Minutes(typed) : null;
        if (minutes == _graph.TimeoutMinutes)
        {
            return;
        }

        _graph.TimeoutMinutes = minutes;
        MarkDirty("timeout-minutes");
    }

    // n8n's "This workflow can be called by" - which pipelines may call this one; a change like any other: saved, merged,
    // undone. "Only the pipelines chosen" with none chosen yet admits nobody, as n8n's empty list does.
    private const string OnlyChosenCallers = "only";

    private string CalledByChoice() => PipelineCallers.Normalize(_graph?.CalledBy) switch
    {
        null => "",
        PipelineCallers.Nobody => _onlyChosenCallers ? OnlyChosenCallers : PipelineCallers.Nobody,
        _ => OnlyChosenCallers,
    };

    // "Only the pipelines chosen" before any is: kept as nobody, shown as the list it is becoming.
    private bool _onlyChosenCallers;

    private void SetCalledByChoice(string value)
    {
        _onlyChosenCallers = value == OnlyChosenCallers;
        var setting = value switch
        {
            OnlyChosenCallers => PipelineCallers.Only(PipelineCallers.Ids(_graph.CalledBy)),
            PipelineCallers.Nobody => PipelineCallers.Nobody,
            _ => null,
        };
        if (setting == PipelineCallers.Normalize(_graph.CalledBy))
        {
            return;
        }

        _graph.CalledBy = setting;
        MarkDirty();
    }

    private void AddCaller(string definitionId)
    {
        if (string.IsNullOrEmpty(definitionId))
        {
            return;
        }

        _onlyChosenCallers = true;
        _graph.CalledBy = PipelineCallers.Only(PipelineCallers.Ids(_graph.CalledBy).Append(definitionId));
        MarkDirty();
    }

    private void RemoveCaller(string definitionId)
    {
        _graph.CalledBy = PipelineCallers.Only(PipelineCallers.Ids(_graph.CalledBy).Where(id => id != definitionId));
        MarkDirty();
    }

    // n8n's workflow "Timezone" - a change like any other: saved, merged, undone; one this machine does not know is said
    // here, and the save refuses it. The preview reads $now and $today in it at once.
    private void SetTimeZone(string value)
    {
        var zone = PipelineTimeZone.Normalize(value);
        if (zone == PipelineTimeZone.Normalize(_graph.TimeZone))
        {
            return;
        }

        _error = PipelineTimeZone.Problem(zone) ?? "";
        _graph.TimeZone = zone;
        MarkDirty();
    }

    // How many runs of the pipeline may go at once - a change like any other: saved, merged, undone.
    private void SetRunsAtOnce(string value)
    {
        var setting = PipelineRunsAtOnce.Normalize(value);
        _graph.RunsAtOnce = setting.Length == 0 ? null : setting;
        MarkDirty();
    }

    private static PipelineGraphNote CopyNote(PipelineGraphNote note) => new()
    {
        Id = note.Id,
        Text = note.Text ?? "",
        Position = new GraphPosition { X = note.Position?.X ?? 0, Y = note.Position?.Y ?? 0 },
        Parent = string.IsNullOrEmpty(note.Parent) ? null : note.Parent,
        ParentPort = string.IsNullOrEmpty(note.Parent) ? null : note.ParentPort,
        Color = PipelineNoteColors.Normalize(note.Color),
    };

    private bool InScope(PipelineGraphNote note) => note.Parent == _scopeParent && (_scopeParent is null || note.ParentPort == _scopePort);

    // n8n's "Save changes before leaving?": leaving for another page with changes not saved is held, and the editor asks
    // - save and leave, leave without saving, or stay. The editor never navigates itself (a step or a run is chosen in place), so
    // any navigation the page makes is leaving this pipeline; a link opening a new tab makes none.
    private string _leaveTo;
    private string _leaveError;
    private bool _leaving;
    private bool _focusLeaving;

    private void OnLeaving(LocationChangingContext context)
    {
        if (_leaving || !_dirty || !CanManage)
        {
            return;
        }

        context.PreventNavigation();
        _leaveTo = context.TargetLocation;
        _leaveError = null;
        _focusLeaving = true;
    }

    private async Task SaveAndLeaveAsync()
    {
        if (await SaveAsync())
        {
            Leave();
            return;
        }

        _leaveError = string.IsNullOrEmpty(_error) ? "It was not saved." : "It was not saved - " + _error; // the question stays: nothing is lost
    }

    private void Leave()
    {
        var target = _leaveTo;
        _leaveTo = null;
        if (target is null)
        {
            return;
        }

        _leaving = true;
        NavigationManager.NavigateTo(target);
    }

    private void Stay()
    {
        _leaveTo = null;
        _leaveError = null;
    }

    private async Task<bool> SaveAsync()
    {
        _busy = true;
        _error = "";
        _message = "";
        _conflicts.Clear();
        try
        {
            if (_collaboration is { IsJoined: true } && _loaded is not null)
            {
                return await SaveMergedAsync();
            }

            _pipeline = ToDetail(await PipelinesService.SaveGraphAsync(_definitionId, ToGraph()), _pipeline);
            _loaded = null; // saved without the merge: no longer a base to measure from
            _dirty = false;
            _message = $"Saved as draft version {_pipeline.Version}.";
            return true;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Saving Pipeline Graph {Error}", ex.Message);
            // The save's own reason when it gave one (a time zone or a cron it does not know, a value an input cannot take) - found
            // driving: the editor said only that "an input may hold a value its type cannot take" while the server named the input.
            _error = RefusalReason(ex) is { Length: > 0 } reason
                ? "The pipeline was refused: " + reason
                : "The pipeline was refused. An input may hold a value its type cannot take, or a step is no longer offered.";
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    // While collaborating: the graph measured against the one this editor loaded. Merged - the canvas
    // becomes the stored graph, both editors' work in it; rejected - nothing was stored, and each conflict says what the
    // other editor holds now.
    private async Task<bool> SaveMergedAsync()
    {
        var result = await PipelinesService.SaveGraphMergedAsync(_definitionId, ToGraph(), _loaded);
        if (result is null)
        {
            _error = "There is no such pipeline on this site any more.";
            return false;
        }

        if (result.Status == nameof(ConflictResolutionStatus.Rejected))
        {
            _error = "Not saved: someone else changed the same thing since you opened the pipeline. Reload to take their version, then make your change again.";
            _conflicts.AddRange(result.Conflicts.Select(conflict =>
                $"{PipelineGraphFields.Describe(conflict.Path, result.Graph)}: yours is {Shown(conflict.ProposedValue)}, theirs is {Shown(conflict.CurrentValue)}."));
            return false;
        }

        _pipeline = ToDetail(result.Pipeline, _pipeline);
        _loaded = result.Graph;
        _dirty = false;
        if (result.Status == nameof(ConflictResolutionStatus.Merged))
        {
            BuildDiagram(result.Graph); // their changes and yours, as stored
            _history.Reset(Snapshot()); // undo cannot reach back past someone else's merged changes
            CheckProblems();
            _message = $"Saved as draft version {_pipeline.Version}, merged with the changes someone else saved meanwhile.";
            _conflicts.AddRange(result.Warnings.Select(warning => $"{PipelineGraphFields.Describe(warning.Path, result.Graph)}: your text replaced {Shown(warning.OverwrittenValue)}."));
        }
        else
        {
            _message = $"Saved as draft version {_pipeline.Version}.";
        }

        await _collaboration.AnnounceAsync("saved the pipeline");
        return true;
    }

    private static string Shown(string value) =>
        value is null ? "(nothing - removed)" : value == PipelineGraphFields.Present ? "(present)" : "'" + (value.Length > 60 ? value[..60] + "…" : value) + "'";

    // n8n's workflow name, edited in place: the pipeline's name and what it does, saved into its draft (a new draft over
    // a published version - the publisher's rule - which a publish puts live), and nothing of the canvas with them.
    private bool _detailsOpen;
    private string _detailsName = "";
    private string _detailsDescription = "";

    private async Task OpenDetails()
    {
        _detailsName = _pipeline?.Name ?? "";
        _detailsDescription = _pipeline?.Description ?? "";
        _detailsOpen = true;
        await FocusFieldAsync("pipelines-editor-details-name");
    }

    // Closed, the focus goes back to the name, where the author started (found driving: it was left on the page).
    private async Task CloseDetailsAsync()
    {
        _detailsOpen = false;
        await FocusFieldAsync("pipelines-editor-name");
    }

    private async Task DetailsKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveDetailsAsync();
        }
        else if (e.Key == "Escape")
        {
            await CloseDetailsAsync();
        }
    }

    private async Task SaveDetailsAsync()
    {
        var name = _detailsName?.Trim() ?? "";
        var description = string.IsNullOrWhiteSpace(_detailsDescription) ? null : _detailsDescription.Trim();
        if (_pipeline is null || name.Length == 0 || _busy)
        {
            return;
        }

        var renamed = name != _pipeline.Name;
        if (!renamed && description == (string.IsNullOrWhiteSpace(_pipeline.Description) ? null : _pipeline.Description.Trim()))
        {
            await CloseDetailsAsync(); // nothing changed, nothing to save
            return;
        }

        _busy = true;
        _error = "";
        var saved = false;
        try
        {
            var wasPublished = _pipeline.IsPublished;
            _pipeline = ToDetail(await PipelinesService.UpdatePipelineAsync(_definitionId, new UpdatePipelineRequest { Name = name, Description = description }), _pipeline);
            saved = true;
            var what = renamed ? "Renamed" : "Its description is saved";
            _message = wasPublished
                ? $"{what} in a new draft, version {_pipeline.Version} - publish it for the running pipeline to take it."
                : $"{what} in draft version {_pipeline.Version}.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Saving Pipeline Details {Error}", ex.Message);
            _error = RefusalReason(ex) is { Length: > 0 } reason ? "Not saved: " + reason : "The name and description were not saved.";
        }
        finally
        {
            _busy = false;
        }

        if (saved)
        {
            await CloseDetailsAsync();
        }
    }

    // n8n's archive: back from it, as a draft, and the editor the author's again.
    private async Task RestoreFromArchiveAsync()
    {
        if (_pipeline is null || _busy)
        {
            return;
        }

        string error = null;
        try
        {
            await PipelinesService.RestorePipelineAsync(_definitionId);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Restoring Pipeline {Error}", ex.Message);
            error = RefusalReason(ex) is { Length: > 0 } reason ? "Not restored: " + reason : "The pipeline could not be restored.";
        }

        if (error is not null)
        {
            _error = error;
            return;
        }

        await LoadAsync();
        _message = "Restored as a draft - publish it to run it again.";
    }

    private async Task ReloadAsync()
    {
        _conflicts.Clear();
        _message = "";
        await LoadAsync();
        StateHasChanged();
    }

    private async Task PublishAsync()
    {
        if (!await SaveAsync())
        {
            return;
        }

        // Saved as a draft, and not published while a problem remains - the server refuses it by the same
        // rule, so the editor says so without asking.
        var errors = _problems.Count(problem => problem.Severity == PipelineGraphProblems.Error);
        if (errors > 0)
        {
            _error = errors == 1
                ? "Not published: 1 problem to fix first - it is listed above the canvas and marked on its step."
                : $"Not published: {errors} problems to fix first - they are listed above the canvas and marked on their steps.";
            return;
        }

        _busy = true;
        try
        {
            var note = string.IsNullOrWhiteSpace(_publishNote) ? null : _publishNote.Trim();
            var result = await PipelinesService.PublishPipelineAsync(_definitionId, note);
            if (result.Succeeded)
            {
                _pipeline = await PipelinesService.GetPipelineAsync(_definitionId) ?? _pipeline;
                _message = $"Published version {_pipeline.Version}." + (note is null ? "" : $" What changed: {note}");
                _publishNote = "";
                if (_versionsOpen)
                {
                    _versions = await PipelinesService.GetVersionsAsync(_definitionId) ?? _versions; // the new one, with its note
                }
            }
            else
            {
                _error = "Not published: " + string.Join("; ", result.Errors);
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Publishing Pipeline {Error}", ex.Message);
            _error = "The pipeline could not be published.";
        }
        finally
        {
            _busy = false;
        }
    }

    // Start = dispatch, and STAY: the canvas follows the run as it goes - each step's state
    // and time on it, its data in the inspector - with a link to the run's log page.
    private async Task RunAsync()
    {
        _error = "";
        try
        {
            var started = await PipelinesService.StartPipelineAsync(_definitionId, new StartPipelineRequest());
            await ShowRunAsync(started.RunId);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Starting Pipeline {Error}", ex.Message);
            // The server's reason when it refused - e.g. a pipeline that runs one at a time, with a run still going.
            _error = RefusalReason(ex) is { } reason ? "The run could not be started: " + reason : "The run could not be started.";
        }
    }

    private async Task LoadRunsAsync()
    {
        try
        {
            _runs = (await PipelinesService.GetRunsAsync(_definitionId, 10) ?? new List<PipelineRunView>())
                .OrderByDescending(run => run.CreatedOnUtc)
                .ToList();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Pipeline Runs {Error}", ex.Message);
            _runs = null; // the picker is left out; the editor works without it
        }
    }

    private async Task ChooseRunAsync(string runId)
    {
        if (string.IsNullOrEmpty(runId))
        {
            StopWatching();
            _shownRunId = null;
            _shownRun = null;
            _runSteps = new List<PipelineStepRunView>();
            ApplyRunToNodes();
            return;
        }

        await ShowRunAsync(runId);
    }

    // Beyond n8n's Insights: each step's figures over a window, on the canvas where a run would be - so a step that fails
    // often, or takes long, shows where it is. Shown, they take the run's place; choosing a run takes theirs.
    private PipelineStepInsightsView _stepInsights;

    private async Task ToggleStepInsightsAsync()
    {
        if (_stepInsights is not null)
        {
            _stepInsights = null;
            ApplyRunToNodes();
            return;
        }

        await StepInsightsAsync(7);
    }

    private async Task StepInsightsAsync(int days)
    {
        _error = "";
        try
        {
            var insights = await PipelinesService.GetStepInsightsAsync(_definitionId, PipelineInsights.Window(days));
            StopWatching();
            _shownRunId = null;
            _shownRun = null;
            _runSteps = new List<PipelineStepRunView>();
            _stepInsights = insights;
            ApplyRunToNodes();
            _message = insights.Runs == 0 ? "No runs in that time: no step has figures yet." : $"Each step's figures over {(insights.Runs == 1 ? "1 run" : insights.Runs + " runs")}, on the canvas.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Step Insights {Error}", ex.Message);
            _error = "The steps' figures could not be loaded.";
        }
    }

    private bool _stopping;

    // n8n's "Stop execution": the run on the canvas cancelled - the Run page's Cancel - and read again at once, then
    // followed until the engine has stopped it (afresh, should it have been followed past the poll's limit), so the canvas says
    // where it stopped.
    private async Task StopRunAsync()
    {
        if (_shownRunId is not { } runId || runId == DraftTestId || _stopping)
        {
            return;
        }

        _stopping = true;
        _error = "";
        try
        {
            await PipelinesService.CancelRunAsync(runId);
            _message = "Stopped the run: nothing after the step it was on runs - a step at work finishes first, a waiting one is cancelled.";
            _runPolls = 0;
            await RefreshShownRunAsync();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Stopping Pipeline Run {Error}", ex.Message);
            _error = RefusalReason(ex) is { Length: > 0 } reason ? "The run could not be stopped: " + reason : "The run could not be stopped.";
        }
        finally
        {
            _stopping = false;
        }
    }

    private async Task ShowRunAsync(string runId)
    {
        StopWatching();
        _stepInsights = null; // a run on the canvas, not the steps' figures
        _shownRunId = runId;
        _shownRun = null;
        _runSteps = new List<PipelineStepRunView>();
        _executionIndex = 0;
        _runPolls = 0;
        await RefreshShownRunAsync();
    }

    // One read of the shown run and its step executions, onto the canvas. An unfinished run - or a dispatched one the engine
    // has not stored yet - is read again a second later, up to MaxRunPolls times; a finished one ends the poll and refreshes
    // the run picker, so the run just started appears in it.
    private async Task RefreshShownRunAsync()
    {
        var runId = _shownRunId;
        if (runId is null)
        {
            return;
        }

        // The run and its steps are read apart: a run whose steps cannot be read still shows its own state, and the editor
        // SAYS the steps could not be read rather than waiting on them (found driving: a failing read left "starting…").
        try
        {
            var run = await PipelinesService.GetRunAsync(runId);
            if (runId != _shownRunId)
            {
                return; // another run was chosen while this one was being read
            }

            _shownRun = run;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Reading Pipeline Run {Error}", ex.Message);
        }

        try
        {
            var steps = await PipelinesService.GetRunStepsAsync(runId) ?? new List<PipelineStepRunView>();
            if (runId != _shownRunId)
            {
                return;
            }

            _runSteps = steps;
            if (_error == RunStepsUnreadable)
            {
                _error = "";
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Reading Pipeline Run Steps {Error}", ex.Message);
            if (_error != RunStepsUnreadable)
            {
                _error = RunStepsUnreadable; // said once, not again at every poll - setting it again speaks it again
            }
        }

        ApplyRunToNodes();
        if ((_shownRun is null || !_shownRun.IsFinished) && _runPolls < MaxRunPolls)
        {
            _runPolls++;
            if (_runTimer is null)
            {
                _runTimer = Clock.CreateTimer(_ => _ = InvokeAsync(async () =>
                {
                    await RefreshShownRunAsync();
                    StateHasChanged();
                }), null, RunPollInterval, Timeout.InfiniteTimeSpan);
            }
            else
            {
                _runTimer.Change(RunPollInterval, Timeout.InfiniteTimeSpan);
            }
        }
        else
        {
            StopWatching();
            await LoadRunsAsync();
        }
    }

    // Each step on the canvas shows what the run did with it: the state of its LAST pass, and its time - or how many passes
    // and their total, for a step in a loop's body. A step the run did not reach is dimmed; no run shown, no marks.
    private void ApplyRunToNodes()
    {
        if (_diagram is null)
        {
            return;
        }

        foreach (var node in _diagram.Nodes.OfType<StepNodeModel>())
        {
            // The steps' figures over a window, where a run would be - amber when some of its passes failed, red when all did.
            if (_stepInsights is not null)
            {
                var insight = _stepInsights.Steps.FirstOrDefault(step => step.StepId == node.StepId);
                node.ShowRun(
                    insight is null ? "none" : insight.Failed == 0 ? "completed" : insight.Failed == insight.Passes ? "faulted" : "handled",
                    insight is null ? "did not run" : PipelineInsights.Describe(insight));
                continue;
            }

            if (_shownRunId is null)
            {
                node.ShowRun(null, null);
                continue;
            }

            var passes = _runSteps.Where(execution => execution.StepId == node.StepId).ToList();
            if (passes.Count == 0)
            {
                // "not yet", never "waiting": a waiting step is one parked on a decision or a time (found driving Ask for approval).
                node.ShowRun("none", _shownRun is { IsFinished: true } ? "did not run" : "not yet");
                continue;
            }

            // Handled: it failed, and the pipeline went on past it; waiting: parked on a bookmark (a Wait, an event) - no worker, no
            // clock running; a pass its finished run abandoned, canceled (PipelineStepStates).
            var last = passes[^1];
            var status = PipelineStepStates.Of(last, _shownRun);
            var total = passes.Sum(pass => ((EndOf(pass) ?? DateTime.UtcNow) - pass.StartedAtUtc).TotalMilliseconds);
            var note = status switch
            {
                "completed" => "done",
                "handled" => last.HandledFailure == PipelineStepRunView.TookFailedPath ? "failed → Failed path" : "failed, went on",
                "faulted" => "failed",
                "running" => "running…",
                "waiting" => "waiting since " + last.StartedAtUtc.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture) + " UTC",
                _ => status,
            };
            if (status != "waiting") // a wait's time is when it began, not a clock counting up
            {
                note += passes.Count > 1 ? $" · ×{passes.Count} · {Seconds(total)}" : $" · {Seconds(total)}";
            }

            // n8n's "3 items": how many records the step's result held (its last pass), counted on the server before any cut.
            if (status is "completed" or "handled" && last.ResultCount is { } records)
            {
                note += records == 1 ? " · 1 record" : $" · {records} records";
            }
            node.ShowRun(status, note);
        }

        ApplyRunToLinks();
    }

    // n8n's "3 items" on a connection: in the run shown, a connection taken - the step it goes to ran after the step it
    // leaves - carries how many records that step's result held (its last pass). A branch not taken carries nothing: the step
    // it goes to never ran.
    private void ApplyRunToLinks()
    {
        if (_diagram is null)
        {
            return;
        }

        foreach (var link in _diagram.Links)
        {
            string count = null;
            if (_shownRunId is not null
                && (link.Source as SinglePortAnchor)?.Port?.Parent is StepNodeModel from
                && (link.Target as SinglePortAnchor)?.Port?.Parent is StepNodeModel to
                && _runSteps.LastOrDefault(pass => pass.StepId == from.StepId) is { Status: "Completed", ResultCount: { } records } left
                && _runSteps.Any(pass => pass.StepId == to.StepId && pass.StartedAtUtc >= left.StartedAtUtc))
            {
                count = records == 1 ? "1 record" : $"{records} records";
            }

            var shown = link.Labels.OfType<RunCountLabelModel>().FirstOrDefault();
            if (shown?.Content == count)
            {
                continue;
            }

            if (shown is not null)
            {
                link.Labels.Remove(shown);
            }

            if (count is not null)
            {
                link.Labels.Add(new RunCountLabelModel(link, count));
            }

            link.Refresh();
        }
    }

    private void StopWatching()
    {
        _runTimer?.Dispose();
        _runTimer = null;
    }

    public void Dispose()
    {
        StopWatching();
        _discussionTimer?.Dispose();
        _discussionTimer = null;
        _keys.Cancel();
        _scriptCheckDelay?.Cancel();
        if (_selfRef is not null)
        {
            try
            {
                _ = JSRuntime.InvokeVoidAsync("stommePipelineEditorDetach", _selfRef).AsTask();
            }
            catch (Exception)
            {
                // the page or the circuit is going: nothing to detach from
            }

            _selfRef.Dispose();
        }
    }

    // The run picker is made afresh when its options change: Blazor puts a select's value back only as it makes one, so a run
    // that moved from "the run just started" into the list of runs read "(none)" while it was on the canvas (found driving Stop
    // run). Its options, not the run chosen: choosing one keeps the picker, and the focus in it.
    private string RunPickerKey() => string.Join(",", (_runs ?? new List<PipelineRunView>()).Select(run => run.Id)
        .Prepend(_shownRunId is not null && (_runs is null || _runs.All(run => run.Id != _shownRunId)) ? _shownRunId : ""));

    private static string RunLabel(PipelineRunView run) =>
        run.IsFinished ? (run.SubStatus == "Finished" ? "finished" : run.SubStatus?.ToLowerInvariant() ?? "finished") : "running";

    // A pass ends when it completed; one that never did - it failed, or was cancelled - in a run that has finished ends with the
    // run (found driving: a step that failed at once read "53.8 s", the time since, and its inspector "running"). Only a pass of
    // a run still going has no end yet.
    private DateTime? EndOf(PipelineStepRunView execution) =>
        execution.CompletedAtUtc ?? (_shownRun is { IsFinished: true } run ? run.FinishedOnUtc ?? run.UpdatedOnUtc : null);

    /// <summary>The most passes the editor's list of what ran shows; the run's page shows every one.</summary>
    public const int MaxPasses = 200;

    // A pass of the run shown, as the list of what ran says it: its step, which of that step's passes it is (as the inspector
    // counts them), the step's name as the canvas has it, its state (PipelineStepStates) and its note - time and records.
    private sealed record RunPass(string StepId, int Index, string Name, string State, string Note);

    private List<RunPass> Passes()
    {
        var counted = new Dictionary<string, int>(StringComparer.Ordinal);
        return _runSteps.Select(pass =>
            {
                var index = counted.TryGetValue(pass.StepId ?? "", out var before) ? before + 1 : 0;
                counted[pass.StepId ?? ""] = index;
                var state = PipelineStepStates.Of(pass, _shownRun);
                var step = _graph.Steps.FirstOrDefault(candidate => candidate.Id == pass.StepId);
                var name = !string.IsNullOrWhiteSpace(step?.Name) ? step.Name
                    : _catalog?.FirstOrDefault(entry => entry.Type == (step?.Type ?? pass.StepType))?.DisplayName ?? pass.StepName ?? pass.StepType;
                var note = state + (state == "waiting" ? "" : " · " + Duration(pass))
                    + (state is "completed" or "handled" && pass.ResultCount is { } records ? (records == 1 ? " · 1 record" : $" · {records} records") : "");
                return (Pass: pass, Line: new RunPass(pass.StepId, index, name, state, note));
            })
            .OrderBy(pair => pair.Pass.StartedAtUtc)
            .Select(pair => pair.Line)
            .ToList();
    }

    private static string PassesSummary(List<RunPass> passes)
    {
        var steps = passes.Select(pass => pass.StepId).Distinct(StringComparer.Ordinal).Count();
        var failed = passes.FirstOrDefault(pass => pass.State == "faulted");
        return "What ran, in order: " + (passes.Count == 1 ? "1 step" : steps == passes.Count ? $"{steps} steps" : $"{passes.Count} passes of {steps} steps")
            + (failed is null ? "" : " - " + failed.Name + " failed");
    }

    // A pass chosen: its step on the canvas - in its body, selected, in the middle - and that pass of it in the inspector; a step
    // taken out of the pipeline since the run is said to be (found driving it: the press did nothing).
    private void GoToPass(RunPass pass)
    {
        if (_graph.Steps.All(step => step.Id != pass.StepId))
        {
            _message = pass.Name + " is not in the pipeline any more - it was in the version that ran.";
            return;
        }

        GoToStep(pass.StepId);
        if (_selected?.StepId == pass.StepId)
        {
            _executionIndex = pass.Index;
        }
    }

    private string Duration(PipelineStepRunView execution) =>
        EndOf(execution) is { } done ? Seconds((done - execution.StartedAtUtc).TotalMilliseconds) : "running";

    private static string Seconds(double milliseconds) => PipelineRunDurations.Describe(TimeSpan.FromMilliseconds(milliseconds));

    private static PipelineDetail ToDetail(PipelineView view, PipelineDetail previous) => new PipelineDetail
    {
        Id = view.Id,
        DefinitionId = view.DefinitionId,
        Name = view.Name,
        Description = view.Description,
        Version = view.Version,
        IsLatest = view.IsLatest,
        IsPublished = view.IsPublished,
        CreatedOnUtc = view.CreatedOnUtc,
        Body = previous?.Body,
    };
}
