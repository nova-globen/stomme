    private readonly Dictionary<string, (string Text, bool Failed)> _scriptPreviews = new(StringComparer.Ordinal);
    private CancellationTokenSource _scriptPreviewDelay;

    private void SetScript(string name, string text)
    {
        if (_selected is null)
        {
            return;
        }

        _selected.InputScripts[name] = text ?? "";
        MarkDirty(_selected.StepId + "/script/" + name);
        _ = PreviewScriptSoonAsync(_selected.StepId, name, text ?? "");
    }

    // A script's value from the server's sandbox, a moment after typing stops, with the values the other previews use.
    private async Task PreviewScriptSoonAsync(string stepId, string name, string script)
    {
        _scriptPreviewDelay?.Cancel();
        var delay = new CancellationTokenSource();
        _scriptPreviewDelay = delay;
        try
        {
            await Task.Delay(400, delay.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        var known = PreviewVariables(out var source);
        var values = known.GroupBy(variable => variable.Name, StringComparer.Ordinal).ToDictionary(group => group.Key, group => PipelineTemplate.Text(group.First().Value), StringComparer.Ordinal);
        (string Text, bool Failed) shown;
        try
        {
            var result = await PipelinesService.PreviewScriptAsync(new ScriptPreviewRequest { Script = script, Values = values });
            shown = string.IsNullOrEmpty(result?.Error)
                ? (source + ": " + (string.IsNullOrEmpty(result?.Value) ? "(nothing)" : result.Value), false)
                : (result.Error, true);
        }
        catch (Exception ex)
        {
            shown = ("The preview failed: " + ex.Message, true);
        }

        if (!delay.IsCancellationRequested)
        {
            _scriptPreviews[stepId + "/" + name] = shown;
            await InvokeAsync(StateHasChanged);
        }
    }

