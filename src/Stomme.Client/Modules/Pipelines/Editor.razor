    // The chosen connection tested as Admin, Connections tests it - the server dials it and says how it went.
    private async Task TestConnectionAsync(string connectionId)
    {
        if (!Guid.TryParse(connectionId, out var id)
            || EditorServices.GetService(typeof(Stomme.Modules.Connectivity.Services.IConnectionsService)) is not Stomme.Modules.Connectivity.Services.IConnectionsService connections)
        {
            return;
        }

        _connectionTesting = true;
        try
        {
            var result = await connections.TestAsync(id);
            _connectionTested = (connectionId, $"{result.Message} ({result.Status})", result.Success);
        }
        catch (Exception ex)
        {
            _connectionTested = (connectionId, "The connection was not tested: " + ex.Message, false);
        }
        finally
        {
            _connectionTesting = false;
        }
    }

