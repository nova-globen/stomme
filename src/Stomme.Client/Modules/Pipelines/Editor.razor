    // A load's fit, answered once the canvas has its size (the canvas tells the diagram, which may be after the editor's last
    // render): true when the view was fitted. A pipeline that shows whole, or one opened on a step a link names, is left as it is.
    private bool FitIfOpening()
    {
        if (!_fitOnOpen || _diagram?.Container is not { Width: > 0, Height: > 0 } canvas)
        {
            return false;
        }

        _fitOnOpen = false;
        if (_pendingStepChosen || CanvasFit.Shows(canvas.Width, canvas.Height, _diagram.Zoom, _diagram.Pan.X, _diagram.Pan.Y,
                _diagram.Nodes.Select(node => (node.Position.X, node.Position.Y, node.Size?.Width, node.Size?.Height))))
        {
            return false;
        }

        FitToView();
        return true;
    }

    // Fit to the selected steps when some are selected, else to all of them (the library's own ZoomToFit throws on a canvas
    // with no size - measured - so CanvasFit decides, and a canvas not drawn yet is left as it is).
    private void FitToView()
    {
        if (_diagram is null)
        {
            return;
        }

        var steps = _diagram.Nodes.Where(node => node.Selected).ToList();
        if (steps.Count == 0)
        {
            steps = _diagram.Nodes.ToList();
        }

        var container = _diagram.Container;
        var fit = CanvasFit.Compute(container?.Width ?? 0, container?.Height ?? 0,
            steps.Select(node => (node.Position.X, node.Position.Y, node.Size?.Width, node.Size?.Height)));
        if (fit is not { } view)
        {
            return;
        }

        _diagram.SetZoom(view.Zoom);
        _diagram.SetPan(view.PanX, view.PanY);
    }

    // The editor's keyboard (pipelines-editor.js) calls in here; the script decides when a key is the editor's.
    [JSInvokable]
    public async Task OnShortcut(string command)
    {
        if (_leaveTo is not null)
        {
            // While leaving is asked about, the canvas's keys wait - Escape is Stay. (Drawn again here: the script calls in from
            // outside any event of the page, and the return skips the end's - found driving it, Escape closed nothing on screen.)
            if (command == "escape")
            {
                Stay();
                StateHasChanged();
            }

            return;
        }

        if (command != "help")
        {
            _menu = null; // a key that does something closes the right-click menu, as a click elsewhere does
        }

        switch (command)
        {
            case "undo":
                Undo();
                break;
            case "redo":
                Redo();
                break;
            case "copy":
                Copy();
                break;
            case "paste":
                Paste();
                break;
            case "delete":
                DeleteSelection();
                break;
            case "save":
                if (CanManage && _diagram is not null && !_busy)
                {
                    await SaveAsync();
                }

                break;
            case "run":
                // What the Run button does, when it is there: the published version, followed on the canvas.
                if (CanRunNow)
                {
                    await RunAsync();
                }

                break;
            case "selectAll":
                SelectAll();
                break;
            case "escape":
                _diagram?.UnselectAll();
                _selected = null;
                _insertOn = null;
                _placeAt = null;
                _menu = null;
                _shortcutsOpen = false;
                break;
            case "disable":
                ToggleDisabled();
                break;
            case "help":
                _shortcutsOpen = !_shortcutsOpen;
                break;
            case "open":
                // Enter (n8n's): the one selected step, in the wide view.
                if (SelectedNodes() is { Count: 1 } one)
                {
                    OpenWide(one[0]);
                }

                break;
            case "note":
                AddNote();
                break;
            case "tidy":
                TidyUp(); // n8n's Shift+Alt+T
                break;
            case "fit":
                FitToView();
                break;
            case "zoomIn":
                ZoomTo((_diagram?.Zoom ?? 1) * 1.2);
                break;
            case "zoomOut":
                ZoomTo((_diagram?.Zoom ?? 1) / 1.2);
                break;
            case "zoomReset":
                ZoomTo(1);
                break;
            case "duplicate":
                Duplicate();
                break;
            case "subPipeline":
                OpenSubPipeline(); // n8n's Alt+X: convert to sub-workflow
                break;
            case "nudgeleft":
            case "nudgeright":
            case "nudgeup":
            case "nudgedown":
                Nudge(command["nudge".Length..]);
                break;
            case "left":
            case "right":
            case "up":
            case "down":
                SelectNeighbour(command);
                break;
            case "menu":
                OpenMenuFromKeyboard();
                break;
        }

        StateHasChanged();
    }

    // Shift+F10 or the menu key: the right-click menu from the keyboard - the selected step's, beside it, or the canvas's, in its
    // middle (a step or note added from it lands there) - with its first entry given the focus.
    private void OpenMenuFromKeyboard()
    {
        if (_diagram is null || !CanManage)
        {
            return;
        }

        if (SelectedNodes() is { Count: > 0 } chosen)
        {
            var node = chosen[0];
            _menu = new CanvasMenu(node, node.Position.X * _diagram.Zoom + _diagram.Pan.X + 24, node.Position.Y * _diagram.Zoom + _diagram.Pan.Y + 24, null);
        }
        else
        {
            var (x, y) = ((_diagram.Container?.Width ?? 0) / 2, (_diagram.Container?.Height ?? 0) / 2);
            _menu = new CanvasMenu(null, x, y, new Point((x - _diagram.Pan.X) / _diagram.Zoom, (y - _diagram.Pan.Y) / _diagram.Zoom));
        }

        _ = FocusMenuAsync();
    }

    private async Task FocusMenuAsync()
    {
        StateHasChanged();
        await Task.Yield();
        try
        {
            await JSRuntime.InvokeVoidAsync("stommePipelineEditorFocusMenu");
        }
        catch (JSException)
        {
            // the editor's script not there yet: the menu is open all the same
        }
    }

