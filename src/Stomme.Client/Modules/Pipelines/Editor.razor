    }

    // n8n's "Error workflow" setting, from the pipeline that fails: the pipelines that start when it fails, read from the
    // map once the pipeline panel is shown (null while it loads, or when it could not be read), and one made in a click.
    private PipelineMapView _failureMap;
    private bool _failureMapAsked;
    private bool _failureMapUnread;
    private PipelineView _handlerMade;
    private bool _makingHandler;

    private List<(PipelineMapNode Handler, bool Every)> FailureHandlers()
    {
        if (!_failureMapAsked && !string.IsNullOrEmpty(_definitionId))
        {
            _failureMapAsked = true;
            _ = LoadFailureMapAsync();
        }

        if (_failureMap is null)
        {
            return null;
        }

        var nodes = _failureMap.Nodes.ToDictionary(node => node.DefinitionId, StringComparer.Ordinal);
        return _failureMap.Links.Where(link => link.From == _definitionId && link.Kind == PipelineLinks.OnFailure && nodes.ContainsKey(link.To)).Select(link => (nodes[link.To], false))
            .Concat(_failureMap.Nodes.Where(node => node.WatchesEvery && node.DefinitionId != _definitionId).Select(node => (node, true)))
            .ToList();
    }

    private async Task LoadFailureMapAsync()
    {
        var definitionId = _definitionId;
        try
        {
            var map = await PipelinesService.GetMapAsync() ?? new PipelineMapView();
            if (definitionId == _definitionId)
            {
                (_failureMap, _failureMapUnread) = (map, false);
            }
        }
        catch (Exception ex)
        {
            await logger.LogInformation("The pipelines that start when this one fails could not be read: {Error}", ex.Message);
            _failureMapUnread = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    // This pipeline's lines of the site's activity, newest first (null while hidden) - read again each time they are shown.
    private const int ActivityShown = 20;
    private List<PipelineAuditEntryView> _activity;

    private async Task ToggleActivityAsync()
    {
        if (_activity is not null)
        {
            _activity = null;
            return;
        }

        try
        {
            _activity = await PipelinesService.GetAuditAsync(_definitionId, ActivityShown) ?? new List<PipelineAuditEntryView>();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading The Pipeline's Activity {Error}", ex.Message);
            _error = "What was done to it could not be read.";
        }
    }

    // The discussion of the pipeline's steps, oldest first. Not part of the graph: no save, no undo, no unsaved mark -
    // each add, resolve and delete is written at once, and the list is read again after it, so what others said since shows too.
    private List<PipelineStepCommentView> _comments = new();
    private bool _commentsUnread;
    private readonly Dictionary<string, string> _commentDrafts = new(StringComparer.Ordinal); // what is being said, per step
    private bool _commenting;
    private bool _showResolved;

    // What went wrong, shown where it was asked: under the step's discussion, or (StepId null) under the pipeline's.
    private sealed record CommentError(string StepId, string Message);

    private CommentError _commentError;

    private async Task LoadCommentsAsync()
    {
        try
        {
            _comments = await PipelinesService.GetStepCommentsAsync(_definitionId) ?? new List<PipelineStepCommentView>();
            _commentsUnread = false;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading The Pipeline's Discussion {Error}", ex.Message);
            _comments = new List<PipelineStepCommentView>();
            _commentsUnread = true;
        }

        // The people a comment may mention - read once; none offered when they cannot be read (a name typed still tells).
        if (_people is null)
        {
            try
            {
                _people = await PipelinesService.GetMentionablePeopleAsync() ?? new List<PipelineMentionView>();
            }
            catch (Exception)
            {
                _people = new List<PipelineMentionView>();
            }
        }
    }

    // @mentions: the people offered while a name is being typed after an @, and what an add told.
    private List<PipelineMentionView> _people;

    private sealed record CommentNote(string StepId, string Message);

    private CommentNote _commentNote;

    private const int MentionsOffered = 6;

    private static readonly System.Text.RegularExpressions.Regex MentionBegun = new(@"(?:^|\s)@(?<name>[\w.\-@]*)$", System.Text.RegularExpressions.RegexOptions.CultureInvariant);

    // The people matching the name begun at the end of what is being said - by user name or display name - never oneself.
    private List<PipelineMentionView> MentionOffers(string draft)
    {
        if (_people is not { Count: > 0 } || string.IsNullOrEmpty(draft) || MentionBegun.Match(draft) is not { Success: true } begun)
        {
            return null;
        }

        var typed = begun.Groups["name"].Value;
        var me = PageState?.User?.Username;
        return _people
            .Where(person => !string.Equals(person.UserName, me, StringComparison.OrdinalIgnoreCase))
            .Where(person => person.UserName.StartsWith(typed, StringComparison.OrdinalIgnoreCase)
                || (person.DisplayName ?? "").Contains(typed, StringComparison.CurrentCultureIgnoreCase))
            .Take(MentionsOffered)
            .ToList();
    }

    // The name begun replaced by the person's user name, and a space to go on writing.
    private void Mention(string stepId, PipelineMentionView person)
    {
        var draft = _commentDrafts.GetValueOrDefault(stepId) ?? string.Empty;
        if (MentionBegun.Match(draft) is not { Success: true } begun)
        {
            return;
        }

        var at = begun.Groups["name"].Index - 1; // the @
        _commentDrafts[stepId] = draft[..at] + "@" + person.UserName + " ";
    }

    private static string ToldNote(PipelineStepCommentView added)
    {
        var said = new List<string>();
        if (added.Told is { Count: > 0 } told)
        {
            said.Add("Told " + Listed(told) + ".");
        }

        if (added.NotTold is { Count: > 0 } notTold)
        {
            said.Add(Listed(notTold.Select(name => "@" + name).ToList()) + " told nobody - no one here by that name can see pipelines.");
        }

        return said.Count == 0 ? null : string.Join(" ", said);

        static string Listed(IReadOnlyList<string> names) =>
            names.Count == 1 ? names[0] : string.Join(", ", names.Take(names.Count - 1)) + " and " + names[^1];
    }

    // After a write: the list as the server has it now. A failed read keeps the list as it stands - the write is shown already.
    private async Task RefreshCommentsAsync()
    {
        try
        {
            if (await PipelinesService.GetStepCommentsAsync(_definitionId) is { } now)
            {
                _comments = now;
            }
        }
        catch (Exception)
        {
            // the next write reads it again
        }

        ShowDiscussionOnSteps();
    }

    private int OpenCommentsOn(string stepId) => _comments.Count(comment => !comment.Resolved && comment.StepId == stepId);

    // The open comments on the steps a step's bodies hold, at any depth - shown on the holder, whose bodies are folded away.
    private int OpenCommentsInside(string holderId) => _comments.Count(comment => !comment.Resolved && Holds(holderId, comment.StepId));

    private bool Holds(string holderId, string stepId)
    {
        var seen = new HashSet<string>(StringComparer.Ordinal);
        for (var parent = _graph?.Steps.FirstOrDefault(step => step.Id == stepId)?.Parent; !string.IsNullOrEmpty(parent) && seen.Add(parent);
             parent = _graph.Steps.FirstOrDefault(step => step.Id == parent)?.Parent)
        {
            if (parent == holderId)
            {
                return true;
            }
        }

        return false;
    }

    private void ShowDiscussionOnSteps()
    {
        foreach (var node in _diagram?.Nodes.OfType<StepNodeModel>() ?? Enumerable.Empty<StepNodeModel>())
        {
            node.SetOpenComments(OpenCommentsOn(node.StepId), OpenCommentsInside(node.StepId));
        }
    }

    // The discussion read again every half minute while the editor is open, so what others say shows without a reload
    // - on the clock the run poll uses, which a test fires itself. A pass that changes nothing draws nothing.
    public static readonly TimeSpan DiscussionPollInterval = TimeSpan.FromSeconds(30);

    private ITimer _discussionTimer;

    private void WatchDiscussion()
    {
        if (_discussionTimer is null)
        {
            _discussionTimer = Clock.CreateTimer(_ => _ = InvokeAsync(PollDiscussionAsync), null, DiscussionPollInterval, Timeout.InfiniteTimeSpan);
        }
        else
        {
            _discussionTimer.Change(DiscussionPollInterval, Timeout.InfiniteTimeSpan);
        }
    }

    private async Task PollDiscussionAsync()
    {
        if (!_commenting && !string.IsNullOrEmpty(_definitionId))
        {
            var before = DiscussionShape(_comments);
            await RefreshCommentsAsync();
            if (DiscussionShape(_comments) != before)
            {
                StateHasChanged();
            }
        }

        WatchDiscussion();
    }

    private static string DiscussionShape(List<PipelineStepCommentView> comments) =>
        string.Join(",", comments.Select(comment => comment.Id.ToString("N") + (comment.Resolved ? "r" : "o")));

    private async Task CommentKeyAsync(KeyboardEventArgs e, string stepId)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            await AddCommentAsync(stepId);
        }
    }

    private async Task AddCommentAsync(string stepId)
    {
        var text = _commentDrafts.GetValueOrDefault(stepId)?.Trim();
        if (_commenting || string.IsNullOrEmpty(text) || string.IsNullOrEmpty(_definitionId))
        {
            return;
        }

        _commenting = true;
        _commentError = null;
        _commentNote = null;
        try
        {
            var added = await PipelinesService.AddStepCommentAsync(_definitionId, new PipelineStepCommentRequest { StepId = stepId, Text = text });
            if (added is null)
            {
                _commentError = new(stepId, "The pipeline is not there any more, so nothing was added.");
                return;
            }

            _comments.Add(added);
            _commentDrafts.Remove(stepId);
            _commentNote = ToldNote(added) is { } note ? new(stepId, note) : null; // who its @mentions told
            await RefreshCommentsAsync();
        }
        catch (Exception ex)
        {
            _commentError = new(stepId, await CommentFailureAsync("It was not added", ex));
        }
        finally
        {
            _commenting = false;
        }
    }

    private async Task SetCommentResolvedAsync(Guid id, bool resolved, string errorFor)
    {
        if (_commenting)
        {
            return;
        }

        _commenting = true;
        _commentError = null;
        try
        {
            var now = await PipelinesService.SetStepCommentResolvedAsync(_definitionId, id, resolved);
            var at = _comments.FindIndex(comment => comment.Id == id);
            if (now is null)
            {
                _commentError = new(errorFor, "That comment is not there any more - someone deleted it.");
                if (at >= 0)
                {
                    _comments.RemoveAt(at);
                }
            }
            else if (at >= 0)
            {
                _comments[at] = now;
            }

            await RefreshCommentsAsync();
        }
        catch (Exception ex)
        {
            _commentError = new(errorFor, await CommentFailureAsync(resolved ? "It was not resolved" : "It was not reopened", ex));
        }
        finally
        {
            _commenting = false;
        }
    }

    private async Task DeleteCommentAsync(Guid id, string errorFor)
    {
        if (_commenting)
        {
            return;
        }

        _commenting = true;
        _commentError = null;
        try
        {
            await PipelinesService.DeleteStepCommentAsync(_definitionId, id); // false: deleted already - the same end
            _comments.RemoveAll(comment => comment.Id == id);
            await RefreshCommentsAsync();
        }
        catch (Exception ex)
        {
            _commentError = new(errorFor, await CommentFailureAsync("It was not deleted", ex));
        }
        finally
        {
            _commenting = false;
        }
    }

    // A refusal says the server's reason; anything else is logged and said plainly.
    private async Task<string> CommentFailureAsync(string what, Exception ex)
    {
        if (RefusalReason(ex) is { } reason)
        {
            return what + ": " + reason;
        }

        await logger.LogError(ex, "Error Writing To The Pipeline's Discussion {Error}", ex.Message);
        return what + " - the discussion could not be reached.";
    }

    // A step of the pipeline at any level: drawn on the canvas, or in a body not shown (the shown level's are the canvas's).
    private bool StepExists(string stepId) =>
        _diagram?.Nodes.OfType<StepNodeModel>().Any(node => node.StepId == stepId) == true
        || _graph?.Steps.Any(step => step.Id == stepId && !OnShownLevel(step)) == true;

    private bool OnShownLevel(PipelineGraphStep step)
    {
        var parent = string.IsNullOrEmpty(step.Parent) ? null : step.Parent;
        return parent == _scopeParent && (parent is null || step.ParentPort == _scopePort);
    }

    private string StepName(string stepId)
    {
        if (_diagram?.Nodes.OfType<StepNodeModel>().Any(node => node.StepId == stepId) == true)
        {
            return StepTitle(stepId);
        }

        var step = _graph?.Steps.FirstOrDefault(candidate => candidate.Id == stepId);
        return step is null ? stepId
            : !string.IsNullOrWhiteSpace(step.Name) ? step.Name
            : _catalog?.FirstOrDefault(entry => entry.Type == step.Type)?.DisplayName ?? step.Type ?? stepId;
    }

    // The comments open first, then - when asked for - those resolved.
    private RenderFragment CommentList(List<PipelineStepCommentView> comments, bool withStep)
    {
        var open = comments.Where(comment => !comment.Resolved).ToList();
        var resolved = comments.Where(comment => comment.Resolved).ToList();
        return @<div class="db-pipeline-editor__comments">
            @if (open.Count > 0)
            {
                <ul id="pipelines-editor-comments-open" class="db-pipeline-editor__comment-list">
                    @foreach (var comment in open)
                    {
                        @CommentItem(comment, withStep)
                    }
                </ul>
            }
            else
            {
                <p id="pipelines-editor-comments-none-open" class="db-pipeline-editor__discussion-quiet">@(comments.Count == 0 ? "Nothing said about it yet." : "Nothing open.")</p>
            }
            @if (resolved.Count > 0)
            {
                <button id="pipelines-editor-comments-resolved-toggle" type="button" class="db-pipeline-editor__step-link" aria-expanded="@(_showResolved ? "true" : "false")" @onclick="() => _showResolved = !_showResolved">@(_showResolved ? "Hide the resolved" : "Show the " + resolved.Count + " resolved")</button>
                @if (_showResolved)
                {
                    <ul id="pipelines-editor-comments-resolved" class="db-pipeline-editor__comment-list">
                        @foreach (var comment in resolved)
                        {
                            @CommentItem(comment, withStep)
                        }
                    </ul>
                }
            }
        </div>;
    }

    private RenderFragment CommentItem(PipelineStepCommentView comment, bool withStep)
    {
        var id = comment.Id;
        var stepId = comment.StepId;
        var errorFor = withStep ? null : stepId;
        var at = System.Globalization.CultureInfo.InvariantCulture;
        return @<li id="@("pipelines-editor-comment-" + id)" class="db-pipeline-editor__comment @(comment.Resolved ? "is-resolved" : "")">
            <div class="db-pipeline-editor__comment-head">
                <strong>@(comment.UserName ?? "someone")</strong>
                <span>@comment.CreatedOnUtc.ToString("yyyy-MM-dd HH:mm", at) UTC</span>
                @if (withStep)
                {
                    @if (StepExists(stepId))
                    {
                        <button id="@("pipelines-editor-comment-step-" + id)" type="button" class="db-pipeline-editor__step-link" title="Go to the step" @onclick="() => GoToStep(stepId)">on @StepName(stepId)</button>
                    }
                    else
                    {
                        <span id="@("pipelines-editor-comment-gone-" + id)" class="db-pipeline-editor__comment-gone">on a step since removed</span>
                    }
                }
            </div>
            <p class="db-pipeline-editor__comment-text">@comment.Text</p>
            @if (comment.Resolved)
            {
                <div class="db-pipeline-editor__comment-resolved">Resolved@(string.IsNullOrEmpty(comment.ResolvedBy) ? "" : " by " + comment.ResolvedBy)@(comment.ResolvedOnUtc is { } resolvedOn ? " " + resolvedOn.ToString("yyyy-MM-dd HH:mm", at) + " UTC" : "")</div>
            }
            <div class="db-pipeline-editor__comment-actions">
                <button id="@("pipelines-editor-comment-resolve-" + id)" type="button" class="db-btn" title="@(comment.Resolved ? "Open it again" : "Dealt with - it moves to the resolved")" @onclick="() => SetCommentResolvedAsync(id, !comment.Resolved, errorFor)" disabled="@_commenting">@(comment.Resolved ? "Reopen" : "Resolve")</button>
                @if (comment.CanDelete)
                {
                    <ActionDialog Header="Delete Comment" Message="@(comment.Mine ? "Delete your comment? It cannot be undone." : $"Delete {comment.UserName ?? "someone"}'s comment? It cannot be undone.")" Action="Delete" Security="SecurityAccessLevel.Anonymous"
                                  Class="db-btn pipelines-editor-comment-delete" ConfirmClass="db-btn pipelines-editor-comment-delete-confirm" CancelClass="db-btn db-btn-neutral pipelines-editor-comment-delete-cancel" OnClick="@(async () => { await DeleteCommentAsync(id, errorFor); StateHasChanged(); })" Disabled="@_commenting" />
                }
            </div>
        </li>;
    }

    // The alert starter watching this pipeline, made beside it (its folder) and published - so it starts at this pipeline's next
    // failure; it says what failed in its run's log until its author swaps the log for a notification.
    private async Task MakeFailureHandlerAsync()
    {
        if (_makingHandler || string.IsNullOrEmpty(_definitionId) || !CanManage)
        {
            return;
        }

        _makingHandler = true;
        _error = "";
        _message = "";
        var (definitionId, watched) = (_definitionId, _pipeline?.Name);
        var name = string.IsNullOrWhiteSpace(watched) ? "When it fails" : $"When '{watched.Trim()}' fails";
        try
        {
            var made = await PipelinesService.CreatePipelineAsync(new CreatePipelineRequest { Name = name, Description = $"Starts when '{watched}' fails, and says what failed and where." });
            await PipelinesService.SaveGraphAsync(made.DefinitionId, PipelineStarters.FailureHandler(definitionId, watched));
            if (!string.IsNullOrEmpty(_pipeline?.Folder))
            {
                await PipelinesService.SetFolderAsync(made.DefinitionId, _pipeline.Folder);
            }

            var published = await PipelinesService.PublishPipelineAsync(made.DefinitionId);
            _handlerMade = made;
            _message = published is { Succeeded: true }
                ? $"Made '{name}' and published it: when a run of this pipeline fails, it says what failed and where. Open it to be told another way."
                : $"Made '{name}', not published ({string.Join(" ", published?.Errors ?? new List<string>())}) - open it to finish it.";
            (_failureMap, _failureMapAsked) = (null, false); // read again: it is one of them now
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Making A Failure Handler {Error}", ex.Message);
            _error = RefusalReason(ex) is { Length: > 0 } reason ? "No failure handler was made: " + reason : "No failure handler was made.";
        }
        finally
        {
            _makingHandler = false;
        }
    }

    // The contracts known of the pipelines the graph calls - each call's not yet asked for is asked for here, once.
    private IReadOnlyDictionary<string, PipelineCallContract> CallContracts(PipelineGraph graph)
    {
        foreach (var call in graph.Steps.Where(step => PipelineCallContracts.IsCall(step.Type)))
        {
            if (call.Inputs.TryGetValue(PipelineCallContracts.CalledInput, out var called) && !string.IsNullOrEmpty(called))
            {
                CalledContract(called);
            }
        }

        return _calledContracts.Where(pair => pair.Value is not null).ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.Ordinal);
    }

    // A connection leaving one of several outcomes (a Decision's True and False, a Fork's branches) says
    // which; a step with one outcome needs no word on its line. And on an author's canvas a connection, once made, carries
    // n8n's + (a step put between its two steps) and bin, under its middle.
    private void LabelLink(BaseLinkModel link)
    {
        if (!link.Labels.Any(label => label.GetType() == typeof(LinkLabelModel)) // the outcome's own label, not the buttons or a run's count
            && (link.Source as SinglePortAnchor)?.Port is StepPortModel { IsInput: false, Outcome: { Length: > 0 } outcome, Parent: StepNodeModel node }
            && node.OutputPorts.Count() > 1)
        {
            link.Labels.Add(new LinkLabelModel(link, outcome, 0.5)); // the middle: a label with no distance is spread along the line with the others
        }

        if (CanManage && link.Target is SinglePortAnchor && !link.Labels.OfType<ConnectionActionsModel>().Any())
        {
            link.Labels.Add(new ConnectionActionsModel(link, BeginInsert, RemoveConnection));
        }
    }

    // n8n's + on a connection: the connection selected and the step search focused; the step chosen next goes between
    // its two steps (InsertBetween). Selecting anything else, or Escape, lets it go.
    private BaseLinkModel _insertOn;

    private void BeginInsert(BaseLinkModel link)
    {
        if (_diagram is null || !CanManage)
        {
            return;
        }

        _diagram.SelectModel(link, unselectOthers: true);
        _selected = null;
        _selectedNote = null;
        _insertOn = link;
        _addFrom = null;
        _dropAt = null;
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            await _stepSearch.FocusAsync();
        });
    }

    // The connection a step is about to be put on, while it is on the canvas and still selected.
    private BaseLinkModel InsertingOn() =>
        _insertOn is { Selected: true } link && _diagram is not null && _diagram.Links.Contains(link) ? link : null;

    private string InsertingNote() =>
        InsertingOn() is { } link
        && (link.Source as SinglePortAnchor)?.Port?.Parent is StepNodeModel from
        && (link.Target as SinglePortAnchor)?.Port?.Parent is StepNodeModel to
            ? "The step you choose goes between " + from.DisplayName + " and " + to.DisplayName + " (Escape stops)."
            : null;

    private void StopInserting()
    {
        if (InsertingOn() is { } link)
        {
            _diagram.UnselectModel(link);
        }

        _insertOn = null;
    }

    // The bin on a connection: the connection gone, as one change (OnLinkRemoved).
    private void RemoveConnection(BaseLinkModel link)
    {
        if (_diagram is null || !CanManage)
        {
            return;
        }

        _diagram.Links.Remove(link);
    }

    // The step chosen after a + on a connection: from the outcome the connection left, through the new step's first outcome on
    // to the step it went to - the steps from that one on moved right when there is no room (StepPlacement.Between). One change.
    private bool InsertBetween(BaseLinkModel connection, StepCatalogEntry entry, Action<StepNodeModel> fill)
    {
        if ((connection.Source as SinglePortAnchor)?.Port is not StepPortModel { IsInput: false, Parent: StepNodeModel source } from
            || (connection.Target as SinglePortAnchor)?.Port is not StepPortModel { IsInput: true, Parent: StepNodeModel target } into)
        {
            return false;
        }

        var spot = StepPlacement.Between((source.Position.X, source.Position.Y), (target.Position.X, target.Position.Y),
            _diagram.Nodes.Select(other => (other.Position.X, other.Position.Y)));
        var node = MakeNode(Guid.NewGuid().ToString("N"), entry.Type, entry.DisplayName, new Point(spot.X, spot.Y));
        _restoring = true; // the moves, the connection taken away and the two made are this one change
        try
        {
            if (spot.Shift > 0)
            {
                var moving = StepPlacement.Downstream(target.StepId, source.StepId, _diagram.Links.Select(link => (
                    ((link.Source as SinglePortAnchor)?.Port?.Parent as StepNodeModel)?.StepId,
                    ((link.Target as SinglePortAnchor)?.Port?.Parent as StepNodeModel)?.StepId)));
                foreach (var step in _diagram.Nodes.OfType<StepNodeModel>().Where(step => moving.Contains(step.StepId)).ToList())
                {
                    step.SetPosition(step.Position.X + spot.Shift, step.Position.Y);
                }
            }

            _diagram.Links.Remove(connection);
            _diagram.Nodes.Add(node);
            _diagram.Links.Add(new LinkModel(from, node.InputPort) { TargetMarker = LinkMarker.Arrow });
            if (node.OutputPorts.FirstOrDefault() is { } onward)
            {
                _diagram.Links.Add(new LinkModel(onward, into) { TargetMarker = LinkMarker.Arrow });
            }
        }
        finally
        {
            _restoring = false;
        }

        _insertOn = null;
        _addFrom = null;
        _dropAt = null;
        _diagram.SelectModel(node, unselectOthers: true);
        _selected = node;
        fill?.Invoke(node);
        MarkDirty();
        _message = "Put " + node.DisplayName + " between " + source.DisplayName + " and " + target.DisplayName
            + (spot.Shift > 0 ? " - the steps after it moved right to make room." : ".");
        return true;
    }

    // Two steps of one flowchart (the pipeline's, or a body's) on the very same spot: one hides the other.
    private static bool StepsStacked(PipelineGraph graph) =>
        (graph?.Steps ?? new List<PipelineGraphStep>())
            .GroupBy(step => (step.Parent, step.ParentPort, X: step.Position?.X ?? 0, Y: step.Position?.Y ?? 0))
            .Any(spot => spot.Count() > 1);

    // Every flowchart laid out left to right by its flow (AutoLayout) - one change, which Undo takes back.
    private void TidyUp()
    {
        if (_diagram is null || !CanManage)
        {
            return;
        }

        // n8n's: with several steps chosen, only they are tidied - kept where they were, and still chosen after.
        var chosen = SelectedNodes().Select(node => node.StepId).ToHashSet(StringComparer.Ordinal);
        Fold();
        if (chosen.Count > 1)
        {
            AutoLayout.Arrange(_graph, chosen);
        }
        else
        {
            AutoLayout.Arrange(_graph);
        }

        _restoring = true;
        try
        {
            ShowScope();
            if (chosen.Count > 1)
            {
                foreach (var node in _diagram.Nodes.OfType<StepNodeModel>().Where(node => chosen.Contains(node.StepId)))
                {
                    _diagram.SelectModel(node, unselectOthers: false);
                }
            }
        }
        finally
        {
            _restoring = false;
        }

        MarkDirty();
        _message = chosen.Count > 1
            ? $"Tidied up the {chosen.Count} steps chosen, by the connections among them."
            : "Tidied up: each flowchart left to right by its flow.";
    }

    // n8n's connection dropped on the canvas: a link drawn from an outcome and let go over nothing is removed by the
    // canvas (it needs a target) - instead of nothing, the step search opens, and the step chosen lands where it was let go,
    // connected from that outcome. Any other removal is a change.
    private void OnLinkRemoved(BaseLinkModel link)
    {
        RedrawSource(link);
        if (link.Target is PositionAnchor dropped && dropped.GetPlainPosition() is { } at
            && (link.Source as SinglePortAnchor)?.Port is StepPortModel { IsInput: false, Parent: StepNodeModel node } port)
        {
            _dropAt = at;
            BeginAddAfter(node, port);
            return;
        }

        MarkDirty();
    }

    private void OnLinkAdded(BaseLinkModel link)
    {
        LabelLink(link);
        link.TargetMarker = LinkMarker.Arrow;
        RedrawSource(link);
        // A link the user draws is attached later; the port constraint (StepPortModel.CanAttachTo) refuses anything but
        // outcome -> input, so what attaches is a connection - with its buttons from then on.
        link.TargetAttached += _ =>
        {
            LabelLink(link);
            link.Refresh();
            RedrawSource(link);
            MarkDirty();
        };
    }

    // The step a connection leaves shows a + on each outcome nothing leaves (StepNode), and the canvas draws a step again only
    // when it changes - so a connection coming or going redraws it (measured: the + stayed away after its connection was removed).
    private static void RedrawSource(BaseLinkModel link) => ((link.Source as SinglePortAnchor)?.Port?.Parent as NodeModel)?.Refresh();

    private void OnSelectionChanged(SelectableModel model)
    {
        if (model.Selected && (model is StepNodeModel or NoteNodeModel))
        {
            _insertOn = null; // the step or note chosen is what comes next, not the connection's +
            _placeAt = null;  // nor the canvas menu's spot
        }

        if (model is StepNodeModel node)
        {
            if (node.Selected && _selected != node)
            {
                _executionIndex = 0; // another step: its first pass in the run shown
            }

            _selected = node.Selected ? node : (_selected == node ? null : _selected);
            if (node.Selected && _collaboration is not null)
            {
                _ = _collaboration.SetRegionAsync("step '" + (string.IsNullOrWhiteSpace(node.Name) ? node.Type : node.Name) + "'");
            }
        }
        else if (model is NoteNodeModel note)
        {
            _selectedNote = note.Selected ? note : (_selectedNote == note ? null : _selectedNote);
        }

        InvokeAsync(StateHasChanged);
    }

    // A step from the palette. With a step selected it lands to that step's right and is connected to it (n8n's "+" after
    // a node) - through the first of its outcomes nothing leaves yet - and becomes the selection, so
    // steps added one after another form a chain. With nothing selected it takes the next free spot of the grid.
    private void AddStep(StepCatalogEntry entry) => AddStep(entry, at: null);

    // A step placed - where it was dropped, after the selected step (connected to it), or in the next free spot - selected, and
    // given what `fill` sets before the change is recorded, so the whole addition is one step to undo.
    private void AddStep(StepCatalogEntry entry, Point at, Action<StepNodeModel> fill = null)
    {
        if (_diagram is null || entry is null)
        {
            return;
        }

        if (at is null && InsertingOn() is { } connection && InsertBetween(connection, entry, fill))
        {
            return;
        }

        if (at is null && _placeAt is { } place)
        {
            at = place; // where the canvas's menu was opened
        }

        _placeAt = null;
        var after = at is null ? _selected : null;
        Point position;
        if (at is not null)
        {
            position = at;
        }
        else if (after is not null && _dropAt is not null && _addFrom is not null && after.OutputPorts.Contains(_addFrom))
        {
            position = _dropAt; // where the connection was let go
        }
        else if (after is not null)
        {
            var spot = StepPlacement.After((after.Position.X, after.Position.Y), _diagram.Nodes.Select(other => (other.Position.X, other.Position.Y)));
            position = new Point(spot.X, spot.Y);
        }
        else
        {
            var count = _diagram.Nodes.Count;
            // Three to a row, so a new step lands in sight on a 1280px window (four 240px apart put the fourth past the canvas).
            position = new Point(30 + (count % 3) * 220, 40 + (count / 3) * 140);
        }

        var node = MakeNode(Guid.NewGuid().ToString("N"), entry.Type, entry.DisplayName, position);
        _diagram.Nodes.Add(node);
        if (after is not null)
        {
            // From the outcome whose + was pressed, while nothing follows it yet; else the first free one.
            var outcome = _addFrom is { } chosen && after.OutputPorts.Contains(chosen) && !chosen.Links.Any()
                ? chosen
                : after.OutputPorts.FirstOrDefault(port => !port.Links.Any()) ?? after.OutputPorts.FirstOrDefault();
            if (outcome is not null)
            {
                _diagram.Links.Add(new LinkModel(outcome, node.InputPort) { TargetMarker = LinkMarker.Arrow });
            }
        }

        _addFrom = null;
        _dropAt = null;
        _diagram.SelectModel(node, unselectOthers: true);
        _selected = node;
        fill?.Invoke(node);
        MarkDirty();
    }

    private void SetSearch(string query)
    {
        _search = query ?? "";
        _searchIndex = 0;
    }

    private List<StepCatalogEntry> SearchResults() => StepSearch.Filter(_catalog, _search);

    // The site's connections the query names, each with a step that uses it - after the steps, in the same list.
    private List<ConnectionChoices.Offer> ConnectionOffers() =>
        _connections is null ? new List<ConnectionChoices.Offer>() : ConnectionChoices.Matching(_catalog, _connections, _connectors, _search);

    // Arrows move the highlight, Enter adds the highlighted step and clears the query for the next one, Escape clears.
    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        var results = SearchResults();
        var offers = ConnectionOffers();
        var commands = CommandResults();
        var count = results.Count + offers.Count + commands.Count;
        switch (e.Key)
        {
            case "ArrowDown":
                _searchIndex = count == 0 ? 0 : Math.Min(_searchIndex + 1, count - 1);
                break;
            case "ArrowUp":
                _searchIndex = Math.Max(_searchIndex - 1, 0);
                break;
            case "Enter":
                var at = Math.Clamp(_searchIndex, 0, Math.Max(0, count - 1));
                if (at < results.Count)
                {
                    AddFromSearch(results[at]);
                }
                else if (at - results.Count < offers.Count)
                {
                    AddOffer(offers[at - results.Count]);
                }
                else if (at - results.Count - offers.Count < commands.Count)
                {
                    await RunCommandAsync(commands[at - results.Count - offers.Count].Id);
                }

                break;
            case "Escape":
                SetSearch("");
                StopInserting();
                break;
        }
    }

    // n8n's command bar: the actions the search names that this person may run here, now.
    private List<EditorCommands.Command> CommandResults() => EditorCommands.Match(_search).Where(command => command.Id switch
    {
        "run" => CanRunNow,
        "ai" => AiOffered,
        "undo" => _history.CanUndo,
        "redo" => _history.CanRedo,
        "publish" or "test" or "save" or "tidy" or "note" => CanManage && _diagram is not null && !_busy,
        _ => _diagram is not null,
    }).ToList();

    // An action chosen in the search: the search is emptied, then the action done as its button or its keys do it.
    private async Task RunCommandAsync(string id)
    {
        SetSearch("");
        switch (id)
        {
            case "publish":
                await PublishAsync();
                break;
            case "test":
                await TestDraftAsync();
                break;
            case "export":
                await ExportAsync();
                break;
            case "versions":
                await ToggleVersionsAsync();
                break;
            case "insights":
                await ToggleStepInsightsAsync();
                break;
            case "ai":
                await ToggleAiAsync();
                break;
            case "find":
                await FocusFieldAsync("pipelines-editor-find");
                break;
            case "shortcuts":
                await OnShortcut("help");
                break;
            default:
                await OnShortcut(id); // save, run, undo, redo, tidy, fit, zoomReset, note, selectAll: as their keys do them
                break;
        }
    }

    private void AddFromSearch(StepCatalogEntry entry)
    {
        AddStep(entry);
        SetSearch("");
    }

    // A connection the palette offered: its step added with the connection chosen - one change to undo.
    private void AddOffer(ConnectionChoices.Offer offer)
    {
        var input = ConnectionChoices.ConnectionInput(offer.Entry);
        AddStep(offer.Entry, at: null, fill: node => node.Inputs[input] = offer.Connection.Id.ToString());
        SetSearch("");
    }

    // A palette entry dropped on the canvas lands where it was dropped, connected to nothing.
    private void OnDrop(DragEventArgs e)
    {
        var entry = _dragging;
        _dragging = null;
        if (entry is null || _diagram is null || !CanManage)
        {
            return;
        }

        AddStep(entry, _diagram.GetRelativeMousePoint(e.ClientX, e.ClientY));
    }

    private void RemoveSelected()
    {
        if (_diagram is null || _selected is null)
        {
            return;
        }

        _diagram.Nodes.Remove(_selected);
        _selected = null;
        MarkDirty();
    }

    private void RenameSelected(string name)
    {
        _selected?.Rename(name ?? "");
        MarkDirty(_selected is null ? null : _selected.StepId + "/name");
    }

    private void SetInput(string name, string value)
    {
        if (_selected is null)
        {
            return;
        }

        _selected.Inputs[name] = value ?? "";
        MarkDirty(_selected.StepId + "/input/" + name);
    }

    private void SetBoolInput(string name, object value) => SetInput(name, value is true ? "true" : "false");

    // n8n's "Ask AI" in its Code node: what is asked of a script, for which step, and how it went.
    private string _scriptAsk = string.Empty;
    private string _scriptAiStep;
    private bool _scriptWriting;
    private string _scriptAiError;
    private string _scriptAiProblem;
    // The script the problem is about: once Undo or the author changes it, the problem is no longer said (found driving it).
    private string _scriptAiProblemFor;

    // What the model is told the script can see - what it is written for, the names its Variables lines give, and what it
    // receives: the Input when it is given as a value, or else (empty: the previous step's result) what the nearest step before
    // it last produced, pinned or in the run shown - as field names and kinds (PipelineScriptInput). Never a value.
    private PipelineScriptRequest ScriptRequestFor(StepNodeModel step, string name)
    {
        var request = new PipelineScriptRequest { Script = Value(step.Inputs, name), Style = Value(step.Inputs, "Style"), Variables = VariableNamesOf(Value(step.Inputs, "Variables")) };

        string seen = null;
        var given = Value(step.Inputs, "Input");
        var readInRun = step.InputVariables.ContainsKey("Input") || step.InputExpressions.ContainsKey("Input") || step.InputScripts.ContainsKey("Input"); // not known here
        if (!readInRun && given.Length > 0)
        {
            seen = given;
        }
        else if (!readInRun && EarlierSteps(step, withResult: true).FirstOrDefault() is { } before)
        {
            seen = before.PinnedResult
                ?? (_shownRunId is null ? null : _runSteps.LastOrDefault(execution => execution.StepId == before.StepId && execution.OutputsJson is not null) is { Truncated: false } record ? ResultOf(record.OutputsJson) : null);
        }

        (request.Receives, request.Fields) = DescribeOnce(seen);
        return request;
    }

    // What a step receives, described once per text: the box asks on every render - every key typed in it, twice (what the AI
    // is told, what completion offers) - and a pinned result can be a long list of records, parsed each time on a WebAssembly
    // site otherwise.
    private string _describedFor;
    private (string Receives, List<PipelineScriptField> Fields) _described;

    private (string Receives, List<PipelineScriptField> Fields) DescribeOnce(string seen)
    {
        if (_described.Receives is null || !string.Equals(_describedFor, seen, StringComparison.Ordinal))
        {
            _describedFor = seen;
            _described = PipelineScriptInput.Describe(seen);
        }

        return (_described.Receives, _described.Fields.ToList()); // a copy: a request's list is its own
    }

    // n8n's completion in its Code node: what the box's completion offers (pipelines-editor.js reads it) - the script's own
    // names for what it is written for, the members of the names it knows, its variables' names and the fields of what it
    // receives, the same the AI is told. Each says what it is; a member says what it writes (insert) and where the caret goes
    // (back: between the brackets of one that takes arguments).
    private string CodeNames(StepNodeModel step, string name)
    {
        var seen = ScriptRequestFor(step, name);
        var names = new List<CodeName>();
        void Member(string of, string member, string detail, bool takesArguments = false, bool call = true) =>
            names.Add(new CodeName { Name = member, Kind = "member", Of = of, Detail = detail, Insert = call ? member + "()" : null, Back = takesArguments ? 1 : 0 });

        var eachItem = string.Equals(seen.Style, "N8nEachItem", StringComparison.OrdinalIgnoreCase);
        if (eachItem || string.Equals(seen.Style, "N8nAllItems", StringComparison.OrdinalIgnoreCase))
        {
            names.Add(new CodeName { Name = "$input", Kind = "global", Detail = "the items" });
            names.Add(new CodeName { Name = "$json", Kind = "global", Detail = eachItem ? "this item's json" : "the first item's json" });
            names.Add(new CodeName { Name = "items", Kind = "global", Detail = "the items, each { json }" });
            names.Add(new CodeName { Name = "console", Kind = "global", Detail = "console.log(...) to the step's log" });
            if (eachItem)
            {
                names.Add(new CodeName { Name = "item", Kind = "global", Detail = "this item's json" });
                names.Add(new CodeName { Name = "$itemIndex", Kind = "global", Detail = "this item's place, from 0" });
            }

            Member("$input", "all", "every item");
            Member("$input", "first", "the first item");
            Member("$input", "last", "the last item");
            Member("$input", "item", "this item", call: false);
            Member("console", "log", "a line to the step's log", takesArguments: true);
        }
        else
        {
            names.Add(new CodeName { Name = "input", Kind = "global", Detail = "the text it is given, or the step before's result" });
            names.Add(new CodeName { Name = "log", Kind = "global", Detail = "log(value): a line to the step's log" });
        }

        names.Add(new CodeName { Name = "JSON", Kind = "global", Detail = "parse and stringify" });
        Member("JSON", "parse", "text to records", takesArguments: true);
        Member("JSON", "stringify", "records to text", takesArguments: true);
        names.Add(new CodeName { Name = "Math", Kind = "global", Detail = "round, floor, max..." });
        foreach (var function in new[] { "round", "floor", "ceil", "max", "min", "abs" })
        {
            Member("Math", function, "Math." + function, takesArguments: true);
        }

        names.AddRange(seen.Variables.Select(variable => new CodeName { Name = variable, Kind = "variable", Detail = "a variable of the step" }));
        names.AddRange(seen.Fields.Select(field => new CodeName { Name = field.Name, Kind = "field", Detail = "field · " + field.Kind }));
        return JsonSerializer.Serialize(names, CodeNameJson);
    }

    private static readonly JsonSerializerOptions CodeNameJson = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingDefault,
    };

    private sealed class CodeName
    {
        public string Name { get; set; }

        public string Kind { get; set; }

        public string Detail { get; set; }

        public string Of { get; set; }

        public string Insert { get; set; }

        public int Back { get; set; }
    }

    // Said under the button, so the author knows what leaves the page.
    private static string ScriptAiTold(PipelineScriptRequest request)
    {
        var told = new List<string>();
        told.Add(request.Receives switch
        {
            PipelineScriptInput.Records when request.Fields.Count > 0 => "the fields of the records it receives (" + string.Join(", ", request.Fields.Select(field => field.Name)) + ")",
            PipelineScriptInput.Records => "that it receives records",
            PipelineScriptInput.Record when request.Fields.Count > 0 => "the fields of the record it receives (" + string.Join(", ", request.Fields.Select(field => field.Name)) + ")",
            PipelineScriptInput.Values => "that it receives a list of values",
            PipelineScriptInput.Text => "that it receives text",
            _ => "not what it receives - run or pin the step before it to tell it",
        });
        if (request.Variables.Count > 0)
        {
            told.Add("its variables' names (" + string.Join(", ", request.Variables) + ")");
        }

        return "The AI is told the script, " + string.Join(" and ", told) + " - never a value.";
    }

    // The script written - or changed - by the site's model, put in the step as ONE change Undo takes back. The step it was
    // asked for gets it even when another is selected by the time it comes back.
    private async Task WriteScriptWithAiAsync(string name)
    {
        var step = _selected;
        var asked = _scriptAsk?.Trim();
        if (step is null || _scriptWriting || string.IsNullOrEmpty(asked) || !AiOffered)
        {
            return;
        }

        _scriptWriting = true;
        _scriptAiStep = step.StepId;
        _scriptAiError = null;
        _scriptAiProblem = null;
        try
        {
            var request = ScriptRequestFor(step, name);
            request.Instruction = asked;
            var written = await PipelinesService.WriteScriptAsync(request);
            if (string.IsNullOrWhiteSpace(written?.Script))
            {
                _scriptAiError = "The AI's answer did not come back.";
                return;
            }

            step.Inputs[name] = written.Script;
            MarkDirty(); // it clears the message, so the message comes after
            _scriptAsk = string.Empty;
            _scriptAiProblem = written.Problem;
            _scriptAiProblemFor = written.Script;
            _message = $"The AI wrote the script of '{step.DisplayName}' - read it before you run it, or Undo (Ctrl+Z) to take it back.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Writing A Pipeline Script With AI {Error}", ex.Message);
            _scriptAiError = RefusalReason(ex) is { Length: > 0 } reason ? "The AI did not write it: " + reason : "The AI could not be asked.";
        }
        finally
        {
            _scriptWriting = false;
        }
    }

    // n8n's "Import cURL" on the HTTP request step.
    private const string CurlStepType = "Stomme.SendHttpRequest";
    // An attribute's literal text is encoded again, so entities in it show as written (found driving it) - the example is C#.
    private const string CurlExample = "curl -X POST https://api.example.com/orders -H 'Content-Type: application/json' -d '{\"item\": \"book\"}'";
    private bool _curlOpen;
    private string _curlText = string.Empty;
    private string _curlError;
    private readonly List<string> _curlNotes = new();
    private string _curlStep;

    // The command read into the step's inputs - each a value of its own from now (a variable or an expression it read before is
    // replaced), the ones curl does not set emptied - as ONE change, so Ctrl+Z takes the whole import back.
    private void ImportCurl()
    {
        if (_selected is null)
        {
            return;
        }

        var request = PipelineCurl.Parse(_curlText, out var error);
        if (request is null)
        {
            _curlError = error;
            return;
        }

        ApplyCurl(_selected, request);
        _curlOpen = false;
        _curlText = string.Empty;
        _curlError = null;
        MarkDirty();
    }

    // The request read into a step's inputs, and what the step does not do the same way kept to show under it.
    private void ApplyCurl(StepNodeModel node, PipelineCurlRequest request)
    {
        var notes = new List<string>(request.Notes);
        void Put(string name, string value)
        {
            node.InputVariables.Remove(name);
            node.InputExpressions.Remove(name);
            node.InputConditions.Remove(name);
            node.InputScripts.Remove(name);
            node.Inputs[name] = value ?? "";
        }

        Put("Url", request.Url);
        var methods = node.Entry?.Inputs.FirstOrDefault(input => input.Name == "Method")?.Options;
        if (methods is null || methods.Contains(request.Method))
        {
            Put("Method", request.Method);
        }
        else
        {
            notes.Add($"The step sends {string.Join(", ", methods)} - not {request.Method}; its method is left as it was.");
        }

        Put("Headers", string.Join("\n", request.Headers));
        Put("Body", request.Body);
        Put("Authorization", request.Authorization);
        Put("SendFile", request.SendFile);
        Put("FileField", request.FileField);
        if (request.ContentType is not null)
        {
            Put("ContentType", request.ContentType);
        }

        if (request.TimeoutSeconds is { } seconds)
        {
            Put("TimeoutSeconds", seconds.ToString(System.Globalization.CultureInfo.InvariantCulture));
        }

        if (!string.IsNullOrEmpty(request.Authorization))
        {
            notes.Add("The Authorization is kept with the pipeline. A connection keeps it in the site's secret store instead (Send through connection).");
        }

        _curlNotes.Clear();
        _curlNotes.AddRange(notes);
        _curlStep = node.StepId;
    }

    // The source picker's value for "an expression"; a variable's id is generated hex, so it cannot be this.
    private const string ExpressionSource = "=expression";

    // An input takes a value of its own, an expression or a variable - one of them.
    private void SetInputSource(string name, string source)
    {
        if (_selected is null)
        {
            return;
        }

        if (source != ScriptSource)
        {
            _selected.InputScripts.Remove(name);
        }

        if (source == ScriptSource)
        {
            // JavaScript, starting from nothing - a value or an expression is not a script.
            if (!_selected.InputScripts.ContainsKey(name))
            {
                _selected.InputScripts[name] = "";
            }

            _selected.Inputs.Remove(name);
            _selected.InputVariables.Remove(name);
            _selected.InputExpressions.Remove(name);
            _selected.InputConditions.Remove(name);
        }
        else if (source == ConditionSource)
        {
            // A condition built from rules - one rule to start, whatever the input held before.
            if (!_selected.InputConditions.ContainsKey(name))
            {
                _selected.InputConditions[name] = new PipelineCondition { Rules = { new PipelineConditionRule() } };
            }

            _selected.Inputs.Remove(name);
            _selected.InputVariables.Remove(name);
            _selected.InputExpressions.Remove(name);
        }
        else if (source == ExpressionSource)
        {
            // What was typed as a value becomes the expression's text, so switching loses nothing.
            if (!_selected.InputExpressions.ContainsKey(name))
            {
                _selected.InputExpressions[name] = _selected.Inputs.TryGetValue(name, out var typed) ? typed ?? "" : "";
            }

            _selected.Inputs.Remove(name);
            _selected.InputVariables.Remove(name);
            _selected.InputConditions.Remove(name);
        }
        else if (string.IsNullOrEmpty(source))
        {
            _selected.InputVariables.Remove(name);
            _selected.InputConditions.Remove(name);
            if (_selected.InputExpressions.Remove(name, out var was))
            {
                // Back to a value: plain text stays; placeholders cannot be a value, so the field starts empty.
                _selected.Inputs[name] = PipelineTemplate.HasPlaceholders(was) ? "" : was ?? "";
            }
        }
        else
        {
            _selected.InputVariables[name] = source;
            _selected.Inputs.Remove(name);
            _selected.InputExpressions.Remove(name);
            _selected.InputConditions.Remove(name);
        }

        MarkDirty();
    }

