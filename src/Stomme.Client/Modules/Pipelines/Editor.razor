    // How many of the records this step had in the run shown meet the rules - those it kept and those it discarded, from its
    // outputs - with the variables the other previews read.
    private (string Text, bool Failed, string Source) RecordConditionPreview(PipelineCondition condition)
    {
        var shown = _shownRunId is null || _selected is null ? null : _runSteps.LastOrDefault(execution => execution.StepId == _selected.StepId && execution.OutputsJson is not null);
        if (shown is null)
        {
            return ("Run the pipeline to see which of this step's records meet it.", false, "preview");
        }

        var records = new List<JsonElement>();
        try
        {
            using var outputs = JsonDocument.Parse(shown.OutputsJson);
            foreach (var port in new[] { "Result", "Discarded" })
            {
                if (outputs.RootElement.ValueKind == JsonValueKind.Object && outputs.RootElement.TryGetProperty(port, out var held) && held.ValueKind == JsonValueKind.Array)
                {
                    records.AddRange(held.EnumerateArray().Select(record => record.Clone()));
                }
            }
        }
        catch (JsonException)
        {
            return ("This step's records in the run shown are too long to preview here.", false, "run shown");
        }

        var known = PreviewValues(out _);
        try
        {
            var meeting = records.Count(record => PipelineConditions.HoldsFor(condition, record, name =>
            {
                var match = known.FirstOrDefault(variable => variable.Name == name);
                return match.Name is null ? (false, null) : (true, match.Value);
            }));
            return ($"{meeting} of {records.Count} record(s) meet it", false, "run shown");
        }
        catch (PipelineTemplateException ex)
        {
            return (ex.Message, true, "run shown");
        }
    }

    // A Fork's branches, one per line in the inspector, become its outcome ports; a branch taken away takes its connections.
    private void SetBranches(string text)
    {
        if (_selected is null)
        {
            return;
        }

        var names = (text ?? "").Split('\n').Select(line => line.Trim()).Where(line => line.Length > 0).ToList();
        var before = PipelineOutcomes.Branches(_selected.Inputs.TryGetValue(StepCatalogEntry.BranchesOutcomes, out var held) ? held : null);
        if (before.Count == names.Count)
        {
            // As many branches as before: a changed line is that branch renamed, and keeps its connections.
            for (var index = 0; index < names.Count; index++)
            {
                if (before[index] != names[index] && _selected.OutputPorts.FirstOrDefault(port => port.Outcome == before[index]) is { } port)
                {
                    port.Rename(names[index]);
                }
            }
        }

        _selected.Inputs[StepCatalogEntry.BranchesOutcomes] = PipelineOutcomes.WriteBranches(names);
        SyncSelectedOutcomes();
        MarkDirty(_selected.StepId + "/branches");
    }

    private static string BranchLines(StepNodeModel step) =>
        string.Join("\n", PipelineOutcomes.Branches(step.Inputs.TryGetValue(StepCatalogEntry.BranchesOutcomes, out var text) ? text : null));

    // A Switch's cases: added, labelled, taken away - each an outcome port beside Default.
    private void AddCase()
    {
        if (_selected is null)
        {
            return;
        }

        var number = _selected.Cases.Count + 1;
        while (_selected.Cases.Any(@case => string.Equals(@case.Label, "Case " + number, StringComparison.OrdinalIgnoreCase)))
        {
            number++;
        }

        _selected.Cases.Add(new PipelineGraphCase { Label = "Case " + number, Condition = new PipelineCondition { Rules = { new PipelineConditionRule() } } });
        SyncSelectedOutcomes();
        MarkDirty();
    }

    private void RemoveCase(int index)
    {
        if (_selected is null || index < 0 || index >= _selected.Cases.Count)
        {
            return;
        }

        _selected.Cases.RemoveAt(index);
        SyncSelectedOutcomes();
        MarkDirty();
    }

    private void SetCaseLabel(int index, string label)
    {
        if (_selected is null || index < 0 || index >= _selected.Cases.Count)
        {
            return;
        }

        // The case's port is renamed with it, its connections kept - even while the label is empty, which the problems say.
        var old = _selected.Cases[index].Label?.Trim() ?? "";
        var shared = _selected.Cases.Where((_, other) => other != index).Any(@case => (@case.Label?.Trim() ?? "") == old);
        if (!shared && _selected.OutputPorts.FirstOrDefault(port => (port.Outcome ?? "") == old) is { } port)
        {
            port.Rename((label ?? "").Trim());
        }

        _selected.Cases[index].Label = label ?? "";
        RelabelSelectedLinks();
        MarkDirty(_selected.StepId + "/case-label/" + index);
    }

    // The selected step's ports follow its outcomes; the connections of a port that went go with it.
    private void SyncSelectedOutcomes()
    {
        if (_selected is null || _diagram is null)
        {
            return;
        }

        var removed = _selected.SyncOutcomes();
        _restoring = true; // the removals are part of this change, not changes of their own
        try
        {
            foreach (var link in _diagram.Links.Where(link => removed.Any(port => ReferenceEquals((link.Source as SinglePortAnchor)?.Port, port))).ToList())
            {
                _diagram.Links.Remove(link);
            }
        }
        finally
        {
            _restoring = false;
        }

        RelabelSelectedLinks();
    }

    // The words on the selected step's connections follow its outcomes' names.
    private void RelabelSelectedLinks()
    {
        if (_selected is null || _diagram is null)
        {
            return;
        }

        foreach (var link in _diagram.Links.Where(link => ReferenceEquals((link.Source as SinglePortAnchor)?.Port?.Parent, _selected)))
        {
            link.Labels.Clear();
            LabelLink(link);
            link.Refresh();
        }

        ApplyRunToLinks(); // the run's counts went with the labels cleared
    }

