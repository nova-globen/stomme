    // An author's editor - not while a version is open read-only, nor while the pipeline is archived (n8n's archive: read-only
    // until it is restored).
    private bool CanManage => _viewingVersion is null && _pipeline?.ArchivedOnUtc is null && IsAuthorizedPermission(PipelinesPermissions.Manage);

    protected override async Task OnParametersSetAsync()
    {
        if (ShouldRender() && ModuleState != null && IsAuthorizedPermission(PipelinesPermissions.View))
        {
            _definitionId = PageState.QueryString.ContainsKey("definition") ? PageState.QueryString["definition"] : null;
            if (!string.IsNullOrEmpty(_definitionId) && _loadedFor != _definitionId)
            {
                _loadedFor = _definitionId;
                await LoadAsync();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The canvas talks to the browser; it is rendered only once the session is interactive (never during prerendering)
        // AND once the base has loaded the module's scripts - the canvas library's included. Flipping it on in the synchronous
        // OnAfterRender raced that load: opening the editor by its URL rendered the canvas before ZBlazorDiagrams existed and
        // the circuit failed (found driving BL-97 increment 12; the list's Edit link won the race because the page was warm).
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender && !_interactive)
        {
            _interactive = true;
            StateHasChanged();
        }

        if (_interactive && !_keysStarted && CanManage)
        {
            _keysStarted = true;
            _ = AttachKeysAsync(_keys.Token);
        }

        // The step a link names: chosen as soon as the canvas exists, and centred once the canvas has its size - a render later
        // when the first one had none.
        if (_pendingStep is { } pending && _diagram is not null)
        {
            var sized = _diagram.Container is { Width: > 0, Height: > 0 };
            if (sized || !_pendingStepChosen)
            {
                _pendingStepChosen = true;
                _pendingStep = sized ? null : pending;
                GoToStep(pending);
            }
        }

        // n8n's zoom to fit on open: a pipeline whose steps do not all show in the canvas at the view it opens with is
        // fitted once the canvas has its size - zoomed out, never in past the steps' own size; one that shows whole opens as it
        // is, and a step a link names wins.
        if (FitIfOpening())
        {
            StateHasChanged();
        }

        // Leaving asked about: its first answer takes the focus, so Enter saves and leaves and Escape stays.
        if (_focusLeaving && _leaveTo is not null)
        {
            _focusLeaving = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("stommePipelineEditorFocus", "pipelines-editor-leave-save");
            }
            catch (JSException)
            {
                // the editor's script not there yet: the question is on the page all the same
            }
        }

        // The selected trigger's panel, read when the step or its name or cron changes.
        var key = _selected is not null && TriggerValue(_selected) is not null ? TriggerKey(_selected) : null;
        if (key != _triggerKey)
        {
            _triggerKey = key;
            _triggerInfo = null;
            _webhookCall = null;
            _webhookSecretError = null;
            if (key is not null)
            {
                await LoadTriggerInfoAsync(key, _selected.Type, TriggerValue(_selected), ZoneOf(_selected));
            }
        }
    }

    // A trigger's name or cron as typed; null when it - or a schedule's time zone - comes from a variable or an expression
    // (known only when it runs).
    private static string TriggerValue(StepNodeModel step)
    {
        var input = step.Type == WebhookStepType ? "WebhookName" : step.Type == ScheduleStepType ? "Cron" : step.Type == PipelineForms.StepType ? "FormName" : step.Type == ChatStepType ? "ChatName" : null;
        if (input is null || Bound(step, input) || (step.Type == ScheduleStepType && Bound(step, "TimeZone")))
        {
            return null;
        }

        return step.Inputs.TryGetValue(input, out var value) ? value ?? "" : "";
    }

    private static bool Bound(StepNodeModel step, string input) =>
        step.InputVariables.ContainsKey(input) || step.InputExpressions.ContainsKey(input) || step.InputScripts.ContainsKey(input);

    // A schedule's time zone as typed - or, with none of its own, the pipeline's; empty is UTC.
    private string ZoneOf(StepNodeModel step) =>
        step.Type != ScheduleStepType ? ""
        : step.Inputs.TryGetValue("TimeZone", out var zone) && !string.IsNullOrWhiteSpace(zone) ? zone
        : _graph?.TimeZone ?? "";

    private string TriggerKey(StepNodeModel step) => step.Type + "|" + TriggerValue(step) + "|" + ZoneOf(step);

    private async Task LoadTriggerInfoAsync(string key, string type, string value, string zone)
    {
        TriggerInfoView info;
        try
        {
            info = await PipelinesService.GetTriggerInfoAsync(type, value, string.IsNullOrWhiteSpace(zone) ? null : zone) ?? new TriggerInfoView { Error = "The trigger could not be read." };
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Reading Trigger {Error}", ex.Message);
            info = new TriggerInfoView { Error = "The trigger could not be read: " + ex.Message };
        }

        if (_triggerKey == key)
        {
            _triggerInfo = info;
            StateHasChanged();
        }
    }

    // The address a caller posts to: this site's, the receiver's path after it.
    private string WebhookUrl(TriggerInfoView info) =>
        (PageState?.Alias?.Protocol ?? "") + (PageState?.Alias?.Name ?? "") + "/" + info.Path;

    // Waits for the next signed call to the selected webhook (at most a minute) and shows what it sent.
    private async Task ListenForWebhookAsync()
    {
        var name = _selected is null ? null : TriggerValue(_selected);
        if (string.IsNullOrWhiteSpace(name) || _listening)
        {
            return;
        }

        var key = _triggerKey;
        _listening = true;
        _webhookCall = null;
        StateHasChanged();
        WebhookCallView call;
        try
        {
            call = await PipelinesService.ListenForWebhookAsync(name, 60) ?? new WebhookCallView();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Listening For Webhook {Error}", ex.Message);
            call = new WebhookCallView { Error = "Listening failed: " + ex.Message };
        }
        finally
        {
            _listening = false;
        }

        if (_triggerKey == key)
        {
            _webhookCall = call;
        }
    }

    // The selected webhook's name as its secret is kept under (normalised as the server does); null when it is not one.
    private string WebhookSecretName() =>
        _selected is not null && _selected.Type == WebhookStepType && TriggerValue(_selected) is { Length: > 0 } name ? name.Trim().ToLowerInvariant() : null;

    // Makes the selected webhook a secret of its own (or a new one), shows it this once, and reads the panel again.
    private async Task RenewWebhookSecretAsync()
    {
        var name = WebhookSecretName();
        if (name is null || _webhookSecretBusy)
        {
            return;
        }

        _webhookSecretBusy = true;
        _webhookSecretError = null;
        try
        {
            var made = await PipelinesService.RenewWebhookSecretAsync(name);
            _webhookSecret = made is { Secret.Length: > 0 } ? made : null;
            _webhookSecretCopied = false;
            if (_webhookSecret is null)
            {
                _webhookSecretError = "No secret came back - try again.";
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Making Webhook Secret {Error}", ex.Message);
            _webhookSecretError = "The secret could not be made: " + RefusalReason(ex);
        }
        finally
        {
            _webhookSecretBusy = false;
        }

        await ReloadTriggerInfoAsync();
    }

    // Removes the selected webhook's own secret - the site's webhook secret opens it again.
    private async Task RemoveWebhookSecretAsync()
    {
        var name = WebhookSecretName();
        if (name is null || _webhookSecretBusy)
        {
            return;
        }

        _webhookSecretBusy = true;
        _webhookSecretError = null;
        try
        {
            await PipelinesService.RemoveWebhookSecretAsync(name);
            _webhookSecret = null;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Removing Webhook Secret {Error}", ex.Message);
            _webhookSecretError = "Its own secret could not be removed: " + RefusalReason(ex);
        }
        finally
        {
            _webhookSecretBusy = false;
        }

        await ReloadTriggerInfoAsync();
    }

