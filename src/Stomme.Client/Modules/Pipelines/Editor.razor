@namespace Stomme.Modules.Pipelines
@inherits ModuleBase
@implements IDisposable
@inject IPipelinesService PipelinesService
@inject NavigationManager NavigationManager
@inject IServiceProvider EditorServices
@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Components.Widgets
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.Models.Base
@using Blazor.Diagrams.Core.Anchors
@using Blazor.Diagrams.Options
@using Stomme.Modules.Pipelines.Canvas
@using Stomme.Collaboration
@using Stomme.Modules.Collaboration
@using Microsoft.JSInterop
@using System.Text.Json

@*
    The pipeline editor (BL-95 increment (c)): the predecessor platform's canvas re-targeted to the ENGINE's model. The palette is the
    engine's step registry (the catalog), a node is a step with the literal inputs the catalog describes, a link is a
    connection through an outcome port, and Save sends the graph, which the server turns into the engine's own Flowchart
    document and the engine judges before it is stored. Everything the predecessor platform modelled itself - templates, connectors,
    step kinds, relations - is gone; the library (Z.Blazor.Diagrams, MIT) supplies pan, zoom, dragging and link drawing
    only, and the node visuals are ours, so it stays swappable.
*@

<PageTitle>Pipeline editor</PageTitle>

@if (!IsAuthorizedPermission(PipelinesPermissions.View))
{
    <p class="db-pipelines-denied" style="color:var(--db-text-2);">You do not have access to pipelines on this site.</p>
}
else if (string.IsNullOrEmpty(_definitionId))
{
    <p style="margin:0;color:var(--db-text-2);">No pipeline was named. <a href="@NavigateUrl()">Back to the pipelines.</a></p>
}
else
{
    @* n8n's "Save changes before leaving?": with changes not saved, the browser asks before a reload, a closed tab or
       another site, and the editor asks before any other page of this one. *@
    <NavigationLock ConfirmExternalNavigation="@(_dirty && CanManage)" OnBeforeInternalNavigation="OnLeaving" />
    <div class="db-pipeline-editor">
        @if (_leaveTo is not null)
        {
            <div id="pipelines-editor-leaving" class="db-pipeline-editor__leaving" role="alertdialog" aria-modal="true" aria-labelledby="pipelines-editor-leaving-title" aria-describedby="pipelines-editor-leaving-text">
                <strong id="pipelines-editor-leaving-title">Save changes before leaving?</strong>
                <p id="pipelines-editor-leaving-text">@($"'{_pipeline?.Name ?? "This pipeline"}' has changes that are not saved; leaving without saving loses them.")</p>
                @if (!string.IsNullOrEmpty(_leaveError))
                {
                    <p id="pipelines-editor-leaving-error" class="db-pipeline-editor__input-problem is-error" role="alert">@_leaveError</p>
                }
                <div class="db-pipeline-editor__leaving-actions">
                    <button id="pipelines-editor-leave-save" type="button" class="db-btn" @onclick="SaveAndLeaveAsync" disabled="@_busy">Save and leave</button>
                    <button id="pipelines-editor-leave-discard" type="button" class="db-btn" @onclick="Leave">Leave without saving</button>
                    <button id="pipelines-editor-leave-stay" type="button" class="db-btn" @onclick="Stay">Stay</button>
                </div>
            </div>
        }
        <header class="db-pipeline-editor__bar">
            <a id="pipelines-editor-back" class="db-btn" href="@NavigateUrl()">Pipelines</a>
            <div class="db-pipeline-editor__title">
                @* n8n's workflow name, edited where it is shown: the pipeline's name and what it does, saved into its draft
                   (Enter saves, Escape leaves it as it was). *@
                @if (_detailsOpen && _pipeline is not null)
                {
                    <div id="pipelines-editor-details" class="db-pipeline-editor__details" role="group" aria-label="The pipeline's name and description">
                        <input id="pipelines-editor-details-name" type="text" class="db-input" aria-label="Name" maxlength="200" value="@_detailsName"
                               @oninput="e => _detailsName = e.Value?.ToString() ?? string.Empty" @onkeydown="DetailsKeyAsync" />
                        <input id="pipelines-editor-details-description" type="text" class="db-input" aria-label="Description" placeholder="What it does (optional)" value="@_detailsDescription"
                               @oninput="e => _detailsDescription = e.Value?.ToString() ?? string.Empty" @onkeydown="DetailsKeyAsync" />
                        <button id="pipelines-editor-details-save" type="button" class="db-btn" @onclick="SaveDetailsAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_detailsName))">Save</button>
                        <button id="pipelines-editor-details-cancel" type="button" class="db-btn" @onclick="CloseDetailsAsync">Cancel</button>
                    </div>
                }
                else if (CanManage && _pipeline is not null && _viewingVersion is null)
                {
                    <button id="pipelines-editor-name" type="button" class="db-pipeline-editor__name" aria-label="@("Rename " + _pipeline.Name)" title="@(string.IsNullOrWhiteSpace(_pipeline.Description) ? "Rename it, or say what it does" : _pipeline.Description + " (click to rename it or change this)")" @onclick="OpenDetails">@_pipeline.Name</button>
                }
                else
                {
                    <strong id="pipelines-editor-name" title="@_pipeline?.Description">@(_pipeline?.Name ?? "Loading…")</strong>
                }
                @if (_pipeline is not null)
                {
                    <span class="db-pipeline-editor__meta">version @_pipeline.Version · @(_pipeline.IsPublished ? "published" : "draft")@(_dirty ? " · unsaved changes" : "")</span>
                }
            </div>
            @if (CanManage)
            {
                <button id="pipelines-editor-save" type="button" class="db-btn" @onclick="SaveAsync" disabled="@(_busy || _diagram is null)">Save</button>
                @* What changed, in the author's words - kept with the version it publishes, shown in the versions list. *@
                <input id="pipelines-editor-publish-note" type="text" class="db-input" style="max-width:16rem;" maxlength="@PublishPipelineRequest.MaxNoteLength"
                       placeholder="What changed (optional)" aria-label="What changed - kept with the version it publishes" value="@_publishNote"
                       @oninput="e => _publishNote = e.Value?.ToString() ?? string.Empty" disabled="@(_busy || _diagram is null)" />
                <button id="pipelines-editor-publish" type="button" class="db-btn" @onclick="PublishAsync" disabled="@(_busy || _diagram is null)">Save and publish</button>
            }
            @if (IsAuthorizedPermission(PipelinesPermissions.Run) && _pipeline is { IsPublished: true })
            {
                <button id="pipelines-editor-run" type="button" class="db-btn" title="Run the published version (Ctrl+Enter)" @onclick="RunAsync" disabled="@_busy">Run</button>
            }
            @* n8n's "Test workflow": the pipeline as it stands, saved or not, for real and stored nowhere. *@
            @if (CanManage && IsAuthorizedPermission(PipelinesPermissions.Run) && _diagram is not null)
            {
                <button id="pipelines-editor-test-draft" type="button" class="db-btn" title="Run the pipeline as it stands on the canvas, saved or not - for real (an HTTP request is sent, a file written), storing nothing - and show what each step did" @onclick="TestDraftAsync" disabled="@(_testing || _busy)">@(_testingDraft ? "Testing…" : "Test pipeline")</button>
            }
            @* Every version the engine keeps - compared with the canvas, opened read-only, restored. *@
            @if (_pipeline is not null)
            {
                <button id="pipelines-editor-versions-toggle" type="button" class="db-btn" aria-expanded="@(_versionsOpen ? "true" : "false")" @onclick="ToggleVersionsAsync">Versions</button>
                @* The canvas as a file another site (or this one) imports - what is shown, saved or not. *@
                <button id="pipelines-editor-export" type="button" class="db-btn" title="Download what the canvas shows as a pipeline file" @onclick="ExportAsync" disabled="@(_diagram is null)">Export</button>
                @* n8n's Evaluations: the published pipeline run over a data table's rows, scored. *@
                <a id="pipelines-editor-evaluations" class="db-btn" href="@NavigateUrl(ModuleState.ModuleId, "Evaluations", "definition=" + Uri.EscapeDataString(_definitionId))" title="Run the published pipeline over a data table's rows as test cases, and score it">Evaluations</a>
            }
            @* A run on the canvas - each step's state and time on it, its data in the inspector. Run stays
               here and follows the run as it goes; any recent run can be chosen. *@
            @if (_runs is { Count: > 0 } || _shownRunId is not null)
            {
                <label for="pipelines-editor-run-select" class="db-pipeline-editor__meta">Show run</label>
                <select id="pipelines-editor-run-select" @key="RunPickerKey()" class="db-input" style="width:auto;" value="@(_shownRunId ?? "")" @onchange="e => ChooseRunAsync(e.Value?.ToString())">
                    <option value="">(none)</option>
                    @if (_shownRunId is not null && (_runs is null || _runs.All(run => run.Id != _shownRunId)))
                    {
                        <option value="@_shownRunId">@(_shownRunId == DraftTestId ? "the pipeline as it stands, tested" : "the run just started")</option>
                    }
                    @foreach (var run in _runs ?? new List<PipelineRunView>())
                    {
                        <option value="@run.Id">@run.CreatedOnUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC · @RunLabel(run)</option>
                    }
                </select>
                @if (_shownRunId is not null)
                {
                    <span id="pipelines-editor-run-state" class="db-pipeline-editor__meta">@(_shownRun is null ? "starting…" : RunLabel(_shownRun))</span>
                    @if (_shownRunId != DraftTestId)
                    {
                        @* n8n's "Stop execution": the run followed here stopped where it is - the Run page's Cancel, for whoever
                           may run the pipeline, while the run goes on or waits, and while it is starting: a run busy in its first
                           burst of work is not stored until the burst ends, and is stopped before its next step all the same. *@
                        @if ((_shownRun is null || _shownRun is { IsFinished: false }) && IsAuthorizedPermission(PipelinesPermissions.Run))
                        {
                            <button id="pipelines-editor-run-stop" type="button" class="db-btn" title="Stop this run: nothing after the step it is on runs - a step at work finishes first, a waiting one is cancelled" @onclick="StopRunAsync" disabled="@_stopping">@(_stopping ? "Stopping…" : "Stop run")</button>
                        }
                        <a id="pipelines-editor-run-page" href="@NavigateUrl(ModuleState.ModuleId, "Run", "id=" + _shownRunId)">its log</a>
                    }
                }
            }
            @if (_pipeline is not null)
            {
                @* Beyond n8n's Insights: how each step has been doing over a window, on the canvas where a run would be. *@
                <button id="pipelines-editor-step-insights" type="button" class="db-btn @(_stepInsights is null ? "" : "is-active")" aria-pressed="@(_stepInsights is null ? "false" : "true")"
                        title="How each step has done over recent runs: how many times it ran, how often it failed, how long it takes" @onclick="ToggleStepInsightsAsync">Step insights</button>
                @if (_stepInsights is not null)
                {
                    <label for="pipelines-editor-step-insights-days" class="db-visually-hidden">Step insights over</label>
                    <select id="pipelines-editor-step-insights-days" class="db-input" style="width:auto;" value="@_stepInsights.Days" @onchange="e => StepInsightsAsync(int.TryParse(e.Value?.ToString(), out var days) ? days : 7)">
                        <option value="1">Last 24 hours</option>
                        <option value="7">Last 7 days</option>
                        <option value="30">Last 30 days</option>
                    </select>
                    <span id="pipelines-editor-step-insights-runs" class="db-pipeline-editor__meta">@(_stepInsights.Runs == 1 ? "1 run" : $"{_stepInsights.Runs} runs")@(_stepInsights.Capped ? " (the newest)" : "")</span>
                }
            }
        </header>

        @if (_pipeline is not null)
        {
            @* Two editors of one pipeline: presence, the advisory lock, and a warning when the other saves. *@
            <CollaborationPanel @ref="_collaboration" ResourceType="@CollaborativeResourceTypes.Pipeline" ResourceId="@_definitionId" ResourceLabel="pipeline"
                                Enabled="@CanManage" CurrentUserId="@(PageState?.User?.UserId ?? 0)"
                                SaveAdvice="Or save: what you changed is merged with theirs, and refused only where you both changed the same thing."
                                OnReloadRequested="ReloadAsync" />
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <p id="pipelines-editor-error" class="db-pipeline-editor__error">@_error</p>
        }
        @if (_conflicts.Count > 0)
        {
            <ul id="pipelines-editor-conflicts" class="db-pipeline-editor__error">
                @foreach (var conflict in _conflicts)
                {
                    <li>@conflict</li>
                }
            </ul>
        }
        @if (!string.IsNullOrEmpty(_message))
        {
            <p id="pipelines-editor-message" class="db-pipeline-editor__message">@_message</p>
        }
        @* What goes wrong, what the editor did and the step the arrow keys reached (the canvas says nothing to a screen
           reader), spoken as they come. The regions are always there - one made with its text already in it is announced by some
           screen readers and not by others - and out of the layout: absolutely placed, so the editor's column sets no gap by them. *@
        <div id="pipelines-editor-say-error" class="db-visually-hidden" role="alert">@SpokenAgain(_error, _errorAgain)</div>
        <div id="pipelines-editor-say" class="db-visually-hidden" role="status" aria-live="polite">@SpokenAgain(_message, _messageAgain)</div>
        <div id="pipelines-editor-say-step" class="db-visually-hidden" role="status" aria-live="polite">@_announce</div>
        @* What testing the pipeline as it stands did: how it went, why it stopped, and its log; each step's state is on
           the canvas, its data in the inspector. *@
        @if (_shownRunId == DraftTestId && _draftTest is { } draftTested)
        {
            <details id="pipelines-editor-draft-test" class="db-pipeline-editor__draft-test" open>
                <summary id="pipelines-editor-draft-test-summary">@DraftTestSummary(draftTested)</summary>
                @if (!string.IsNullOrEmpty(draftTested.Error))
                {
                    <p id="pipelines-editor-draft-test-error" class="db-pipeline-editor__error">@draftTested.Error</p>
                }
                @if (draftTested.Log is { Count: > 0 } draftLines)
                {
                    <ol id="pipelines-editor-draft-test-log" class="db-pipeline-editor__draft-test-log">
                        @foreach (var draftLine in draftLines)
                        {
                            <li>@draftLine</li>
                        }
                    </ol>
                }
            </details>
        }
        @* n8n's logs: what the run shown did, pass by pass in the order the passes began - each one's state, time and records
           - a press away from its step on the canvas and its data in the inspector. The canvas shows each step's last state; this,
           the order and a loop's every pass. Closed until opened, so the canvas keeps its place. *@
        @if (_shownRunId is not null && _runSteps.Count > 0)
        {
            var passes = Passes();
            <details id="pipelines-editor-passes" class="db-pipeline-editor__passes">
                <summary id="pipelines-editor-passes-summary">@PassesSummary(passes)</summary>
                <ol class="db-pipeline-editor__passes-list">
                    @foreach (var pass in passes.Take(MaxPasses))
                    {
                        var chosen = pass;
                        <li>
                            <button type="button" class="db-pipeline-editor__pass is-@chosen.State" @onclick="() => GoToPass(chosen)">
                                <span class="db-pipeline-editor__pass-name">@chosen.Name</span> <span class="db-pipeline-editor__pass-note">@chosen.Note</span>
                            </button>
                        </li>
                    }
                </ol>
                @if (passes.Count > MaxPasses)
                {
                    <p class="db-pipeline-editor__meta" style="margin:0;">And @(passes.Count - MaxPasses) more - the run's page has every one.</p>
                }
            </details>
        }

        @* Undo and redo, copy and paste, delete, fit - also Ctrl+Z, Ctrl+Y, Ctrl+C, Ctrl+V, Delete and Ctrl+S
           (pipelines-editor.js); Ctrl+click selects several steps. *@
        @if (CanManage && _diagram is not null)
        {
            <div class="db-pipeline-editor__tools" role="toolbar" aria-label="Edit">
                @* n8n's AI workflow builder: the site's model changes the canvas as the author asks, the change marked on it. *@
                @if (AiOffered)
                {
                    <button id="pipelines-editor-ai-toggle" type="button" class="db-btn @(_aiOpen ? "is-active" : "")" aria-expanded="@(_aiOpen ? "true" : "false")"
                            title="Say what the pipeline should do, or what should change: the site's AI changes the canvas, marked on it - save to keep it, or Undo" @onclick="ToggleAiAsync">Build with AI</button>
                }
                <button id="pipelines-editor-undo" type="button" class="db-btn" title="Undo (Ctrl+Z)" @onclick="Undo" disabled="@(!_history.CanUndo)">Undo</button>
                <button id="pipelines-editor-redo" type="button" class="db-btn" title="Redo (Ctrl+Y)" @onclick="Redo" disabled="@(!_history.CanRedo)">Redo</button>
                <button id="pipelines-editor-copy" type="button" class="db-btn" title="Copy the selected steps (Ctrl+C)" @onclick="Copy">Copy</button>
                <button id="pipelines-editor-paste" type="button" class="db-btn" title="Paste (Ctrl+V)" @onclick="Paste" disabled="@(_clipboard is null)">Paste</button>
                <button id="pipelines-editor-delete" type="button" class="db-btn" title="Delete the selected steps and connections (Delete)" @onclick="DeleteSelection">Delete</button>
                <button id="pipelines-editor-fit" type="button" class="db-btn" title="Fit the pipeline to the canvas" @onclick="FitToView">Fit</button>
                <button id="pipelines-editor-tidy" type="button" class="db-btn" title="Lay every flowchart out left to right by its flow - only the steps chosen, when several are (Shift+Alt+T; Undo takes it back)" @onclick="TidyUp">Tidy up</button>
                <button id="pipelines-editor-add-note" type="button" class="db-btn" title="A sticky note for whoever reads the pipeline - never run" @onclick="AddNote">Add note</button>
                <label for="pipelines-editor-import" class="db-btn" title="Put a pipeline file on the canvas in place of what is there (Undo takes it back)">Import</label>
                <InputFile id="pipelines-editor-import" class="db-pipeline-editor__file" accept=".json,application/json" OnChange="ImportIntoCanvasAsync" />
                <button id="pipelines-editor-shortcuts-toggle" type="button" class="db-btn" title="The keyboard shortcuts (?)" aria-expanded="@(_shortcutsOpen ? "true" : "false")" @onclick="() => _shortcutsOpen = !_shortcutsOpen">Shortcuts</button>
            </div>
            @* Every key the editor answers to, in one place (n8n's "?"). The keys themselves are pipelines-editor.js's. *@
            @if (_shortcutsOpen)
            {
                <div id="pipelines-editor-shortcuts" class="db-pipeline-editor__shortcuts" role="region" aria-label="Keyboard shortcuts">
                    <dl>
                        @foreach (var (keys, what) in Shortcuts)
                        {
                            <dt><kbd>@keys</kbd></dt>
                            <dd>@what</dd>
                        }
                    </dl>
                    <button id="pipelines-editor-shortcuts-close" type="button" class="db-btn" @onclick="() => _shortcutsOpen = false">Close</button>
                </div>
            }
            @* n8n's AI workflow builder: what the author asks, the model at work, and what it says it did. The change itself
               is on the canvas, marked, an ordinary change: saved when the author saves, taken back by Undo. *@
            @if (_aiOpen && AiOffered)
            {
                <section id="pipelines-editor-ai" class="db-pipeline-editor__ai" aria-label="Build with AI">
                    @if (_aiTurns.Count > 0)
                    {
                        @* The conversation so far, for this session: the AI is told it with each request, so it can be answered. The
                           latest answer is the one the page names (pipelines-editor-ai-summary). *@
                        <ol id="pipelines-editor-ai-turns" class="db-pipeline-editor__ai-turns" aria-label="The conversation so far">
                            @for (var at = 0; at < _aiTurns.Count; at++)
                            {
                                var turn = _aiTurns[at];
                                <li class="db-pipeline-editor__ai-asked"><span class="db-pipeline-editor__ai-who">You:</span> @turn.Asked</li>
                                <li id="@(at == _aiTurns.Count - 1 ? "pipelines-editor-ai-summary" : null)" class="db-pipeline-editor__ai-summary"><strong>The AI says:</strong> @turn.Said</li>
                            }
                        </ol>
                    }
                    <label for="pipelines-editor-ai-instruction">@(_aiTurns.Count == 0 ? "What should the pipeline do, or what should change?" : "Your answer, or what else should change")</label>
                    <textarea id="pipelines-editor-ai-instruction" class="db-input" rows="3" maxlength="2000" spellcheck="true"
                              placeholder="e.g. When a form is sent, sort the message with AI into complaint or question, and e-mail complaints to support@example.com"
                              value="@_aiInstruction" @oninput="e => _aiInstruction = e.Value?.ToString() ?? string.Empty" @onkeydown="AiKeyAsync" disabled="@_aiBusy"></textarea>
                    <div class="db-pipeline-editor__ai-actions">
                        <button id="pipelines-editor-ai-ask" type="button" class="db-btn" title="Ask the site's AI (Ctrl+Enter)" @onclick="AskAiAsync" disabled="@(_aiBusy || string.IsNullOrWhiteSpace(_aiInstruction) || _viewingVersion is not null)">@(_aiBusy ? "Working on it…" : "Ask")</button>
                        <button id="pipelines-editor-ai-close" type="button" class="db-btn" @onclick="CloseAi" disabled="@_aiBusy">Close</button>
                        @if (_aiTurns.Count > 0)
                        {
                            <button id="pipelines-editor-ai-new" type="button" class="db-btn" title="Forget the conversation and start again" @onclick="() => { _aiTurns.Clear(); _aiSummary = null; }" disabled="@_aiBusy">New conversation</button>
                        }
                        <span class="db-pipeline-editor__meta">The site's AI changes the canvas, and nothing is saved until you save. Passwords, keys and connections stay yours to enter.</span>
                    </div>
                </section>
            }
            @* n8n's "Convert to sub-workflow" (Alt+X, or the step menu): the chosen steps moved into a pipeline of their own,
               which this one then runs where they stood. What it would do - or why it cannot - is said before anything is made. *@
            @if (_subOpen && CanManage)
            {
                <section id="pipelines-editor-sub" class="db-pipeline-editor__ai" aria-label="Move into a sub-pipeline">
                    @if (_subMade is { } made)
                    {
                        <p id="pipelines-editor-sub-made">Moved into '@made.Name', published. <a id="pipelines-editor-sub-open" href="@NavigateUrl(ModuleState.ModuleId, "Editor", "definition=" + Uri.EscapeDataString(made.DefinitionId))">Open '@made.Name'</a></p>
                    }
                    else if (_subPlan?.Refusal is { } refusal)
                    {
                        <p id="pipelines-editor-sub-refusal" class="db-pipeline-editor__input-problem is-error" role="alert">These steps cannot move: @refusal</p>
                    }
                    else if (_subPlan is not null)
                    {
                        <p id="pipelines-editor-sub-what">@SubPipelineSummary(_subPlan)</p>
                        <label for="pipelines-editor-sub-name">The new pipeline's name</label>
                        <input id="pipelines-editor-sub-name" type="text" class="db-input" maxlength="200" value="@_subName" @oninput="e => _subName = e.Value?.ToString() ?? string.Empty" disabled="@_subBusy" />
                    }
                    <div class="db-pipeline-editor__ai-actions">
                        @if (_subMade is null && _subPlan is { Refusal: null })
                        {
                            <button id="pipelines-editor-sub-move" type="button" class="db-btn" @onclick="MoveIntoSubPipelineAsync" disabled="@(_subBusy || string.IsNullOrWhiteSpace(_subName))">@(_subBusy ? "Moving…" : "Move")</button>
                        }
                        <button id="pipelines-editor-sub-close" type="button" class="db-btn" @onclick="() => _subOpen = false" disabled="@_subBusy">@(_subMade is null && _subPlan is { Refusal: null } ? "Cancel" : "Close")</button>
                        <span class="db-pipeline-editor__meta">The new pipeline is saved and published at once; this one changes on the canvas, kept when you save.</span>
                    </div>
                </section>
            }
        }

        @* Find on the canvas - a step by its name, its type, its comment or what it holds, in any body, however deep;
           Ctrl+F (pipelines-editor.js), Enter for the next, Shift+Enter the one before. A viewer finds too. *@
        @if (_diagram is not null && _graph.Steps.Count > 0)
        {
            <div class="db-pipeline-editor__find" role="search" aria-label="Find on the canvas">
                <input id="pipelines-editor-find" type="search" class="db-input" placeholder="Find on the canvas (Ctrl+F)" aria-label="Find a step on the canvas" value="@_findText" @oninput="e => SetFind(e.Value?.ToString())" @onkeydown="FindKey" />
                @if (_findMatches is { } matches)
                {
                    @if (matches.Count == 0)
                    {
                        <p id="pipelines-editor-find-none" class="db-pipeline-editor__find-none">No step holds "@_findText".</p>
                    }
                    else
                    {
                        <ul id="pipelines-editor-find-results" class="db-pipeline-editor__find-results">
                            @for (var index = 0; index < matches.Count; index++)
                            {
                                var match = matches[index];
                                var at = index;
                                <li>
                                    <button type="button" class="db-pipeline-editor__find-result @(at == _findIndex ? "is-current" : "")" @onclick="() => GoToMatch(at)">
                                        <strong>@match.Step</strong> <span>@match.Field: @match.Snippet</span>@if (!string.IsNullOrEmpty(match.Where)) {<span class="db-pipeline-editor__find-where"> · @match.Where</span>}
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                }
            </div>
        }

        @if (_viewingVersion is { } viewing)
        {
            <div id="pipelines-editor-viewing" class="db-pipeline-editor__viewing" role="status">
                <strong>Version @viewing, read-only.</strong>
                <button id="pipelines-editor-viewing-back" type="button" class="db-btn" @onclick="BackToCanvas">Back to the canvas</button>
                @if (IsAuthorizedPermission(PipelinesPermissions.Manage))
                {
                    <button id="pipelines-editor-viewing-restore" type="button" class="db-btn" title="Put this version on the canvas - save to keep it, or Undo" @onclick="() => RestoreVersionAsync(viewing)">Restore this version</button>
                }
            </div>
        }
        else if (_pipeline?.ArchivedOnUtc is { } archivedOn)
        {
            @* n8n's archive: an archived pipeline is read-only and does not run until it is restored, as a draft. *@
            <div id="pipelines-editor-archived" class="db-pipeline-editor__viewing" role="status">
                <span><strong>Archived@(archivedOn > DateTime.MinValue ? " " + archivedOn.ToString("yyyy-MM-dd") : "")@(string.IsNullOrEmpty(_pipeline.ArchivedBy) ? "" : " by " + _pipeline.ArchivedBy).</strong> It does not run, and is read-only until it is restored.</span>
                @if (IsAuthorizedPermission(PipelinesPermissions.Manage))
                {
                    <button id="pipelines-editor-restore" type="button" class="db-btn" title="Back from the archive as a draft - publish it to run it again" @onclick="RestoreFromArchiveAsync" disabled="@_busy">Restore</button>
                }
            </div>
        }
        else if (_comparison is not null)
        {
            @* A version compared with the canvas - what is new or changed since it marked on the steps and connections, kept
               up with every change, until the author stops comparing; the list is under Versions. The AI's change is marked the
               same way, against the canvas as it was before it. *@
            <div id="pipelines-editor-comparing" class="db-pipeline-editor__comparing" role="status">
                <span id="pipelines-editor-comparing-summary">@(_comparingAi ? "The AI's change" : $"Since version {_comparedVersion}"): @PipelineGraphDiff.Summary(_comparison)@(_comparison.Count == 0 ? "." : " - marked on the canvas.")</span>
                <button id="pipelines-editor-comparing-stop" type="button" class="db-btn" @onclick="StopComparing">@(_comparingAi ? "Stop marking" : "Stop comparing")</button>
            </div>
        }
        @if (_versionsOpen)
        {
            <section id="pipelines-editor-versions" class="db-pipeline-editor__versions" aria-label="Versions">
                @if (_versions is null)
                {
                    <p>Loading…</p>
                }
                else if (_versions.Count == 0)
                {
                    <p>No versions.</p>
                }
                else
                {
                    <ul>
                        @foreach (var version in _versions)
                        {
                            var number = version.Version;
                            <li id="@("pipelines-editor-version-" + number)">
                                <span class="db-pipeline-editor__version">Version @number · @VersionState(version) · @version.CreatedOnUtc.ToString("yyyy-MM-dd HH:mm") UTC@(string.IsNullOrEmpty(version.SavedBy) ? "" : " · saved by " + version.SavedBy)</span>
                                @if (!string.IsNullOrEmpty(version.Note))
                                {
                                    <q class="db-pipeline-editor__version-note" id="@("pipelines-editor-version-note-" + number)">@version.Note</q>
                                }
                                <button id="@("pipelines-editor-version-compare-" + number)" type="button" class="db-btn" title="What changed from this version to the canvas" @onclick="() => CompareVersionAsync(number)">Compare</button>
                                <button id="@("pipelines-editor-version-open-" + number)" type="button" class="db-btn" title="Show this version on the canvas, read-only" @onclick="() => OpenVersionAsync(number)">Open</button>
                                @if (IsAuthorizedPermission(PipelinesPermissions.Manage))
                                {
                                    <button id="@("pipelines-editor-version-restore-" + number)" type="button" class="db-btn" title="Put this version on the canvas - save to keep it, or Undo" @onclick="() => RestoreVersionAsync(number)">Restore</button>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (_comparison is not null)
                {
                    <div id="pipelines-editor-version-diff">
                        <strong>From @(_comparingAi ? "the canvas before the AI's change" : $"version {_comparedVersion}") to the canvas:</strong>
                        @if (_comparison.Count == 0)
                        {
                            <p>No difference.</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var change in _comparison)
                                {
                                    var stepId = change.StepId;
                                    <li class="@("is-" + change.Kind)">
                                        @if (stepId is not null && _viewingVersion is null && _graph.Steps.Any(step => step.Id == stepId))
                                        {
                                            <button type="button" class="db-pipeline-editor__change" title="Show the step" @onclick="() => GoToStep(stepId)">@change.Line</button>
                                        }
                                        else
                                        {
                                            @change.Line
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </section>
        }

        @* What is wrong with the pipeline as it stands, each one a way to its step. Errors keep it from being
           published (the server refuses by the same rule); warnings say what runs but does nothing meant. *@
        @if (_problems.Count > 0)
        {
            <details id="pipelines-editor-problems" class="db-pipeline-editor__problems @(_problems.Any(problem => problem.Severity == PipelineGraphProblems.Error) ? "has-errors" : "")" open>
                <summary id="pipelines-editor-problems-summary">@ProblemsSummary()</summary>
                <ul>
                    @foreach (var problem in _problems)
                    {
                        var shown = problem;
                        <li class="@(problem.Severity == PipelineGraphProblems.Error ? "is-error" : "is-warning")">
                            <button type="button" class="db-pipeline-editor__problem" title="Show the step" @onclick="() => GoToProblem(shown)">
                                <span class="db-pipeline-editor__problem-kind">@(problem.Severity == PipelineGraphProblems.Error ? "Problem" : "Warning")</span>
                                <strong>@problem.Step</strong>: @problem.Message
                            </button>
                        </li>
                    }
                </ul>
                @* n8n's "fix with AI": the builder asked to fix what is listed here, its change marked and one Undo away. *@
                @if (AiOffered && _viewingVersion is null)
                {
                    <button id="pipelines-editor-problems-ai" type="button" class="db-btn" title="Ask the site's AI to fix what is listed here - its change is marked on the canvas, and Undo takes it back" @onclick="FixProblemsWithAiAsync" disabled="@_aiBusy">Fix with AI</button>
                }
            </details>
        }

        <div class="db-pipeline-editor__body @(IsWide ? "is-wide" : "")">
            <aside class="db-pipeline-editor__palette" aria-label="Step catalog">
                <h4>Steps</h4>
                @if (_catalog is null)
                {
                    <p style="color:var(--db-text-2);">Loading…</p>
                }
                else
                {
                    @* Find a step by typing (Ctrl+K or / from anywhere), arrows and Enter to add it; a step added
                       while another is selected lands to its right, connected to it. Every entry can also be dragged onto the canvas. *@
                    <label for="pipelines-editor-step-search" class="db-pipeline-editor__search-label">Find a step <span style="color:var(--db-text-2);">(Ctrl+K)</span></label>
                    <input id="pipelines-editor-step-search" type="search" class="db-input" placeholder="e.g. csv, http, loop" autocomplete="off" @ref="_stepSearch"
                           value="@_search" @oninput="e => SetSearch(e.Value?.ToString())" @onkeydown="OnSearchKeyDown" disabled="@(!CanManage || _diagram is null)" />
                    @if (InsertingNote() is { } inserting)
                    {
                        <p id="pipelines-editor-inserting" class="db-pipeline-editor__inserting">@inserting</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        var results = SearchResults();
                        var offers = ConnectionOffers();
                        var commands = CommandResults();
                        @if (results.Count == 0 && offers.Count == 0 && commands.Count == 0)
                        {
                            <p id="pipelines-editor-step-noresults" style="color:var(--db-text-2);">No step matches '@_search'.</p>
                        }
                        else
                        {
                            <ul id="pipelines-editor-step-results" class="db-pipeline-editor__results" role="listbox" aria-label="Matching steps">
                                @for (var index = 0; index < results.Count; index++)
                                {
                                    var entry = results[index];
                                    var active = index == _searchIndex;
                                    <li role="option" aria-selected="@(active ? "true" : "false")">
                                        <button type="button" class="db-pipeline-editor__step @(active ? "is-active" : "")" title="@entry.Description" draggable="true"
                                                @ondragstart="() => _dragging = entry" @onclick="() => AddFromSearch(entry)" disabled="@(!CanManage || _diagram is null)">
                                            @entry.DisplayName <span class="db-pipeline-editor__step-category">@entry.Category</span>
                                        </button>
                                    </li>
                                }
                                @* n8n's node per service: a connection whose name or connector matches, with the step that uses it,
                                   added with the connection chosen. *@
                                @for (var index = 0; index < offers.Count; index++)
                                {
                                    var offer = offers[index];
                                    var active = results.Count + index == _searchIndex;
                                    <li role="option" aria-selected="@(active ? "true" : "false")">
                                        <button id="@("pipelines-editor-connection-offer-" + index)" type="button" class="db-pipeline-editor__step @(active ? "is-active" : "")"
                                                title="@(offer.Entry.DisplayName + " with the connection " + offer.Connection.Name)" @onclick="() => AddOffer(offer)" disabled="@(!CanManage || _diagram is null)">
                                            @offer.Connection.Name <span class="db-pipeline-editor__step-category">@offer.Connection.ConnectorDisplayName · @offer.Entry.DisplayName</span>
                                        </button>
                                    </li>
                                }
                                @* n8n's command bar: the editor's own actions found by name, each with its keys. *@
                                @for (var index = 0; index < commands.Count; index++)
                                {
                                    var command = commands[index];
                                    var active = results.Count + offers.Count + index == _searchIndex;
                                    <li role="option" aria-selected="@(active ? "true" : "false")">
                                        <button id="@("pipelines-editor-command-" + command.Id)" type="button" class="db-pipeline-editor__step @(active ? "is-active" : "")"
                                                @onclick="() => RunCommandAsync(command.Id)">
                                            @command.Label <span class="db-pipeline-editor__step-category">@(string.IsNullOrEmpty(command.Keys) ? "Action" : "Action · " + command.Keys)</span>
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    }
                    else
                    {
                        @foreach (var group in _catalog.GroupBy(entry => entry.Category))
                        {
                            <div class="db-pipeline-editor__group">
                                <h5>@group.Key</h5>
                                @foreach (var entry in group)
                                {
                                    <button type="button" class="db-pipeline-editor__step" title="@entry.Description" draggable="true"
                                            @ondragstart="() => _dragging = entry" @onclick="() => AddStep(entry)" disabled="@(!CanManage || _diagram is null)">
                                        @entry.DisplayName
                                    </button>
                                }
                            </div>
                        }
                    }
                }
            </aside>

            <div class="db-pipeline-editor__canvas" id="pipelines-editor-canvas" style="position:relative;"
                 @ondragover:preventDefault="true" @ondrop="OnDrop" @oncontextmenu="OnCanvasContextMenu" @oncontextmenu:preventDefault="@CanManage">
                @* Inside a step's body the canvas shows that body alone; the trail is the way back out. *@
                @if (_scopeParent is not null)
                {
                    <nav id="pipelines-editor-trail" aria-label="Which body the canvas shows" style="position:absolute;top:0.5rem;left:0.5rem;z-index:2;display:flex;gap:0.35rem;align-items:center;flex-wrap:wrap;background:var(--db-bg-elev);border:1px solid var(--db-border);border-radius:6px;padding:0.25rem 0.5rem;">
                        <button id="pipelines-editor-trail-root" type="button" class="db-btn" @onclick="() => ShowLevel(null, null)">Pipeline</button>
                        @foreach (var level in Trail())
                        {
                            var (levelParent, levelPort, label) = level;
                            <span aria-hidden="true">›</span>
                            @if (levelParent == _scopeParent && levelPort == _scopePort)
                            {
                                <strong id="pipelines-editor-trail-current">@label</strong>
                            }
                            else
                            {
                                <button type="button" class="db-btn" @onclick="() => ShowLevel(levelParent, levelPort)">@label</button>
                            }
                        }
                    </nav>
                }
                @if (_diagram is not null && _interactive)
                {
                    <CanvasGrid Diagram="_diagram" />
                    <CascadingValue Value="_diagram" IsFixed="true" @key="_diagram">
                        @* Shift+drag on an empty spot draws a box that selects every step it touches. *@
                        <DiagramCanvas>
                            <Widgets>
                                <SelectionBoxWidget />
                                @* A map of the whole body shown and where the view is in it. *@
                                <NavigatorWidget Width="180" Height="120" Class="db-pipeline-editor__minimap" NodeColor="currentColor" ViewStrokeColor="currentColor" ViewStrokeWidth="3" />
                            </Widgets>
                        </DiagramCanvas>
                    </CascadingValue>
                    <ZoomControls Diagram="_diagram" ZoomTo="ZoomTo" Fit="FitToView" />
                    @* n8n's empty canvas: the first step a press away, in the canvas's middle (or Ctrl+K, or the Steps list). *@
                    @if (!_diagram.Nodes.OfType<StepNodeModel>().Any())
                    {
                        <div id="pipelines-editor-empty" class="db-pipeline-editor__empty">
                            @if (CanManage)
                            {
                                <button id="pipelines-editor-add-first" type="button" class="db-btn" @onclick="AddFirstStepAsync">+ Add the first step</button>
                                <p>or pick one from Steps (Ctrl+K)</p>
                                @if (AiOffered)
                                {
                                    <button id="pipelines-editor-add-ai" type="button" class="db-btn" @onclick="OpenAiAsync">Build it with AI</button>
                                }
                            }
                            else
                            {
                                <p>No steps here yet.</p>
                            }
                        </div>
                    }
                }
                else
                {
                    <p style="margin:1rem;color:var(--db-text-2);">@(_pipeline is null ? "Loading…" : "The canvas needs an interactive session.")</p>
                }
                @* n8n's right-click menu: on a step (or the selected steps it is one of), or on an empty spot - what the keys
                   and the buttons over a step do, each with its key. A click or a right-click anywhere else, or Escape, closes it. *@
                @if (_menu is { } menu)
                {
                    <div class="db-pipeline-editor__menu-backdrop" @onclick="CloseMenu" @oncontextmenu="CloseMenu" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true"></div>
                    <div id="pipelines-editor-menu" class="db-pipeline-editor__menu" role="menu" aria-label="@(menu.ConnectFrom is { } connecting ? "Connect " + menu.Step?.DisplayName + (menu.Step?.OutputPorts.Count() > 1 ? " (" + connecting.Label + ")" : "") + " to" : menu.Disconnecting ? "Disconnect " + menu.Step?.DisplayName : menu.Step is null ? "The canvas" : "Step " + menu.Step.DisplayName)"
                         style="@MenuPlace(menu)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
                        @foreach (var (itemId, label, keys, act) in MenuItems(menu))
                        {
                            var chosen = act;
                            <button id="@("pipelines-editor-menu-" + itemId)" type="button" role="menuitem" class="db-pipeline-editor__menu-item" @onclick="() => FromMenu(chosen)">
                                <span>@label</span>@if (!string.IsNullOrEmpty(keys)) {<kbd>@keys</kbd>}
                            </button>
                        }
                    </div>
                }
            </div>

            <aside class="db-pipeline-editor__inspector" aria-label="Step settings">
                @if (_selected is null && _selectedNote is not null)
                {
                    @* A sticky note's text. *@
                    <h4>Note</h4>
                    <p style="color:var(--db-text-2);">For whoever reads the pipeline - never run. Delete removes it.</p>
                    <label for="pipelines-editor-note-text">Text</label>
                    <textarea id="pipelines-editor-note-text" class="db-input" rows="6" value="@_selectedNote.Text" @oninput="e => SetNoteText(e.Value?.ToString())" disabled="@(!CanManage)"></textarea>
                    @* n8n's note colours, each one of the theme's. *@
                    <fieldset id="pipelines-editor-note-colors" class="db-pipeline-editor__note-colors">
                        <legend>Colour</legend>
                        @foreach (var (value, label) in NoteColorChoices)
                        {
                            var choice = value;
                            var choiceId = "pipelines-editor-note-color-" + (choice ?? "accent");
                            <span>
                                <input id="@choiceId" type="radio" name="pipelines-editor-note-color" checked="@(_selectedNote.Color == choice)" @onchange="() => SetNoteColor(choice)" disabled="@(!CanManage)" />
                                <label for="@choiceId"><span class="db-pipeline-editor__swatch @(choice is null ? "" : "db-note--" + choice)" aria-hidden="true"></span>@label</label>
                            </span>
                        }
                    </fieldset>
                }
                else if (_selected is null)
                {
                    <h4>Nothing selected</h4>
                    <p style="color:var(--db-text-2);">Click a step on the canvas to edit its name and inputs. Drag from an outcome port to another step's input to connect them.</p>

                    @* The pipeline's discussion - each comment with the step it is on, a way to the step; one on a step since
                       removed is said, and can still be resolved or deleted here. *@
                    <div id="pipelines-editor-discussion" class="db-pipeline-editor__discussion">
                        <h4 style="margin-top:1rem;">Discussion</h4>
                        @if (_commentsUnread)
                        {
                            <p id="pipelines-editor-discussion-unread" class="db-pipeline-editor__discussion-quiet">The discussion could not be read.</p>
                        }
                        else if (_comments.Count == 0)
                        {
                            <p id="pipelines-editor-discussion-none" class="db-pipeline-editor__discussion-quiet">None yet. Select a step to ask or say something about it.</p>
                        }
                        else
                        {
                            @CommentList(_comments, withStep: true)
                        }
                        @if (_commentError is { StepId: null } commentError)
                        {
                            <p id="pipelines-editor-discussion-error" class="db-pipeline-editor__error">@commentError.Message</p>
                        }
                    </div>

                    @* The pipeline's variables: how one step's output reaches a later step's input (found walking the editor: an
                       input could only hold a typed value, so a step could not use an earlier step's output once another had run). *@
                    <h4 style="margin-top:1rem;">Variables</h4>
                    <p style="color:var(--db-text-2);">A step saves an output to a variable; a later step reads it into an input. Select a step to bind them.</p>
                    @if (_variables.Count == 0)
                    {
                        <p id="pipelines-editor-variables-empty" style="color:var(--db-text-2);">No variables yet.</p>
                    }
                    else
                    {
                        @* The editor keeps the variables apart from the graph's steps; where each is used reads them together. *@
                        var usage = new PipelineGraph { Steps = _graph.Steps, Variables = _variables };
                        <ul id="pipelines-editor-variables" style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.25rem;">
                            @foreach (var variable in _variables)
                            {
                                var id = variable.Id;
                                <li style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
                                    @if (_renamingVariable == id)
                                    {
                                        @* A variable renamed, and every expression and condition that reads it (PipelineVariableRenames). *@
                                        <input id="pipelines-editor-variable-rename-name" class="db-input" style="flex:1 1 8rem;" type="text" aria-label="@("The new name for " + variable.Name)" value="@_renameTo" @oninput="e => _renameTo = e.Value?.ToString() ?? string.Empty" @onkeydown="RenameVariableKey" />
                                        <button id="pipelines-editor-variable-rename-apply" type="button" class="db-btn" @onclick="RenameVariable">Rename</button>
                                        <button id="pipelines-editor-variable-rename-cancel" type="button" class="db-btn" @onclick="() => _renamingVariable = null">Cancel</button>
                                    }
                                    else
                                    {
                                        <span style="flex:1 1 auto;"><strong>@variable.Name</strong> <span style="color:var(--db-text-2);">(@VariableKind(variable.TypeName))</span></span>
                                        @* What the variable holds before any step saves to it; the server types it as the variable holds. *@
                                        @if (variable.TypeName == "Boolean")
                                        {
                                            <select id="@("pipelines-editor-variable-value-" + id)" class="db-input" style="width:auto;" aria-label="@(variable.Name + " starts as")" value="@(variable.Value ?? "")" @onchange="e => SetVariableValue(id, e.Value?.ToString())" disabled="@(!CanManage)">
                                                <option value="">(no starting value)</option>
                                                <option value="true">starts true</option>
                                                <option value="false">starts false</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <input id="@("pipelines-editor-variable-value-" + id)" class="db-input" style="width:9rem;" type="@(variable.TypeName is "Int32" or "Double" ? "number" : "text")" step="@(variable.TypeName == "Int32" ? "1" : "any")" placeholder="starting value" aria-label="@(variable.Name + " starts as")" value="@variable.Value" @onchange="e => SetVariableValue(id, e.Value?.ToString())" disabled="@(!CanManage)" />
                                        }
                                        @if (CanManage)
                                        {
                                            <button id="@("pipelines-editor-variable-rename-" + id)" type="button" class="db-btn" title="Rename it - and every expression and condition that reads it" @onclick="() => StartRenameVariable(id)">Rename</button>
                                            <button type="button" class="db-btn" title="Remove the variable; every step bound to it is unbound" @onclick="() => RemoveVariable(id)">Remove</button>
                                        }
                                        @* Where it is used - the steps that set it and those that read it, each a way to the step; one that
                                           nothing reads is said (better than n8n, whose data has no names to follow). *@
                                        var uses = PipelineVariableUses.Of(usage, id, _catalog);
                                        <div id="@("pipelines-editor-variable-uses-" + id)" class="db-pipeline-editor__variable-uses">
                                            @if (uses.SetBy.Count == 0 && uses.ReadBy.Count == 0)
                                            {
                                                <span>Not used yet.</span>
                                            }
                                            else
                                            {
                                                <span>@(uses.SetBy.Count == 0 ? (string.IsNullOrEmpty(variable.Value) ? "no step sets it" : "no step sets it - its starting value") : "set by ")</span>
                                                @for (var at = 0; at < uses.SetBy.Count; at++)
                                                {
                                                    var target = uses.SetBy[at];
                                                    <button type="button" class="db-pipeline-editor__step-link" @onclick="() => GoToStep(target)">@StepTitle(target)</button>@(at < uses.SetBy.Count - 1 ? ", " : "")
                                                }
                                                <span>&nbsp;·&nbsp;</span>
                                                @if (uses.ReadBy.Count == 0)
                                                {
                                                    <span class="is-warning">nothing reads it</span>
                                                }
                                                else
                                                {
                                                    <span>read by </span>
                                                    @for (var at = 0; at < uses.ReadBy.Count; at++)
                                                    {
                                                        var target = uses.ReadBy[at];
                                                        <button type="button" class="db-pipeline-editor__step-link" @onclick="() => GoToStep(target)">@StepTitle(target)</button>@(at < uses.ReadBy.Count - 1 ? ", " : "")
                                                    }
                                                }
                                            }
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    @if (CanManage)
                    {
                        <label for="pipelines-editor-variable-name">New variable</label>
                        <input id="pipelines-editor-variable-name" type="text" class="db-input" placeholder="e.g. records" value="@_newVariableName" @onchange="e => _newVariableName = e.Value?.ToString()" />
                        <label for="pipelines-editor-variable-type">It holds</label>
                        <select id="pipelines-editor-variable-type" class="db-input" value="@_newVariableType" @onchange="e => _newVariableType = e.Value?.ToString()">
                            @foreach (var type in VariableTypes)
                            {
                                <option value="@type">@VariableKind(type)</option>
                            }
                        </select>
                        <button id="pipelines-editor-variable-add" type="button" class="db-btn" @onclick="AddVariable">Add variable</button>
                    }

                    @* How many runs may go at once - a schedule firing while the last run still works, a webhook called twice. *@
                    <h4 style="margin-top:1rem;">Runs</h4>
                    <label for="pipelines-editor-runs-at-once">How many at once</label>
                    <select id="pipelines-editor-runs-at-once" class="db-input" value="@(_graph?.RunsAtOnce ?? "")" @onchange="e => SetRunsAtOnce(e.Value?.ToString())" disabled="@(!CanManage)">
                        @foreach (var choice in PipelineRunsAtOnce.All)
                        {
                            <option value="@choice.Value">@choice.Label</option>
                        }
                    </select>
                    <p id="pipelines-editor-runs-at-once-help" style="color:var(--db-text-2);">@(_graph?.RunsAtOnce == PipelineRunsAtOnce.OneInTurn
                        ? "A start while a run is going - or waiting - waits its turn: it is a run, listed as Queued, and starts once the runs before it have ended, oldest first. It applies once published."
                        : "A start while a run is going - or waiting - is skipped by a trigger and refused by Run. It applies once published.")</p>
                    @* n8n's "save successful executions" - a pipeline run every minute need not keep every good run. *@
                    <label style="display:flex;gap:0.4rem;align-items:center;">
                        <input id="pipelines-editor-keep-successful-runs" type="checkbox" checked="@(_graph?.KeepSuccessfulRuns != false)" @onchange="e => SetKeepSuccessfulRuns(e.Value is true)" disabled="@(!CanManage)" />
                        Keep the runs that finish well
                    </label>
                    <p style="color:var(--db-text-2);">Unticked, a run that finishes well is deleted a couple of minutes after it ends, with its log; a run that fails or is cancelled is kept. It applies once published.</p>
                    @* n8n's "save execution progress" - a long run's steps seen as they finish, and kept if the host stops mid-way. *@
                    <label style="display:flex;gap:0.4rem;align-items:center;">
                        <input id="pipelines-editor-save-progress" type="checkbox" checked="@(_graph?.SaveProgress == true)" @onchange="e => SetSaveProgress(e.Value is true)" disabled="@(!CanManage)" />
                        Save progress after each step
                    </label>
                    <p id="pipelines-editor-save-progress-help" style="color:var(--db-text-2);">Ticked, a run is stored after each step it runs - its steps show as they finish, and a run the host stops mid-way keeps what it had done. More writes per run. It applies once published.</p>
                    @* n8n Enterprise's execution data redaction: a run kept, without what its steps received and produced. *@
                    <label for="pipelines-editor-keep-step-data">Keep what each step received and produced</label>
                    <select id="pipelines-editor-keep-step-data" class="db-input" value="@(PipelineStepDataKeeping.Normalize(_graph?.KeepStepData))" @onchange="e => SetKeepStepData(e.Value?.ToString())" disabled="@(!CanManage)">
                        @foreach (var choice in PipelineStepDataKeeping.All)
                        {
                            <option value="@choice.Value">@choice.Label</option>
                        }
                    </select>
                    <p style="color:var(--db-text-2);">For data that should not be kept: a run that is not to keep it has its steps' inputs and outputs, and what it was started with, emptied a couple of minutes after it ends - its status, times, errors, log and saved values stay, but a run started with something is then not run again. It applies once published, to the runs already kept too.</p>
                    @* n8n's "time saved per execution" - what the pipeline is worth, added up in Insights. *@
                    <label for="pipelines-editor-minutes-saved">Minutes saved by each run</label>
                    <input id="pipelines-editor-minutes-saved" type="number" class="db-input" min="1" max="@PipelineInsights.MaxMinutesSavedPerRun" step="1" placeholder="Not said"
                           value="@(_graph?.MinutesSavedPerRun?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" @onchange="e => SetMinutesSaved(e.Value?.ToString())" disabled="@(!CanManage)" />
                    <p style="color:var(--db-text-2);">The minutes of a person's work one run that finishes well saves. The pipelines list adds them up over a day, a week or a month. It applies once published.</p>
                    @* n8n's "Timeout Workflow" - a run stuck in a loop, or on a step that never ends, does not run for ever. *@
                    <label for="pipelines-editor-timeout-minutes">Stop a run busy longer than (minutes)</label>
                    <input id="pipelines-editor-timeout-minutes" type="number" class="db-input" min="1" max="@PipelineRunTimeout.MaxMinutes" step="1" placeholder="No limit"
                           value="@(_graph?.TimeoutMinutes?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" @onchange="e => SetTimeoutMinutes(e.Value?.ToString())" disabled="@(!CanManage)" />
                    <p style="color:var(--db-text-2);">A run still working after this long in one go is stopped before its next step; the time it waits - for a time, a decision, a call - does not count. Up to a day. It applies once published.</p>
                    @* n8n's workflow "Timezone" - where $now and $today are read, and a schedule with no zone of its own. *@
                    <label for="pipelines-editor-time-zone">Time zone</label>
                    <input id="pipelines-editor-time-zone" type="text" class="db-input" list="pipelines-editor-time-zones" placeholder="UTC"
                           value="@(_graph?.TimeZone ?? "")" @onchange="e => SetTimeZone(e.Value?.ToString())" disabled="@(!CanManage)" />
                    <datalist id="pipelines-editor-time-zones">
                        @foreach (var zone in PipelineTimeZone.Suggested)
                        {
                            <option value="@zone"></option>
                        }
                    </datalist>
                    <p style="color:var(--db-text-2);">Where the pipeline reads time: {{ $now }} with this zone's offset, {{ $today }} its date, and a schedule with no zone of its own. An IANA name - Europe/Stockholm - daylight saving followed; empty is UTC. It applies once published.</p>
                    @* n8n's "This workflow can be called by" - which pipelines may run this one with Execute, Dispatch or Bulk dispatch pipeline. *@
                    <h4 style="margin-top:1rem;">Calls from other pipelines</h4>
                    <label for="pipelines-editor-called-by">Who may call it</label>
                    <select id="pipelines-editor-called-by" class="db-input" value="@CalledByChoice()" @onchange="e => SetCalledByChoice(e.Value?.ToString())" disabled="@(!CanManage)">
                        <option value="">Any pipeline on the site</option>
                        <option value="@PipelineCallers.Nobody">No other pipeline</option>
                        <option value="@OnlyChosenCallers">Only the pipelines chosen</option>
                    </select>
                    @if (CalledByChoice() == OnlyChosenCallers)
                    {
                        var admitted = PipelineCallers.Ids(_graph?.CalledBy);
                        @if (admitted.Count == 0)
                        {
                            <p id="pipelines-editor-called-by-none" style="color:var(--db-text-2);">None chosen yet: no pipeline may call it.</p>
                        }
                        else
                        {
                            <ul id="pipelines-editor-called-by-list" class="db-pipeline-editor__variables">
                                @foreach (var admittedId in admitted)
                                {
                                    var id = admittedId;
                                    var known = _otherPipelines?.FirstOrDefault(other => other.DefinitionId == id);
                                    <li id="@("pipelines-editor-called-by-" + id)">
                                        <span>@(known?.Name ?? (id == _definitionId ? "This pipeline" : $"A pipeline not on this site ({id})"))</span>
                                        @if (CanManage)
                                        {
                                            <button type="button" class="db-btn" title="It may no longer call this pipeline" @onclick="() => RemoveCaller(id)">Remove</button>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        @if (CanManage && _otherPipelines is not null && _otherPipelines.Where(other => !admitted.Contains(other.DefinitionId)).ToList() is { Count: > 0 } choosable)
                        {
                            <label for="pipelines-editor-called-by-add">Let it be called by</label>
                            <select id="pipelines-editor-called-by-add" class="db-input" value="" @onchange="e => AddCaller(e.Value?.ToString())">
                                <option value="">(choose a pipeline)</option>
                                @foreach (var other in choosable)
                                {
                                    <option value="@other.DefinitionId">@other.Name</option>
                                }
                            </select>
                        }
                    }
                    <p style="color:var(--db-text-2);">A call it does not allow fails at the calling step, saying why, and the calling pipeline's editor warns of it. A person, the Run API, MCP and its own triggers start it whatever this says. It applies once published.</p>
                    @* n8n's "Error workflow" setting - what starts when this pipeline fails, and one made in a click. *@
                    <h4 style="margin-top:1rem;">When it fails</h4>
                    @if (FailureHandlers() is { } handlers)
                    {
                        @if (handlers.Count == 0)
                        {
                            <p id="pipelines-editor-on-failure-none" style="color:var(--db-text-2);">Nothing starts when it fails: a failed run is only listed with the runs.</p>
                        }
                        else
                        {
                            <ul id="pipelines-editor-on-failure-list" class="db-pipeline-editor__variables">
                                @foreach (var (handler, every) in handlers)
                                {
                                    <li>
                                        <a href="@NavigateUrl(ModuleState.ModuleId, "Editor", "definition=" + Uri.EscapeDataString(handler.DefinitionId))">@(handler.Name ?? handler.DefinitionId)</a>
                                        <span style="color:var(--db-text-2);">@(every ? " - starts when any pipeline fails" : " - starts when this one fails")@(handler.IsPublished ? "" : "; a draft, so it does not start until it is published")</span>
                                    </li>
                                }
                            </ul>
                        }
                    }
                    else if (_failureMapUnread)
                    {
                        <p id="pipelines-editor-on-failure-unread" style="color:var(--db-text-2);">What starts when it fails could not be read.</p>
                    }
                    @if (CanManage)
                    {
                        <button id="pipelines-editor-on-failure-make" type="button" class="db-btn" title="A pipeline that starts when this one fails and says what failed and where - published, in this pipeline's folder" @onclick="MakeFailureHandlerAsync" disabled="@_makingHandler">Make a failure handler</button>
                    }
                    @if (_handlerMade is { } handlerMade)
                    {
                        <p id="pipelines-editor-on-failure-made"><a id="pipelines-editor-on-failure-open" href="@NavigateUrl(ModuleState.ModuleId, "Editor", "definition=" + Uri.EscapeDataString(handlerMade.DefinitionId))">Open '@handlerMade.Name'</a></p>
                    }
                    <p style="color:var(--db-text-2);">A "Pipeline failed" trigger starts a pipeline when a run of this one fails - or of any - with the failure to read: n8n's error workflow, set from the pipeline that fails.</p>
                    @* What was done to this pipeline, by whom and when - the site's pipeline activity, this pipeline's lines. *@
                    @if (IsAuthorizedPermission(PipelinesPermissions.Manage) && !string.IsNullOrEmpty(_definitionId))
                    {
                        <h4 style="margin-top:1rem;">Activity</h4>
                        <button id="pipelines-editor-activity-toggle" type="button" class="db-btn" aria-pressed="@(_activity is null ? "false" : "true")" @onclick="ToggleActivityAsync">@(_activity is null ? "Show what was done to it" : "Hide it")</button>
                        @if (_activity is { Count: 0 })
                        {
                            <p id="pipelines-editor-activity-none" style="color:var(--db-text-2);">Nothing recorded for it yet.</p>
                        }
                        else if (_activity is not null)
                        {
                            <ul id="pipelines-editor-activity-list" class="db-pipeline-editor__variables">
                                @foreach (var entry in _activity)
                                {
                                    <li>
                                        <span style="color:var(--db-text-2);">@entry.OccurredOnUtc.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) UTC</span>
                                        @* The separator is text, not the whitespace beside the link: Razor trims that around a code block. *@
                                        <span>@(entry.UserName ?? "the system") @entry.Action@(string.IsNullOrEmpty(entry.Detail) ? "" : " - " + entry.Detail)@(string.IsNullOrEmpty(entry.RunId) ? "" : " - ")</span>
                                        @if (!string.IsNullOrEmpty(entry.RunId))
                                        {
                                            <a href="@NavigateUrl(ModuleState.ModuleId, "Run", "id=" + Uri.EscapeDataString(entry.RunId))">the run</a>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    }
                }
                else
                {
                    @if (IsWide)
                    {
                        <div id="pipelines-editor-wide-in" class="db-pipeline-editor__wide-in">@WideRunData(received: true)</div>
                    }
                    <div class="db-pipeline-editor__settings">
                    <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:baseline;justify-content:space-between;">
                        <h4 style="margin:0;">@(_selected.Entry?.DisplayName ?? _selected.Type)</h4>
                        @* n8n's node details view: the step's settings between what it received and what it produced. *@
                        <button id="pipelines-editor-wide" type="button" class="db-btn" aria-pressed="@(_wide ? "true" : "false")" title="@(_wide ? "Back to the canvas" : "The step's settings between what it received and what it produced in the run shown")" @onclick="() => _wide = !_wide">@(_wide ? "Back to the canvas" : "Wide view")</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_selected.Entry?.Description))
                    {
                        <p style="color:var(--db-text-2);">@_selected.Entry.Description</p>
                    }
                    @* What is wrong with this step as it stands - the step's own here, each input's under it. *@
                    @{ var selectedProblems = _problems.Where(problem => problem.StepId == _selected.StepId).ToList(); }
                    @if (selectedProblems.Any(problem => problem.Input is null))
                    {
                        <ul id="pipelines-editor-step-problems" class="db-pipeline-editor__step-problems">
                            @foreach (var problem in selectedProblems.Where(problem => problem.Input is null))
                            {
                                <li class="@(problem.Severity == PipelineGraphProblems.Error ? "is-error" : "is-warning")">@problem.Message</li>
                            }
                        </ul>
                    }
                    @* A text field commits on INPUT. On change, typing in a field and then clicking another step on the
                       canvas wrote the text to the step clicked: the selection re-renders the inspector before the browser fires
                       change, and an unchanged rendered value leaves the typed text in the box (found on UAT, 2026-10-05). *@
                    <label for="pipelines-editor-step-name">Name</label>
                    <input id="pipelines-editor-step-name" type="text" class="db-input" value="@_selected.Name" @oninput="e => RenameSelected(e.Value?.ToString())" disabled="@(!CanManage)" />
                    @* A step switched off stays in the pipeline and is skipped when it runs (D on the canvas does the same). *@
                    <div class="db-pipeline-editor__switch">
                        <input id="pipelines-editor-step-disabled" type="checkbox" checked="@_selected.Disabled" @onchange="e => SetSelectedDisabled(e.Value is true)" disabled="@(!CanManage)" />
                        <label for="pipelines-editor-step-disabled">Switched off - skipped when the pipeline runs</label>
                    </div>
                    @* A comment for whoever reads the pipeline, shown on the step. *@
                    <label for="pipelines-editor-step-comment">Comment</label>
                    <textarea id="pipelines-editor-step-comment" class="db-input" rows="2" placeholder="What this step is for - shown on it" value="@_selected.Comment" @oninput="e => SetComment(e.Value?.ToString())" disabled="@(!CanManage)"></textarea>
                    @* A discussion of the step (better than n8n, whose workflows have none): anyone who can see the pipeline
                       asks, answers and resolves; written at once, never part of a save or an undo. *@
                    @{
                        var discussedStep = _selected.StepId;
                        var stepComments = _comments.Where(comment => comment.StepId == discussedStep).ToList();
                        var openHere = stepComments.Count(comment => !comment.Resolved);
                    }
                    <div id="pipelines-editor-discussion" class="db-pipeline-editor__discussion">
                        <h5>Discussion@(openHere > 0 ? " - " + openHere + " open" : "")</h5>
                        @if (_commentsUnread)
                        {
                            <p id="pipelines-editor-discussion-unread" class="db-pipeline-editor__discussion-quiet">The discussion could not be read.</p>
                        }
                        else
                        {
                            @CommentList(stepComments, withStep: false)
                            <textarea id="pipelines-editor-discussion-text" class="db-input" rows="2" maxlength="@PipelineStepCommentLimits.MaxText" aria-label="@("Say something about " + StepTitle(discussedStep))"
                                      placeholder="Ask or say something about this step - Ctrl+Enter adds it" value="@_commentDrafts.GetValueOrDefault(discussedStep)"
                                      @oninput="e => _commentDrafts[discussedStep] = e.Value?.ToString() ?? string.Empty" @onkeydown="e => CommentKeyAsync(e, discussedStep)"></textarea>
                            @* @ and a name offers the people who can see the pipeline; one chosen is written in for the name begun. *@
                            @if (MentionOffers(_commentDrafts.GetValueOrDefault(discussedStep)) is { Count: > 0 } offers)
                            {
                                <div id="pipelines-editor-mentions" class="db-pipeline-editor__mentions" role="listbox" aria-label="People to mention">
                                    @foreach (var person in offers)
                                    {
                                        var chosen = person;
                                        <button type="button" role="option" class="db-pipeline-editor__mention" @onclick="() => Mention(discussedStep, chosen)">@chosen.DisplayName <span>@@@chosen.UserName</span></button>
                                    }
                                </div>
                            }
                            <button id="pipelines-editor-discussion-add" type="button" class="db-btn" @onclick="() => AddCommentAsync(discussedStep)" disabled="@(_commenting || string.IsNullOrWhiteSpace(_commentDrafts.GetValueOrDefault(discussedStep)))">@(_commenting ? "Adding…" : "Add to the discussion")</button>
                            @if (_commentNote is { } commentNote && commentNote.StepId == discussedStep)
                            {
                                <p id="pipelines-editor-discussion-told" class="db-pipeline-editor__discussion-quiet">@commentNote.Message</p>
                            }
                        }
                        @if (_commentError is { } commentError && commentError.StepId == discussedStep)
                        {
                            <p id="pipelines-editor-discussion-error" class="db-pipeline-editor__error">@commentError.Message</p>
                        }
                    </div>
                    @* n8n's pinned data: a test hands this on in place of running the step (an API not called again); a run
                       runs it. Edited here as n8n's pinned output is; Unpin lets a test run the step again. *@
                    @if (_selected.PinnedResult is not null)
                    {
                        <div id="pipelines-editor-pinned" class="db-pipeline-editor__pinned">
                            <label for="pipelines-editor-pinned-result">Pinned result - a test hands it on in place of running the step; a run runs it</label>
                            <textarea id="pipelines-editor-pinned-result" class="db-input db-pipeline-editor__expression" rows="4" spellcheck="false" value="@_selected.PinnedResult" @oninput="e => SetPinned(e.Value?.ToString(), typed: true)" disabled="@(!CanManage)"></textarea>
                            @if (CanManage)
                            {
                                <button id="pipelines-editor-unpin" type="button" class="db-btn" @onclick="() => SetPinned(null)">Unpin</button>
                            }
                        </div>
                    }
                    @if (_selected.Entry is not null)
                    {
                        @* BL-229, n8n's mapping: each variable, and each field of what it holds (the values the previews use), dragged
                           into an input reads it there - dropped on a value it makes the value an expression (pipelines-editor.js). *@
                        var draggable = CanManage && _selected.Entry.Inputs.Count > 0 ? PipelineTemplate.Suggest("", PreviewValues(out _), max: 24) : (IReadOnlyList<string>)Array.Empty<string>();
                        @if (draggable.Count > 0)
                        {
                            @* The pipeline's own values in sight; the built-in ones ($now, $run, $vars...) folded away - sixteen of them
                               pushed the step's own inputs out of sight (found looking at UAT with fresh eyes). *@
                            var builtIns = draggable.Where(placeholder => placeholder.StartsWith("{{ $", StringComparison.Ordinal)).ToList();
                            <div id="pipelines-editor-drag-fields" class="db-pipeline-editor__drag-fields" role="list" aria-label="Variables to drag into an input">
                                <span class="db-pipeline-editor__drag-hint">Drag into an input:</span>
                                @foreach (var placeholder in draggable.Except(builtIns))
                                {
                                    <span class="db-pipeline-editor__drag-field" role="listitem" draggable="true" data-drag-text="@placeholder" title="Drag into an input - a value becomes an expression reading it">@placeholder</span>
                                }
                                @if (builtIns.Count > 0)
                                {
                                    <details id="pipelines-editor-drag-builtins" class="db-pipeline-editor__drag-more">
                                        <summary>built-in values (@builtIns.Count)</summary>
                                        @foreach (var placeholder in builtIns)
                                        {
                                            <span class="db-pipeline-editor__drag-field" role="listitem" draggable="true" data-drag-text="@placeholder" title="Drag into an input - a value becomes an expression reading it">@placeholder</span>
                                        }
                                    </details>
                                }
                            </div>
                        }
                        @if (_selected.Type == PipelineCallContracts.WhenCalledType && Callers() is { } callers)
                        {
                            @* Who calls this pipeline - whom a change to what it expects touches. *@
                            <div id="pipelines-editor-callers" style="color:var(--db-text-2);">
                                @if (callers.Count == 0)
                                {
                                    <span>No pipeline calls this one yet - choose it in another pipeline's Execute or Dispatch pipeline.</span>
                                }
                                else
                                {
                                    <span>Called by:</span>
                                    <ul style="margin:0;padding-left:1.25rem;">
                                        @foreach (var caller in callers)
                                        {
                                            <li><a href="@NavigateUrl(ModuleState.ModuleId, "Editor", "definition=" + Uri.EscapeDataString(caller.DefinitionId))">@(caller.Name ?? caller.DefinitionId)</a>, its step '@(caller.StepName ?? caller.StepId)'@(caller.Waits ? " - waits for the run" : " - does not wait")</li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                        @if (_selected.Type == CurlStepType && CanManage)
                        {
                            @* n8n's "Import cURL": a curl command (an API's documentation, a browser's "Copy as cURL") read into this
                               step's inputs, as one change Ctrl+Z takes back; what the step does not do the same way is said. *@
                            @if (_curlOpen)
                            {
                                <label for="pipelines-editor-curl-text">curl command</label>
                                <textarea id="pipelines-editor-curl-text" class="db-input" rows="5" placeholder="@CurlExample" value="@_curlText" @oninput="e => _curlText = e.Value?.ToString() ?? string.Empty"></textarea>
                                <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
                                    <button id="pipelines-editor-curl-import" type="button" class="db-btn" @onclick="ImportCurl">Import</button>
                                    <button id="pipelines-editor-curl-cancel" type="button" class="db-btn" @onclick="() => { _curlOpen = false; _curlError = null; }">Cancel</button>
                                </div>
                                @if (!string.IsNullOrEmpty(_curlError))
                                {
                                    <p id="pipelines-editor-curl-error" class="db-pipeline-editor__input-problem is-error" role="alert">@_curlError</p>
                                }
                            }
                            else
                            {
                                <div><button id="pipelines-editor-curl-open" type="button" class="db-btn" title="Fill this step from a curl command - an API's example, or a browser's Copy as cURL" @onclick="() => { _curlOpen = true; _curlNotes.Clear(); }">Import cURL</button></div>
                            }
                            @if (_curlNotes.Count > 0 && _curlStep == _selected.StepId)
                            {
                                <ul id="pipelines-editor-curl-notes" style="margin:0;padding-left:1.25rem;color:var(--db-text-2);">
                                    @foreach (var note in _curlNotes)
                                    {
                                        <li>@note</li>
                                    }
                                </ul>
                            }
                        }
                        @foreach (var input in _selected.Entry.Inputs)
                        {
                            var name = input.Name;
                            var kind = KindOf(input);
                            var readsVariable = _selected.InputVariables.TryGetValue(name, out var boundVariable) ? boundVariable : null;
                            var expression = _selected.InputExpressions.TryGetValue(name, out var heldExpression) ? heldExpression ?? "" : null;
                            var condition = _selected.InputConditions.TryGetValue(name, out var heldCondition) ? heldCondition : null;
                            var script = _selected.InputScripts.TryGetValue(name, out var heldScript) ? heldScript ?? "" : null;
                            var scriptsOffered = _capabilities?.Scripts == true || script is not null;
                            var isBoolean = input.TypeName == "Boolean";
                            @if (_selected.Entry.OutcomesFrom == StepCatalogEntry.CaseOutcomes && name == StepCatalogEntry.CaseOutcomes)
                            {
                                @* A Switch's cases - each a label (an outcome port on the step) and a condition. *@
                                <h5 style="margin:0.75rem 0 0;">Cases</h5>
                                <p style="color:var(--db-text-2);margin:0;">It goes out through the first case that holds (or every one, matching any), else through Default.</p>
                                <div id="pipelines-editor-cases" class="db-pipeline-editor__cases">
                                    @for (var caseIndex = 0; caseIndex < _selected.Cases.Count; caseIndex++)
                                    {
                                        var at = caseIndex;
                                        var held = _selected.Cases[at];
                                        <div class="db-pipeline-editor__case">
                                            <label for="@("pipelines-editor-case-label-" + at)">Case @(at + 1) - its outcome</label>
                                            <div class="db-pipeline-editor__rule">
                                                <input id="@("pipelines-editor-case-label-" + at)" type="text" class="db-input" value="@held.Label" @oninput="e => SetCaseLabel(at, e.Value?.ToString())" disabled="@(!CanManage)" />
                                                @if (CanManage)
                                                {
                                                    <button id="@("pipelines-editor-case-remove-" + at)" type="button" class="db-btn" title="Remove this case and its connection" @onclick="() => RemoveCase(at)">Remove</button>
                                                }
                                            </div>
                                            <ConditionEditor IdPrefix="@("pipelines-editor-case-" + at)" Label="@("Case " + (at + 1))" Condition="held.Condition" Disabled="@(!CanManage)"
                                                             Changed="() => ConditionChanged(StepCatalogEntry.CaseOutcomes + at)" Preview="ConditionPreview" />
                                        </div>
                                    }
                                    @if (CanManage)
                                    {
                                        <button id="pipelines-editor-case-add" type="button" class="db-btn" @onclick="AddCase">Add case</button>
                                    }
                                </div>
                                @foreach (var problem in selectedProblems.Where(problem => problem.Input == name))
                                {
                                    <div class="db-pipeline-editor__input-problem @(problem.Severity == PipelineGraphProblems.Error ? "is-error" : "is-warning")">@problem.Message</div>
                                }
                                continue;
                            }
                            @if (input.UIHint == PipelineInputHints.VariablePicker)
                            {
                                @* The variable the step sets (Set Variable): one of the pipeline's - never a value, an expression or a script. *@
                                <label for="@("pipelines-editor-input-" + name)" title="@input.Description">@input.DisplayName<span class="db-pipeline-editor__required" title="The step needs a variable here"> *</span><span style="color:var(--db-text-2);"> (the variable it sets)</span></label>
                                <select id="@("pipelines-editor-input-" + name)" class="db-input" value="@(readsVariable ?? "")" @onchange="e => SetInputSource(name, e.Value?.ToString())" disabled="@(!CanManage)">
                                    <option value="">(choose a variable)</option>
                                    @foreach (var variable in _variables)
                                    {
                                        <option value="@variable.Id">@variable.Name</option>
                                    }
                                    @if (readsVariable is not null && _variables.All(variable => variable.Id != readsVariable))
                                    {
                                        <option value="@readsVariable">(not in this pipeline)</option>
                                    }
                                </select>
                                @if (_variables.Count == 0)
                                {
                                    <p id="@("pipelines-editor-no-variables-" + name)" style="color:var(--db-text-2);margin:0;">This pipeline has no variables yet - select nothing on the canvas and add one.</p>
                                }
                                @foreach (var problem in selectedProblems.Where(problem => problem.Input == name))
                                {
                                    <div id="@("pipelines-editor-input-problem-" + name)" class="db-pipeline-editor__input-problem @(problem.Severity == PipelineGraphProblems.Error ? "is-error" : "is-warning")">@problem.Message</div>
                                }
                                continue;
                            }
                            <label for="@("pipelines-editor-input-" + name)" title="@input.Description">@input.DisplayName@if (input.IsRequired) {<span class="db-pipeline-editor__required" title="The step needs a value here"> *</span>}@if (kind is not null) {<span style="color:var(--db-text-2);"> (@kind)</span>}</label>
                            @* An earlier step's result is a value to read too, so it offers the choice even before any variable exists. *@
                            @if (_variables.Count > 0 || expression is not null || condition is not null || isBoolean || scriptsOffered || (CanManage && EarlierSteps(_selected).Count > 0))
                            {
                                <select id="@("pipelines-editor-source-" + name)" class="db-input" aria-label="@("Where " + input.DisplayName + " comes from")" value="@(condition is not null ? ConditionSource : script is not null ? ScriptSource : expression is not null ? ExpressionSource : readsVariable ?? "")" @onchange="e => SetInputSource(name, e.Value?.ToString())" disabled="@(!CanManage)">
                                    <option value="">a value</option>
                                    @if (isBoolean || condition is not null)
                                    {
                                        <option value="@ConditionSource">a condition</option>
                                    }
                                    <option value="@ExpressionSource">an expression</option>
                                    @if (scriptsOffered)
                                    {
                                        <option value="@ScriptSource">JavaScript</option>
                                    }
                                    @foreach (var variable in _variables)
                                    {
                                        <option value="@variable.Id">the variable '@variable.Name'</option>
                                    }
                                </select>
                            }
                            @if (readsVariable is not null)
                            {
                                @* The input reads the variable: no value of its own. *@
                            }
                            else if (script is not null)
                            {
                                @* JavaScript, run in the server's bounded sandbox with the variables in scope by name;
                                   previewed there, with the values the other previews use. *@
                                <textarea id="@("pipelines-editor-script-" + name)" class="db-input db-pipeline-editor__expression" rows="3" spellcheck="false" aria-label="@(input.DisplayName + " JavaScript")"
                                          placeholder="e.g. rows.filter(r => r.total > 100).length" value="@script" @oninput="e => SetScript(name, e.Value?.ToString())" disabled="@(!CanManage)"></textarea>
                                var shownPreview = _scriptPreviews.TryGetValue(_selected.StepId + "/" + name, out var held) ? held : ((string Text, bool Failed)?)null;
                                <div id="@("pipelines-editor-script-preview-" + name)" class="db-pipeline-editor__preview @(shownPreview?.Failed == true ? "is-error" : "")">
                                    @(shownPreview?.Text ?? (_capabilities?.Scripts == true ? "Type to see what it gives." : "Scripts are switched off on this site (Pipelines:Scripts:Enabled): a run fails here."))
                                </div>
                            }
                            else if (condition is not null)
                            {
                                @* Rules comparing values - n8n's IF - tested when the step runs, previewed here. *@
                                <ConditionEditor IdPrefix="@("pipelines-editor-condition-" + name)" Label="@input.DisplayName" Condition="condition" Disabled="@(!CanManage)"
                                                 Changed="() => ConditionChanged(name)" Preview="ConditionPreview" />
                            }
                            else if (_selected.Entry.OutcomesFrom == StepCatalogEntry.BranchesOutcomes && name == StepCatalogEntry.BranchesOutcomes)
                            {
                                @* A Fork's branches, one per line - each an outcome port on the step, all taken at once. *@
                                <textarea id="@("pipelines-editor-input-" + name)" class="db-input" rows="3" placeholder="One branch per line, e.g. Mail" value="@BranchLines(_selected)" @oninput="e => SetBranches(e.Value?.ToString())" disabled="@(!CanManage)"></textarea>
                            }
                            else if (expression is not null)
                            {
                                @* Text with {{ variable.path }} placeholders, filled when the step runs - previewed here
                                   with the values of the run shown (to an author) or the variables' starting values. *@
                                <textarea id="@("pipelines-editor-expression-" + name)" class="db-input db-pipeline-editor__expression" rows="2" spellcheck="false" aria-label="@(input.DisplayName + " expression")"
                                          placeholder="e.g. Hello {{ person.name }}" value="@expression" @oninput="e => SetExpression(name, e.Value?.ToString())" disabled="@(!CanManage)"></textarea>
                                var suggestions = CanManage ? PipelineTemplate.Suggest(expression, PreviewValues(out _)) : new List<string>();
                                @if (suggestions.Count > 0)
                                {
                                    @* Every value offered: the built-in ones folded away, as in the drag list above; while a name is typed after
                                       an open {{ the few that match are all shown. *@
                                    var narrowing = System.Text.RegularExpressions.Regex.IsMatch(expression, @"\{\{\s*[^}\s][^}]*$");
                                    var foldedBuiltIns = narrowing ? new List<string>() : suggestions.Where(suggestion => suggestion.StartsWith("{{ $", StringComparison.Ordinal)).ToList();
                                    <div id="@("pipelines-editor-suggestions-" + name)" class="db-pipeline-editor__suggestions" aria-label="Variables to use">
                                        @foreach (var suggestion in suggestions.Except(foldedBuiltIns))
                                        {
                                            var taken = suggestion;
                                            <button type="button" class="db-pipeline-editor__suggestion" @onclick="() => SetExpression(name, PipelineTemplate.Accept(expression, taken))">@suggestion</button>
                                        }
                                        @if (foldedBuiltIns.Count > 0)
                                        {
                                            <details class="db-pipeline-editor__drag-more">
                                                <summary>built-in values (@foldedBuiltIns.Count)</summary>
                                                @foreach (var suggestion in foldedBuiltIns)
                                                {
                                                    var taken = suggestion;
                                                    <button type="button" class="db-pipeline-editor__suggestion" @onclick="() => SetExpression(name, PipelineTemplate.Accept(expression, taken))">@suggestion</button>
                                                }
                                            </details>
                                        }
                                    </div>
                                }
                                @* n8n reads an earlier node's output where it is needed: the results of the steps that lead here,
                                   each put in through the variable its Result saves to - made and bound on the spot when it saves to none -
                                   so the value is kept across a pause as any variable's is. *@
                                var earlier = CanManage ? EarlierSteps(_selected) : new List<StepNodeModel>();
                                @if (earlier.Count > 0)
                                {
                                    <details id="@("pipelines-editor-earlier-" + name)" class="db-pipeline-editor__drag-more">
                                        <summary>earlier steps' results (@earlier.Count)</summary>
                                        @foreach (var before in earlier)
                                        {
                                            var source = before;
                                            var savedAs = SavedResultVariable(before)?.Name;
                                            <button type="button" class="db-pipeline-editor__suggestion" title="@(savedAs is null ? "Saves its result to a new variable, and puts that here" : "Its result is saved as " + savedAs)"
                                                    @onclick="() => UseEarlierResult(name, expression, source)">@(before.DisplayName)@(savedAs is null ? "" : " - " + savedAs)</button>
                                        }
                                    </details>
                                }
                                var (previewText, previewFailed, previewSource) = Preview(expression);
                                <div id="@("pipelines-editor-preview-" + name)" class="db-pipeline-editor__preview @(previewFailed ? "is-error" : "")">
                                    <span class="db-pipeline-editor__preview-source">@previewSource:</span> @previewText
                                </div>
                            }
                            else if (input.UIHint == "checkbox" || input.TypeName == "Boolean")
                            {
                                <input id="@("pipelines-editor-input-" + name)" type="checkbox" checked="@IsTicked(_selected.Inputs, name, input.DefaultValue)" @onchange="e => SetBoolInput(name, e.Value)" disabled="@(!CanManage)" />
                            }
                            else if (input.UIHint == PipelineInputHints.ConnectionPicker && _connections is not null)
                            {
                                @* One of the site's connections by name (its credentials stay in the site's secret store); one no longer
                                   on the site stays named, so a save keeps it. An editor that may not list connections types the id. *@
                                var chosenConnection = Value(_selected.Inputs, name);
                                @* A step that names the connector types it can use is offered only connections of those; one
                                   chosen that is not one stays named and says so. *@
                                var offeredConnections = ConnectionChoices.Offered(input, _connections);
                                <select id="@("pipelines-editor-input-" + name)" class="db-input" value="@chosenConnection" @onchange="e => SetInput(name, e.Value?.ToString())" disabled="@(!CanManage)">
                                    <option value="">(choose a connection)</option>
                                    @foreach (var connection in offeredConnections)
                                    {
                                        <option value="@connection.Id.ToString()">@connection.Name · @connection.ConnectorDisplayName</option>
                                    }
                                    @if (!string.IsNullOrEmpty(chosenConnection) && offeredConnections.All(connection => !string.Equals(connection.Id.ToString(), chosenConnection, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        var elsewhere = _connections.FirstOrDefault(connection => string.Equals(connection.Id.ToString(), chosenConnection, StringComparison.OrdinalIgnoreCase));
                                        <option value="@chosenConnection">@(elsewhere is null ? "(not on this site: " + chosenConnection + ")" : elsewhere.Name + " · " + elsewhere.ConnectorDisplayName + " (not one this step can use)")</option>
                                    }
                                </select>
                                @if (offeredConnections.Count == 0)
                                {
                                    <p id="@("pipelines-editor-no-connection-" + name)" style="color:var(--db-text-2);margin:0;">@ConnectionChoices.NoneYet(input, _connectors)</p>
                                }
                                @* n8n's "Create new credential" from the node: a connection made here, then chosen for the step; and
                                   the one chosen tested. The server decides both (connections:manage) and says why when it refuses. *@
                                @if (CanManage && _connectors is not null)
                                {
                                    var makingHere = _newConnectionFor == NewConnectionKey(name);
                                    @if (makingHere)
                                    {
                                        <div id="pipelines-editor-new-connection" style="border:1px solid var(--db-border);border-radius:6px;padding:0.5rem;">
                                            <Stomme.Modules.Connectivity.ConnectionForm IdPrefix="pipelines-editor-new-connection" Connectors="ConnectionChoices.Makeable(input, _connectors)" CanCancel="true"
                                                OnSaved="@((Stomme.Connectivity.ConnectionView made) => ConnectionMade(name, made))" OnCancel="() => _newConnectionFor = null" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                                            <button id="pipelines-editor-new-connection-open" type="button" class="db-btn" @onclick="() => _newConnectionFor = NewConnectionKey(name)">New connection</button>
                                            @if (_connections.Any(connection => string.Equals(connection.Id.ToString(), chosenConnection, StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <button id="pipelines-editor-connection-test" type="button" class="db-btn" @onclick="() => TestConnectionAsync(chosenConnection)" disabled="@_connectionTesting">Test connection</button>
                                            }
                                        </div>
                                    }
                                    @if (_connectionTested is { } tested && string.Equals(tested.Id, chosenConnection, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <p id="pipelines-editor-connection-test-result" class="@(tested.Success ? "" : "is-error")" style="margin:0;">@tested.Said</p>
                                    }
                                }
                            }
                            else if (input.UIHint == PipelineInputHints.ConnectorOperation && SelectedConnector() is { } connector)
                            {
                                @* n8n's operation list: the chosen connection's connector's operations by name, the one chosen saying
                                   what it does and what it takes; one this connector does not have stays named, so a save keeps it. *@
                                var operations = ConnectionChoices.Operations(connector);
                                var chosenOperation = Value(_selected.Inputs, name);
                                var pickedOperation = string.IsNullOrEmpty(chosenOperation)
                                    ? operations.FirstOrDefault()
                                    : operations.FirstOrDefault(operation => string.Equals(operation.Name, chosenOperation, StringComparison.OrdinalIgnoreCase));
                                <select id="@("pipelines-editor-input-" + name)" class="db-input" value="@chosenOperation" @onchange="e => SetInput(name, e.Value?.ToString())" disabled="@(!CanManage)">
                                    <option value="">@(operations.Count > 0 ? "(its first: " + operations[0].DisplayName + ")" : "(the connector's default)")</option>
                                    @foreach (var operation in operations)
                                    {
                                        <option value="@operation.Name">@operation.DisplayName</option>
                                    }
                                    @if (!string.IsNullOrEmpty(chosenOperation) && pickedOperation is null)
                                    {
                                        <option value="@chosenOperation">(not @(connector.DisplayName)'s: @chosenOperation)</option>
                                    }
                                </select>
                                @if (pickedOperation is not null)
                                {
                                    var ownBox = _selected.Entry.Inputs.Any(own => own.UIHint == PipelineInputHints.SqlQuery);
                                    // The step's Query box takes an operation's 'query' only when it is a statement of many lines - SQL,
                                    // a GraphQL document; a one-line search (Zendesk's, Gmail's, Supabase's PostgREST query) stays a
                                    // parameter, as the n8n import writes it.
                                    var boxed = ownBox ? pickedOperation.Parameters.FirstOrDefault(parameter => string.Equals(parameter.Name, "query", StringComparison.OrdinalIgnoreCase) && parameter.Type == "Multiline") : null;
                                    var takes = pickedOperation.Parameters.Where(parameter => !ReferenceEquals(parameter, boxed)).ToList();
                                    <div id="pipelines-editor-operation-help" style="color:var(--db-text-2);font-size:0.85rem;">
                                        @if (!string.IsNullOrWhiteSpace(pickedOperation.Description))
                                        {
                                            <p style="margin:0.25rem 0;">@pickedOperation.Description</p>
                                        }
                                        @if (boxed is not null)
                                        {
                                            <p id="pipelines-editor-operation-query" style="margin:0.25rem 0;">Its @boxed.DisplayName goes in Query@(string.IsNullOrWhiteSpace(boxed.Description) ? "." : ": " + boxed.Description)</p>
                                        }
                                        @if (takes.Count > 0)
                                        {
                                            <p style="margin:0.25rem 0 0;">Its parameters, one 'name = value' per line:</p>
                                            <ul id="pipelines-editor-operation-parameters" style="margin:0;padding-left:1.1rem;">
                                                @foreach (var parameter in takes)
                                                {
                                                    <li><code>@parameter.Name</code> - @parameter.DisplayName@(parameter.Required ? " (required)" : "")@(string.IsNullOrWhiteSpace(parameter.Description) ? "" : ": " + parameter.Description)</li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                }
                            }
                            else if (input.UIHint == PipelineInputHints.SiteTablePicker && _siteTables is not null)
                            {
                                @* n8n's Data tables: one of the site's tables by name, its columns said beneath; one no longer on
                                   the site stays named, so a save keeps it. *@
                                var chosenTable = Value(_selected.Inputs, name);
                                var pickedTable = _siteTables.FirstOrDefault(table => string.Equals(table.Name, chosenTable, StringComparison.OrdinalIgnoreCase));
                                <select id="@("pipelines-editor-input-" + name)" class="db-input" value="@(pickedTable?.Name ?? chosenTable)" @onchange="e => SetInput(name, e.Value?.ToString())" disabled="@(!CanManage)">
                                    <option value="">(choose a data table)</option>
                                    @foreach (var table in _siteTables)
                                    {
                                        <option value="@table.Name">@table.Name</option>
                                    }
                                    @if (!string.IsNullOrEmpty(chosenTable) && pickedTable is null)
                                    {
                                        <option value="@chosenTable">(not on this site: @chosenTable)</option>
                                    }
                                </select>
                                @if (pickedTable is not null)
                                {
                                    <p id="@("pipelines-editor-table-columns-" + name)" style="color:var(--db-text-2);margin:0;">Columns: @string.Join(", ", pickedTable.Columns.Select(column => column.Name + " (" + PipelineSiteTables.Label(column.Type) + ")")), and every row's id, createdAt and updatedAt.</p>
                                }
                                else if (_siteTables.Count == 0)
                                {
                                    <p style="color:var(--db-text-2);margin:0;">This site has no data tables yet - make one on the pipelines list, under Data tables.</p>
                                }
                            }
                            else if (input.UIHint == "pipeline-definition-picker" && _otherPipelines is not null)
                            {
                                @* The engine's pipeline picker (Execute, Dispatch and Bulk dispatch pipeline): the site's other pipelines by
                                   name, the value their definition id. One no longer on the site stays named, so a save keeps it. *@
                                var chosen = Value(_selected.Inputs, name);
                                <select id="@("pipelines-editor-input-" + name)" class="db-input" value="@chosen" @onchange="e => SetInput(name, e.Value?.ToString())" disabled="@(!CanManage)">
                                    <option value="">@(_selected.Type == PipelineFailure.StepType ? "(every pipeline on the site)" : "(choose a pipeline)")</option>
                                    @foreach (var other in _otherPipelines)
                                    {
                                        <option value="@other.DefinitionId">@other.Name</option>
                                    }
                                    @if (!string.IsNullOrEmpty(chosen) && _otherPipelines.All(other => other.DefinitionId != chosen))
                                    {
                                        <option value="@chosen">(not on this site: @chosen)</option>
                                    }
                                </select>
                                @if (!string.IsNullOrEmpty(chosen) && _otherPipelines.FirstOrDefault(other => other.DefinitionId == chosen) is { } calledPipeline)
                                {
                                    @* n8n's "open sub-workflow": the pipeline chosen, in its own editor. *@
                                    <div><a id="@("pipelines-editor-open-called-" + name)" href="@NavigateUrl(ModuleState.ModuleId, "Editor", "definition=" + Uri.EscapeDataString(chosen))">Open '@calledPipeline.Name'</a></div>
                                }
                                @if (PipelineCallContracts.IsCall(_selected.Type) && !string.IsNullOrEmpty(chosen) && CalledFields(chosen) is { Count: > 0 } expects)
                                {
                                    @* What the chosen pipeline's "When called by another pipeline" expects - and its fields as Input's template. *@
                                    <p id="pipelines-editor-called-fields" style="margin:0;color:var(--db-text-2);">It expects: @PipelineFields.Describe(expects)</p>
                                    <div><button id="pipelines-editor-called-template" type="button" class="db-btn" title="Write the fields it expects into Input, each with an empty value of its kind" @onclick="@(() => SetInput("Input", PipelineFields.Template(expects)))" disabled="@(!CanManage)">Fill Input with its fields</button></div>
                                }
                            }
                            else if (input.UIHint == PipelineInputHints.RecordCondition)
                            {
                                @* Rules tested on each record (Filter records, n8n's Filter) - an If's rules, {{ field }} reading the
                                   record's field - held as the input's value, and previewed on the records the step had in the run shown. *@
                                <ConditionEditor IdPrefix="@("pipelines-editor-record-condition-" + name)" Label="@input.DisplayName" Condition="RecordConditionOf(name)" Disabled="@(!CanManage)"
                                                 Changed="() => RecordConditionChanged(name)" Preview="RecordConditionPreview" />
                            }
                            else if (input.UIHint == PipelineInputHints.AgentTools)
                            {
                                @* BL-229, the AI agent: the tools it may call, one name per line; the site's published tools offered to add. *@
                                var named = AgentToolsOf(Value(_selected.Inputs, name));
                                <textarea id="@("pipelines-editor-input-" + name)" class="db-input" rows="3" placeholder="(every tool on this site)" value="@Value(_selected.Inputs, name)" @oninput="e => SetInput(name, e.Value?.ToString())" disabled="@(!CanManage)"></textarea>
                                @if (_agentTools is { Count: > 0 })
                                {
                                    <div id="pipelines-editor-agent-tools" class="db-pipeline-editor__agent-tools">
                                        <span style="color:var(--db-text-2);">Tools on this site:</span>
                                        @foreach (var tool in _agentTools)
                                        {
                                            var listed = named.Contains(tool.Name, StringComparer.OrdinalIgnoreCase);
                                            <button type="button" class="db-btn" title="@(tool.Description + (string.IsNullOrEmpty(tool.PipelineName) ? "" : " - runs '" + tool.PipelineName + "'"))" disabled="@(listed || !CanManage)" @onclick="() => AddAgentTool(name, tool.Name)">@(listed ? "✓ " : "+ ")@tool.Name</button>
                                        }
                                    </div>
                                }
                                else if (_agentTools is not null)
                                {
                                    <p id="pipelines-editor-agent-tools-none" style="color:var(--db-text-2);margin:0;">No AI agent tool is published on this site yet: a published pipeline that starts with "AI agent tool" is one.</p>
                                }
                            }
                            else if (input.UIHint == PipelineInputHints.FormFields)
                            {
                                @* BL-229, the Form trigger: the form's fields, held as the input's value. *@
                                <FormFieldsEditor IdPrefix="@("pipelines-editor-form-fields-" + name)" Fields="FormFieldsOf(name)" Disabled="@(!CanManage)" Changed="() => FormFieldsChanged(name)" />
                            }
                            else if (input.UIHint is "code-editor" or PipelineInputHints.SqlQuery)
                            {
                                @* Code and SQL as written, line by line, in a fixed-width box - a one-line box cut a script or a statement
                                   to its first line. *@
                                @* And edited like code (pipelines-editor.js, stommeCodeBox): Tab indents, Shift+Tab takes it back,
                                   Enter keeps the indentation, Escape then Tab leaves the box; where the caret is shown under it. *@
                                @* Its code coloured (pipelines-editor.js fills the copy behind the box; until it does, the box shows its text). *@
                                <div class="db-pipeline-editor__code-wrap" data-code-language="@(input.UIHint == PipelineInputHints.SqlQuery ? "sql" : "javascript")">
                                    <pre class="db-pipeline-editor__code-shade" aria-hidden="true"></pre>
                                    <textarea id="@("pipelines-editor-input-" + name)" class="db-input db-pipeline-editor__expression db-pipeline-editor__code" rows="6" spellcheck="false"
                                              placeholder="@(input.UIHint == PipelineInputHints.SqlQuery ? "e.g. SELECT * FROM orders WHERE id = @id" : null)"
                                              aria-describedby="@("pipelines-editor-input-" + name + "-keys")"
                                              data-code-names="@(input.UIHint == "code-editor" ? CodeNames(_selected, name) : null)"
                                              value="@Value(_selected.Inputs, name)" @oninput="e => SetInput(name, e.Value?.ToString())" disabled="@(!CanManage)"></textarea>
                                </div>
                                <div class="db-pipeline-editor__code-status">
                                    <span id="@("pipelines-editor-input-" + name + "-position")" aria-live="off"></span>
                                    <span id="@("pipelines-editor-input-" + name + "-keys")">@(input.UIHint == "code-editor" ? "Tab indents · Ctrl+Space completes · Esc then Tab leaves the box" : "Tab indents · Esc then Tab leaves the box")</span>
                                </div>
                                @if (input.UIHint == "code-editor" && AiOffered && _capabilities?.Scripts == true)
                                {
                                    @* n8n's "Ask AI" in its Code node: the site's model writes the script, or changes it, told what the
                                       script can see - what it receives, as field names and kinds, and its variables' names - and never a value;
                                       the script comes back as one change Undo takes back. What it is told is said under the button. *@
                                    var hasScript = !string.IsNullOrWhiteSpace(Value(_selected.Inputs, name));
                                    var ownAsk = _scriptAiStep == _selected.StepId;
                                    <div class="db-pipeline-editor__script-ai">
                                        <label for="pipelines-editor-script-ai-ask">@(hasScript ? "Ask AI to change it" : "Ask AI to write it")</label>
                                        <textarea id="pipelines-editor-script-ai-ask" class="db-input" rows="2" placeholder="e.g. Keep the orders over 100 and add up their totals"
                                                  value="@(ownAsk ? _scriptAsk : "")" @oninput="e => { _scriptAiStep = _selected.StepId; _scriptAsk = e.Value?.ToString() ?? string.Empty; }" disabled="@_scriptWriting"></textarea>
                                        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;">
                                            <button id="pipelines-editor-script-ai-write" type="button" class="db-btn" disabled="@(_scriptWriting || !ownAsk || string.IsNullOrWhiteSpace(_scriptAsk))" @onclick="() => WriteScriptWithAiAsync(name)">@(_scriptWriting ? "Writing…" : hasScript ? "Change it" : "Write it")</button>
                                            <span id="pipelines-editor-script-ai-told" class="db-pipeline-editor__script-ai-told">@ScriptAiTold(ScriptRequestFor(_selected, name))</span>
                                        </div>
                                        @if (ownAsk && !string.IsNullOrEmpty(_scriptAiError))
                                        {
                                            <p id="pipelines-editor-script-ai-error" class="db-pipeline-editor__input-problem is-error" role="alert">@_scriptAiError</p>
                                        }
                                        @if (ownAsk && !string.IsNullOrEmpty(_scriptAiProblem) && _scriptAiProblemFor == Value(_selected.Inputs, name))
                                        {
                                            <p id="pipelines-editor-script-ai-problem" class="db-pipeline-editor__input-problem is-warning">@_scriptAiProblem</p>
                                        }
                                    </div>
                                }
                            }
                            else if (input.UIHint == "multiline")
                            {
                                <textarea id="@("pipelines-editor-input-" + name)" class="db-input" rows="4" value="@Value(_selected.Inputs, name)" @oninput="e => SetInput(name, e.Value?.ToString())" disabled="@(!CanManage)"></textarea>
                            }
                            else if (input.Options != null && input.Options.Count > 0)
                            {
                                <select id="@("pipelines-editor-input-" + name)" class="db-input" value="@Value(_selected.Inputs, name)" @onchange="e => SetInput(name, e.Value?.ToString())" disabled="@(!CanManage)">
                                    <option value="">@(string.IsNullOrEmpty(input.DefaultValue) ? "(default)" : "(default: " + input.DefaultValue + ")")</option>
                                    @foreach (var option in input.Options)
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input id="@("pipelines-editor-input-" + name)" type="@(input.IsSensitive ? "password" : IsNumber(input) ? "number" : "text")" step="@(IsWholeNumber(input) ? "1" : "any")" class="db-input" value="@Value(_selected.Inputs, name)" placeholder="@input.DefaultValue" @oninput="e => SetInput(name, e.Value?.ToString())" disabled="@(!CanManage)" />
                            }
                            @if (input.UIHint == PipelineInputHints.PipelineFile && CanManage && _viewingVersion is null
                                && readsVariable is null && expression is null && condition is null && script is null)
                            {
                                @* A file step's path chosen from the site's pipeline folder (the Files page's), as a plain value. *@
                                <PipelineFilePicker IdPrefix="@("pipelines-editor-files-" + name)" Current="@Value(_selected.Inputs, name)" FilesUrl="@NavigateUrl(ModuleState.ModuleId, "Files")"
                                                    Chosen="path => SetInput(name, path)" />
                            }
                            @foreach (var problem in selectedProblems.Where(problem => problem.Input == name))
                            {
                                <div id="@("pipelines-editor-input-problem-" + name)" class="db-pipeline-editor__input-problem @(problem.Severity == PipelineGraphProblems.Error ? "is-error" : "is-warning")">@problem.Message</div>
                                @if (problem.Code == PipelineGraphProblems.PlaceholderInValue && CanManage)
                                {
                                    @* What was typed becomes the expression's text, so nothing is lost (SetInputSource). *@
                                    <button id="@("pipelines-editor-make-expression-" + name)" type="button" class="db-btn" @onclick="() => SetInputSource(name, ExpressionSource)">Make it an expression</button>
                                }
                            }
                        }

                        @if (_selected.Entry.Outputs.Count > 0 && _variables.Count > 0)
                        {
                            <h5 style="margin:0.75rem 0 0;">Outputs</h5>
                            @foreach (var output in _selected.Entry.Outputs)
                            {
                                var outputName = output.Name;
                                <label for="@("pipelines-editor-output-" + outputName)">Save @output.DisplayName to</label>
                                <select id="@("pipelines-editor-output-" + outputName)" class="db-input" value="@(_selected.OutputVariables.TryGetValue(outputName, out var savesTo) ? savesTo : "")" @onchange="e => SetOutputVariable(outputName, e.Value?.ToString())" disabled="@(!CanManage)">
                                    <option value="">(not saved)</option>
                                    @foreach (var variable in _variables)
                                    {
                                        <option value="@variable.Id">the variable '@variable.Name'</option>
                                    }
                                </select>
                            }
                        }
                        else if (_selected.Entry.Outputs.Count > 0)
                        {
                            <p style="color:var(--db-text-2);margin-top:0.75rem;">This step has outputs (@string.Join(", ", _selected.Entry.Outputs.Select(output => output.DisplayName))). Add a variable - select nothing on the canvas - to save one for a later step.</p>
                        }

                        @* A trigger's own panel - where a webhook is called and how a call is signed (and an
                           author can listen for one), a schedule's next runs. Read off the rules the receiver and the schedules apply. *@
                        @if (_selected.Type == ChatStepType)
                        {
                            @* BL-229, the Chat trigger: where visitors talk to it, whether the site serves chats, and a message to test with. *@
                            <h5 style="margin:0.75rem 0 0;">Talking to it</h5>
                            <div id="pipelines-editor-trigger" class="db-pipeline-editor__trigger">
                                @if (TriggerValue(_selected) is null)
                                {
                                    <p>Its name comes from a variable or an expression, so its address is known only when it runs.</p>
                                }
                                else if (_triggerInfo is null || _triggerKey != TriggerKey(_selected))
                                {
                                    <p>Loading…</p>
                                }
                                else if (!string.IsNullOrEmpty(_triggerInfo.Error))
                                {
                                    <p id="pipelines-editor-trigger-error" class="db-pipeline-editor__input-problem is-error">@_triggerInfo.Error</p>
                                }
                                else
                                {
                                    <p>Once it is published, the site's visitors talk to it here - no sign-in: <a id="pipelines-editor-chat-url" href="@WebhookUrl(_triggerInfo)" target="_blank" rel="noopener noreferrer">@WebhookUrl(_triggerInfo)</a></p>
                                    @if (!_triggerInfo.Enabled)
                                    {
                                        <p id="pipelines-editor-chat-off" class="db-pipeline-editor__input-problem is-warning">The site does not serve chats: Pipelines:Chats:Enabled is off.</p>
                                    }
                                }
                                <p id="pipelines-editor-chat-note" style="color:var(--db-text-2);">Each message runs the pipeline: the message is this step's result, and the reply is the result of the last step the run completes. Its Session is the visitor's conversation - give it to an AI agent as its memory key and the agent remembers it.</p>
                                @if (_selected.OutputVariables.TryGetValue("Result", out var chatVariable) && _variables.FirstOrDefault(variable => variable.Id == chatVariable) is { } holdsMessage)
                                {
                                    <button id="pipelines-editor-chat-use" type="button" class="db-btn" title="Test the next steps with a message a visitor might send" @onclick="() => UseSampleMessage(holdsMessage.Name)">Use a sample message for testing ('@holdsMessage.Name')</button>
                                }
                            </div>
                        }
                        else if (_selected.Type == AgentToolStepType)
                        {
                            @* BL-229, the AI agent: who calls this tool, with what, and what goes back. *@
                            var toolName = Value(_selected.Inputs, "ToolName");
                            <h5 style="margin:0.75rem 0 0;">When it runs</h5>
                            <div id="pipelines-editor-trigger" class="db-pipeline-editor__trigger">
                                <p id="pipelines-editor-agent-tool-note">Once it is published, an AI agent step on this site may call it@(string.IsNullOrWhiteSpace(toolName) ? "" : $" as '{toolName.Trim()}'") - when the model decides to, from its description. What the model gives it is this step's result; the result of the last step its run completes is the tool's answer.</p>
                            </div>
                        }
                        else if (_selected.Type == PipelineForms.StepType)
                        {
                            @* BL-229, the Form trigger: where people fill it in, whether the site serves forms, and a sample to test with. *@
                            <h5 style="margin:0.75rem 0 0;">Filling it in</h5>
                            <div id="pipelines-editor-trigger" class="db-pipeline-editor__trigger">
                                @if (TriggerValue(_selected) is null)
                                {
                                    <p>Its name comes from a variable or an expression, so its address is known only when it runs.</p>
                                }
                                else if (_triggerInfo is null || _triggerKey != TriggerKey(_selected))
                                {
                                    <p>Loading…</p>
                                }
                                else if (!string.IsNullOrEmpty(_triggerInfo.Error))
                                {
                                    <p id="pipelines-editor-trigger-error" class="db-pipeline-editor__input-problem is-error">@_triggerInfo.Error</p>
                                }
                                else
                                {
                                    <p>Once it is published, anyone with its address fills it in - no sign-in: <a id="pipelines-editor-form-url" href="@WebhookUrl(_triggerInfo)" target="_blank" rel="noopener noreferrer">@WebhookUrl(_triggerInfo)</a></p>
                                    @if (!_triggerInfo.Enabled)
                                    {
                                        <p id="pipelines-editor-form-off" class="db-pipeline-editor__input-problem is-warning">The site does not serve forms: Pipelines:Forms:Enabled is off.</p>
                                    }
                                }
                                @{
                                    var holdsAnswers = _selected.OutputVariables.TryGetValue("Result", out var answersVariable) ? _variables.FirstOrDefault(variable => variable.Id == answersVariable) : null;
                                    var firstKey = FormFieldsOf("Fields").Select(PipelineForms.KeyOf).FirstOrDefault() ?? "email";
                                }
                                <p id="pipelines-editor-form-result" style="color:var(--db-text-2);">Its result is the answers - one value per field, under the name each field is kept as - read with an expression, e.g. <code>{{ @(holdsAnswers?.Name ?? "answers").@firstKey }}</code>.</p>
                                @if (holdsAnswers is not null)
                                {
                                    <button id="pipelines-editor-form-use" type="button" class="db-btn" title="Test the next steps with made-up answers to this form" @onclick="() => UseSampleSubmission(holdsAnswers.Name)">Use a sample submission for testing ('@holdsAnswers.Name')</button>
                                }
                                else
                                {
                                    <p style="color:var(--db-text-2);">Save its Result to a variable to test the next steps with a sample submission.</p>
                                }
                            </div>
                        }
                        else if (_selected.Type is WebhookStepType or ScheduleStepType)
                        {
                            var webhook = _selected.Type == WebhookStepType;
                            <h5 style="margin:0.75rem 0 0;">@(webhook ? "Calling it" : "When it runs")</h5>
                            <div id="pipelines-editor-trigger" class="db-pipeline-editor__trigger">
                                @if (TriggerValue(_selected) is null)
                                {
                                    <p>@(webhook ? "Its name comes from a variable or an expression, so its address is known only when it runs." : "Its schedule comes from a variable or an expression, so its runs are known only when it runs.")</p>
                                }
                                else if (_triggerInfo is null || _triggerKey != TriggerKey(_selected))
                                {
                                    <p>Loading…</p>
                                }
                                else if (!string.IsNullOrEmpty(_triggerInfo.Error))
                                {
                                    <p id="pipelines-editor-trigger-error" class="db-pipeline-editor__input-problem is-error">@_triggerInfo.Error</p>
                                }
                                else if (webhook)
                                {
                                    <p>POST to <code id="pipelines-editor-webhook-url">@WebhookUrl(_triggerInfo)</code></p>
                                    <p>Sign each call: <code>@_triggerInfo.SignatureHeader: sha256=&lt;HMAC-SHA256 of the body&gt;</code> under <span id="pipelines-editor-webhook-signed-with">@(_triggerInfo.OwnSecret || _triggerInfo.OwnSecretUnreadable ? "its own secret" : "the site's webhook secret")</span>.@(_triggerInfo.Allowlisted ? " Only the callers its allowlist names are admitted." : "")</p>
                                    @if (!_triggerInfo.Enabled)
                                    {
                                        <p id="pipelines-editor-webhook-off" class="db-pipeline-editor__input-problem is-warning">The site does not receive webhooks: Pipelines:Webhooks:Enabled is off.</p>
                                    }
                                    else if (_triggerInfo.OwnSecretUnreadable)
                                    {
                                        <p id="pipelines-editor-webhook-secret-unreadable" class="db-pipeline-editor__input-problem is-error">Its own secret cannot be read - the host's key ring changed - so every call is refused. Make a new one and give it to its callers.</p>
                                    }
                                    else if (!_triggerInfo.Signed)
                                    {
                                        <p id="pipelines-editor-webhook-unsigned" class="db-pipeline-editor__input-problem is-warning">@(_triggerInfo.SecretFromFile
                                            ? "The webhook secret is to come from a file (Pipelines:Webhooks:SecretFile), and that file is missing, unreadable or empty - so every call is refused. The host's log says which."
                                            : "No webhook secret is configured (Pipelines:Webhooks:Secret or SecretFile), so every call is refused.")@(CanManage ? " Or give it a secret of its own." : "")</p>
                                    }
                                    else if (CanManage)
                                    {
                                        <button id="pipelines-editor-webhook-listen" type="button" class="db-btn" title="Wait up to a minute for the next signed call, and show what it sent" @onclick="ListenForWebhookAsync" disabled="@_listening">@(_listening ? "Listening… call it now" : "Listen for a call")</button>
                                    }
                                    @* A secret of its own - in the site's secret store, shown once when made; its callers then sign with it alone. *@
                                    @if (_triggerInfo.Enabled && CanManage)
                                    {
                                        @if (_webhookSecret is not null && _webhookSecret.Name == WebhookSecretName())
                                        {
                                            <div id="pipelines-editor-webhook-secret-new" class="db-pipeline-editor__webhook-secret" role="status">
                                                <p>Its new secret - shown this once; give it to its callers now. The site keeps it protected and never shows it again.</p>
                                                <input id="pipelines-editor-webhook-secret-value" type="text" class="db-input" readonly value="@_webhookSecret.Secret" aria-label="The webhook's new secret" />
                                                <button id="pipelines-editor-webhook-secret-copy" type="button" class="db-btn" title="Copy the secret" @onclick="CopyWebhookSecretAsync">@(_webhookSecretCopied ? "Copied" : "Copy")</button>
                                                <button id="pipelines-editor-webhook-secret-hide" type="button" class="db-btn db-btn-neutral" title="Hide it - it is not shown again" @onclick="HideWebhookSecret">Done</button>
                                            </div>
                                        }
                                        @if (_triggerInfo.OwnSecret || _triggerInfo.OwnSecretUnreadable)
                                        {
                                            <div class="db-pipeline-editor__webhook-secret-actions">
                                                <ActionDialog Id="pipelines-editor-webhook-secret-renew" Header="Make a new secret" Action="Make a new secret" Security="SecurityAccessLevel.Anonymous"
                                                              Message="Make a new secret for this webhook? Calls signed with its present one are refused from now on, until its callers have the new one."
                                                              Class="db-btn pipelines-editor-webhook-secret-renew" ConfirmClass="db-btn pipelines-editor-webhook-secret-renew-confirm" CancelClass="db-btn db-btn-neutral"
                                                              OnClick="@(async () => { await RenewWebhookSecretAsync(); StateHasChanged(); })" Disabled="@_webhookSecretBusy" />
                                                <ActionDialog Id="pipelines-editor-webhook-secret-remove" Header="Remove its own secret" Action="Remove" Text="Remove its own secret" Security="SecurityAccessLevel.Anonymous"
                                                              Message="Remove this webhook's own secret? Its calls are then verified under the site's webhook secret, and those signed with its own are refused."
                                                              Class="db-btn pipelines-editor-webhook-secret-remove" ConfirmClass="db-btn pipelines-editor-webhook-secret-remove-confirm" CancelClass="db-btn db-btn-neutral"
                                                              OnClick="@(async () => { await RemoveWebhookSecretAsync(); StateHasChanged(); })" Disabled="@_webhookSecretBusy" />
                                            </div>
                                        }
                                        else
                                        {
                                            <button id="pipelines-editor-webhook-secret-make" type="button" class="db-btn" title="A secret for this webhook alone: its callers sign with it, and the site's webhook secret no longer opens it" @onclick="RenewWebhookSecretAsync" disabled="@_webhookSecretBusy">Give it its own secret</button>
                                        }
                                        @if (!string.IsNullOrEmpty(_webhookSecretError))
                                        {
                                            <p id="pipelines-editor-webhook-secret-error" class="db-pipeline-editor__input-problem is-error">@_webhookSecretError</p>
                                        }
                                    }
                                    @if (_webhookCall is not null)
                                    {
                                        @if (!string.IsNullOrEmpty(_webhookCall.Error))
                                        {
                                            <p id="pipelines-editor-webhook-call-error" class="db-pipeline-editor__input-problem is-error">@_webhookCall.Error</p>
                                        }
                                        else if (!_webhookCall.Received)
                                        {
                                            <p id="pipelines-editor-webhook-call-none">No call came within a minute.</p>
                                        }
                                        else
                                        {
                                            <p id="pipelines-editor-webhook-call-head">Received @_webhookCall.ReceivedAtUtc.ToString("HH:mm:ss") UTC@(string.IsNullOrEmpty(_webhookCall.ContentType) ? "" : " · " + _webhookCall.ContentType)@(_webhookCall.Truncated ? " · the first 64 KB" : "")</p>
                                            <pre id="pipelines-editor-webhook-call" class="db-pipeline-editor__data">@_webhookCall.Body</pre>
                                            @if (_selected.OutputVariables.TryGetValue("Result", out var payloadVariable) && _variables.FirstOrDefault(variable => variable.Id == payloadVariable) is { } holds)
                                            {
                                                <button id="pipelines-editor-webhook-use" type="button" class="db-btn" title="Test the next steps with what this call sent" @onclick="() => UseWebhookCall(holds.Name)">Use for testing ('@holds.Name')</button>
                                            }
                                            else
                                            {
                                                <p style="color:var(--db-text-2);">Save its Result to a variable to test the next steps with what this call sent.</p>
                                            }
                                        }
                                    }
                                }
                                else
                                {
                                    <ol id="pipelines-editor-schedule-runs" class="db-pipeline-editor__runs">
                                        @for (var index = 0; index < _triggerInfo.NextRunsUtc.Count; index++)
                                        {
                                            var utc = _triggerInfo.NextRunsUtc[index];
                                            @if (!string.IsNullOrEmpty(_triggerInfo.TimeZone) && index < _triggerInfo.NextRunsInZone.Count)
                                            {
                                                <li>@_triggerInfo.NextRunsInZone[index].ToString("ddd yyyy-MM-dd HH:mm") @_triggerInfo.TimeZone · @utc.ToString("HH:mm") UTC</li>
                                            }
                                            else
                                            {
                                                <li>@utc.ToString("ddd yyyy-MM-dd HH:mm") UTC</li>
                                            }
                                        }
                                    </ol>
                                    <p style="color:var(--db-text-2);">Once it is published; the site's schedules are checked every @(_triggerInfo.CheckedEverySeconds == 60 ? "minute" : _triggerInfo.CheckedEverySeconds + " seconds").</p>
                                    @if (!_triggerInfo.Enabled)
                                    {
                                        <p id="pipelines-editor-schedule-off" class="db-pipeline-editor__input-problem is-warning">The site's schedules are switched off: Pipelines:Schedules:Enabled is off.</p>
                                    }
                                }
                            </div>
                        }
                        else if (_selected.Type == PipelineFailure.StepType)
                        {
                            @* n8n's error workflow - which runs start this one, and a failure to test the next steps with. *@
                            var watched = Value(_selected.Inputs, "Pipeline");
                            var watchedName = string.IsNullOrEmpty(watched) ? null : _otherPipelines?.FirstOrDefault(other => other.DefinitionId == watched)?.Name ?? watched;
                            <h5 style="margin:0.75rem 0 0;">When it runs</h5>
                            <div id="pipelines-editor-trigger" class="db-pipeline-editor__trigger">
                                <p id="pipelines-editor-failure-watch">@(watchedName is null
                                    ? "When a run of any pipeline on this site fails - except a pipeline that starts this way, so a failure handler that fails starts nothing."
                                    : $"When a run of '{watchedName}' fails.") Once it is published.</p>
                                <p style="color:var(--db-text-2);">Its result is the failure: <code>pipeline</code>, <code>run</code>, <code>step</code>, <code>error</code> and <code>failedAt</code> - read with an expression, e.g. <code>{{ failure.error }}</code>.</p>
                                @if (_selected.OutputVariables.TryGetValue("Result", out var failureVariable) && _variables.FirstOrDefault(variable => variable.Id == failureVariable) is { } holdsFailure)
                                {
                                    <button id="pipelines-editor-failure-use" type="button" class="db-btn" title="Test the next steps with a made-up failure" @onclick="() => UseSampleFailure(holdsFailure.Name, watchedName)">Use a sample failure for testing ('@holdsFailure.Name')</button>
                                }
                                else
                                {
                                    <p style="color:var(--db-text-2);">Save its Result to a variable to test the next steps with a sample failure.</p>
                                }
                            </div>
                        }
                        else if (_selected.Type == PipelineFileEvent.StepType)
                        {
                            @* n8n's Local File Trigger - which files start this one, the folder on the Files page, and a file to test with. *@
                            var watchedFolder = PipelineFilePaths.Normalize(Value(_selected.Inputs, "Folder") ?? "");
                            var patterns = PipelineFileEvent.NormalizePattern(Value(_selected.Inputs, "Pattern"));
                            var deeper = IsTrue(_selected.Inputs, "Subfolders");
                            var changedToo = IsTrue(_selected.Inputs, "Changed");
                            <h5 style="margin:0.75rem 0 0;">When it runs</h5>
                            <div id="pipelines-editor-trigger" class="db-pipeline-editor__trigger">
                                <p id="pipelines-editor-file-watch">When a file@(patterns.Length == 0 ? "" : " named " + patterns) is put in @(watchedFolder.Length == 0 ? "the site's pipeline folder" : "'" + watchedFolder + "'")@(deeper ? " or a folder inside it" : "")@(changedToo ? ", or one there is written again" : "") - one run a file. Once it is published: files already there then start nothing.</p>
                                <p style="color:var(--db-text-2);">Its result is the file: <code>path</code> - for a file step to read - <code>name</code>, <code>folder</code>, <code>size</code>, <code>modifiedAt</code> and <code>event</code> (<code>add</code> or <code>change</code>), read with an expression, e.g. <code>{{ file.path }}</code>. A pipeline that writes into the folder it watches starts itself again - write somewhere else.</p>
                                <a id="pipelines-editor-file-folder" href="@NavigateUrl(ModuleState.ModuleId, "Files", watchedFolder.Length == 0 ? "" : "folder=" + Uri.EscapeDataString(watchedFolder))">Open the folder in Files</a>
                                @if (_selected.OutputVariables.TryGetValue("Result", out var fileVariable) && _variables.FirstOrDefault(variable => variable.Id == fileVariable) is { } holdsFile)
                                {
                                    <button id="pipelines-editor-file-use" type="button" class="db-btn" title="Test the next steps with a made-up file" @onclick="() => UseSampleFile(holdsFile.Name, watchedFolder, patterns)">Use a sample file for testing ('@holdsFile.Name')</button>
                                    @* n8n's "Fetch test event": the newest file the trigger would take that is there now. *@
                                    <button id="pipelines-editor-file-newest" type="button" class="db-btn" disabled="@_fetchingTestEvent" title="Test the next steps with the newest file in the folder its names take"
                                            @onclick="() => UseNewestFileAsync(holdsFile.Name, watchedFolder, patterns)">Use the newest file there for testing</button>
                                }
                                else
                                {
                                    <p style="color:var(--db-text-2);">Save its Result to a variable to test the next steps with a sample file.</p>
                                }
                            </div>
                        }
                        else if (_selected.Type == PipelineTelegramEvent.StepType)
                        {
                            @* n8n's Telegram Trigger - which messages start this one, how it gets them, and a message to test with. *@
                            <h5 style="margin:0.75rem 0 0;">When it runs</h5>
                            <div id="pipelines-editor-trigger" class="db-pipeline-editor__trigger">
                                <p id="pipelines-editor-telegram-watch">When the bot of the connection chosen gets a message - in a chat with it, in a group it is in, or a post in a channel it runs - one run a message. The bot is asked for its messages every few seconds, so it needs no address the internet can reach; a bot with a webhook set (n8n's trigger sets one) gets none here until the webhook is deleted. Once it is published: messages already waiting start nothing. Every pipeline on one bot gets each message: Telegram hands a message once.</p>
                                <p style="color:var(--db-text-2);">Its result is the message: <code>text</code>, <code>chat.id</code>, <code>chat.type</code>, <code>from.username</code>, <code>from.firstName</code>, <code>messageId</code> and <code>date</code> - answer it with Send chat message to <code>{{ message.chat.id }}</code>, in reply to <code>{{ message.messageId }}</code>. The bot's token stays in the connection.</p>
                                @if (_selected.OutputVariables.TryGetValue("Result", out var telegramVariable) && _variables.FirstOrDefault(variable => variable.Id == telegramVariable) is { } holdsTelegram)
                                {
                                    <button id="pipelines-editor-telegram-use" type="button" class="db-btn" title="Test the next steps with a made-up message" @onclick="() => UseSampleTelegram(holdsTelegram.Name)">Use a sample message for testing ('@holdsTelegram.Name')</button>
                                }
                                else
                                {
                                    <p style="color:var(--db-text-2);">Save its Result to a variable to test the next steps with a sample message.</p>
                                }
                            </div>
                        }
                        else if (_selected.Type == PipelineEmailEvent.StepType)
                        {
                            @* n8n's Email Trigger (IMAP) - which messages start this one, what it does with them, and a message to test with. *@
                            var watchedMailbox = string.IsNullOrWhiteSpace(Value(_selected.Inputs, "Mailbox")) ? PipelineEmailEvent.Inbox : Value(_selected.Inputs, "Mailbox").Trim();
                            var marksRead = IsTrue(_selected.Inputs, "MarkRead");
                            var keepsAttachments = IsTrue(_selected.Inputs, "KeepAttachments");
                            var emailConnection = Value(_selected.Inputs, "Connection");
                            <h5 style="margin:0.75rem 0 0;">When it runs</h5>
                            <div id="pipelines-editor-trigger" class="db-pipeline-editor__trigger">
                                <p id="pipelines-editor-email-watch">When a message arrives in '@watchedMailbox' of the connection chosen - one run a message, followed by its UID, so one a person read first still starts its run@(marksRead ? "; each is then marked read" : "")@(keepsAttachments ? "; its attachments are kept in the pipeline folder, under mail/" : ""). Once it is published: messages already there then start nothing.</p>
                                <p style="color:var(--db-text-2);">Its result is the message: <code>subject</code>, <code>from</code>, <code>to</code>, <code>cc</code>, <code>date</code>, <code>text</code>, <code>html</code> and <code>attachments</code> - each its <code>name</code>, <code>size</code>@(keepsAttachments ? " and the path a file step reads" : "") - read with an expression, e.g. <code>{{ email.subject }}</code>. The account's password stays in the connection.</p>
                                @if (_selected.OutputVariables.TryGetValue("Result", out var emailVariable) && _variables.FirstOrDefault(variable => variable.Id == emailVariable) is { } holdsEmail)
                                {
                                    <button id="pipelines-editor-email-use" type="button" class="db-btn" title="Test the next steps with a made-up message" @onclick="() => UseSampleEmail(holdsEmail.Name, watchedMailbox, keepsAttachments)">Use a sample message for testing ('@holdsEmail.Name')</button>
                                    @if (CanManage && Guid.TryParse(emailConnection, out _))
                                    {
                                        @* n8n's "Fetch test event": real mail, read through the connection - nothing marked, nothing kept. *@
                                        <button id="pipelines-editor-email-fetch" type="button" class="db-btn" disabled="@_fetchingTestEvent" title="Read the newest message in the mailbox through the connection - nothing is marked read or kept"
                                                @onclick="() => FetchNewestEmailAsync(holdsEmail.Name, emailConnection, watchedMailbox)">Fetch the newest message for testing</button>
                                    }
                                }
                                else
                                {
                                    <p style="color:var(--db-text-2);">Save its Result to a variable to test the next steps with a sample message.</p>
                                }
                            </div>
                        }

                        @* A step that holds others - a loop's Body, an If's Then and Else. Each body is a flowchart of its own,
                           opened on the canvas; its steps run inside this one. *@
                        @if (_selected.Entry.Bodies is { Count: > 0 })
                        {
                            <h5 style="margin:0.75rem 0 0;">Holds</h5>
                            <p style="color:var(--db-text-2);">The steps in a body run inside this step: a loop runs its body once per value, an If runs the branch its condition names.</p>
                            @foreach (var body in _selected.Entry.Bodies)
                            {
                                var port = body;
                                var held = HeldCount(_selected.StepId, port);
                                <button id="@("pipelines-editor-open-" + port)" type="button" class="db-btn" style="display:block;margin-top:0.25rem;" @onclick="() => OpenBody(port)">Open @port (@(held == 1 ? "1 step" : held + " steps"))</button>
                            }
                        }
                    }
                    @* What the shown run did with this step - n8n's input and output panels (beside the settings
                       in the wide view). *@
                    @if (_shownRunId is not null && !IsWide)
                    {
                        var executions = _runSteps.Where(execution => execution.StepId == _selected.StepId).ToList();
                        <h5 style="margin:0.75rem 0 0;">In the run</h5>
                        @if (executions.Count == 0)
                        {
                            <p id="pipelines-editor-run-none" style="color:var(--db-text-2);">@(_shownRun is { IsFinished: true } ? "This step did not run." : "Not reached yet.")</p>
                        }
                        else
                        {
                            var index = Math.Clamp(_executionIndex, 0, executions.Count - 1);
                            var shown = executions[index];
                            @if (executions.Count > 1)
                            {
                                <label for="pipelines-editor-run-execution">Pass</label>
                                <select id="pipelines-editor-run-execution" class="db-input" value="@index" @onchange="e => _executionIndex = int.TryParse(e.Value?.ToString(), out var chosen) ? chosen : 0">
                                    @for (var pass = 0; pass < executions.Count; pass++)
                                    {
                                        <option value="@pass">@(pass + 1) of @executions.Count · @PipelineStepStates.StatusOf(executions[pass], _shownRun)</option>
                                    }
                                </select>
                            }
                            <p id="pipelines-editor-run-status" style="margin:0.25rem 0;">@PipelineStepStates.StatusOf(shown, _shownRun) · @Duration(shown) · started @shown.StartedAtUtc.ToString("HH:mm:ss.fff") UTC</p>
                            @if (!string.IsNullOrEmpty(shown.Error))
                            {
                                <p id="pipelines-editor-run-error" class="db-pipeline-editor__error">@shown.Error</p>
                                @* n8n's "fix with AI" on a node's error: the builder told what the step failed with. *@
                                @if (AiOffered && _viewingVersion is null)
                                {
                                    var failedStep = _selected.DisplayName;
                                    var failure = shown.Error;
                                    <button id="pipelines-editor-run-error-ai" type="button" class="db-btn" title="Ask the site's AI to change the pipeline so this step does not fail this way - marked on the canvas, Undo takes it back" @onclick="() => FixFailureWithAiAsync(failedStep, failure)" disabled="@_aiBusy">Fix with AI</button>
                                }
                            }
                            @if (shown.DataNotKept)
                            {
                                <p id="pipelines-editor-run-not-kept" style="color:var(--db-text-2);">@StepDataNotKept</p>
                            }
                            else if (shown.InputsJson is null && shown.OutputsJson is null && !CanManage)
                            {
                                <p style="color:var(--db-text-2);">What the step received and produced is shown to the pipeline's authors.</p>
                            }
                            else
                            {
                                <div>Input</div>
                                <DataView Id="pipelines-editor-run-input" Label="Input" Json="@shown.InputsJson" />
                                <div>Output</div>
                                <DataView Id="pipelines-editor-run-output" Label="Output" Json="@shown.OutputsJson" />
                                @if (CanManage && FilesOf(shown.InputsJson) is { Count: > 0 } files)
                                {
                                    @* n8n's view and download of a node's binary data: the files this pass read or wrote, in the
                                       site's pipeline folder - each to download, or to see in its folder on the Files page. *@
                                    <ul id="pipelines-editor-run-files" style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:0.125rem;">
                                        @for (var fileAt = 0; fileAt < files.Count; fileAt++)
                                        {
                                            var path = files[fileAt];
                                            <li>
                                                <a id="@("pipelines-editor-run-file-" + fileAt)" href="@FileDownloadUrl(path)" download="@PipelineFilePaths.Name(path)" title="Download it from the site's pipeline folder">@path</a>
                                                · <a id="@("pipelines-editor-run-file-folder-" + fileAt)" href="@NavigateUrl(ModuleState.ModuleId, "Files", "folder=" + Uri.EscapeDataString(PipelineFilePaths.Parent(path)))">in Files</a>
                                            </li>
                                        }
                                    </ul>
                                }
                                @if (shown.Truncated)
                                {
                                    <p style="color:var(--db-text-2);">A value was too long to show whole; it is cut.</p>
                                }
                                else if (CanManage && _viewingVersion is null && ResultOf(shown.OutputsJson) is { } produced)
                                {
                                    <button id="pipelines-editor-pin-run" type="button" class="db-btn" title="A test then hands this result on in place of running the step - n8n's pinned data" @onclick="() => SetPinned(produced)">Pin this result</button>
                                }
                            }
                            @* n8n's "Debug in editor": what the steps leading here produced in this run, pinned, so a test up to
                               here runs this step on the run's own data and calls nothing before it again. *@
                            @if (CanManage && _viewingVersion is null && RunResultsBefore(_selected) is { Count: > 0 } ledHere)
                            {
                                <button id="pipelines-editor-pin-before" type="button" class="db-btn" title="Pins what each step leading here produced in this run - a test up to here then runs this step on the run's data" @onclick="PinRunResultsBefore">Pin the results that led here (@ledHere.Count)</button>
                            }
                        }
                    }
                    @* What happens when the step fails - tried again, and whether the run goes on past it. *@
                    @if (_selected.Entry is not null)
                    {
                        <h5 style="margin:0.75rem 0 0;">When it fails</h5>
                        <label for="pipelines-editor-retries">Try again (times, up to 5)</label>
                        <input id="pipelines-editor-retries" type="number" min="0" max="5" step="1" class="db-input" value="@_selected.Retries" @oninput="e => SetReliability(e.Value?.ToString(), null, null)" disabled="@(!CanManage)" />
                        @if (_selected.Retries > 0)
                        {
                            <label for="pipelines-editor-retry-delay">Seconds between tries (up to 60)</label>
                            <input id="pipelines-editor-retry-delay" type="number" min="0" max="60" step="1" class="db-input" value="@_selected.RetryDelaySeconds" @oninput="e => SetReliability(null, e.Value?.ToString(), null)" disabled="@(!CanManage)" />
                        }
                        @* n8n's three: stop the workflow, continue, continue using the error output - here a Failed port on the step. *@
                        <label for="pipelines-editor-on-failure">If it still fails</label>
                        <select id="pipelines-editor-on-failure" class="db-input" value="@(_selected.FailedPath ? FailedPathChoice : _selected.ContinueOnError ? GoOnChoice : StopChoice)" @onchange="e => SetOnFailure(e.Value?.ToString())" disabled="@(!CanManage)">
                            <option value="@StopChoice">Stop the pipeline</option>
                            <option value="@GoOnChoice">Go on (the failure is logged)</option>
                            <option value="@FailedPathChoice">Take its Failed path</option>
                        </select>
                        @if ((_selected.FailedPath || _selected.ContinueOnError) && _variables.Count > 0)
                        {
                            <label for="pipelines-editor-failure-variable">Save the error to</label>
                            <select id="pipelines-editor-failure-variable" class="db-input" value="@(_selected.FailureVariable ?? "")" @onchange="e => SetFailureVariable(e.Value?.ToString())" disabled="@(!CanManage)">
                                <option value="">(not saved)</option>
                                @foreach (var variable in _variables)
                                {
                                    <option value="@variable.Id">the variable '@variable.Name'</option>
                                }
                            </select>
                            @if (_selected.FailureVariable is not null && _variables.FirstOrDefault(variable => variable.Id == _selected.FailureVariable) is { } savesFailure)
                            {
                                <p style="color:var(--db-text-2);margin:0;">Read it with {{ @(savesFailure.Name).error }} - the step's name is {{ @(savesFailure.Name).step }}.</p>
                            }
                        }
                    }
                    @* Test this step on its own (n8n's "execute step") with the values the variables hold - what
                       the author types here (kept for the session), else the values kept with the pipeline, the run shown's, or the
                       starting values. *@
                    @if (CanManage && IsAuthorizedPermission(PipelinesPermissions.Run) && _selected.Entry is not null)
                    {
                        <h5 style="margin:0.75rem 0 0;">Test this step</h5>
                        <p style="color:var(--db-text-2);">Runs this step on its own, for real - an HTTP request is sent, a file is written - and stores nothing.@(_variables.Count > 0 ? " The variables hold:" : "")</p>
                        @foreach (var variable in _variables.Where(variable => !string.IsNullOrWhiteSpace(variable.Name)))
                        {
                            var variableName = variable.Name;
                            <label for="@("pipelines-editor-test-value-" + variable.Id)">@variableName@(variable.TestValue is null ? "" : " (kept)")</label>
                            <input id="@("pipelines-editor-test-value-" + variable.Id)" type="text" class="db-input" value="@TestValue(variableName)" @oninput="e => _testValues[variableName] = e.Value?.ToString() ?? string.Empty" />
                        }
                        <div style="display:flex;gap:0.35rem;margin-top:0.35rem;">
                            <button id="pipelines-editor-test-step" type="button" class="db-btn" @onclick="() => TestSelectedStepAsync(false)" disabled="@(_testing || _busy)">@(_testing ? "Testing…" : "Test step")</button>
                            @if (LeadsHere(_selected))
                            {
                                @* n8n tests a step with what leads to it - every step before this one runs first, for real, storing nothing. *@
                                <button id="pipelines-editor-test-up-to-here" type="button" class="db-btn" title="Run every step that leads here first, then this one - for real, storing nothing" @onclick="() => TestSelectedStepAsync(true)" disabled="@(_testing || _busy)">Test up to here</button>
                            }
                            @if (_testValues.Count > 0)
                            {
                                <button id="pipelines-editor-test-reset" type="button" class="db-btn" title="Back to the values kept with the pipeline, else the run shown's, else the starting values" @onclick="() => _testValues.Clear()">Reset values</button>
                            }
                        </div>
                        @* n8n's pinned data - the values typed here kept WITH the pipeline (saved with it, shown to its authors only,
                           never exported), so the next session tests with them too. The run itself never reads them. *@
                        <div style="display:flex;gap:0.35rem;margin-top:0.35rem;">
                            @if (HasUnkeptTestValues())
                            {
                                <button id="pipelines-editor-test-keep" type="button" class="db-btn" title="Save these values with the pipeline, for tests only - its authors see them, a run never reads them, an export leaves them out" @onclick="KeepTestValues">Keep with the pipeline</button>
                            }
                            @if (RunValuesToKeep().Count > 0)
                            {
                                @* n8n's "Debug in editor": the run on the canvas's values kept as the test values, so the next
                                   session tests with what that run really held. *@
                                <button id="pipelines-editor-test-keep-run" type="button" class="db-btn" title="Keep what the run on the canvas left in the variables as the test values - saved with the pipeline, for tests only" @onclick="KeepRunValues">Keep the run's values</button>
                            }
                            @if (_variables.Any(variable => variable.TestValue is not null))
                            {
                                <button id="pipelines-editor-test-forget" type="button" class="db-btn" title="Stop keeping test values with the pipeline" @onclick="ForgetKeptTestValues">Forget kept values</button>
                            }
                        </div>
                        @if (_testResult is not null && _testedStepId == _selected.StepId)
                        {
                            var tested = _testResult.Steps.LastOrDefault(step => step.StepId == _selected.StepId);
                            <div id="pipelines-editor-test-result">
                                <p id="pipelines-editor-test-status" style="margin:0.25rem 0;">@(_testedUpToHere ? UpToHereSummary(_testResult, tested) : TestSummary(_testResult, tested))</p>
                                @if (_testedUpToHere)
                                {
                                    <ol id="pipelines-editor-test-steps" class="db-pipeline-editor__runs">
                                        @foreach (var ran in _testResult.Steps.Where(ran => ran.StepId != _selected.StepId))
                                        {
                                            @* A failure the pipeline went on past is "failed, and took its Failed path", not "done" (found on UAT, 10.13.0). *@
                                            <li>@(StepTitle(ran.StepId)) - @RanAs(ran)@(string.IsNullOrEmpty(ran.Error) ? "" : ": " + ran.Error)</li>
                                        }
                                    </ol>
                                }
                                @if (!string.IsNullOrEmpty(_testResult.Error))
                                {
                                    <p id="pipelines-editor-test-error" class="db-pipeline-editor__error">@_testResult.Error</p>
                                }
                                @if (tested is not null && (tested.InputsJson is not null || tested.OutputsJson is not null))
                                {
                                    <div>Input</div>
                                    <DataView Id="pipelines-editor-test-input" Label="Input" Json="@tested.InputsJson" />
                                    <div>Output</div>
                                    <DataView Id="pipelines-editor-test-output" Label="Output" Json="@tested.OutputsJson" />
                                    @if (CanManage && !tested.Truncated && tested.StepId == _selected.StepId && ResultOf(tested.OutputsJson) is { } testedResult)
                                    {
                                        <button id="pipelines-editor-pin-test" type="button" class="db-btn" title="A test then hands this result on in place of running the step - n8n's pinned data" @onclick="() => SetPinned(testedResult)">Pin this result</button>
                                    }
                                }
                                @if (_testResult.Log.Count > 0)
                                {
                                    <div>Log</div>
                                    <pre id="pipelines-editor-test-log" class="db-pipeline-editor__data">@string.Join("\n", _testResult.Log)</pre>
                                }
                            </div>
                        }
                    }
                    @if (CanManage)
                    {
                        <button id="pipelines-editor-remove" type="button" class="db-btn" @onclick="RemoveSelected">Remove step</button>
                    }
                    </div>
                    @if (IsWide)
                    {
                        <div id="pipelines-editor-wide-out" class="db-pipeline-editor__wide-out">@WideRunData(received: false)</div>
                    }
                }
            </aside>
        </div>
    </div>
}

@code {
    private string _definitionId;
    private string _loadedFor;
    private PipelineDetail _pipeline;
    private List<StepCatalogEntry> _catalog;

    // What is wrong with the graph as it stands - the rule the server's publish applies.
    private List<PipelineGraphProblem> _problems = new List<PipelineGraphProblem>();

    // A step test - the values the author typed for it (by variable name, kept for the session), the
    // step it was made for and what it did.
    private readonly Dictionary<string, string> _testValues = new Dictionary<string, string>(StringComparer.Ordinal);
    private bool _testing;
    private string _testedStepId;
    private StepTestResult _testResult;

    // The sticky note selected on the canvas, edited in the inspector.
    private NoteNodeModel _selectedNote;

    // The versions panel, the version open read-only (and the canvas it stands in for), a comparison.
    private bool _versionsOpen;
    private List<PipelineVersionView> _versions;
    private int? _viewingVersion;
    private string _beforeViewing;
    private List<PipelineGraphChange> _comparison;
    private int _comparedVersion;
    private PipelineGraph _comparedGraph; // the version compared with the canvas, while it is
    private bool _comparingAi; // What is compared is the canvas before the AI's change, not a version

    // n8n's AI workflow builder: the panel, what the author asks, the site's model at work, and what it said it did.
    private bool _aiOpen;
    private string _aiInstruction = "";
    private bool _aiBusy;
    private string _aiSummary;

    // The conversation so far, for this session - told to the AI with each request (the server keeps the latest few); forgotten
    // with "New conversation" and when another pipeline opens.
    private readonly List<PipelineAiTurn> _aiTurns = new List<PipelineAiTurn>();

    // Offered to an author of this pipeline where the site's model can be asked and the person may spend it - the assistant's own
    // key, which the server answers in the capabilities (this page reads its own module's keys only) and asks again of every request.
    private bool AiOffered => CanManage && _capabilities?.Ai == true;

    private async Task ToggleAiAsync()
    {
        if (_aiOpen)
        {
            CloseAi();
            return;
        }

        await OpenAiAsync();
    }

    private async Task OpenAiAsync()
    {
        _aiOpen = true;
        await FocusFieldAsync("pipelines-editor-ai-instruction");
    }

    private void CloseAi()
    {
        if (!_aiBusy)
        {
            _aiOpen = false;
        }
    }

    // n8n's "fix with AI": what the editor marks, as the list says it.
    private Task FixProblemsWithAiAsync() =>
        AskAiAboutAsync("Fix what the editor marks on this pipeline:",
            _problems.Select(problem => $"- {(problem.Severity == PipelineGraphProblems.Error ? "Problem" : "Warning")} at '{problem.Step}': {problem.Message}"));

    // ...and what a run's step failed with - the error the inspector shows, nothing else of the run's data.
    private Task FixFailureWithAiAsync(string step, string failure) =>
        AskAiAboutAsync($"The step '{step}' failed in a run with: {failure}\nChange the pipeline so it does not fail this way.", Enumerable.Empty<string>());

    // The request written into the panel, as many of its lines as the server's limit takes, and asked at once.
    private async Task AskAiAboutAsync(string request, IEnumerable<string> lines)
    {
        if (_aiBusy)
        {
            return;
        }

        var text = request.Length > MaxAiInstruction ? request[..MaxAiInstruction] : request;
        foreach (var line in lines)
        {
            if (text.Length + 1 + line.Length > MaxAiInstruction)
            {
                break;
            }

            text += "\n" + line;
        }

        _aiOpen = true;
        _aiInstruction = text;
        await AskAiAsync();
    }

    // The server's own bound on what is asked (DesignPipelineGraphCommandHandler.MaxInstructionLength).
    private const int MaxAiInstruction = 2000;

    // Ctrl+Enter asks (the editor's script leaves it to this box, where elsewhere it runs the pipeline); Escape closes.
    private async Task AiKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            await AskAiAsync();
        }
        else if (e.Key == "Escape")
        {
            CloseAi();
        }
    }

    // The canvas sent to the site's model with what the author asks; what comes back - judged by the save's rule on the server -
    // goes on the canvas as ONE change (Undo takes it back), marked against the canvas as it was. A canvas changed while the model
    // worked is not overwritten: the author asks again.
    private async Task AskAiAsync()
    {
        var instruction = _aiInstruction?.Trim();
        if (_aiBusy || string.IsNullOrEmpty(instruction) || !AiOffered || _diagram is null || _viewingVersion is not null)
        {
            return;
        }

        _aiBusy = true;
        _error = "";
        _message = "";
        _aiSummary = null;
        var definitionId = _definitionId;
        var before = ToGraph();
        var asked = System.Text.Json.JsonSerializer.Serialize(before);
        try
        {
            var designed = await PipelinesService.DesignGraphAsync(new PipelineGraphDesignRequest { Graph = before, Instruction = instruction, Earlier = _aiTurns.ToList() });
            if (designed is null)
            {
                _error = "The AI's answer did not come back.";
                return;
            }

            if (designed.Graph is null)
            {
                // An answer, not a change - a question answered, or one asked back: the canvas stays as it is, and the exchange joins
                // the conversation, to be answered.
                _aiSummary = string.IsNullOrWhiteSpace(designed.Summary) ? null : designed.Summary.Trim();
                _aiTurns.Add(new PipelineAiTurn { Asked = instruction, Said = _aiSummary ?? "(no answer)" });
                _aiInstruction = "";
                _message = "The AI answered without changing the canvas.";
                return;
            }

            if (definitionId != _definitionId || _diagram is null || _viewingVersion is not null || System.Text.Json.JsonSerializer.Serialize(ToGraph()) != asked)
            {
                _error = "The canvas changed while the AI worked, so its change was not put on it - ask again.";
                return;
            }

            _restoring = true;
            try
            {
                BuildDiagram(designed.Graph);
            }
            finally
            {
                _restoring = false;
            }

            MarkDirty();
            _comparedGraph = before;
            _comparingAi = true;
            _comparison = PipelineGraphDiff.Changes(before, ToGraph());
            ApplyComparisonToNodes();
            _aiSummary = string.IsNullOrWhiteSpace(designed.Summary) ? null : designed.Summary.Trim();
            _aiTurns.Add(new PipelineAiTurn { Asked = instruction, Said = _aiSummary ?? "(it said nothing)" });
            _aiInstruction = "";
            _message = $"The AI's change is on the canvas ({PipelineGraphDiff.Summary(_comparison)}), marked on it - save to keep it, or Undo (Ctrl+Z) to take it back.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Building Pipeline With AI {Error}", ex.Message);
            _error = RefusalReason(ex) is { Length: > 0 } reason ? "The AI did not change the pipeline: " + reason : "The AI could not be asked.";
        }
        finally
        {
            _aiBusy = false;
        }
    }

    // n8n's "Convert to sub-workflow": the plan for the selected steps, the canvas it was made for, the new pipeline's
    // name, and the pipeline made once they moved.
    private bool _subOpen;
    private bool _subBusy;
    private PipelineSubPipelines.Plan _subPlan;
    private string _subPlanned;
    private string _subName = "";
    private PipelineView _subMade;

    private static string NewStepId() => Guid.NewGuid().ToString("N");

    // Alt+X, and the step menu: what moving the selected steps would do - or why they cannot move - before anything is made. A
    // step the editor marks with an error is said here too: the new pipeline's publish would refuse it.
    private void OpenSubPipeline()
    {
        var chosen = SelectedNodes();
        if (_diagram is null || !CanManage || _viewingVersion is not null || _catalog is null || chosen.Count == 0)
        {
            return;
        }

        var graph = ToGraph();
        _subMade = null;
        _subPlan = PipelineSubPipelines.Make(graph, chosen.Select(node => node.StepId), _catalog, NewStepId);
        if (_subPlan.Refusal is null && _problems.FirstOrDefault(problem => problem.Severity == PipelineGraphProblems.Error && _subPlan.Moved.Contains(problem.StepId)) is { } marked)
        {
            _subPlan = new PipelineSubPipelines.Plan { Refusal = $"'{marked.Step}' has a problem the editor marks - {marked.Message} Fix it first." };
        }

        _subPlanned = System.Text.Json.JsonSerializer.Serialize(graph);
        var first = chosen.OrderBy(node => node.Position.X).ThenBy(node => node.Position.Y).First();
        _subName = string.IsNullOrWhiteSpace(_pipeline?.Name) ? first.DisplayName : $"{_pipeline.Name} - {first.DisplayName}";
        _subOpen = true;
        _ = FocusFieldAsync(_subPlan.Refusal is null ? "pipelines-editor-sub-name" : "pipelines-editor-sub-close");
    }

    private static string SubPipelineSummary(PipelineSubPipelines.Plan plan)
    {
        static string Listed(IEnumerable<PipelineGraphVariable> variables)
        {
            var names = variables.Select(variable => "'" + variable.Name + "'").ToList();
            return names.Count <= 1 ? string.Concat(names) : string.Join(", ", names.Take(names.Count - 1)) + " and " + names[^1];
        }

        var text = $"Moves {plan.Moved.Count} step{(plan.Moved.Count == 1 ? "" : "s")} into a new pipeline, which this one then runs where they stood and waits for - a failure there fails the run here.";
        if (plan.Sent.Count > 0)
        {
            text += " It sends " + Listed(plan.Sent) + ".";
        }

        if (plan.GivenBack.Count > 0)
        {
            text += " It gets back " + Listed(plan.GivenBack) + ".";
        }

        return text;
    }

    // The new pipeline made, saved and published - the server judges it as any save and publish - then, on this canvas, the steps
    // replaced by the call as ONE change Undo takes back (the new pipeline stays). A canvas changed meanwhile is not overwritten.
    private async Task MoveIntoSubPipelineAsync()
    {
        var plan = _subPlan;
        var name = _subName?.Trim();
        if (_subBusy || plan?.Called is null || plan.Refusal is not null || string.IsNullOrEmpty(name) || _diagram is null || !CanManage)
        {
            return;
        }

        _subBusy = true;
        _error = "";
        _message = "";
        var definitionId = _definitionId;
        try
        {
            var made = await PipelinesService.CreatePipelineAsync(new CreatePipelineRequest { Name = name, Description = $"Moved out of '{_pipeline?.Name}'." });
            await PipelinesService.SaveGraphAsync(made.DefinitionId, plan.Called);
            if (!string.IsNullOrEmpty(_pipeline?.Folder))
            {
                await PipelinesService.SetFolderAsync(made.DefinitionId, _pipeline.Folder); // beside the pipeline it came out of
            }
            var published = await PipelinesService.PublishPipelineAsync(made.DefinitionId);
            if (published is null || !published.Succeeded)
            {
                _error = $"'{name}' was made but not published ({string.Join(" ", published?.Errors ?? new List<string>())}) - open it to finish it. This pipeline is as it was.";
                return;
            }

            if (definitionId != _definitionId || _diagram is null || _viewingVersion is not null || System.Text.Json.JsonSerializer.Serialize(ToGraph()) != _subPlanned)
            {
                _error = $"The canvas changed meanwhile, so the steps were not replaced - '{name}' is made and published: move them again, or run it from an Execute pipeline step.";
                return;
            }

            var calling = PipelineSubPipelines.Call(ToGraph(), plan, made.DefinitionId, name, NewStepId,
                _catalog?.FirstOrDefault(entry => entry.Type == PipelineSubPipelines.CallType)?.Version ?? 1);
            _restoring = true;
            try
            {
                BuildDiagram(calling);
            }
            finally
            {
                _restoring = false;
            }

            MarkDirty();
            if (_otherPipelines is not null && _otherPipelines.All(other => other.DefinitionId != made.DefinitionId))
            {
                _otherPipelines.Add(made); // the call's pipeline picker names it
            }

            if (_diagram.Nodes.OfType<StepNodeModel>().FirstOrDefault(node => node.Type == PipelineSubPipelines.CallType && calling.Steps.Any(step => step.Id == node.StepId && step.Inputs.TryGetValue("PipelineDefinitionId", out var called) && called == made.DefinitionId)) is { } call)
            {
                _diagram.SelectModel(call, unselectOthers: true);
                _selected = call;
            }

            _subMade = made;
            _message = $"Moved {plan.Moved.Count} step{(plan.Moved.Count == 1 ? "" : "s")} into '{name}', published - this pipeline now runs it where they stood. Save to keep the change; Undo (Ctrl+Z) takes it back here, and '{name}' stays.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Moving Steps Into A Sub-Pipeline {Error}", ex.Message);
            _error = RefusalReason(ex) is { Length: > 0 } reason ? "The steps were not moved: " + reason : "The steps could not be moved.";
        }
        finally
        {
            _subBusy = false;
        }
    }

