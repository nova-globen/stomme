    // The script is a module resource and may load after the first render: try for a few seconds, then give up quietly
    // (the toolbar does everything the keys do).
    private async Task AttachKeysAsync(CancellationToken ct)
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        for (var attempt = 0; attempt < 20 && !ct.IsCancellationRequested; attempt++)
        {
            try
            {
                if (await JSRuntime.InvokeAsync<bool>("stommePipelineEditorAttach", ct, _selfRef))
                {
                    return;
                }
            }
            catch (JSException)
            {
                // not loaded yet
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch (InvalidOperationException)
            {
                return; // prerendering, or the circuit is gone
            }

            try
            {
                await Task.Delay(250, ct);
            }
            catch (OperationCanceledException)
            {
                return;
            }
        }
    }

    // The graph to save: the canvas's body folded in, then every step of every body with its position, inputs and bindings,
    // every connection, and the variables.
    private PipelineGraph ToGraph()
    {
        Fold();
        return new PipelineGraph
        {
            Steps = _graph.Steps.Select(CopyStep).ToList(),
            Connections = _graph.Connections.Select(connection => new PipelineGraphConnection { SourceId = connection.SourceId, SourcePort = connection.SourcePort, TargetId = connection.TargetId }).ToList(),
            Variables = _variables.Select(variable => new PipelineGraphVariable { Id = variable.Id, Name = variable.Name, TypeName = variable.TypeName, Value = variable.Value, TestValue = variable.TestValue }).ToList(),
            Notes = _graph.Notes.Select(CopyNote).ToList(),
            RunsAtOnce = _graph.RunsAtOnce,
            KeepSuccessfulRuns = _graph.KeepSuccessfulRuns == false ? false : null,
            SaveProgress = _graph.SaveProgress == true ? true : null,
            KeepStepData = PipelineStepDataKeeping.Stored(_graph.KeepStepData),
            MinutesSavedPerRun = PipelineInsights.MinutesSaved(_graph.MinutesSavedPerRun),
            TimeoutMinutes = PipelineRunTimeout.Minutes(_graph.TimeoutMinutes),
            CalledBy = PipelineCallers.Normalize(_graph.CalledBy),
            TimeZone = PipelineTimeZone.Normalize(_graph.TimeZone),
        };
    }

