    // BL-229 (n8n's pinned data): the selected step's pinned result - set from what a run or a test produced, edited, or
    // removed (null). Pinning and unpinning are a step of undo each; typing in the pinned result joins the step before it.
    private void SetPinned(string result, bool typed = false)
    {
        if (_selected is null || !CanManage)
        {
            return;
        }

        _selected.Pin(result);
        MarkDirty(typed ? _selected.StepId + "/pinned" : null); // it clears the message, so the message comes after
        if (!typed)
        {
            _message = _selected.PinnedResult is null ? $"'{_selected.DisplayName}' is no longer pinned: a test runs it." : $"'{_selected.DisplayName}' is pinned: a test hands its pinned result on in place of running it.";
        }
    }

    // A step's Result as its outputs carry it - text as it is, anything else as compact JSON (the record shows JSON indented for
    // reading; a step's own result is the compact text, found driving a pin from a run); null when it has none.
    // The paths a pass of the selected step was given in the site's pipeline folder - its inputs the step marks as one, each a
    // plain path (a template the run did not resolve is no file) - in the order the step lists them.
    private List<string> FilesOf(string inputsJson)
    {
        var marked = _selected?.Entry?.Inputs.Where(input => input.UIHint == PipelineInputHints.PipelineFile).Select(input => input.Name).ToList();
        if (string.IsNullOrEmpty(inputsJson) || marked is not { Count: > 0 })
        {
            return new List<string>();
        }

        try
        {
            using var inputs = JsonDocument.Parse(inputsJson);
            if (inputs.RootElement.ValueKind != JsonValueKind.Object)
            {
                return new List<string>();
            }

            var given = inputs.RootElement.EnumerateObject().ToDictionary(property => property.Name, property => property.Value.Clone(), StringComparer.OrdinalIgnoreCase);
            return marked
                .Select(name => given.TryGetValue(name, out var value) && value.ValueKind == JsonValueKind.String ? PipelineFilePaths.Normalize(value.GetString()) : "")
                .Where(path => path.Length > 0 && !path.Contains("{{", StringComparison.Ordinal))
                .Distinct(StringComparer.Ordinal)
                .ToList();
        }
        catch (JsonException)
        {
            return new List<string>();
        }
    }

    private string FileDownloadUrl(string path) => Utilities.TenantUrl(PageState.Alias, "/api/Pipelines/files/content?path=" + Uri.EscapeDataString(path));

    private static string ResultOf(string outputsJson)
    {
        if (string.IsNullOrEmpty(outputsJson))
        {
            return null;
        }

        try
        {
            using var outputs = JsonDocument.Parse(outputsJson);
            return outputs.RootElement.ValueKind == JsonValueKind.Object && outputs.RootElement.TryGetProperty("Result", out var result)
                ? result.ValueKind switch
                {
                    JsonValueKind.String => result.GetString(),
                    JsonValueKind.Null or JsonValueKind.Undefined => null,
                    _ => JsonSerializer.Serialize(result),
                }
                : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

