    private RenderFragment WideRunData(bool received)
    {
        var shown = ShownExecution(out var count);
        var title = received ? "Received" : "Produced";
        var id = received ? "pipelines-editor-wide-received" : "pipelines-editor-wide-produced";
        return @<div style="display:flex;flex-direction:column;gap:0.5rem;min-width:0;">
            <h4 style="margin:0;">@title</h4>
            @if (_shownRunId is null)
            {
                <p style="color:var(--db-text-2);margin:0;">@(received ? "What the step received in a run shows here - choose one in Show run above, or press Run." : "What it produced in that run shows here.")</p>
            }
            else if (shown is null)
            {
                <p style="color:var(--db-text-2);margin:0;">@(_shownRun is { IsFinished: true } ? "This step did not run." : "Not reached yet.")</p>
            }
            else
            {
                @if (received)
                {
                    <p style="margin:0;">@PipelineStepStates.StatusOf(shown, _shownRun) · @Duration(shown) · started @shown.StartedAtUtc.ToString("HH:mm:ss.fff") UTC@(count > 1 ? $" · pass {Math.Clamp(_executionIndex, 0, count - 1) + 1} of {count}" : "")</p>
                }
                else if (!string.IsNullOrEmpty(shown.Error))
                {
                    <p class="db-pipeline-editor__error">@shown.Error</p>
                }

                @if (shown.DataNotKept)
                {
                    <p style="color:var(--db-text-2);margin:0;">@StepDataNotKept</p>
                }
                else if (shown.InputsJson is null && shown.OutputsJson is null && !CanManage)
                {
                    <p style="color:var(--db-text-2);margin:0;">What the step received and produced is shown to the pipeline's authors.</p>
                }
                else
                {
                    <DataView Id="@id" Label="@title" Json="@(received ? shown.InputsJson : shown.OutputsJson)" />
                }
            }
            @if (received && CanManage && ValuesToMap(out var source) is { Count: > 0 } values)
            {
                @* n8n's mapping from its input panel: each value the pipeline holds here, dragged into a setting reads it there. *@
                <h5 style="margin:0.5rem 0 0;">Values to map</h5>
                <p style="color:var(--db-text-2);margin:0;">@source - drag one into a setting.</p>
                <ul id="pipelines-editor-wide-available" class="db-pipeline-editor__available">
                    @foreach (var (placeholder, value) in values)
                    {
                        <li><span class="db-pipeline-editor__drag-field" draggable="true" data-drag-text="@placeholder" title="Drag into a setting - a value becomes an expression reading it">@placeholder</span> <span class="db-pipeline-editor__available-value">@value</span></li>
                    }
                </ul>
            }
        </div>;
    }

    // The pipeline's own values the wide view offers to map - each field with what it holds, as the previews read them (the test
    // values, the run shown's, else the starting values).
    private List<(string Placeholder, string Value)> ValuesToMap(out string source)
    {
        var known = PreviewValues(out source);
        var values = new List<(string, string)>();
        foreach (var placeholder in PipelineTemplate.Suggest("", known, max: 40).Where(placeholder => !placeholder.StartsWith("{{ $", StringComparison.Ordinal)))
        {
            string text;
            try
            {
                text = PipelineTemplate.Text(PipelineTemplate.Render(placeholder, name =>
                {
                    var match = known.FirstOrDefault(variable => variable.Name == name);
                    return match.Name is null ? (false, null) : (true, match.Value);
                }));
            }
            catch (PipelineTemplateException)
            {
                text = "";
            }

            values.Add((placeholder, text.Length > 80 ? text[..80] + "…" : text));
        }

        return values;
    }
