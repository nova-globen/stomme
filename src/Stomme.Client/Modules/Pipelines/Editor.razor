    // The reason a save was refused, as the server gave it: a refusal over HTTP (a WebAssembly site) carries it, and on a Server
    // site the handler's own exception does - without the parameter name .NET appends. Anything else has none to show.
    private static string RefusalReason(Exception ex)
    {
        var reason = ex switch
        {
            Stomme.Services.ServiceRefusalException refusal => refusal.Message,
            ArgumentException argument => argument.ParamName is null ? argument.Message : argument.Message.Replace($" (Parameter '{argument.ParamName}')", string.Empty, StringComparison.Ordinal),
            InvalidOperationException invalid => invalid.Message,
            _ => null,
        };
        return string.IsNullOrWhiteSpace(reason) ? null : reason.Trim();
    }

