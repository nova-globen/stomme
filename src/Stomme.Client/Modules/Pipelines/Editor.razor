    // Ctrl+D (n8n's): the selected steps copied beside themselves, with what they hold - the clipboard left as it was.
    private void Duplicate()
    {
        var chosen = SelectedNodes().Select(node => node.StepId).ToList();
        if (chosen.Count == 0 || !CanManage || _diagram is null)
        {
            return;
        }

        Fold();
        Paste(StepClipboard.Copy(_graph, chosen), null);
        _message = chosen.Count == 1 ? "Duplicated 1 step." : $"Duplicated {chosen.Count} steps.";
    }

    // 0, + and - (n8n's): the zoom set about the middle of the canvas, so what is there stays there.
    private void ZoomTo(double zoom)
    {
        if (_diagram is null)
        {
            return;
        }

        var to = Math.Clamp(zoom, 0.2, 2);
        if (_diagram.Container is not { Width: > 0, Height: > 0 } container)
        {
            _diagram.SetZoom(to);
            return;
        }

        var (middleX, middleY) = (container.Width / 2, container.Height / 2);
        var (atX, atY) = ((middleX - _diagram.Pan.X) / _diagram.Zoom, (middleY - _diagram.Pan.Y) / _diagram.Zoom);
        _diagram.SetZoom(to);
        _diagram.SetPan(middleX - atX * to, middleY - atY * to);
    }

    // A layout without the pointer: Shift and an arrow move what is chosen - steps and notes - a dot of the canvas's grid
    // that way; a run of presses is one change Undo takes back whole, and a screen reader is told what moved.
    private void Nudge(string direction)
    {
        if (_diagram is null || !CanManage || _diagram.GetSelectedModels().OfType<NodeModel>().ToList() is not { Count: > 0 } chosen)
        {
            return;
        }

        var (dx, dy) = direction switch
        {
            "left" => (-CanvasGrid.Spacing, 0d),
            "right" => (CanvasGrid.Spacing, 0d),
            "up" => (0d, -CanvasGrid.Spacing),
            _ => (0d, CanvasGrid.Spacing),
        };
        foreach (var node in chosen)
        {
            node.SetPosition(node.Position.X + dx, node.Position.Y + dy);
        }

        MarkDirty("nudge");
        Announce("Moved " + (chosen.Count == 1 && chosen[0] is StepNodeModel step ? step.DisplayName : chosen.Count == 1 ? "the note" : chosen.Count + " chosen") + " " + direction);
    }

    // What a screen reader is told after an arrow: the step reached, or that none is that way - the same words again told again
    // (two steps of one name, a second arrow into the edge) by a no-break space on or off their end.
    private string _announce;

    private void Announce(string text) => _announce = _announce == text ? text + Unread : text;

    /// <summary>
    /// A step as a screen reader says it: its name, its type when the name is not that, how it went in the run shown (the note on
    /// the step, its signs in words), its problems, and whether it is switched off.
    /// </summary>
    public static string Spoken(StepNodeModel node) => string.Join(", ", new[]
    {
        node.DisplayName,
        node.Entry is { } entry && entry.DisplayName != node.DisplayName ? entry.DisplayName : null,
        node.RunNote?.Replace(" · ", ", ").Replace(" → ", " then ").Replace("×", "times "),
        node.ProblemBadge,
        node.Disabled ? "switched off" : null,
    }.Where(part => !string.IsNullOrEmpty(part)));

    // The arrows (n8n's): the next step that way (StepNavigation), selected, and brought into sight when it is out of it.
    private void SelectNeighbour(string direction)
    {
        if (_diagram is null || SelectedNodes() is not { Count: 1 } one)
        {
            return;
        }

        var steps = _diagram.Nodes.OfType<StepNodeModel>().ToDictionary(node => node.StepId, node => (node.Position.X, node.Position.Y), StringComparer.Ordinal);
        var next = StepNavigation.Next(direction, one[0].StepId, steps, _diagram.Links.Select(link => (
            ((link.Source as SinglePortAnchor)?.Port?.Parent as StepNodeModel)?.StepId,
            ((link.Target as SinglePortAnchor)?.Port?.Parent as StepNodeModel)?.StepId)));
        if (_diagram.Nodes.OfType<StepNodeModel>().FirstOrDefault(node => node.StepId == next) is not { } node)
        {
            Announce("No step that way");
            return;
        }

        _diagram.SelectModel(node, unselectOthers: true);
        _selected = node;
        Announce(Spoken(node));
        if (_diagram.Container is { Width: > 0, Height: > 0 } container)
        {
            var (x, y) = (node.Position.X * _diagram.Zoom + _diagram.Pan.X, node.Position.Y * _diagram.Zoom + _diagram.Pan.Y);
            if (x < 0 || y < 0 || x > container.Width - 100 || y > container.Height - 60)
            {
                _diagram.SetPan(container.Width / 2 - node.Position.X * _diagram.Zoom, container.Height / 2 - node.Position.Y * _diagram.Zoom);
            }
        }
    }

