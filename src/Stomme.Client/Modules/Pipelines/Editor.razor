    // Whether a condition holds with the values the preview reads - the test values, the run shown's, else the starting values -
    // or why it cannot say.
    private (string Text, bool Failed, string Source) ConditionPreview(PipelineCondition condition)
    {
        var known = PreviewValues(out var source);
        try
        {
            var holds = PipelineConditions.Evaluate(condition, name =>
            {
                var match = known.FirstOrDefault(variable => variable.Name == name);
                return match.Name is null ? (false, null) : (true, match.Value);
            });
            return (holds ? "it holds" : "it does not hold", false, source);
        }
        catch (PipelineTemplateException ex)
        {
            return (ex.Message, true, source);
        }
    }

    // Filter records' rules, held as the input's value: the condition the rule editor changes in place, made again from the value
    // whenever the value changed under it (an undo, a merged save) - so what is shown is always what will be saved.
    private readonly Dictionary<string, (string Text, PipelineCondition Condition)> _recordConditions = new(StringComparer.Ordinal);

    private PipelineCondition RecordConditionOf(string name)
    {
        var key = _selected.StepId + "/" + name;
        var text = Value(_selected.Inputs, name);
        if (_recordConditions.TryGetValue(key, out var held) && held.Text == text)
        {
            return held.Condition;
        }

        // Nothing yet shows one empty rule to fill in; it is saved once something is typed into it.
        var condition = PipelineConditions.TryRead(text, out var read) && read.Rules.Count > 0 ? read : new PipelineCondition { Rules = { new PipelineConditionRule() } };
        _recordConditions[key] = (text, condition);
        return condition;
    }

    private void RecordConditionChanged(string name)
    {
        if (_selected is null || !_recordConditions.TryGetValue(_selected.StepId + "/" + name, out var held))
        {
            return;
        }

        var text = PipelineConditions.Write(held.Condition);
        _selected.Inputs[name] = text;
        _recordConditions[_selected.StepId + "/" + name] = (text, held.Condition);
        MarkDirty(_selected.StepId + "/record-condition/" + name);
    }

