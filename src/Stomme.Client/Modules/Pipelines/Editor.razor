    // n8n's "Fetch test event": a real event for a trigger's next steps - the newest message in the mailbox, read through
    // the connection on the server (nothing marked, nothing kept), or the newest file in the folder the trigger's names take.
    private bool _fetchingTestEvent;

    private async Task FetchNewestEmailAsync(string variableName, string connection, string mailbox)
    {
        _fetchingTestEvent = true;
        try
        {
            var fetched = await PipelinesService.FetchNewestEmailAsync(connection, mailbox);
            if (fetched?.Value is { Length: > 0 } message)
            {
                _testValues[variableName] = message;
                _message = $"'{variableName}' holds the newest message in '{mailbox}' - select a later step and Test step.";
            }
            else
            {
                _message = fetched?.Problem ?? $"'{mailbox}' could not be read.";
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Fetching The Newest Message {Error}", ex.Message);
            _message = $"'{mailbox}' could not be read.";
        }
        finally
        {
            _fetchingTestEvent = false;
        }
    }

    private async Task UseNewestFileAsync(string variableName, string folder, string patterns)
    {
        _fetchingTestEvent = true;
        try
        {
            var listed = await PipelinesService.GetPipelineFilesAsync(folder);
            var names = PipelineFileEvent.Patterns(patterns);
            var newest = listed?.Entries.Where(entry => !entry.IsFolder && PipelineFileEvent.Matches(entry.Name, names))
                .OrderByDescending(entry => entry.ModifiedOnUtc).ThenByDescending(entry => entry.Path, StringComparer.Ordinal).FirstOrDefault();
            var where = folder.Length == 0 ? "the pipeline folder" : $"'{folder}'";
            if (newest is null)
            {
                _message = $"There is no file in {where} its names take - put one there on the Files page.";
                return;
            }

            _testValues[variableName] = PipelineFileEvent.Write(newest.Path, newest.Length, new DateTimeOffset(DateTime.SpecifyKind(newest.ModifiedOnUtc, DateTimeKind.Utc)), PipelineFileEvent.Added);
            _message = $"'{variableName}' holds {newest.Path}, the newest file in {where} - select a later step and Test step.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Reading The Pipeline Folder {Error}", ex.Message);
            _message = "The pipeline folder could not be read.";
        }
        finally
        {
            _fetchingTestEvent = false;
        }
    }

    // A made-up file the trigger would take, in its folder - the fields a run gets.
    private void UseSampleFile(string variableName, string folder, string patterns)
    {
        _testValues[variableName] = PipelineFileEvent.Sample(folder, patterns, DateTimeOffset.UtcNow);
        _message = $"'{variableName}' holds a sample file - select a later step and Test step.";
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = "";
        // A load starts clean of the versions: none open read-only (its "back" would bring the canvas it stood in for - another
        // pipeline's, when a caller's link opened this one here), none compared, the list read again when it is opened.
        _viewingVersion = null;
        _beforeViewing = null;
        _versionsOpen = false;
        _versions = null;
        _comparedGraph = null;
        _comparison = null;
        _comparingAi = false;
        _aiSummary = null; // what the AI said of another pipeline's canvas
        _aiTurns.Clear(); // and the conversation about it
        _detailsOpen = false; // the last one's name half typed is not this one's
        (_callers, _callersAsked) = (null, false); // the pipelines that call the last one are not this one's callers
        (_failureMap, _failureMapAsked, _handlerMade) = (null, false, null); // nor are its failure handlers
        _activity = null; // nor what was done to it
        (_newConnectionFor, _connectionTested) = (null, null); // nor a connection being made or tested for it
        _commentDrafts.Clear(); // nor what was being said of its steps
        (_commentError, _commentNote) = (null, null);
        try
        {
            _catalog ??= await PipelinesService.GetStepsAsync() ?? new List<StepCatalogEntry>();
            // The site's connections for the connection picker - when a step names one, and only for an editor allowed to list
            // them (the Connectivity module answers that); otherwise the connection is typed as its id.
            if (_connections is null
                && _catalog.Any(entry => entry.Inputs.Any(input => input.UIHint == PipelineInputHints.ConnectionPicker))
                && EditorServices.GetService(typeof(Stomme.Modules.Connectivity.Services.IConnectionsService)) is Stomme.Modules.Connectivity.Services.IConnectionsService connections)
            {
                try
                {
                    _connections = (await connections.ListAsync() ?? new List<Stomme.Connectivity.ConnectionView>()).OrderBy(connection => connection.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
                }
                catch (Exception ex)
                {
                    await logger.LogInformation("The pipeline editor could not list the site's connections: {Error}", ex.Message);
                    _connections = null;
                }

                if (_connections is not null)
                {
                    try
                    {
                        _connectors = await connections.ListConnectorsAsync() ?? new List<Stomme.Connectivity.ConnectorView>();
                    }
                    catch (Exception ex)
                    {
                        await logger.LogInformation("The pipeline editor could not list the installed connectors: {Error}", ex.Message);
                        _connectors = null;
                    }
                }
            }

            try
            {
                _siteVariables = await PipelinesService.GetSiteVariablesAsync() ?? new Dictionary<string, string>();
            }
            catch (Exception ex)
            {
                await logger.LogInformation("The pipeline editor could not read the site's variables: {Error}", ex.Message);
                _siteVariables = new Dictionary<string, string>();
            }

            if (_siteTables is null && _catalog.Any(entry => entry.Inputs.Any(input => input.UIHint == PipelineInputHints.SiteTablePicker)))
            {
                try
                {
                    _siteTables = await PipelinesService.GetSiteTablesAsync() ?? new List<PipelineSiteTableView>();
                }
                catch (Exception ex)
                {
                    await logger.LogInformation("The pipeline editor could not list the site's data tables: {Error}", ex.Message);
                    _siteTables = null; // the table is typed by name
                }
            }

            if (_agentTools is null && _catalog.Any(entry => entry.Inputs.Any(input => input.UIHint == PipelineInputHints.AgentTools)))
            {
                try
                {
                    _agentTools = await PipelinesService.GetAgentToolsAsync() ?? new List<AgentToolView>();
                }
                catch (Exception ex)
                {
                    await logger.LogInformation("The pipeline editor could not list the site's AI agent tools: {Error}", ex.Message);
                    _agentTools = null;
                }
            }

            if (_capabilities is null)
            {
                // An editor that cannot ask offers nothing a run might refuse.
                try
                {
                    _capabilities = await PipelinesService.GetCapabilitiesAsync() ?? new PipelineCapabilitiesView();
                }
                catch (Exception ex)
                {
                    await logger.LogError(ex, "Error Reading Pipeline Capabilities {Error}", ex.Message);
                    _capabilities = new PipelineCapabilitiesView();
                }
            }
            _pipeline = await PipelinesService.GetPipelineAsync(_definitionId);
            if (_pipeline is null)
            {
                _error = "There is no such pipeline on this site.";
                return;
            }

            try
            {
                _otherPipelines = (await PipelinesService.GetPipelinesAsync() ?? new List<PipelineView>())
                    .Where(other => other.DefinitionId != _definitionId)
                    .OrderBy(other => other.Name, StringComparer.CurrentCultureIgnoreCase)
                    .ToList();
            }
            catch (Exception)
            {
                _otherPipelines = null;
            }

            var graph = await PipelinesService.GetGraphAsync(_definitionId) ?? new PipelineGraph();
            _loaded = graph; // the base a collaborating save is measured from
            await LoadCommentsAsync(); // before the steps are drawn: each shows its open comments
            WatchDiscussion();
            // Steps piled on one spot (a graph made through the API, a file or the assistant without positions) open laid
            // out rather than as a stack - a change to save, measured from the graph as stored.
            var stacked = StepsStacked(graph);
            if (stacked)
            {
                graph = System.Text.Json.JsonSerializer.Deserialize<PipelineGraph>(System.Text.Json.JsonSerializer.Serialize(graph));
                AutoLayout.Arrange(graph);
            }

            _scopeParent = null; // a load opens on the pipeline itself
            _scopePort = null;
            BuildDiagram(graph);
            _fitOnOpen = true; // once the canvas has its size: fitted when its steps do not all show
            _dirty = stacked && CanManage;
            _history.Reset(Snapshot()); // a load: nothing before it to undo
            if (stacked)
            {
                _message = CanManage ? "Its steps were piled on one spot, so they are laid out - Save keeps it." : "Its steps were piled on one spot, so they are shown laid out.";
            }

            CheckProblems();
            await LoadRunsAsync();
            // A run opened from its page ("Open in the editor") is shown on the canvas - one of this pipeline's only.
            if (PageState.QueryString.TryGetValue("run", out var requested) && !string.IsNullOrEmpty(requested))
            {
                await ShowRunAsync(requested);
                if (_shownRun is not null && _shownRun.DefinitionId != _definitionId)
                {
                    await ChooseRunAsync(null);
                }
            }

            // A step named by the link (find in every pipeline) is gone to once the canvas has its size.
            _pendingStep = PageState.QueryString.TryGetValue("step", out var linked) && !string.IsNullOrEmpty(linked) ? linked : null;
            _pendingStepChosen = false;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Pipeline Editor {Error}", ex.Message);
            _error = "The pipeline could not be loaded.";
        }
        finally
        {
            _busy = false;
        }
    }

    // The whole graph becomes the editor's; the canvas stays in the body it showed when that body is still there (a merge
    // that kept it), and otherwise shows the pipeline itself.
    private void BuildDiagram(PipelineGraph graph)
    {
        _graph = new PipelineGraph
        {
            Steps = (graph.Steps ?? new List<PipelineGraphStep>()).Select(CopyStep).ToList(),
            Connections = (graph.Connections ?? new List<PipelineGraphConnection>())
                .Select(connection => new PipelineGraphConnection { SourceId = connection.SourceId, SourcePort = connection.SourcePort, TargetId = connection.TargetId })
                .ToList(),
            Notes = (graph.Notes ?? new List<PipelineGraphNote>()).Where(note => !string.IsNullOrEmpty(note?.Id)).Select(CopyNote).ToList(),
            RunsAtOnce = graph.RunsAtOnce,
            KeepSuccessfulRuns = graph.KeepSuccessfulRuns == false ? false : null,
            SaveProgress = graph.SaveProgress == true ? true : null,
            KeepStepData = PipelineStepDataKeeping.Stored(graph.KeepStepData),
            MinutesSavedPerRun = PipelineInsights.MinutesSaved(graph.MinutesSavedPerRun),
            TimeoutMinutes = PipelineRunTimeout.Minutes(graph.TimeoutMinutes),
            CalledBy = PipelineCallers.Normalize(graph.CalledBy),
            TimeZone = PipelineTimeZone.Normalize(graph.TimeZone),
        };
        _variables = (graph.Variables ?? new List<PipelineGraphVariable>())
            .Select(variable => new PipelineGraphVariable { Id = variable.Id, Name = variable.Name, TypeName = variable.TypeName, Value = variable.Value, TestValue = variable.TestValue })
            .ToList();
        if (_scopeParent is not null && !_graph.Steps.Any(step => step.Id == _scopeParent))
        {
            _scopeParent = null;
            _scopePort = null;
        }

        ShowScope();
    }

    private static PipelineGraphStep CopyStep(PipelineGraphStep step) => new()
    {
        Id = step.Id,
        Type = step.Type,
        Version = step.Version,
        Name = step.Name,
        Position = new GraphPosition { X = step.Position?.X ?? 0, Y = step.Position?.Y ?? 0 },
        Comment = step.Comment,
        PinnedResult = step.PinnedResult,
        Retries = step.Retries,
        RetryDelaySeconds = step.RetryDelaySeconds,
        ContinueOnError = step.ContinueOnError,
        FailedPath = step.FailedPath,
        FailureVariable = step.FailureVariable,
        Disabled = step.Disabled,
        Inputs = new Dictionary<string, string>(step.Inputs ?? new Dictionary<string, string>()),
        InputVariables = new Dictionary<string, string>(step.InputVariables ?? new Dictionary<string, string>()),
        InputExpressions = new Dictionary<string, string>(step.InputExpressions ?? new Dictionary<string, string>()),
        InputScripts = new Dictionary<string, string>(step.InputScripts ?? new Dictionary<string, string>()),
        InputConditions = (step.InputConditions ?? new Dictionary<string, PipelineCondition>()).ToDictionary(pair => pair.Key, pair => PipelineConditions.Copy(pair.Value)),
        Cases = PipelineOutcomes.Copy(step.Cases),
        OutputVariables = new Dictionary<string, string>(step.OutputVariables ?? new Dictionary<string, string>()),
        Parent = string.IsNullOrEmpty(step.Parent) ? null : step.Parent,
        ParentPort = string.IsNullOrEmpty(step.Parent) ? null : step.ParentPort,
    };

    private bool InScope(PipelineGraphStep step) => step.Parent == _scopeParent && (_scopeParent is null || step.ParentPort == _scopePort);

    // The canvas for the body the editor is in: its steps and the connections between them.
    private void ShowScope()
    {
        var diagram = new BlazorDiagram(new BlazorDiagramOptions
        {
            AllowMultiSelection = true, // Ctrl+click adds a step to the selection
            Zoom = { Enabled = true },
        });
        diagram.RegisterComponent<StepNodeModel, StepNode>();
        diagram.RegisterComponent<NoteNodeModel, NoteNode>();
        diagram.RegisterComponent<ConnectionActionsModel, ConnectionActions>();
        diagram.RegisterComponent<RunCountLabelModel, RunCountLabel>();

        // The body's sticky notes, under its steps.
        foreach (var note in _graph.Notes.Where(InScope))
        {
            diagram.Nodes.Add(MakeNote(note.Id, note.Text, new Point(note.Position?.X ?? 0, note.Position?.Y ?? 0), note.Color));
        }

        var nodes = new Dictionary<string, StepNodeModel>(StringComparer.Ordinal);
        foreach (var step in _graph.Steps.Where(InScope))
        {
            var node = MakeNode(step.Id, step.Type, step.Name, new Point(step.Position?.X ?? 0, step.Position?.Y ?? 0));
            node.Annotate(step.Comment);
            node.Pin(step.PinnedResult);
            node.SetReliability(step.Retries, step.RetryDelaySeconds, step.ContinueOnError, step.FailedPath, step.FailureVariable);
            node.SetDisabled(step.Disabled);
            foreach (var input in step.Inputs ?? new Dictionary<string, string>())
            {
                node.Inputs[input.Key] = input.Value;
            }

            foreach (var input in step.InputVariables ?? new Dictionary<string, string>())
            {
                node.InputVariables[input.Key] = input.Value;
            }

            foreach (var input in step.InputExpressions ?? new Dictionary<string, string>())
            {
                node.InputExpressions[input.Key] = input.Value;
            }

            foreach (var input in step.InputScripts ?? new Dictionary<string, string>())
            {
                node.InputScripts[input.Key] = input.Value;
            }

            foreach (var input in step.InputConditions ?? new Dictionary<string, PipelineCondition>())
            {
                node.InputConditions[input.Key] = PipelineConditions.Copy(input.Value);
            }

            node.Cases.AddRange(PipelineOutcomes.Copy(step.Cases));
            node.SyncOutcomes(); // A Fork's branches, a Switch's cases - before its connections find their ports

            foreach (var output in step.OutputVariables ?? new Dictionary<string, string>())
            {
                node.OutputVariables[output.Key] = output.Value;
            }

            node.Locked = _viewingVersion is not null; // a version open read-only: its steps stay where they are
            nodes[step.Id] = node;
            diagram.Nodes.Add(node);
        }

        foreach (var connection in _graph.Connections)
        {
            if (!nodes.TryGetValue(connection.SourceId ?? "", out var source) || !nodes.TryGetValue(connection.TargetId ?? "", out var target))
            {
                continue;
            }

            var port = source.OutputPorts.FirstOrDefault(p => p.Outcome == connection.SourcePort) ?? source.OutputPorts.FirstOrDefault();
            if (port is null)
            {
                continue;
            }

            var link = new LinkModel(port, target.InputPort) { TargetMarker = LinkMarker.Arrow };
            LabelLink(link);
            diagram.Links.Add(link);
        }

        diagram.Links.Added += OnLinkAdded;
        diagram.Links.Removed += OnLinkRemoved;
        diagram.Nodes.Removed += _ => MarkDirty();
        diagram.SelectionChanged += OnSelectionChanged;
        diagram.ContainerChanged += () =>
        {
            if (ReferenceEquals(diagram, _diagram) && FitIfOpening())
            {
                _ = InvokeAsync(StateHasChanged);
            }
        };
        _selected = null;
        _selectedNote = null;
        _menu = null; // a menu was for the canvas it opened on
        _diagram = diagram;
        ApplyRunToNodes();
        ApplyProblemsToNodes();
        ApplyComparisonToNodes();
    }

    private NoteNodeModel MakeNote(string id, string text, Point position, string color = null)
    {
        var note = new NoteNodeModel(id, text, position) { Locked = _viewingVersion is not null };
        note.Paint(color);
        note.Moved += _ => MarkDirty();
        return note;
    }

    // The canvas's body back into the graph: its steps and their connections as drawn now. A step removed from the canvas
    // takes everything it held with it - its bodies, and every connection inside them.
    private void Fold()
    {
        if (_diagram is null)
        {
            return;
        }

        var shown = _diagram.Nodes.OfType<StepNodeModel>().ToList();
        var shownIds = new HashSet<string>(shown.Select(node => node.StepId), StringComparer.Ordinal);
        var wasHere = new HashSet<string>(_graph.Steps.Where(InScope).Select(step => step.Id), StringComparer.Ordinal);
        var gone = new HashSet<string>(wasHere.Where(id => !shownIds.Contains(id)), StringComparer.Ordinal);
        for (var grew = gone.Count > 0; grew;)
        {
            grew = false;
            foreach (var step in _graph.Steps.Where(step => step.Parent is not null && gone.Contains(step.Parent) && !gone.Contains(step.Id)).ToList())
            {
                gone.Add(step.Id);
                grew = true;
            }
        }

        _graph.Steps.RemoveAll(step => wasHere.Contains(step.Id) || gone.Contains(step.Id));
        _graph.Connections.RemoveAll(connection => wasHere.Contains(connection.SourceId) || gone.Contains(connection.SourceId) || gone.Contains(connection.TargetId));
        foreach (var node in shown)
        {
            _graph.Steps.Add(new PipelineGraphStep
            {
                Id = node.StepId,
                Type = node.Type,
                Version = node.Entry?.Version ?? 1,
                Name = node.Name,
                Position = new GraphPosition { X = node.Position.X, Y = node.Position.Y },
                Comment = node.Comment,
                PinnedResult = node.PinnedResult,
                Retries = node.Retries,
                RetryDelaySeconds = node.RetryDelaySeconds,
                ContinueOnError = node.ContinueOnError,
                FailedPath = node.FailedPath,
                FailureVariable = node.FailureVariable,
                Disabled = node.Disabled,
                Inputs = new Dictionary<string, string>(node.Inputs),
                InputVariables = new Dictionary<string, string>(node.InputVariables),
                InputExpressions = new Dictionary<string, string>(node.InputExpressions),
                InputScripts = new Dictionary<string, string>(node.InputScripts),
                InputConditions = node.InputConditions.ToDictionary(pair => pair.Key, pair => PipelineConditions.Copy(pair.Value)),
                Cases = PipelineOutcomes.Copy(node.Cases),
                OutputVariables = new Dictionary<string, string>(node.OutputVariables),
                Parent = _scopeParent,
                ParentPort = _scopeParent is null ? null : _scopePort,
            });
        }

        // The body's notes as the canvas has them; a note in a body of a step that is gone goes with it.
        _graph.Notes.RemoveAll(note => InScope(note) || (note.Parent is not null && gone.Contains(note.Parent)));
        foreach (var note in _diagram.Nodes.OfType<NoteNodeModel>())
        {
            _graph.Notes.Add(new PipelineGraphNote
            {
                Id = note.NoteId,
                Text = note.Text,
                Position = new GraphPosition { X = note.Position.X, Y = note.Position.Y },
                Parent = _scopeParent,
                ParentPort = _scopeParent is null ? null : _scopePort,
                Color = note.Color,
            });
        }

        foreach (var link in _diagram.Links)
        {
            if ((link.Source as SinglePortAnchor)?.Port is StepPortModel { IsInput: false, Parent: StepNodeModel source } from
                && (link.Target as SinglePortAnchor)?.Port is StepPortModel { IsInput: true, Parent: StepNodeModel target })
            {
                _graph.Connections.Add(new PipelineGraphConnection { SourceId = source.StepId, SourcePort = from.Outcome, TargetId = target.StepId });
            }
        }
    }

    // Into one of the selected step's bodies, or back out to any level of the trail.
    private void OpenBody(string port)
    {
        if (_selected is null)
        {
            return;
        }

        var holder = _selected.StepId;
        ShowLevel(holder, port);
    }

    private void ShowLevel(string parent, string port)
    {
        Fold();
        _scopeParent = parent;
        _scopePort = parent is null ? null : port;
        ShowScope();
        if (_collaboration is not null)
        {
            _ = _collaboration.SetRegionAsync(parent is null ? "the pipeline" : Trail().LastOrDefault().Label ?? "a body");
        }

        StateHasChanged();
    }

    // The levels from the pipeline down to the body shown: each the holding step's name and the body's port.
    private List<(string Parent, string Port, string Label)> Trail()
    {
        var trail = new List<(string Parent, string Port, string Label)>();
        var seen = new HashSet<string>(StringComparer.Ordinal);
        for (var (parent, port) = (_scopeParent, _scopePort); parent is not null && seen.Add(parent);)
        {
            var holder = _graph.Steps.FirstOrDefault(step => step.Id == parent);
            var name = string.IsNullOrWhiteSpace(holder?.Name) ? (_catalog?.FirstOrDefault(entry => entry.Type == holder?.Type)?.DisplayName ?? holder?.Type ?? "a step") : holder.Name;
            trail.Insert(0, (parent, port, name + " › " + port));
            (parent, port) = (holder?.Parent, holder?.ParentPort);
        }

        return trail;
    }

    // How many steps a body holds directly. The holder is a step on the canvas, so its bodies are not the canvas's and were folded in.
    private int HeldCount(string holder, string port) => _graph.Steps.Count(step => step.Parent == holder && step.ParentPort == port);

    private StepNodeModel MakeNode(string id, string type, string name, Point position)
    {
        var entry = _catalog?.FirstOrDefault(e => e.Type == type);
        var node = new StepNodeModel(id, entry, type, name, position);
        node.Moved += _ => MarkDirty();
        node.Opened = OpenWide;
        node.AddAfter = CanManage ? BeginAddAfter : null;
        // n8n's buttons over a step: an author's, and the test only where they may run the pipeline too.
        node.Test = CanManage && IsAuthorizedPermission(PipelinesPermissions.Run) ? TestFromCanvas : null;
        node.Toggle = CanManage ? ToggleFromCanvas : null;
        node.Delete = CanManage ? DeleteFromCanvas : null;
        node.Menu = CanManage ? OpenStepMenu : null;
        node.SetOpenComments(OpenCommentsOn(id), OpenCommentsInside(id)); // Its discussion still open, on it and inside it
        return node;
    }

    // n8n's right-click menu: where it opened inside the canvas, the step it is for (null for the canvas's own), and,
    // for the canvas's, the spot in the diagram a step or note added from it lands on. With an outcome to connect from, it lists
    // the steps that outcome may go to ("Connect to…"); disconnecting, the step's connections ("Disconnect…").
    private sealed record CanvasMenu(StepNodeModel Step, double X, double Y, Point At, StepPortModel ConnectFrom = null, bool Disconnecting = false);

    private CanvasMenu _menu;
    private Point _placeAt; // "Add a step here": where the step chosen next lands

    // On a step: the step selected, unless it is one of the steps already selected - then the menu is for all of them.
    private void OpenStepMenu(StepNodeModel node, double clientX, double clientY)
    {
        if (_diagram is null || !CanManage)
        {
            return;
        }

        if (!node.Selected)
        {
            _diagram.SelectModel(node, unselectOthers: true);
            _selected = node;
        }

        var spot = _diagram.GetRelativePoint(clientX, clientY);
        _menu = new CanvasMenu(node, spot.X, spot.Y, null);
        InvokeAsync(StateHasChanged);
    }

    private void OnCanvasContextMenu(MouseEventArgs e)
    {
        if (_diagram is null || !CanManage)
        {
            return;
        }

        var spot = _diagram.GetRelativePoint(e.ClientX, e.ClientY);
        _menu = new CanvasMenu(null, spot.X, spot.Y, _diagram.GetRelativeMousePoint(e.ClientX, e.ClientY));
    }

    private void CloseMenu() => _menu = null;

    // Kept inside the canvas: a menu opened near its right or bottom edge opens to the left or upwards.
    private string MenuPlace(CanvasMenu menu)
    {
        var (width, height) = (_diagram?.Container?.Width ?? 0, _diagram?.Container?.Height ?? 0);
        var x = width > 0 ? Math.Max(0, Math.Min(menu.X, width - 230)) : menu.X;
        var y = height > 0 ? Math.Max(0, Math.Min(menu.Y, height - 30 * MenuItems(menu).Count - 12)) : menu.Y;
        return FormattableString.Invariant($"left:{x:0}px;top:{y:0}px;");
    }

    // What the keys and the buttons over a step do, each with its key.
    private List<(string Id, string Label, string Keys, Action Act)> MenuItems(CanvasMenu menu)
    {
        var items = new List<(string Id, string Label, string Keys, Action Act)>();
        if (menu.ConnectFrom is { } from)
        {
            foreach (var target in ConnectTargets(from))
            {
                var to = target;
                items.Add(("to-" + to.StepId, to.DisplayName, "", () => ConnectTo(from, to)));
            }
        }
        else if (menu.Disconnecting && menu.Step is { } held)
        {
            var connections = ConnectionsOf(held);
            for (var index = 0; index < connections.Count; index++)
            {
                var (link, label) = connections[index];
                items.Add(("disconnect-" + index, label, "", () => Disconnect(link)));
            }
        }
        else if (menu.Step is { } step)
        {
            var chosen = SelectedNodes();
            var one = chosen.Count <= 1;
            if (one)
            {
                items.Add(("open", "Open", "Enter", () => OpenWide(step)));
                if (step.Test is not null && step.Entry is not null)
                {
                    items.Add(("test", "Test this step", "", () => TestFromCanvas(step)));
                }

                items.Add(("rename", "Rename", "F2", () => _ = FocusFieldAsync("pipelines-editor-step-name")));

                // A connection without the pointer: each outcome's "Connect to…" lists the steps it may go to.
                var outcomes = step.OutputPorts.ToList();
                foreach (var outcome in outcomes.Where(port => ConnectTargets(port).Count > 0))
                {
                    var port = outcome;
                    items.Add((outcomes.Count == 1 ? "connect" : "connect-" + outcomes.IndexOf(port), outcomes.Count == 1 ? "Connect to…" : $"Connect {port.Label} to…", "",
                        () => OpenConnectMenu(menu, port)));
                }

                // And a connection taken away without the pointer: "Disconnect…" lists the step's connections, either way.
                if (ConnectionsOf(step).Count > 0)
                {
                    items.Add(("disconnect", "Disconnect…", "", () => OpenDisconnectMenu(menu)));
                }
            }

            items.Add(("toggle", chosen.Count > 0 && chosen.All(node => node.Disabled) ? "Switch on" : "Switch off", "D", ToggleDisabled));
            items.Add(("copy", "Copy", "Ctrl+C", () => _ = CopyFromMenuAsync()));
            items.Add(("duplicate", "Duplicate", "Ctrl+D", Duplicate));
            items.Add(("sub-pipeline", one ? "Move into a sub-pipeline…" : $"Move {chosen.Count} steps into a sub-pipeline…", "Alt+X", OpenSubPipeline));
            // The canvas's own delete - nothing stored until Save, Undo brings it back (DeleteConfirmationGateTests lists it).
            items.Add(("delete", one ? "Delete" : $"Delete {chosen.Count} steps", "Delete", DeleteSelection));
        }
        else
        {
            items.Add(("add-step", "Add a step here", "Ctrl+K", () => _ = AddStepHereAsync(menu.At)));
            if (_clipboard is not null)
            {
                items.Add(("paste", "Paste", "Ctrl+V", Paste));
            }

            items.Add(("add-note", "Add a sticky note here", "Shift+S", () => AddNoteAt(menu.At)));
            items.Add(("select-all", "Select all", "Ctrl+A", SelectAll));
            items.Add(("tidy", "Tidy up", "Shift+Alt+T", TidyUp));
            items.Add(("fit", "Fit to the canvas", "1", FitToView));
        }

        return items;
    }

    private void FromMenu(Action act)
    {
        _menu = null;
        act();
    }

    // A connection made without the pointer (better than n8n, whose connections are dragged only): the steps on this
    // canvas an outcome may go to, the nearest first - not the step itself, nor one the outcome goes to already.
    private List<StepNodeModel> ConnectTargets(StepPortModel from)
    {
        if (_diagram is null || from.Parent is not StepNodeModel source)
        {
            return new List<StepNodeModel>();
        }

        var taken = from.Links.Select(link => (link.Target as SinglePortAnchor)?.Port?.Parent).Where(node => node is not null).ToHashSet();
        return _diagram.Nodes.OfType<StepNodeModel>()
            .Where(node => !ReferenceEquals(node, source) && !taken.Contains(node))
            .OrderBy(node => Math.Pow(node.Position.X - source.Position.X, 2) + Math.Pow(node.Position.Y - source.Position.Y, 2))
            .ToList();
    }

    // "Connect to…": the menu again where it was, listing those steps - the keys go through them as through any menu, Enter
    // connects, Escape closes it.
    private void OpenConnectMenu(CanvasMenu menu, StepPortModel from)
    {
        _menu = menu with { ConnectFrom = from };
        _ = FocusMenuAsync();
    }

    // A step's connections as its menu names them: where each of its outcomes goes ("to Log", or "to Log (Approved)" from a step
    // with several), then where each coming into it comes from ("from Greet") - not one still being drawn.
    private static List<(BaseLinkModel Link, string Label)> ConnectionsOf(StepNodeModel step)
    {
        static string Outcome(StepPortModel port) => ((StepNodeModel)port.Parent).OutputPorts.Count() > 1 ? " (" + port.Label + ")" : "";

        var outgoing = step.OutputPorts.SelectMany(port => port.Links
            .Where(link => ReferenceEquals((link.Source as SinglePortAnchor)?.Port, port))
            .Select(link => (Link: link, To: (link.Target as SinglePortAnchor)?.Port?.Parent as StepNodeModel))
            .Where(pair => pair.To is not null)
            .Select(pair => (pair.Link, "to " + pair.To.DisplayName + Outcome(port))));
        var incoming = step.InputPort.Links
            .Select(link => (Link: link, From: (link.Source as SinglePortAnchor)?.Port as StepPortModel))
            .Where(pair => pair.From is { IsInput: false, Parent: StepNodeModel } && ReferenceEquals((pair.Link.Target as SinglePortAnchor)?.Port, step.InputPort))
            .Select(pair => (pair.Link, "from " + ((StepNodeModel)pair.From.Parent).DisplayName + Outcome(pair.From)));
        return outgoing.Concat(incoming).ToList();
    }

    // "Disconnect…": the menu again where it was, listing them; Enter takes the one chosen away.
    private void OpenDisconnectMenu(CanvasMenu menu)
    {
        _menu = menu with { Disconnecting = true };
        _ = FocusMenuAsync();
    }

    // The connection's own ✕: nothing stored until Save, Undo brings it back - and said from its source to its target, whichever
    // end's menu it came from (found driving: "Disconnected Parse it to Write the spreadsheet" read wrong).
    private void Disconnect(BaseLinkModel link)
    {
        if (_diagram is null || !CanManage || !_diagram.Links.Contains(link)
            || (link.Source as SinglePortAnchor)?.Port is not StepPortModel { Parent: StepNodeModel source } from
            || (link.Target as SinglePortAnchor)?.Port?.Parent is not StepNodeModel target)
        {
            return;
        }

        RemoveConnection(link);
        _message = "Removed the connection from " + source.DisplayName + (source.OutputPorts.Count() > 1 ? " (" + from.Label + ")" : "")
            + " to " + target.DisplayName + "."; // after the removal's MarkDirty, which clears it
    }

    // The connection a drag would draw - its label and buttons, one change Undo takes back - and said.
    private void ConnectTo(StepPortModel from, StepNodeModel target)
    {
        if (_diagram is null || !CanManage || from.Parent is not StepNodeModel source || !ConnectTargets(from).Contains(target))
        {
            return;
        }

        _diagram.Links.Add(new LinkModel(from, target.InputPort) { TargetMarker = LinkMarker.Arrow });
        MarkDirty(); // clears the message, so it is said after
        _message = "Connected " + source.DisplayName + (source.OutputPorts.Count() > 1 ? " (" + from.Label + ")" : "") + " to " + target.DisplayName + ".";
    }

    // n8n's empty canvas: "Add a step here" in the canvas's middle - the step chosen next is centred there.
    private Task AddFirstStepAsync()
    {
        var (width, height, zoom) = (_diagram?.Container?.Width ?? 0, _diagram?.Container?.Height ?? 0, _diagram?.Zoom ?? 1);
        return AddStepHereAsync(width > 0 && height > 0
            ? new Point((width / 2 - _diagram.Pan.X) / zoom - CanvasFit.DefaultStepWidth / 2, (height / 2 - _diagram.Pan.Y) / zoom - CanvasFit.DefaultStepHeight / 2)
            : new Point(AutoLayout.Left, AutoLayout.Top));
    }

