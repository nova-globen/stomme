    // A change to one of the step's reliability settings; the others stay as they are.
    private void SetReliability(string retries, string delaySeconds, bool? continueOnError)
    {
        if (_selected is null)
        {
            return;
        }

        static int Whole(string text, int fallback) =>
            int.TryParse(text, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var value) ? value : fallback;

        _selected.SetReliability(
            retries is null ? _selected.Retries : Whole(retries, 0),
            delaySeconds is null ? _selected.RetryDelaySeconds : Whole(delaySeconds, 0),
            continueOnError ?? _selected.ContinueOnError,
            _selected.FailedPath,
            _selected.FailureVariable);
        MarkDirty();
    }

