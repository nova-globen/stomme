    // The values an expression is previewed with: what the author gave a variable for a step test (increment 6's values, kept
    // for the session - a sample failure, a webhook call heard), else the value kept with the pipeline for tests, else what the
    // run shown left in it (RunValues - an author's, from its steps' outputs), else its starting value. The source names the
    // freshest used.
    private List<(string Name, object Value)> PreviewVariables(out string source)
    {
        var ran = _shownRunId is null ? new Dictionary<string, string>() : RunValues.FromSteps(_runSteps, OutputVariablesOf);
        var named = _variables.Where(variable => !string.IsNullOrWhiteSpace(variable.Name)).ToList();
        source = named.Any(variable => _testValues.ContainsKey(variable.Name) || variable.TestValue is not null) ? "With the test values"
            : ran.Count > 0 ? "With the run shown"
            : "With the starting values";
        return named
            .Select(variable => (variable.Name, _testValues.TryGetValue(variable.Name, out var given) ? (object)given
                : variable.TestValue is not null ? variable.TestValue
                : ran.TryGetValue(variable.Id, out var held) ? held
                : variable.Value))
            .ToList();
    }

    // The values a template or a condition is previewed and suggested with: the variables' (above), then the built-ins (BL-229,
    // PipelineBuiltIns) - the moment, the run shown and this pipeline - which the engine fills from the run when the step runs and
    // which answer before a variable of the same name there, so here too.
    private List<(string Name, object Value)> PreviewValues(out string source)
    {
        var values = PreviewVariables(out source);
        values.RemoveAll(value => PipelineBuiltIns.IsBuiltIn(value.Name));
        var run = _shownRun;
        var facts = new PipelineRunFacts(DateTimeOffset.UtcNow, run?.Id, run?.CorrelationId,
            run is null ? null : new DateTimeOffset(DateTime.SpecifyKind(run.CreatedOnUtc, DateTimeKind.Utc)),
            _pipeline?.DefinitionId, _pipeline?.Name, run?.Version ?? _pipeline?.Version, _siteVariables, TimeZone: _graph?.TimeZone);
        values.AddRange(PipelineBuiltIns.Values(facts).Select(builtIn => (builtIn.Name, (object)builtIn.Value)));
        return values;
    }

    // The site's variables ($vars), read with the pipeline; none when they could not be read.
    private Dictionary<string, string> _siteVariables = new();

    // A typed test value the pipeline does not keep yet - what "Keep with the pipeline" would save.
    private bool HasUnkeptTestValues() =>
        _variables.Any(variable => !string.IsNullOrWhiteSpace(variable.Name)
            && _testValues.TryGetValue(variable.Name, out var typed)
            && !string.Equals(typed, variable.TestValue, StringComparison.Ordinal));

    // The typed values become the pipeline's (a change like any other: unsaved until saved, one step of undo); a variable
    // nothing was typed for keeps what it kept.
    private void KeepTestValues()
    {
        var changed = false;
        foreach (var variable in _variables.Where(variable => !string.IsNullOrWhiteSpace(variable.Name)))
        {
            if (_testValues.TryGetValue(variable.Name, out var typed) && !string.Equals(typed, variable.TestValue, StringComparison.Ordinal))
            {
                variable.TestValue = typed;
                changed = true;
            }
        }

        _testValues.Clear(); // now kept, so shown from the pipeline
        if (changed)
        {
            MarkDirty();
        }
    }

    // The run shown's values that are not what the pipeline keeps for tests - what "Keep the run's values" would save.
    private Dictionary<string, string> RunValuesToKeep()
    {
        if (_shownRunId is null)
        {
            return new Dictionary<string, string>();
        }

        var ran = RunValues.FromSteps(_runSteps, OutputVariablesOf);
        return _variables
            .Where(variable => !string.IsNullOrWhiteSpace(variable.Name) && ran.TryGetValue(variable.Id, out var held) && !string.Equals(held, variable.TestValue, StringComparison.Ordinal))
            .ToDictionary(variable => variable.Id, variable => ran[variable.Id], StringComparer.Ordinal);
    }

    // The run shown's values become the pipeline's test values (a change like any other: unsaved until saved, one step of undo);
    // what was typed for those variables gives way to them.
    private void KeepRunValues()
    {
        var keep = RunValuesToKeep();
        foreach (var variable in _variables.Where(variable => keep.ContainsKey(variable.Id)))
        {
            variable.TestValue = keep[variable.Id];
            _testValues.Remove(variable.Name);
        }

        if (keep.Count > 0)
        {
            MarkDirty();
        }
    }

    private void ForgetKeptTestValues()
    {
        foreach (var variable in _variables)
        {
            variable.TestValue = null;
        }

        MarkDirty();
    }

    // A step's output-to-variable bindings: the canvas's node when it is shown, else the graph's step.
    private IReadOnlyDictionary<string, string> OutputVariablesOf(string stepId) =>
        (IReadOnlyDictionary<string, string>)_diagram?.Nodes.OfType<StepNodeModel>().FirstOrDefault(node => node.StepId == stepId)?.OutputVariables
        ?? _graph.Steps.FirstOrDefault(step => step.Id == stepId)?.OutputVariables;

    // The versions the engine keeps, newest first.
    private async Task ToggleVersionsAsync()
    {
        _versionsOpen = !_versionsOpen;
        if (_versionsOpen)
        {
            _versions = null;
            try
            {
                _versions = await PipelinesService.GetVersionsAsync(_definitionId) ?? new List<PipelineVersionView>();
            }
            catch (Exception ex)
            {
                await logger.LogError(ex, "Error Loading Pipeline Versions {Error}", ex.Message);
                _versions = new List<PipelineVersionView>();
                _error = "The versions could not be read.";
            }
        }
    }

    // A version's place: the one that runs (published), the one being worked on (the draft, the latest unpublished), or an
    // earlier one - the engine unpublishes a version when a newer one is published (found driving: they read "draft").
    private static string VersionState(PipelineVersionView version) => (version.IsPublished, version.IsLatest) switch
    {
        (true, true) => "published · latest",
        (true, false) => "published",
        (false, true) => "draft",
        _ => "earlier",
    };

    private async Task<PipelineGraph> VersionGraphAsync(int version)
    {
        try
        {
            return await PipelinesService.GetVersionGraphAsync(_definitionId, version);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Pipeline Version {Error}", ex.Message);
            _error = $"Version {version} could not be read.";
            return null;
        }
    }

    // The canvas the author works on: the one shown, or - while a version is open - the one it stands in for.
    private PipelineGraph WorkingGraph() =>
        _viewingVersion is null ? ToGraph() : System.Text.Json.JsonSerializer.Deserialize<PipelineGraph>(_beforeViewing) ?? new PipelineGraph();

    private async Task CompareVersionAsync(int version)
    {
        var graph = await VersionGraphAsync(version);
        if (graph is null)
        {
            return;
        }

        _comparedVersion = version;
        _comparedGraph = graph;
        _comparingAi = false;
        _comparison = PipelineGraphDiff.Changes(graph, WorkingGraph());
        ApplyComparisonToNodes();
    }

    // The comparison follows the canvas - every change, load, undo and merged save says it again (CheckProblems) - while
    // a version open read-only leaves it as it was, for the canvas it stands in for.
    private void RefreshComparison(PipelineGraph graph)
    {
        if (_comparedGraph is not null && graph is not null && _viewingVersion is null)
        {
            _comparison = PipelineGraphDiff.Changes(_comparedGraph, graph);
        }

        ApplyComparisonToNodes();
    }

    private void StopComparing()
    {
        _comparedGraph = null;
        _comparison = null;
        _comparingAi = false;
        ApplyComparisonToNodes();
    }

    // While a version is compared, each step on the canvas says whether it is new since that version or changed - its
    // own settings, or the steps (and connections) its bodies hold - with what changed on hover, and each connection added since
    // takes the theme's "ok" colour. A version open read-only shows none of it, and stopping the comparison takes it away.
    private void ApplyComparisonToNodes()
    {
        if (_diagram is null)
        {
            return;
        }

        var changes = _viewingVersion is null ? _comparison : null;
        foreach (var node in _diagram.Nodes.OfType<StepNodeModel>())
        {
            var own = changes?.Where(change => !change.IsConnection && change.StepId == node.StepId).ToList() ?? new List<PipelineGraphChange>();
            var inside = changes?.Where(change => change.StepId is not null && change.StepId != node.StepId
                && (IsInside(_graph.Steps, change.StepId, node.StepId) || IsInside(_comparedGraph?.Steps, change.StepId, node.StepId))).ToList() ?? new List<PipelineGraphChange>();
            var note = string.Join(Environment.NewLine, own.Concat(inside).Select(change => change.Line));
            if (own.Any(change => change.Kind == PipelineGraphDiff.Added))
            {
                node.ShowChange(PipelineGraphDiff.Added, _comparingAi ? "added by the AI" : $"new since version {_comparedVersion}", note);
            }
            else if (own.Count > 0 || inside.Count > 0)
            {
                var where = own.Count == 0 ? "changed inside" : inside.Count == 0 ? "changed" : "changed, inside too,";
                node.ShowChange(PipelineGraphDiff.Changed, _comparingAi ? $"{where} by the AI" : $"{where} since version {_comparedVersion}", note);
            }
            else
            {
                node.ShowChange(null, null, null);
            }
        }

        foreach (var link in _diagram.Links.OfType<LinkModel>())
        {
            var added = changes is not null
                && (link.Source as SinglePortAnchor)?.Port is StepPortModel port && port.Parent is StepNodeModel from
                && (link.Target as SinglePortAnchor)?.Port?.Parent is StepNodeModel to
                && changes.Any(change => change.IsConnection && change.Kind == PipelineGraphDiff.Added
                    && change.StepId == from.StepId && change.TargetId == to.StepId && change.SourcePort == (port.Outcome ?? ""));
            var color = added ? AddedConnectionColor : null;
            if (link.Color != color)
            {
                link.Color = color;
                link.Refresh();
            }
        }
    }

    // The theme governs: a connection new since the version compared is drawn in its "ok" colour.
    private const string AddedConnectionColor = "var(--db-ok)";

    // A version on the canvas, read-only: nothing can be changed, saved or published until "Back to the canvas".
    private async Task OpenVersionAsync(int version)
    {
        var graph = await VersionGraphAsync(version);
        if (graph is null)
        {
            return;
        }

        _beforeViewing ??= Snapshot();
        _viewingVersion = version;
        _restoring = true;
        try
        {
            BuildDiagram(graph);
        }
        finally
        {
            _restoring = false;
        }

        CheckProblems();
    }

    private void BackToCanvas()
    {
        if (_viewingVersion is null)
        {
            return;
        }

        var canvas = WorkingGraph();
        _viewingVersion = null;
        _beforeViewing = null;
        _restoring = true;
        try
        {
            BuildDiagram(canvas);
        }
        finally
        {
            _restoring = false;
        }

        CheckProblems();
    }

    // A version back on the canvas as an ordinary change: saved only when the author saves, and Undo takes it back.
    private async Task RestoreVersionAsync(int version)
    {
        var graph = await VersionGraphAsync(version);
        if (graph is null)
        {
            return;
        }

        _viewingVersion = null;
        _beforeViewing = null;
        _restoring = true;
        try
        {
            BuildDiagram(graph);
        }
        finally
        {
            _restoring = false;
        }

        MarkDirty();
        _message = $"Version {version} is on the canvas - save to keep it, or Undo (Ctrl+Z) to take it back.";
    }

    // What the canvas shows - a version open read-only included - as a pipeline file, downloaded by the
    // editor's script (a Blob, so nothing goes back to the server).
    private async Task ExportAsync()
    {
        if (_diagram is null)
        {
            return;
        }

        var name = _pipeline?.Name + (_viewingVersion is { } version ? $" version {version}" : "");
        try
        {
            await JSRuntime.InvokeVoidAsync("stommePipelineEditorDownload", PipelineExchange.FileName(name), PipelineExchange.Write(_pipeline?.Name, _pipeline?.Description, ToGraph()));
            _message = $"Exported as {PipelineExchange.FileName(name)}.";
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            await logger.LogError(ex, "Error Exporting Pipeline {Error}", ex.Message);
            _error = "The pipeline could not be exported: " + ex.Message;
        }
    }

    // A pipeline file on the canvas in place of what is there, as an ordinary change: saved only when the author saves, and Undo
    // takes it back. The file's name and description stay the file's; this pipeline keeps its own.
    private async Task ImportIntoCanvasAsync(InputFileChangeEventArgs args)
    {
        _error = "";
        _message = "";
        if (!CanManage || _diagram is null)
        {
            return;
        }

        PipelineExchangeDocument document;
        try
        {
            if (args.File.Size > PipelineExchange.MaxBytes)
            {
                throw new PipelineExchangeException($"The file is larger than {PipelineExchange.MaxBytes / (1024 * 1024)} MB.");
            }

            using var reader = new System.IO.StreamReader(args.File.OpenReadStream(PipelineExchange.MaxBytes));
            document = PipelineExchange.Read(await reader.ReadToEndAsync());
        }
        catch (PipelineExchangeException ex)
        {
            _error = $"'{args.File.Name}' was not imported: {ex.Message}";
            return;
        }

        _restoring = true;
        try
        {
            BuildDiagram(document.Graph);
        }
        finally
        {
            _restoring = false;
        }

        MarkDirty();
        var unknown =document.Graph.Steps.Select(step => step.Type).Distinct().Where(type => _catalog?.Any(entry => entry.Type == type) != true).ToList();
        _message = (document.ConvertedFrom == N8nWorkflowImport.Source
                ? $"'{args.File.Name}' (an n8n workflow) is on the canvas - the note on it says what is left to finish; save to keep it, or Undo (Ctrl+Z) to take it back."
                : $"'{args.File.Name}' is on the canvas - save to keep it, or Undo (Ctrl+Z) to take it back.")
            + (unknown.Count == 0 ? "" : $" This site has no step {string.Join(", ", unknown)}: the save will refuse it until it is replaced.");
    }

    // What a variable holds for a step test - what the author typed, else the value kept with the pipeline,
    // the run shown's value or the starting value (the preview's).
    private string TestValue(string name)
    {
        if (_testValues.TryGetValue(name, out var typed))
        {
            return typed;
        }

        return PreviewVariables(out _).FirstOrDefault(variable => variable.Name == name).Value as string;
    }

    private async Task TestSelectedStepAsync(bool upToHere)
    {
        if (_selected is null || _testing)
        {
            return;
        }

        var stepId = _selected.StepId;
        _testing = true;
        _testedStepId = stepId;
        _testedUpToHere = upToHere;
        _testResult = null;
        try
        {
            _testResult = await PipelinesService.TestStepAsync(_definitionId, new StepTestRequest { Graph = ToGraph(), StepId = stepId, Values = TestValuesByName(), UpToHere = upToHere });
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Testing Pipeline Step {Error}", ex.Message);
            _testResult = new StepTestResult { Status = "Refused", Error = "The step could not be tested: " + ex.Message };
        }
        finally
        {
            _testing = false;
        }
    }

    // Each variable holding something for a test, by name; one holding nothing keeps its starting value.
    private Dictionary<string, string> TestValuesByName() => _variables
        .Where(variable => !string.IsNullOrWhiteSpace(variable.Name))
        .GroupBy(variable => variable.Name, StringComparer.Ordinal)
        .Select(group => (Name: group.Key, Value: TestValue(group.Key)))
        .Where(pair => pair.Value is not null)
        .ToDictionary(pair => pair.Name, pair => pair.Value, StringComparer.Ordinal);

    // n8n's "Test workflow": the pipeline as it stands on the canvas, saved or not, run for real and stored nowhere -
    // what each step did shown on the canvas as a run is (its data in the inspector and the wide view), how it went above it.
    private const string DraftTestId = "draft-test";
    private StepTestResult _draftTest;
    private bool _testingDraft;

    private async Task TestDraftAsync()
    {
        if (_diagram is null || !CanManage || _testing)
        {
            return;
        }

        _testing = true;
        _testingDraft = true;
        _draftTest = null;
        StopWatching();
        try
        {
            _draftTest = await PipelinesService.TestStepAsync(_definitionId, new StepTestRequest { Graph = ToGraph(), Values = TestValuesByName(), Whole = true });
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Testing The Pipeline {Error}", ex.Message);
            _draftTest = new StepTestResult { Status = "Refused", Error = "The pipeline could not be tested: " + ex.Message };
        }
        finally
        {
            _testing = false;
            _testingDraft = false;
        }

        var now = DateTime.UtcNow;
        _shownRunId = DraftTestId;
        _shownRun = new PipelineRunView { Id = DraftTestId, Status = "Finished", SubStatus = _draftTest.Status, CreatedOnUtc = now, UpdatedOnUtc = now, FinishedOnUtc = now };
        _runSteps = _draftTest.Steps ?? new List<PipelineStepRunView>();
        _executionIndex = 0;
        ApplyRunToNodes();
    }

    // How the test went, in a line: finished with how many steps run, the step that failed, a wait, a stop or a refusal.
    private string DraftTestSummary(StepTestResult result)
    {
        var ran = (result.Steps ?? new List<PipelineStepRunView>()).Select(step => step.StepId).Distinct(StringComparer.Ordinal).Count();
        var steps = ran == 1 ? "1 step ran" : $"{ran} steps ran";
        return result.Status switch
        {
            "Finished" => $"Tested the pipeline as it stands: finished - {steps}. Nothing was stored.",
            "Faulted" => $"Tested the pipeline as it stands: it failed{(result.Steps?.LastOrDefault(step => step.Status == "Faulted") is { } failed ? " at '" + StepTitle(failed.StepId) + "'" : "")} - {steps}. Nothing was stored.",
            "Suspended" => $"Tested the pipeline as it stands: a step waits - for its trigger, a timer or an event - so the test stops there; {steps}. Nothing was stored.",
            "Stopped" => "Tested the pipeline as it stands: stopped - it took too long.",
            "Refused" => "The pipeline could not be tested.",
            _ => $"Tested the pipeline as it stands: {result.Status?.ToLowerInvariant()} - {steps}.",
        };
    }

    private bool _testedUpToHere;

    // Whether a step has a step before it in its own flowchart - what "Test up to here" would run first.
    // Read off the canvas's own links (the graph's connections are brought up to date only when it is saved or tested).
    private bool LeadsHere(StepNodeModel step) =>
        step is not null && _diagram is not null && _diagram.Links.Any(link =>
            (link.Target as SinglePortAnchor)?.Port is StepPortModel { IsInput: true, Parent: StepNodeModel target } && target.StepId == step.StepId);

    // The steps that lead to this one in its own flowchart, nearest first - those with a Result to read (or every one).
    private List<StepNodeModel> EarlierSteps(StepNodeModel step, bool withResult = true)
    {
        var found = new List<StepNodeModel>();
        if (step is null || _diagram is null)
        {
            return found;
        }

        var seen = new HashSet<string>(StringComparer.Ordinal) { step.StepId };
        var waiting = new Queue<StepNodeModel>();
        waiting.Enqueue(step);
        while (waiting.Count > 0)
        {
            var current = waiting.Dequeue();
            foreach (var link in _diagram.Links)
            {
                if ((link.Target as SinglePortAnchor)?.Port is StepPortModel { IsInput: true, Parent: StepNodeModel target } && target.StepId == current.StepId
                    && (link.Source as SinglePortAnchor)?.Port is StepPortModel { Parent: StepNodeModel source } && seen.Add(source.StepId))
                {
                    found.Add(source);
                    waiting.Enqueue(source);
                }
            }
        }

        return withResult ? found.Where(candidate => candidate.Entry?.Outputs.Any(output => output.Name == ResultOutput) == true).ToList() : found;
    }

    // BL-229 (n8n's "Debug in editor"): what each step leading here produced in the run shown - its last pass's Result - for
    // pinning; a result cut short in the record is left out, as it is not the whole result.
    private List<(StepNodeModel Step, string Result)> RunResultsBefore(StepNodeModel step) =>
        _shownRunId is null || step is null
            ? new List<(StepNodeModel, string)>()
            : EarlierSteps(step, withResult: false)
                .Select(before => (Step: before, Record: _runSteps.LastOrDefault(execution => execution.StepId == before.StepId && execution.OutputsJson is not null)))
                .Where(pair => pair.Record is { Truncated: false })
                .Select(pair => (pair.Step, Result: ResultOf(pair.Record.OutputsJson)))
                .Where(pair => pair.Result is not null)
                .ToList();

    // Every one of them pinned, as one change to save and to undo.
    private void PinRunResultsBefore()
    {
        var pins = RunResultsBefore(_selected);
        if (pins.Count == 0 || !CanManage)
        {
            return;
        }

        foreach (var (step, result) in pins)
        {
            step.Pin(result);
        }

        MarkDirty();
        _message = (pins.Count == 1 ? "Pinned 1 earlier step's result" : $"Pinned {pins.Count} earlier steps' results") + " from this run: Test up to here runs this step on the run's data.";
    }

    private const string ResultOutput = "Result";

    // The variable a step's Result is saved to, while the pipeline still has it.
    private PipelineGraphVariable SavedResultVariable(StepNodeModel step) =>
        step.OutputVariables.TryGetValue(ResultOutput, out var id) ? _variables.FirstOrDefault(variable => variable.Id == id) : null;

    // An earlier step's result put into this expression through the variable its Result saves to - made, named after the step,
    // and bound to it when it saves to none - as one change to save and to undo.
    private void UseEarlierResult(string input, string expression, StepNodeModel source)
    {
        if (_selected is null || !CanManage)
        {
            return;
        }

        var variable = SavedResultVariable(source);
        if (variable is null)
        {
            variable = new PipelineGraphVariable { Id = "var-" + Guid.NewGuid().ToString("N")[..12], Name = PipelineVariableNames.For(source.DisplayName, _variables.Select(known => known.Name)), TypeName = "Object" };
            _variables.Add(variable);
            source.OutputVariables[ResultOutput] = variable.Id;
        }

        _selected.InputExpressions[input] = PipelineTemplate.Accept(expression, "{{ " + variable.Name + " }}");
        MarkDirty();
    }

    private string StepTitle(string stepId) =>
        _diagram?.Nodes.OfType<StepNodeModel>().FirstOrDefault(node => node.StepId == stepId) is { } node
            ? (string.IsNullOrWhiteSpace(node.Name) ? node.Entry?.DisplayName ?? stepId : node.Name)
            : stepId;

    // What a test up to here did: the step reached and how it went, or that it was not reached and why.
    private static string UpToHereSummary(StepTestResult result, PipelineStepRunView tested) =>
        tested is null
            ? result.Status switch
            {
                "Faulted" => "A step before it failed, so it was not reached.",
                "Suspended" => "A step before it waits - for its trigger, a timer or an event - so the test stops there.",
                "Stopped" => "Stopped: it took too long.",
                "Refused" => "Not run.",
                _ => "It was not reached.",
            }
            : "Ran with the steps before it: " + RanAs(tested) + (tested.CompletedAtUtc is { } end ? $" · {(end - tested.StartedAtUtc).TotalMilliseconds:0} ms" : "");

    // How a tested step ended, in a word or three: a failure the pipeline went on past is not "done".
    private static string RanAs(PipelineStepRunView tested) => tested?.Status switch
    {
        null => "done",
        "Completed" when tested.HandledFailure == PipelineStepRunView.TookFailedPath => "failed, and took its Failed path",
        "Completed" when tested.HandledFailure is not null => "failed, and the pipeline would go on",
        "Completed" => "done",
        var other => other.ToLowerInvariant(),
    };

    private static string TestSummary(StepTestResult result, PipelineStepRunView tested) => result.Status switch
    {
        "Finished" => "Ran on its own: " + RanAs(tested) + (tested?.CompletedAtUtc is { } end ? $" · {(end - tested.StartedAtUtc).TotalMilliseconds:0} ms" : ""),
        "Faulted" => "Ran on its own and failed.",
        "Suspended" => "It waits - for its trigger, a timer or an event - so a test of it alone stops there.",
        "Stopped" => "Stopped: it took too long.",
        _ => "Not run.",
    };

    private (string Text, bool Failed, string Source) Preview(string template)
    {
        var known = PreviewValues(out var source);
        try
        {
            var value = PipelineTemplate.Render(template, name =>
            {
                var match = known.FirstOrDefault(variable => variable.Name == name);
                return match.Name is null ? (false, null) : (true, match.Value);
            });
            var text = PipelineTemplate.Text(value);
            return (text.Length == 0 ? "(empty)" : text.Length > 400 ? text[..400] + "…" : text, false, source);
        }
        catch (PipelineTemplateException ex)
        {
            return (ex.Message, true, source);
        }
    }

    private void SetOutputVariable(string name, string variableId)
    {
        if (_selected is null)
        {
            return;
        }

        if (string.IsNullOrEmpty(variableId))
        {
            _selected.OutputVariables.Remove(name);
        }
        else
        {
            _selected.OutputVariables[name] = variableId;
        }

        MarkDirty();
    }

    private void AddVariable()
    {
        var name = (_newVariableName ?? "").Trim();
        if (name.Length == 0)
        {
            _error = "A variable needs a name.";
            return;
        }

        if (_variables.Any(variable => string.Equals(variable.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            _error = $"There is already a variable named '{name}'.";
            return;
        }

        _error = "";
        _variables.Add(new PipelineGraphVariable { Id = "var-" + Guid.NewGuid().ToString("N")[..12], Name = name, TypeName = VariableTypes.Contains(_newVariableType) ? _newVariableType : "Object" });
        _newVariableName = "";
        MarkDirty();
    }

    private void SetVariableValue(string id, string value)
    {
        var variable = _variables.FirstOrDefault(candidate => candidate.Id == id);
        if (variable is null)
        {
            return;
        }

        variable.Value = string.IsNullOrEmpty(value) ? null : value;
        MarkDirty("variable/" + id);
    }

    // Removing a variable unbinds every step that read it or saved to it, so no save names a variable that is gone - the
    // canvas's steps and every body's.
    // A variable renamed, and every expression, condition and case that reads it - as ONE change Undo takes back. A
    // script or a record's rules holding the old name are said, to be checked (PipelineVariableRenames).
    private string _renamingVariable;
    private string _renameTo = "";

    private void StartRenameVariable(string id)
    {
        if (!CanManage || _variables.FirstOrDefault(variable => variable.Id == id) is not { } variable)
        {
            return;
        }

        _renamingVariable = id;
        _renameTo = variable.Name;
        _ = FocusFieldAsync("pipelines-editor-variable-rename-name");
    }

    private void RenameVariableKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            RenameVariable();
        }
        else if (e.Key == "Escape")
        {
            _renamingVariable = null;
        }
    }

    private void RenameVariable()
    {
        var id = _renamingVariable;
        if (id is null || !CanManage || _diagram is null || _viewingVersion is not null)
        {
            return;
        }

        var graph = ToGraph();
        if (PipelineVariableRenames.Problem(_renameTo, graph.Variables, id) is { } problem)
        {
            _error = problem;
            return;
        }

        var from = graph.Variables.First(variable => variable.Id == id).Name;
        var to = _renameTo.Trim();
        var outcome = PipelineVariableRenames.Apply(graph, id, to, _catalog ?? new List<StepCatalogEntry>());
        _restoring = true;
        try
        {
            BuildDiagram(graph);
        }
        finally
        {
            _restoring = false;
        }

        MarkDirty();
        _renamingVariable = null;
        _error = "";
        _message = $"Renamed '{from}' to '{to}'"
            + (outcome.Places switch { 0 => ".", 1 => " - and the one expression or condition reading it.", var places => $" - and the {places} expressions and conditions reading it." })
            + (outcome.ToCheck.Count == 0 ? "" : $" Check {string.Join(", ", outcome.ToCheck.Select(step => "'" + step + "'"))}: a script reads variables by name, and a record's rules may mean a field - they were not changed.");
    }

    private void RemoveVariable(string id)
    {
        _variables.RemoveAll(variable => variable.Id == id);
        foreach (var step in _graph.Steps)
        {
            foreach (var input in step.InputVariables.Where(binding => binding.Value == id).Select(binding => binding.Key).ToList())
            {
                step.InputVariables.Remove(input);
            }

            foreach (var output in step.OutputVariables.Where(binding => binding.Value == id).Select(binding => binding.Key).ToList())
            {
                step.OutputVariables.Remove(output);
            }

            if (step.FailureVariable == id)
            {
                step.FailureVariable = null;
            }
        }

        foreach (var node in _diagram?.Nodes.OfType<StepNodeModel>() ?? Enumerable.Empty<StepNodeModel>())
        {
            if (node.FailureVariable == id)
            {
                node.SetReliability(node.Retries, node.RetryDelaySeconds, node.ContinueOnError, node.FailedPath, null);
            }

            foreach (var input in node.InputVariables.Where(binding => binding.Value == id).Select(binding => binding.Key).ToList())
            {
                node.InputVariables.Remove(input);
            }

            foreach (var output in node.OutputVariables.Where(binding => binding.Value == id).Select(binding => binding.Key).ToList())
            {
                node.OutputVariables.Remove(output);
            }
        }

        MarkDirty();
    }

    private static string Value(Dictionary<string, string> inputs, string name) => inputs.TryGetValue(name, out var value) ? value : "";

    // What an author reads beside an input's name: the kind of value it takes, never a .NET type name (found walking the
    // editor in a browser: "Seconds (Int32)", "Level (LogMessageLevel)"). Text, a checkbox and a dropdown need no word.
    private static readonly HashSet<string> WholeNumbers = new(StringComparer.Ordinal) { "Int16", "Int32", "Int64", "UInt16", "UInt32", "UInt64", "Byte" };
    private static readonly HashSet<string> Numbers = new(StringComparer.Ordinal) { "Single", "Double", "Decimal" };

    private static bool IsWholeNumber(StepInputView input) => WholeNumbers.Contains(input.TypeName);

    private static bool IsNumber(StepInputView input) => IsWholeNumber(input) || Numbers.Contains(input.TypeName);

    private static string KindOf(StepInputView input) =>
        input.Options is { Count: > 0 } || input.UIHint == "checkbox" || input.TypeName is "String" or "Boolean" ? null
        : IsWholeNumber(input) ? "whole number"
        : IsNumber(input) ? "number"
        : input.TypeName switch
        {
            "TimeSpan" => "duration, e.g. 00:05:00",
            "DateTime" or "DateTimeOffset" => "date and time",
            "Guid" => "identifier",
            "Object" or "ExpandoObject" or "JsonElement" or "JsonNode" => "JSON",
            // A loop's Items: a JSON array, or a variable an earlier step saved its records to.
            "ICollection`1" or "IEnumerable`1" or "IList`1" or "List`1" or "IReadOnlyList`1" or "ICollection" or "IEnumerable" => "list, e.g. [\"a\", \"b\"]",
            // Execute pipeline's Input: what the sub-pipeline reads as {{ $input.name }}.
            "IDictionary`2" or "Dictionary`2" or "IReadOnlyDictionary`2" => "JSON object, e.g. {\"order\": 42}",
            _ => input.TypeName,
        };

    private static bool IsTrue(Dictionary<string, string> inputs, string name) => inputs.TryGetValue(name, out var value) && string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);

    // A tick as the run reads it (found driving Guardrails): the value given, or - none given - the step's own default, so
    // a tick that is on unless switched off (CSV's Has header, Map fields' Keep other fields) shows ticked, as it runs.
    private static bool IsTicked(Dictionary<string, string> inputs, string name, string defaultValue) =>
        inputs.TryGetValue(name, out var value) && !string.IsNullOrEmpty(value)
            ? string.Equals(value, "true", StringComparison.OrdinalIgnoreCase)
            : string.Equals(defaultValue, "true", StringComparison.OrdinalIgnoreCase);

    // Every change marks the pipeline unsaved and is one step of undo; a change with a key - typing in
    // one field - joins the step before it while it carries the same key. Nothing is recorded while a snapshot is being
    // restored or a batch (a delete of several steps) is under way.
    private void MarkDirty(string coalesceKey = null)
    {
        _dirty = true;
        _fitOnOpen = false; // a change made before the canvas has its size: the view is the author's now, not the opening's
        _message = "";
        if (!_restoring && _diagram is not null)
        {
            var graph = ToGraph();
            _history.Record(System.Text.Json.JsonSerializer.Serialize(graph), coalesceKey, DateTime.UtcNow);
            CheckProblems(graph);
        }

        InvokeAsync(StateHasChanged);
    }

    private string Snapshot() => System.Text.Json.JsonSerializer.Serialize(ToGraph());

    // The graph's problems (PipelineGraphProblems - the server's publish refuses on its errors), on the
    // steps and in the list above the canvas. Run after every change, a load, an undo and a merged save.
    private void CheckProblems(PipelineGraph graph = null)
    {
        graph = _catalog is null || _diagram is null ? null : graph ?? ToGraph();
        _problems = graph is null
            ? new List<PipelineGraphProblem>()
            : PipelineGraphProblems.Find(graph, _catalog, CallContracts(graph), string.IsNullOrEmpty(_definitionId) ? null : _definitionId);
        if (graph is not null)
        {
            _problems.AddRange(ScriptProblems(graph));
            // An operation's required parameters its step does not give (n8n marks a node's required fields): only the editor
            // knows each connection's connector.
            if (_connections is not null && _connectors is not null)
            {
                _problems.AddRange(PipelineConnectorProblems.Find(graph, _catalog, id => ConnectionChoices.ConnectorOf(id, _connections, _connectors)));
            }
        }

        ApplyProblemsToNodes();
        RefreshComparison(graph);
    }

    // n8n's Code node linting: every script checked to parse as its step runs it, by the server's parser, a moment after
    // the author stops typing. Kept by its text and style, so a result holds wherever that text is and none is shown for a text
    // that is no longer there.
    private readonly Dictionary<string, string> _scriptChecked = new(StringComparer.Ordinal);
    private CancellationTokenSource _scriptCheckDelay;
    private const int ScriptCheckDelayMilliseconds = 500;
    private const int ScriptChecksKept = 500;

    // A script is known by its text, its style and the names it may read: a variable added to its step checks it again.
    private static string ScriptKey(string style, IReadOnlyList<string> names, string script) =>
        (style ?? "") + "\u0001" + (names is null ? "\u0002" : string.Join(",", names)) + "\u0001" + script;

    // The names a Run script step's Variables lines give ('name = value', one per line).
    private static List<string> VariableNamesOf(string lines)
    {
        var names = new List<string>();
        foreach (var line in (lines ?? "").Split('\n'))
        {
            if (line.IndexOf('=') is > 0 and var at)
            {
                names.Add(line[..at].Trim());
            }
        }

        return names;
    }

    // The scripts a graph holds: each code input given as a value (a Run script step's, in the style the step says it is written
    // for, with the names its Variables lines give - so a name it reads and can see nowhere is said too), and every input given
    // as JavaScript (checked to parse only: it reads every variable in scope, more than the editor knows).
    private IEnumerable<(PipelineGraphStep Step, string Input, string Style, IReadOnlyList<string> Names, string Script)> ScriptsOf(PipelineGraph graph)
    {
        foreach (var step in graph.Steps)
        {
            var entry = _catalog?.FirstOrDefault(candidate => candidate.Type == step.Type);
            foreach (var input in entry?.Inputs.Where(input => input.UIHint == "code-editor") ?? Enumerable.Empty<StepInputView>())
            {
                if (step.Inputs.TryGetValue(input.Name, out var code) && !string.IsNullOrWhiteSpace(code)
                    && !step.InputExpressions.ContainsKey(input.Name) && !step.InputVariables.ContainsKey(input.Name) && !step.InputScripts.ContainsKey(input.Name))
                {
                    yield return (step, input.Name, step.Inputs.TryGetValue("Style", out var style) ? style : "",
                        VariableNamesOf(step.Inputs.TryGetValue("Variables", out var lines) ? lines : ""), code);
                }
            }

            foreach (var (input, script) in step.InputScripts)
            {
                if (!string.IsNullOrWhiteSpace(script))
                {
                    yield return (step, input, "", null, script);
                }
            }
        }
    }

    // Those checked and found not to parse, as warnings on their inputs - the save does not parse scripts, but the step fails
    // when it runs; any not checked yet are asked about shortly.
    private List<PipelineGraphProblem> ScriptProblems(PipelineGraph graph)
    {
        var found = new List<PipelineGraphProblem>();
        var waiting = false;
        foreach (var (step, input, style, names, script) in ScriptsOf(graph))
        {
            if (!_scriptChecked.TryGetValue(ScriptKey(style, names, script), out var problem))
            {
                waiting = true;
            }
            else if (problem is not null)
            {
                var name = string.IsNullOrWhiteSpace(step.Name) ? _catalog?.FirstOrDefault(entry => entry.Type == step.Type)?.DisplayName ?? step.Type : step.Name;
                found.Add(new PipelineGraphProblem
                {
                    StepId = step.Id, Step = name, Input = input, Severity = PipelineGraphProblems.Warning, Code = PipelineGraphProblems.ScriptDoesNotParse,
                    Message = problem + ". The step fails when it runs.",
                });
            }
        }

        if (waiting)
        {
            CheckScriptsSoon();
        }

        return found;
    }

    private void CheckScriptsSoon()
    {
        _scriptCheckDelay?.Cancel();
        _scriptCheckDelay = new CancellationTokenSource();
        _ = CheckScriptsAsync(_scriptCheckDelay.Token);
    }

    private async Task CheckScriptsAsync(CancellationToken cancel)
    {
        try
        {
            await Task.Delay(ScriptCheckDelayMilliseconds, cancel);
            if (_diagram is null || _catalog is null)
            {
                return;
            }

            var asked = ScriptsOf(ToGraph())
                .Select(found => (found.Style, found.Names, found.Script, Key: ScriptKey(found.Style, found.Names, found.Script)))
                .Where(found => !_scriptChecked.ContainsKey(found.Key))
                .DistinctBy(found => found.Key)
                .Take(200)
                .ToList();
            if (asked.Count == 0)
            {
                return;
            }

            var answered = await PipelinesService.CheckScriptsAsync(new PipelineScriptCheckRequest
            {
                Scripts = asked.Select(found => new PipelineScriptCheck { Script = found.Script, Style = found.Style, Names = found.Names?.ToList() }).ToList(),
            });
            await InvokeAsync(() =>
            {
                if (_scriptChecked.Count > ScriptChecksKept)
                {
                    _scriptChecked.Clear(); // every keystroke is a text of its own: the latest are what matter
                }

                var found = false;
                for (var at = 0; at < asked.Count; at++)
                {
                    var problem = answered?.Problems?.ElementAtOrDefault(at);
                    _scriptChecked[asked[at].Key] = problem;
                    found |= problem is not null;
                }

                // A script that parses shows nothing it did not show before it was checked, so only a problem found draws again.
                if (found)
                {
                    CheckProblems();
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
            // typed again, or the editor closed: the next pause asks
        }
        catch (ObjectDisposedException)
        {
            // the editor closed while it was asked
        }
        catch (Exception ex)
        {
            // Not checked is not a problem: nothing is said, and the next change asks again.
            await logger.LogDebug(ex, "Error Checking Pipeline Scripts {Error}", ex.Message);
        }
    }

    // Each step on the canvas: its own problems, and those of the steps its bodies hold (at any depth), which the canvas
    // does not show while it shows this body.
    private void ApplyProblemsToNodes()
    {
        if (_diagram is null)
        {
            return;
        }

        foreach (var node in _diagram.Nodes.OfType<StepNodeModel>())
        {
            node.ShowProblems(
                _problems.Where(problem => problem.StepId == node.StepId).ToList(),
                _problems.Where(problem => problem.StepId != node.StepId && IsInside(problem.StepId, node.StepId)).ToList());
        }
    }

    // Whether a step sits, at any depth, in the bodies of another.
    private bool IsInside(string stepId, string holderId) => IsInside(_graph.Steps, stepId, holderId);

    // The same in a graph's steps - a version compared holds steps the canvas no longer does; none, nothing is inside.
    private static bool IsInside(IReadOnlyList<PipelineGraphStep> steps, string stepId, string holderId)
    {
        var seen = new HashSet<string>(StringComparer.Ordinal);
        for (var step = steps?.FirstOrDefault(candidate => candidate.Id == stepId); step?.Parent is not null && seen.Add(step.Id);)
        {
            if (step.Parent == holderId)
            {
                return true;
            }

            var parent = step.Parent;
            step = steps.FirstOrDefault(candidate => candidate.Id == parent);
        }

        return false;
    }

    private void GoToProblem(PipelineGraphProblem problem) => GoToStep(problem.StepId);

    // Find on the canvas - the matches for what is typed, none until something is.
    private string _findText = "";
    private List<PipelineGraphMatch> _findMatches;
    private int _findIndex = -1;

    private void SetFind(string text)
    {
        _findText = text ?? "";
        _findIndex = -1;
        _findMatches = string.IsNullOrWhiteSpace(_findText) || _diagram is null ? null : PipelineGraphFind.Find(ToGraph(), _catalog, _findText);
    }

    // Enter goes to the next match and Shift+Enter to the one before, as a browser's find does; Escape clears it.
    private void FindKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            SetFind("");
            return;
        }

        if (e.Key != "Enter" || _findMatches is not { Count: > 0 } matches)
        {
            return;
        }

        GoToMatch(_findIndex < 0 ? (e.ShiftKey ? matches.Count - 1 : 0) : (_findIndex + (e.ShiftKey ? -1 : 1) + matches.Count) % matches.Count);
    }

    private void GoToMatch(int index)
    {
        if (_findMatches is not { } matches || index < 0 || index >= matches.Count)
        {
            return;
        }

        _findIndex = index;
        GoToStep(matches[index].StepId);
    }

    // From a list to the step: the body that holds it on the canvas, the step selected and in the middle of the view.
    private void GoToStep(string stepId)
    {
        if (_diagram is null)
        {
            return;
        }

        Fold();
        var step = _graph.Steps.FirstOrDefault(candidate => candidate.Id == stepId);
        if (step is null)
        {
            return;
        }

        var parent = string.IsNullOrEmpty(step.Parent) ? null : step.Parent;
        if (parent != _scopeParent || (parent is not null && step.ParentPort != _scopePort))
        {
            ShowLevel(parent, step.ParentPort);
        }

        var node = _diagram.Nodes.OfType<StepNodeModel>().FirstOrDefault(candidate => candidate.StepId == stepId);
        if (node is null)
        {
            return;
        }

        _diagram.SelectModel(node, unselectOthers: true);
        _selected = node;
        var container = _diagram.Container;
        if (container is { Width: > 0, Height: > 0 })
        {
            var width = node.Size?.Width is > 0 ? node.Size.Width : CanvasFit.DefaultStepWidth;
            var height = node.Size?.Height is > 0 ? node.Size.Height : CanvasFit.DefaultStepHeight;
            _diagram.SetPan(container.Width / 2 - (node.Position.X + width / 2) * _diagram.Zoom, container.Height / 2 - (node.Position.Y + height / 2) * _diagram.Zoom);
        }

        StateHasChanged();
    }

    private string ProblemsSummary()
    {
        var errors = _problems.Count(problem => problem.Severity == PipelineGraphProblems.Error);
        var warnings = _problems.Count - errors;
        var warned = warnings == 0 ? "" : warnings == 1 ? "1 warning" : warnings + " warnings";
        if (errors == 0)
        {
            return warned + " - nothing that keeps the pipeline from being published";
        }

        var fix = (errors == 1 ? "1 problem" : errors + " problems") + " to fix before publishing";
        return warnings == 0 ? fix : fix + ", " + warned;
    }

    private void Undo() => Restore(_history.Undo());

    private void Redo() => Restore(_history.Redo());

    private void Restore(string state)
    {
        if (state is null)
        {
            return;
        }

        var graph = System.Text.Json.JsonSerializer.Deserialize<PipelineGraph>(state) ?? new PipelineGraph();
        // The steps selected before stay selected where they still exist, so an undo does not empty the inspector.
        var kept = new HashSet<string>(SelectedNodes().Select(node => node.StepId), StringComparer.Ordinal);
        _restoring = true;
        try
        {
            BuildDiagram(graph);
            foreach (var node in _diagram.Nodes.OfType<StepNodeModel>().Where(node => kept.Contains(node.StepId)))
            {
                _diagram.SelectModel(node, unselectOthers: false);
                _selected = node;
            }
        }
        finally
        {
            _restoring = false;
        }

        CheckProblems();

        _dirty = true;
        _message = "";
        StateHasChanged();
    }

    private List<StepNodeModel> SelectedNodes() =>
        _diagram?.GetSelectedModels().OfType<StepNodeModel>().ToList() ?? new List<StepNodeModel>();

    // The selected steps, what they hold and the connections among them (StepClipboard).
    private void Copy()
    {
        var chosen = SelectedNodes().Select(node => node.StepId).ToList();
        if (chosen.Count == 0)
        {
            _message = "Select the steps to copy first (Ctrl+click adds one, Shift+drag draws a box, Ctrl+A takes all).";
            return;
        }

        Fold();
        _clipboard = StepClipboard.Copy(_graph, chosen);
        _clipboardVariables = StepClipboard.VariablesUsed(_clipboard, _variables);
        _message = chosen.Count == 1 ? "Copied 1 step." : $"Copied {chosen.Count} steps.";
    }

    // The copy on the SYSTEM clipboard too: a pipeline file holding the copied steps and the variables they use, so they paste
    // into another pipeline, another tab or another site (n8n's copy). The editor's script writes it after Ctrl+C.
    [JSInvokable]
    public string CopySelection()
    {
        Copy();
        InvokeAsync(StateHasChanged);
        return _clipboard is null ? null : PipelineExchange.Write(null, null, new PipelineGraph
        {
            Steps = _clipboard.Steps,
            Connections = _clipboard.Connections,
            Variables = _clipboardVariables ?? new List<PipelineGraphVariable>(),
        });
    }

    // BL-229, n8n's mapping: a variable or a field dragged onto an input's VALUE (pipelines-editor.js) - the value becomes an
    // expression ending in the placeholder, so it reads what was dropped instead of sending "{{ ... }}" as typed. An expression
    // takes the drop in place (the browser's own); a value that is not text is never dropped on.
    [JSInvokable]
    public Task OnDropIntoInput(string name, string placeholder)
    {
        if (_selected?.Entry is null || !CanManage || string.IsNullOrEmpty(name) || !PipelineTemplate.HasPlaceholders(placeholder)
            || _selected.Entry.Inputs.All(input => input.Name != name)
            || (_selected.Entry.OutcomesFrom == StepCatalogEntry.BranchesOutcomes && name == StepCatalogEntry.BranchesOutcomes))
        {
            return Task.CompletedTask;
        }

        var typed = _selected.Inputs.TryGetValue(name, out var value) ? value ?? "" : "";
        _selected.InputExpressions[name] = typed.Length == 0 ? placeholder : typed + " " + placeholder;
        SetInputSource(name, ExpressionSource);
        return InvokeAsync(StateHasChanged);
    }

    // What the browser pasted (Ctrl+V): steps copied from any pipeline editor, with their variables; nodes copied in n8n, brought
    // over (N8nWorkflowImport) with their notes and the note of what is left to finish; a curl command as an HTTP request step
    // filled from it (n8n's paste of one onto its canvas) - else the editor's own copy.
    [JSInvokable]
    public Task OnPasteText(string text)
    {
        if (!CanManage || _diagram is null)
        {
            return Task.CompletedTask;
        }

        PipelineExchangeDocument document = null;
        try
        {
            document = string.IsNullOrWhiteSpace(text) ? null : PipelineExchange.Read(text);
        }
        catch (PipelineExchangeException)
        {
            // not steps copied from an editor: a curl command, or the editor's own copy, if there is one
        }

        if (document?.Graph is { Steps.Count: > 0 } graph)
        {
            var fromN8n = document.ConvertedFrom == N8nWorkflowImport.Source;
            Paste(graph, graph.Variables, fromN8n ? graph.Notes : null);
            if (fromN8n)
            {
                _message = $"Pasted n8n's nodes as {graph.Steps.Count} {(graph.Steps.Count == 1 ? "step" : "steps")} - the note beside them says what is left to finish.";
            }
        }
        else if (text?.TrimStart().StartsWith("curl", StringComparison.OrdinalIgnoreCase) == true
            && PipelineCurl.Parse(text, out _) is { } curl
            && _catalog?.FirstOrDefault(entry => entry.Type == CurlStepType) is { } http)
        {
            AddStep(http, at: null, fill: node => ApplyCurl(node, curl));
            _message = "Pasted the curl command as an HTTP request step.";
        }
        else
        {
            Paste();
        }

        return InvokeAsync(StateHasChanged);
    }

    // The copy as new steps in the body the canvas shows, offset from the originals, and selected.
    private void Paste()
    {
        if (_clipboard is not null)
        {
            Paste(_clipboard, _clipboardVariables);
        }
    }

    private void Paste(PipelineGraph copy, IEnumerable<PipelineGraphVariable> variables, IEnumerable<PipelineGraphNote> notes = null)
    {
        if (copy is null || _diagram is null || !CanManage)
        {
            return;
        }

        Fold();
        var pasted = StepClipboard.Paste(copy, _scopeParent, _scopePort, () => Guid.NewGuid().ToString("N"));
        var added = StepClipboard.MergeVariables(pasted, variables, _variables);
        _variables.AddRange(added);
        _graph.Steps.AddRange(pasted.Steps);
        _graph.Connections.AddRange(pasted.Connections);
        // Notes that come with a paste (n8n's, and what is left to finish) land beside the steps, as far off as they are.
        foreach (var note in notes ?? Enumerable.Empty<PipelineGraphNote>())
        {
            _graph.Notes.Add(new PipelineGraphNote
            {
                Id = "note-" + Guid.NewGuid().ToString("N")[..8],
                Text = note.Text,
                Color = note.Color,
                Position = new GraphPosition { X = (note.Position?.X ?? 0) + StepClipboard.PasteOffset, Y = (note.Position?.Y ?? 0) + StepClipboard.PasteOffset },
                Parent = _scopeParent,
                ParentPort = _scopeParent is null ? null : _scopePort,
            });
        }

        var placed = new HashSet<string>(pasted.Steps.Where(step => step.Parent == _scopeParent).Select(step => step.Id), StringComparer.Ordinal);
        ShowScope();
        var first = true;
        foreach (var node in _diagram.Nodes.OfType<StepNodeModel>().Where(node => placed.Contains(node.StepId)))
        {
            _diagram.SelectModel(node, unselectOthers: first);
            _selected = node;
            first = false;
        }

        MarkDirty();
        if (added.Count > 0)
        {
            _message = "Pasted, with " + (added.Count == 1 ? "the variable " : "the variables ") + string.Join(", ", added.Select(variable => "'" + variable.Name + "'")) + " it uses.";
        }
    }

    // Every selected step (with what it holds) and every selected connection, as ONE step to undo.
    private void DeleteSelection()
    {
        if (_diagram is null || !CanManage)
        {
            return;
        }

        var models = _diagram.GetSelectedModels().ToList();
        if (models.Count == 0)
        {
            return;
        }

        _menu = null; // Ctrl+X too: the menu was for what is gone
        _restoring = true;
        try
        {
            foreach (var link in models.OfType<BaseLinkModel>())
            {
                _diagram.Links.Remove(link);
            }

            foreach (var node in models.OfType<StepNodeModel>())
            {
                _diagram.Nodes.Remove(node);
            }

            foreach (var note in models.OfType<NoteNodeModel>())
            {
                _diagram.Nodes.Remove(note);
            }
        }
        finally
        {
            _restoring = false;
        }

        _selected = null;
        _selectedNote = null;
        MarkDirty();
    }

    // A sticky note where the author is looking - the middle of the view, or below the steps.
