    private void ConnectionMade(string input, Stomme.Connectivity.ConnectionView made)
    {
        _connections = _connections.Where(connection => connection.Id != made.Id).Append(made).OrderBy(connection => connection.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
