    // A pipeline's folder is the pipeline's, not a version's: moving it is not an edit and publishes nothing. A folder already on
    // the list keeps its spelling - one folder, whatever case it is typed in.
    private async Task MoveAsync(PipelineView pipeline)
    {
        _error = "";
        _message = "";
        var folder = PipelineFolders.Normalize(_moveTo, out var problem);
        if (problem is not null)
        {
            _error = problem;
            return;
        }

        folder = PipelineFolders.Spelled(folder, (_pipelines ?? new List<PipelineView>()).Select(other => other.Folder));
        _busy = true;
        try
        {
            pipeline.Folder = await PipelinesService.SetFolderAsync(pipeline.DefinitionId, folder) ?? "";
            _moving = null;
            _message = pipeline.Folder.Length == 0 ? $"'{pipeline.Name}' is at the top of the list now." : $"'{pipeline.Name}' is in {pipeline.Folder} now.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Moving Pipeline {Error}", ex.Message);
            _error = ex is Stomme.Services.ServiceRefusalException or ArgumentException ? "The pipeline was not moved: " + ex.Message : "The pipeline could not be moved.";
        }
        finally
        {
            _busy = false;
        }
    }

    // What is created in a folder goes in it, as n8n's does: a new pipeline, a starter, an import - and a copy goes where its
    // original is. It is made either way: a folder refused is said.
    private async Task PlaceInFolderAsync(string definitionId, string folder)
    {
        if (string.IsNullOrEmpty(folder) || string.IsNullOrEmpty(definitionId))
        {
            return;
        }

        try
        {
            await PipelinesService.SetFolderAsync(definitionId, folder);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Placing Pipeline In Folder {Error}", ex.Message);
            _error = $"It was made, but not put in {folder} - move it from its row's More.";
        }
    }

    // A starter chosen names the new pipeline after itself while no name of the author's own is typed - as a workflow made from
    // an n8n template is named after it - so Create needs one choice, not two.
    private void ChooseStarter(string id)
    {
        var named = PipelineStarters.Find(_starterId)?.Name;
        _starterId = id ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_newName) || _newName == named)
        {
            _newName = PipelineStarters.Find(_starterId)?.Name ?? string.Empty;
        }
    }

    private async Task CreateAsync()
    {
        if (PipelineStarters.Find(_starterId) is { } starter)
        {
            await ImportAsync(new ImportPipelineRequest { Name = _newName, Description = string.IsNullOrWhiteSpace(_newDescription) ? starter.Description : _newDescription, Graph = starter.Graph() });
            return;
        }

        _busy = true;
        _error = "";
        _message = "";
        try
        {
            var created = await PipelinesService.CreatePipelineAsync(new CreatePipelineRequest { Name = _newName, Description = _newDescription });
            _newName = "";
            _newDescription = "";
            _message = $"Created '{created.Name}' as a draft" + (_folder.Length == 0 ? "." : $", in {_folder}.");
            await PlaceInFolderAsync(created.DefinitionId, _folder);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Creating Pipeline {Error}", ex.Message);
            _error = "The pipeline was refused: it needs a name of at most 200 characters.";
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }

    // BL-229 increment 10: a file read here (its shape checked by the one reader the editor uses too), stored by the server only
    // once its save would accept it.
    private async Task ImportFileAsync(InputFileChangeEventArgs args)
    {
        _error = "";
        _message = "";
        IReadOnlyList<PipelineExchangeDocument> documents;
        try
        {
            // BL-229: n8n's export of many workflows is one file too - each a pipeline of its own (PipelineExchange.ReadMany).
            if (args.File.Size > PipelineExchange.MaxManyBytes)
            {
                throw new PipelineExchangeException($"The file is larger than {PipelineExchange.MaxManyBytes / (1024 * 1024)} MB.");
            }

            using var reader = new System.IO.StreamReader(args.File.OpenReadStream(PipelineExchange.MaxManyBytes));
            documents = PipelineExchange.ReadMany(await reader.ReadToEndAsync());
        }
        catch (PipelineExchangeException ex)
        {
            _error = $"'{args.File.Name}' was not imported: {ex.Message}";
            return;
        }

        if (documents.Count > 1)
        {
            await ImportManyAsync(documents, System.IO.Path.GetFileNameWithoutExtension(args.File.Name));
            return;
        }

        var document = documents[0];
        var name = !string.IsNullOrWhiteSpace(_newName) ? _newName
            : !string.IsNullOrWhiteSpace(document.Name) ? document.Name
            : System.IO.Path.GetFileNameWithoutExtension(args.File.Name);
        await ImportAsync(new ImportPipelineRequest { Name = name, Description = string.IsNullOrWhiteSpace(_newDescription) ? document.Description : _newDescription, Graph = document.Graph });
    }

    // BL-229: each workflow of n8n's export a draft of its own, judged by the save as any import is; the list says how many came
    // over, and which did not and why - the rest are not held back by one. A file of this site's many (a folder exported) keeps
    // its folders below the one shown, and once every pipeline is made, the calls among them are pointed at the new ones.
    private async Task ImportManyAsync(IReadOnlyList<PipelineExchangeDocument> documents, string fileName)
    {
        _busy = true;
        var created = 0;
        var refused = new List<string>();
        var becameOf = new Dictionary<string, string>(StringComparer.Ordinal);
        var made = new List<(string DefinitionId, PipelineExchangeDocument Document)>();
        try
        {
            for (var index = 0; index < documents.Count; index++)
            {
                var name = !string.IsNullOrWhiteSpace(documents[index].Name) ? documents[index].Name : fileName + " " + (index + 1);
                try
                {
                    var imported = await PipelinesService.ImportPipelineAsync(new ImportPipelineRequest { Name = name, Description = documents[index].Description, Graph = documents[index].Graph });
                    created++;
                    await PlaceInFolderAsync(imported?.DefinitionId, PipelineExchange.FolderIn(_folder, documents[index].Folder));
                    if (imported?.DefinitionId is { } definitionId)
                    {
                        made.Add((definitionId, documents[index]));
                        if (documents[index].Id is { } id)
                        {
                            becameOf[id] = definitionId;
                        }
                    }
                }
                catch (Exception ex)
                {
                    await logger.LogError(ex, "Error Importing Pipeline {Error}", ex.Message);
                    refused.Add($"'{name}' ({ex.Message})");
                }
            }

            var repointed = 0;
            foreach (var (definitionId, document) in made.Where(pair => PipelineExchange.References(pair.Document.Graph).Any(becameOf.ContainsKey)))
            {
                try
                {
                    var changed = PipelineExchange.Repoint(document.Graph, becameOf);
                    await PipelinesService.SaveGraphAsync(definitionId, document.Graph);
                    repointed += changed;
                }
                catch (Exception ex)
                {
                    await logger.LogError(ex, "Error Pointing Imported Calls {Error}", ex.Message);
                    refused.Add($"'{document.Name}' was made, but still calls the pipelines it was exported with ({ex.Message})");
                }
            }

            var fromN8n = documents.Any(document => document.ConvertedFrom == N8nWorkflowImport.Source);
            _newName = "";
            _newDescription = "";
            await LoadAsync();
            _message = $"Imported {created} of {documents.Count} pipelines as drafts"
                + (repointed == 0 ? "" : $" - what they named of each other now names the new pipelines ({(repointed == 1 ? "1 place" : $"{repointed} places")})")
                + (fromN8n ? " - each brought over from n8n has a note on its canvas of what is left to finish." : ".");
            _error = refused.Count == 0 ? _error : "Not created: " + string.Join("; ", refused) + ".";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportAsync(ImportPipelineRequest request)
    {
        _busy = true;
        _error = "";
        _message = "";
        try
        {
            var created = await PipelinesService.ImportPipelineAsync(request);
            _newName = "";
            _newDescription = "";
            _starterId = "";
            await PlaceInFolderAsync(created.DefinitionId, _folder);
            NavigationManager.NavigateTo(NavigateUrl(ModuleState.ModuleId, "Editor", "definition=" + created.DefinitionId));
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Importing Pipeline {Error}", ex.Message);
            _error = $"'{request.Name}' was not created: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PublishAsync(PipelineView pipeline)
    {
        _error = "";
        _message = "";
        try
        {
            var result = await PipelinesService.PublishPipelineAsync(pipeline.DefinitionId);
            _message = result.Succeeded
                ? $"Published '{pipeline.Name}' version {pipeline.Version}."
                : $"'{pipeline.Name}' was not published: {string.Join("; ", result.Errors)}";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Publishing Pipeline {Error}", ex.Message);
            _error = "The pipeline could not be published.";
        }

        await LoadAsync();
    }

    // BL-229 - before a pipeline stops running (archived or retracted - only a published version runs): what stops working with it,
    // read from the map (PipelineLinks.LeftBehind) - asked only when something does; when nothing does, nothing is asked.
    private const string LeaveArchive = "archive";
    private const string LeaveRetract = "retract";
    private PipelineView _leaving;
    private string _leavingAction;
    private List<string> _leavingSaid = new();

    private async Task<List<string>> LeftBehindAsync(IEnumerable<string> leaving)
    {
        try
        {
            return PipelineLinks.LeftBehind(await PipelinesService.GetMapAsync(), leaving);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading The Pipeline Map {Error}", ex.Message);
            return new List<string> { "Which other pipelines run it could not be read." };
        }
    }

    private async Task AskBeforeLeavingAsync(PipelineView pipeline, string action)
    {
        _error = "";
        _message = "";
        _leaving = null;
        _busy = true;
        List<string> said;
        try
        {
            said = await LeftBehindAsync(new[] { pipeline.DefinitionId });
        }
        finally
        {
            _busy = false;
        }

        if (said.Count > 0)
        {
            (_leaving, _leavingAction, _leavingSaid) = (pipeline, action, said);
            return;
        }

        await (action == LeaveRetract ? RetractAsync(pipeline) : ArchiveAsync(pipeline));
    }

    private async Task LeaveAnywayAsync()
    {
        var (pipeline, action) = (_leaving, _leavingAction);
        _leaving = null;
        if (pipeline is not null)
        {
            await (action == LeaveRetract ? RetractAsync(pipeline) : ArchiveAsync(pipeline));
        }
    }

    private async Task RetractAsync(PipelineView pipeline)
    {
        _error = "";
        _message = "";
        try
        {
            await PipelinesService.RetractPipelineAsync(pipeline.DefinitionId);
            _message = $"Retracted '{pipeline.Name}'.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Retracting Pipeline {Error}", ex.Message);
            _error = "The pipeline could not be retracted.";
        }

        await LoadAsync();
    }

    // BL-229 - n8n's archive: set aside - unpublished, so nothing starts it - and out of the list until it is restored or deleted.
    private async Task ArchiveAsync(PipelineView pipeline)
    {
        string message = null;
        string error = null;
        try
        {
            await PipelinesService.ArchivePipelineAsync(pipeline.DefinitionId);
            message = $"Archived '{pipeline.Name}': it does not run. Restore it, or delete it for good, under Archived.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Archiving Pipeline {Error}", ex.Message);
            error = "The pipeline could not be archived.";
        }

        await LoadAsync();
        (_message, _error) = (message ?? "", error ?? "");
    }

    private async Task RestoreAsync(PipelineView pipeline)
    {
        string message = null;
        string error = null;
        try
        {
            await PipelinesService.RestorePipelineAsync(pipeline.DefinitionId);
            message = $"Restored '{pipeline.Name}' as a draft - publish it to run it again.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Restoring Pipeline {Error}", ex.Message);
            error = "The pipeline could not be restored.";
        }

        await LoadAsync();
        (_message, _error) = (message ?? "", error ?? "");
        if (error is null && _pipelines?.Any(other => other.ArchivedOnUtc is not null) != true)
        {
            _showArchived = false; // the archive is empty: back to the pipelines
        }
    }

    private async Task DeleteAsync(PipelineView pipeline)
    {
        _error = "";
        _message = "";
        try
        {
            await PipelinesService.DeletePipelineAsync(pipeline.DefinitionId);
            _message = $"Deleted '{pipeline.Name}' and every version of it.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Pipeline {Error}", ex.Message);
            _error = "The pipeline could not be deleted.";
        }

        var (message, error) = (_message, _error);
        await LoadAsync();
        (_message, _error) = (message, error);
        if (_pipelines?.Any(other => other.ArchivedOnUtc is not null) != true)
        {
            _showArchived = false; // the archive is empty: back to the pipelines
        }
    }

    // BL-229 - n8n's archive: the list shows the pipelines in use, or - when asked - the ones set aside.
    private bool _showArchived;

    // Start = dispatch and leave. The run's page observes it by polling; nothing here waits for the engine.
    private async Task StartAsync(PipelineView pipeline)
    {
        _error = "";
        _message = "";
        try
        {
            var started = await PipelinesService.StartPipelineAsync(pipeline.DefinitionId, new StartPipelineRequest());
            NavigationManager.NavigateTo(NavigateUrl(ModuleState.ModuleId, "Run", "id=" + started.RunId + "&started=1"));
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Starting Pipeline {Error}", ex.Message);
            // The server's reason when it refused (BL-222) - e.g. a pipeline that runs one at a time, with a run still going.
            // On a Server site the handler's own exception carries it; over HTTP the refusal does.
            _error = ex is Stomme.Services.ServiceRefusalException or InvalidOperationException ? "The run could not be started: " + ex.Message : "The run could not be started.";
        }
    }

    // A copy is the pipeline's graph imported under a new name - judged by the save's rule like any import - and opened in the
    // editor; a draft until it is published, so a trigger it holds starts nothing yet.
    private async Task DuplicateAsync(PipelineView pipeline)
    {
        _error = "";
        _message = "";
        _busy = true;
        try
        {
            var graph = await PipelinesService.GetGraphAsync(pipeline.DefinitionId) ?? new PipelineGraph();
            var copy = await PipelinesService.ImportPipelineAsync(new ImportPipelineRequest { Name = CopyName(pipeline.Name), Description = pipeline.Description, Graph = graph });
            if (pipeline.Tags?.Count > 0)
            {
                await PipelinesService.SetTagsAsync(copy.DefinitionId, pipeline.Tags);
            }

            await PlaceInFolderAsync(copy.DefinitionId, pipeline.Folder);

            NavigationManager.NavigateTo(NavigateUrl(ModuleState.ModuleId, "Editor", "definition=" + copy.DefinitionId));
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Duplicating Pipeline {Error}", ex.Message);
            _error = "The pipeline could not be duplicated.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>The copy's name: the pipeline's, said to be a copy, within the 200 characters a name may have.</summary>
    public static string CopyName(string name)
    {
        const string suffix = " (copy)";
        var original = (name ?? "").Trim();
        return (original.Length + suffix.Length > 200 ? original[..(200 - suffix.Length)] : original) + suffix;
    }
}
