    private async Task RenameFolderAsync()
    {
        var folders = (_pipelines ?? new List<PipelineView>()).Select(pipeline => pipeline.Folder);
        var to = PipelineFolders.Normalize(_folderTo, out var problem);
        if ((problem ?? PipelineFolders.MoveProblem(folders, _folder, to)) is { } refused)
        {
            _error = refused;
            return;
        }

        await MoveFolderAsync(new PipelineFolderMoveRequest { Folder = _folder, NewFolder = to }, moved =>
            $"'{PipelineFolders.Name(_folder)}' is {moved.Folder} now{(moved.Moved == 1 ? ", with its pipeline." : $", with its {moved.Moved} pipelines.")}");
    }

    // BL-229: the pipelines in the folder shown - and in the folders inside it; every one at the top - as one file, each with its
    // id and its folder below this one (PipelineExchange.WriteMany). Archived ones stay behind, as the list leaves them out.
    private async Task ExportFolderAsync()
    {
        _error = "";
        _message = "";
        var chosen = (_pipelines ?? new List<PipelineView>())
            .Where(pipeline => pipeline.ArchivedOnUtc is null && PipelineFolders.IsWithin(pipeline.Folder, _folder))
            .OrderBy(pipeline => pipeline.Folder ?? "", StringComparer.CurrentCultureIgnoreCase).ThenBy(pipeline => pipeline.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        if (chosen.Count > PipelineExchange.MaxWorkflows)
        {
            _error = $"{chosen.Count} pipelines are more than one file holds ({PipelineExchange.MaxWorkflows}) - export a folder inside it.";
            return;
        }

        _busy = true;
        try
        {
            var documents = new List<PipelineExchangeDocument>();
            foreach (var pipeline in chosen)
            {
                documents.Add(new PipelineExchangeDocument
                {
                    Id = pipeline.DefinitionId,
                    Name = pipeline.Name,
                    Description = pipeline.Description,
                    Folder = PipelineFolders.Moved(pipeline.Folder, _folder, ""),
                    Graph = await PipelinesService.GetGraphAsync(pipeline.DefinitionId) ?? new PipelineGraph(),
                });
            }

            var file = PipelineExchange.FileName(_folder.Length == 0 ? "all" : PipelineFolders.Name(_folder)).Replace(".pipeline.json", ".pipelines.json", StringComparison.Ordinal);
            await JSRuntime.InvokeVoidAsync("stommePipelineEditorDownload", file, PipelineExchange.WriteMany(documents));
            _message = $"Exported {(documents.Count == 1 ? "1 pipeline" : $"{documents.Count} pipelines")} as {file} - imported on another site, its folders are kept and the calls among them run the copies.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Exporting Pipelines {Error}", ex.Message);
            _error = "The pipelines could not be exported: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task RemoveFolderAsync() =>
        MoveFolderAsync(new PipelineFolderMoveRequest { Folder = _folder, Remove = true }, moved =>
            $"'{PipelineFolders.Name(_folder)}' is removed; {(moved.Moved == 1 ? "its pipeline is" : $"its {moved.Moved} pipelines are")} in {(moved.Folder.Length == 0 ? "the top of the list" : moved.Folder)} now.");

    // The server moves every pipeline in the folder - the archived ones too - and the list is read again, then shows where they went.
    private async Task MoveFolderAsync(PipelineFolderMoveRequest request, Func<PipelineFolderMoveResult, string> said)
    {
        _error = "";
        _message = "";
        _busy = true;
        try
        {
            var moved = await PipelinesService.MoveFolderAsync(request);
            if (moved is null)
            {
                await LoadAsync();
                OpenFolder("");
                _error = "That folder has no pipeline in it any more - the list is read again.";
                return;
            }

            var message = said(moved);
            await LoadAsync();
            OpenFolder(moved.Folder);
            _message = message;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Moving Folder {Error}", ex.Message);
            _error = ex is Stomme.Services.ServiceRefusalException or ArgumentException ? "The folder was not changed: " + ex.Message : "The folder could not be changed.";
        }
        finally
        {
            _busy = false;
        }
    }

    // A new folder is opened before anything is in it - it is there once a pipeline is created in it or moved to it.
    private void NewFolder()
    {
        var name = PipelineFolders.Normalize(_newFolder, out var error);
        var path = error is null && name.Length > 0 ? PipelineFolders.Normalize(_folder.Length == 0 ? name : _folder + PipelineFolders.Separator + name, out error) : "";
        if (error is not null || path.Length == 0)
        {
            _error = error ?? "A folder needs a name.";
            return;
        }

        _error = "";
        _newFolder = "";
        _folder = path;
        _message = $"'{PipelineFolders.Name(path)}' is open - a pipeline created here goes in it, or move one here from its row's More.";
    }

    private void NewFolderKey(KeyboardEventArgs args)
