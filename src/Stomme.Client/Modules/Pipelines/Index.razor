    // Every word typed, anywhere in the name, the description or a tag, ignoring case - the step search's rule; and every tag
    // chosen in the filter (BL-229, n8n's tag filter).
    public static IEnumerable<PipelineView> Matching(IEnumerable<PipelineView> pipelines, string search, IReadOnlyCollection<string> tags = null)
    {
        var words = (search ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return pipelines.Where(pipeline =>
            words.All(word =>
                (pipeline.Name ?? "").Contains(word, StringComparison.CurrentCultureIgnoreCase)
                || (pipeline.Description ?? "").Contains(word, StringComparison.CurrentCultureIgnoreCase)
                || (pipeline.Tags ?? new List<string>()).Any(tag => tag.Contains(word, StringComparison.CurrentCultureIgnoreCase)))
            && (tags ?? Array.Empty<string>()).All(tag => (pipeline.Tags ?? new List<string>()).Contains(tag, StringComparer.OrdinalIgnoreCase)));
    }

    /// <summary>Every tag the site's pipelines carry, once whatever its case, in order.</summary>
    public static List<string> TagsOf(IEnumerable<PipelineView> pipelines) =>
        pipelines.SelectMany(pipeline => pipeline.Tags ?? new List<string>())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(tag => tag, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

