    private async Task MoveChosenAsync(List<PipelineView> chosen)
    {
        var folder = PipelineFolders.Normalize(_chosenText, out var problem);
        if (problem is not null)
        {
            _error = problem;
            return;
        }

        folder = PipelineFolders.Spelled(folder, (_pipelines ?? new List<PipelineView>()).Select(other => other.Folder));
        await ForEachChosenAsync(chosen, pipeline => PipelinesService.SetFolderAsync(pipeline.DefinitionId, folder),
            done => $"Moved {Count(done)} to {(folder.Length == 0 ? "the top of the list" : folder)}.");
    }

    private async Task TagChosenAsync(List<PipelineView> chosen)
    {
        var tag = PipelineTags.Normalize(new List<string> { _chosenText }, out var problem);
        if (problem is not null || tag.Count == 0)
        {
            _error = problem ?? "A tag needs a name.";
            return;
        }

        await ForEachChosenAsync(chosen, pipeline =>
        {
            var tags = (pipeline.Tags ?? new List<string>()).Append(tag[0]).ToList();
            PipelineTags.Normalize(tags, out var tooMany);
            return tooMany is null ? PipelinesService.SetTagsAsync(pipeline.DefinitionId, tags) : throw new ArgumentException(tooMany);
        }, done => $"Tagged {Count(done)} {tag[0]}.");
    }

