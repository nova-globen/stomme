            const string file = "chosen.pipelines.json";
            await JSRuntime.InvokeVoidAsync("stommePipelineEditorDownload", file, PipelineExchange.WriteMany(documents));
            _message = $"Exported {Count(documents.Count)} as {file} - imported on another site, the calls among them run the copies.";
