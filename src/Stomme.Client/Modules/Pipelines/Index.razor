    // Them as one file (PipelineExchange.WriteMany): browsing a folder, each one's folder below it; found by a search, its own.
    private async Task ExportChosenAsync(List<PipelineView> chosen, bool browsing)
    {
        _error = "";
        _message = "";
        _busy = true;
        try
        {
            var documents = new List<PipelineExchangeDocument>();
            foreach (var pipeline in chosen)
            {
                documents.Add(new PipelineExchangeDocument
                {
                    Id = pipeline.DefinitionId,
