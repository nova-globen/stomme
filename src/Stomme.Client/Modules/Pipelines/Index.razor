            _busy = false;
        }
    }

    private static string Count(int pipelines) => pipelines == 1 ? "1 pipeline" : $"{pipelines} pipelines";

    private async Task ForEachChosenAsync(List<PipelineView> chosen, Func<PipelineView, Task> act, Func<int, string> said)
    {
        _error = "";
        _message = "";
        _busy = true;
        var done = 0;
        var refused = new List<string>();
        try
        {
            foreach (var pipeline in chosen)
            {
                try
                {
                    await act(pipeline);
                    done++;
                    _chosen.Remove(pipeline.DefinitionId);
                }
                catch (Exception ex) when (ex is Stomme.Services.ServiceRefusalException or ArgumentException)
                {
                    refused.Add($"'{pipeline.Name}' ({ex.Message})"); // refused, saying why - an answer, not an error
                }
                catch (Exception ex)
                {
                    await logger.LogError(ex, "Error Acting On A Chosen Pipeline {Error}", ex.Message);
                    refused.Add($"'{pipeline.Name}' (it could not be done)");
                }
            }

            _chosenAction = null;
            await LoadAsync();
            _message = said(done);
            _error = refused.Count == 0 ? "" : "Not done: " + string.Join("; ", refused) + ".";
        }
        finally
        {
            _busy = false;
        }
    }

