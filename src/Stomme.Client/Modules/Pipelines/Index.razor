    private async Task LoadAsync()
    {
        _busy = true;
        _error = "";
        try
        {
            _pipelines = await PipelinesService.GetPipelinesAsync(withLastRuns: true) ?? new List<PipelineView>();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Pipelines {Error}", ex.Message);
            _error = "The pipelines could not be loaded.";
        }
        finally
        {
            _busy = false;
        }

        try
        {
            _variables = (await PipelinesService.GetSiteVariablesAsync() ?? new Dictionary<string, string>())
                .OrderBy(pair => pair.Key, StringComparer.Ordinal).Select(pair => (pair.Key, pair.Value)).ToList();
        }
        catch (Exception ex)
        {
            await logger.LogInformation("The site's pipeline variables could not be read: {Error}", ex.Message);
            _variables = null;
        }

        try
        {
            _openComments = await PipelinesService.GetOpenCommentCountsAsync() ?? new Dictionary<string, int>();
        }
        catch (Exception ex)
        {
            await logger.LogInformation("The pipelines' open comments could not be counted: {Error}", ex.Message);
            _openComments = new Dictionary<string, int>(); // the list works without them
        }

        try
        {
            _approvals = (await PipelinesService.GetApprovalsAsync() ?? new List<PipelineApprovalView>()).Count;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Pipeline Approvals {Error}", ex.Message);
            _approvals = 0; // the list works without the count
        }

        await InsightsAsync(_insights?.Days.ToString(System.Globalization.CultureInfo.InvariantCulture));
        await UpcomingAsync(_upcoming?.Hours.ToString(System.Globalization.CultureInfo.InvariantCulture));
        if (_map is not null)
        {
            // An open map follows the list: a pipeline archived, retracted or added changes it.
            try
            {
                _map = await PipelinesService.GetMapAsync() ?? new PipelineMapView();
            }
            catch (Exception ex)
            {
                await logger.LogInformation("The pipeline map could not be read again: {Error}", ex.Message);
            }
        }

        if (_activity is not null)
        {
            // An open activity list follows the list too: what was just done is its newest line.
            try
            {
                _activity = await PipelinesService.GetAuditAsync() ?? new List<PipelineAuditEntryView>();
            }
            catch (Exception ex)
            {
                await logger.LogInformation("The pipelines' activity could not be read again: {Error}", ex.Message);
            }
        }
    }

