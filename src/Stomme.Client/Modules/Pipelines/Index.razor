    private (List<(PipelineMapNode Node, double X, double Y)> Nodes, List<(string Kind, string Path, string Title)> Lines, double Width, double Height, int Alone) MapDrawing()
    {
        var linked = _map.Links.SelectMany(link => new[] { link.From, link.To }).Concat(_map.Nodes.Where(node => node.WatchesEvery).Select(node => node.DefinitionId))
            .ToHashSet(StringComparer.Ordinal);
        var shown = _map.Nodes.Where(node => linked.Contains(node.DefinitionId)).OrderBy(node => node.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        var graph = new PipelineGraph
        {
            Steps = shown.Select(node => new PipelineGraphStep { Id = node.DefinitionId, Type = "map" }).ToList(),
            Connections = _map.Links.Select(link => new PipelineGraphConnection { SourceId = link.From, TargetId = link.To }).ToList(),
        };
        Stomme.Modules.Pipelines.Canvas.AutoLayout.Arrange(graph);
        var at = graph.Steps.ToDictionary(step => step.Id, step => (X: step.Position.X, Y: Canvas.AutoLayout.Top + (step.Position.Y - Canvas.AutoLayout.Top) * MapRowScale), StringComparer.Ordinal);
        var nodes = shown.Select(node => (node, at[node.DefinitionId].X, at[node.DefinitionId].Y)).ToList();
        var names = _map.Nodes.ToDictionary(node => node.DefinitionId, node => node.Name, StringComparer.Ordinal);
        var lines = new List<(string, string, string)>();
        foreach (var link in _map.Links.Where(link => at.ContainsKey(link.From) && at.ContainsKey(link.To)))
        {
            var (fromX, fromY) = (at[link.From].X + MapNodeWidth, at[link.From].Y + MapNodeHeight / 2);
            var (toX, toY) = (at[link.To].X, at[link.To].Y + MapNodeHeight / 2);
            var bend = Math.Max(40, Math.Abs(toX - fromX) / 2);
            var path = string.Create(System.Globalization.CultureInfo.InvariantCulture, $"M {fromX} {fromY} C {fromX + bend} {fromY}, {toX - bend} {toY}, {toX} {toY}");
            lines.Add((link.Kind, path, $"{names.GetValueOrDefault(link.From)} {Said(link.Kind)} {names.GetValueOrDefault(link.To)}"));
        }

        var width = nodes.Count == 0 ? 0 : nodes.Max(node => node.Item2) + MapNodeWidth + 30;
        var height = nodes.Count == 0 ? 0 : nodes.Max(node => node.Item3) + MapNodeHeight + 30;
        return (nodes, lines, width, height, _map.Nodes.Count - shown.Count);
    }

    private static string Said(string kind) => kind switch
    {
        PipelineLinks.Calls => "calls",
        PipelineLinks.Starts => "starts",
        PipelineLinks.OnFailure => "failing starts",
        PipelineLinks.AsTool => "may use as an AI tool",
        _ => kind,
    };

