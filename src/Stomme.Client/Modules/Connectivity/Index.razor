@namespace Stomme.Modules.Connectivity
@inherits ModuleBase
@inject IConnectionsService ConnectionsService

@*
    The Connections page (BL-94 increment 7, D110): this site's connections to external systems, with the installed
    connectors as the editor's picker. A holder of connections:view reads; a holder of connections:manage adds, edits,
    tests and deletes. The form (ConnectionForm, which the pipeline editor uses too) renders the chosen connector's declared
    settings and its scheme's credential fields; a credential is typed in and never read back - on an edit a blank one
    means "leave it". Every button that appears is decided again by the server when it is pressed.
*@

<PageTitle>Connections</PageTitle>

@if (!IsAuthorizedPermission(ConnectionPermissions.View))
{
    <p class="db-connections-denied" style="color:var(--db-text-2);">You do not have access to connections on this site (@ConnectionPermissions.View).</p>
}
else
{
    <div class="db-connections" style="display:flex;flex-direction:column;gap:1rem;">
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:baseline;">
            <h3 style="margin:0;flex:1 1 auto;">Connections</h3>
            <button id="connections-refresh" type="button" class="db-btn" @onclick="LoadAsync" disabled="@_busy">Refresh</button>
        </div>

        @if (_connections is null)
        {
            <p style="margin:0;color:var(--db-text-2);">Loading…</p>
        }
        else if (_connections.Count == 0)
        {
            <p id="connections-empty" style="margin:0;color:var(--db-text-2);">No connections.</p>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="db-connections-table" style="width:100%;border-collapse:collapse;">
                    <thead>
                        <tr>
                            <th style="text-align:left;">Name</th>
                            <th style="text-align:left;">Connector</th>
                            <th style="text-align:left;">Endpoint</th>
                            <th style="text-align:left;">Credentials</th>
                            <th style="text-align:left;">Status</th>
                            <th style="text-align:left;">Last tested</th>
                            <th style="width:1px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var connection in _connections)
                        {
                            <tr id="connection-@connection.Id">
                                <td>@connection.Name</td>
                                <td>@connection.ConnectorDisplayName</td>
                                <td style="font-family:monospace;">@connection.Endpoint</td>
                                <td style="color:var(--db-text-2);">@(connection.HasCredentials ? string.Join(", ", connection.CredentialFields) : "none")</td>
                                <td>@connection.Status @(connection.ConnectorInstalled ? "" : "(connector not installed)")</td>
                                <td style="font-family:monospace;">@(connection.LastTestedUtc?.ToString("u") ?? "—")</td>
                                <td style="white-space:nowrap;">
                                    @if (_canManage)
                                    {
                                        <button type="button" class="db-btn" @onclick="@(() => TestAsync(connection))" disabled="@_busy">Test</button>
                                        <button type="button" class="db-btn" @onclick="@(() => Edit(connection))" disabled="@_busy">Edit</button>
                                        <ActionDialog Header="Delete Connection" Message="@($"Delete the connection '{connection.Name}' and its stored credentials? It cannot be undone.")" Action="Delete" Security="SecurityAccessLevel.Anonymous" Class="db-btn db-btn-danger" OnClick="@(async () => await DeleteAsync(connection))" Disabled="@_busy" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_canManage)
        {
            <section id="connections-editor" style="display:flex;flex-direction:column;gap:0.5rem;max-width:40rem;">
                <h3 style="margin:0;">@(_editing is null ? "New connection" : $"Edit '{_editing.Name}'")</h3>
                <ConnectionForm Connectors="_connectors" Editing="_editing" OnSaved="SavedAsync" OnCancel="CancelEdit" />
            </section>
        }

        <section id="connections-egress" style="display:flex;flex-direction:column;gap:0.5rem;max-width:40rem;">
            <h3 style="margin:0;">Private hosts</h3>
            <p style="margin:0;color:var(--db-text-2);">A connection - and the AI assistant's model endpoint - reaches a private or loopback address only when its host is listed here: a database on the local network, or a model server on this machine. Exact host names or IP addresses.</p>
            @if (_egress is null)
            {
                <p style="margin:0;color:var(--db-text-2);">Loading…</p>
            }
            else if (_egress.CanEdit)
            {
                <textarea id="connections-egress-hosts" class="db-input" rows="3" placeholder="10.0.0.5, db.corp.example.com" @bind="_egressText"></textarea>
                <div style="display:flex;gap:0.5rem;">
                    <button id="connections-egress-save" type="button" class="db-btn" @onclick="SaveEgressAsync" disabled="@_busy">Save private hosts</button>
                </div>
            }
            else
            {
                <p id="connections-egress-list" style="margin:0;font-family:monospace;">@(_egress.AllowedHosts.Count == 0 ? "None - every private and loopback address is refused." : string.Join(", ", _egress.AllowedHosts))</p>
                <p style="margin:0;color:var(--db-text-2);font-size:0.85em;">Only a Host user may change this: it opens the installation's own network to this site.</p>
            }
        </section>

        @if (!string.IsNullOrEmpty(_message))
        {
            <p id="connections-message" style="margin:0;">@_message</p>
        }

        <p id="connections-trademarks" style="margin:0;font-size:0.85em;color:var(--db-text-2);">@ConnectorTrademarkNotice.Text</p>
    </div>
}

@code {
    private List<ConnectionView> _connections;
    private List<ConnectorView> _connectors = new();
    private bool _busy;
    private bool _canManage;
    private string _message = string.Empty;

    private ConnectionView _editing;
    private ConnectionEgressView _egress;
    private string _egressText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _canManage = IsAuthorizedPermission(ConnectionPermissions.Manage);
        await LoadAsync();
        await LoadEgressAsync();
        if (_canManage)
        {
            try
            {
                _connectors = await ConnectionsService.ListConnectorsAsync();
            }
            catch (Exception ex)
            {
                await logger.LogError(ex, "Could not load the connectors.");
            }
        }
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _connections = await ConnectionsService.ListAsync();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Could not load the connections.");
            _connections = new List<ConnectionView>();
        }
        finally
        {
            _busy = false;
        }
    }

    // The private hosts (BL-180): every viewer reads them; the server lets only the Host change them, and says so in CanEdit.
    private async Task LoadEgressAsync()
    {
        try
        {
            _egress = await ConnectionsService.GetEgressAsync();
            _egressText = string.Join(", ", _egress?.AllowedHosts ?? Array.Empty<string>());
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Could not load the private hosts.");
        }
    }

    private async Task SaveEgressAsync()
    {
        _busy = true;
        try
        {
            _egress = await ConnectionsService.SaveEgressAsync(_egressText);
            _egressText = string.Join(", ", _egress.AllowedHosts);
            _message = _egress.AllowedHosts.Count == 0 ? "No private host is allowed." : $"Private hosts saved: {string.Join(", ", _egress.AllowedHosts)}.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Could not save the private hosts.");
            _message = "The private hosts were not saved: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Edit(ConnectionView connection)
    {
        _editing = connection; // the form loads it; its credentials are never read back
        _message = string.Empty;
        BringIntoView("connections-editor"); // below the list (BL-22)
    }

    private void CancelEdit() => _editing = null;

    // The form saved one: said here, the list read again, the form back to a new connection.
    private async Task SavedAsync(ConnectionView saved)
    {
        _message = $"'{saved.Name}' saved.";
        _editing = null;
        await LoadAsync();
    }

    private async Task TestAsync(ConnectionView connection)
    {
        _busy = true;
        try
        {
            var result = await ConnectionsService.TestAsync(connection.Id);
            _message = $"'{connection.Name}': {result.Message} ({result.Status})";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Could not test connection {ConnectionId}.", connection.Id);
            _message = "The connection was not tested: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }

    private async Task DeleteAsync(ConnectionView connection)
    {
        _busy = true;
        try
        {
            await ConnectionsService.DeleteAsync(connection.Id);
            _message = $"'{connection.Name}' deleted.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Could not delete connection {ConnectionId}.", connection.Id);
            _message = "The connection was not deleted: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
        StateHasChanged(); // called back from the confirmation dialog, not from an event of this page (BL-22)
    }
}
