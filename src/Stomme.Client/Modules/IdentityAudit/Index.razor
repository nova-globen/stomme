@namespace Stomme.Modules.IdentityAudit
@inherits ModuleBase
@inject IIdentityAuditService AuditService

@*
    The identity audit ledger: who signed in, who failed, who was locked out, whose password was reset and whose
    roles changed on this site. Administrators only - the page is placed for them and the server decides every read
    again. Plain markup, so it reads the same in Static, Interactive and Headless.
*@

<PageTitle>Identity Audit</PageTitle>

<div class="db-identity-audit" style="display:flex;flex-direction:column;gap:1rem;">
    <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:baseline;">
        <h3 style="margin:0;flex:1 1 auto;">Identity audit</h3>
        <label for="identity-audit-days" style="color:var(--db-text-2);">Last</label>
        <select id="identity-audit-days" class="db-select" style="width:auto;" @bind="_days" @bind:after="LoadAsync">
            <option value="1">day</option>
            <option value="7">7 days</option>
            <option value="30">30 days</option>
            <option value="90">90 days</option>
            <option value="365">year</option>
        </select>
        <button id="identity-audit-refresh" type="button" class="db-btn" @onclick="LoadAsync" disabled="@_busy">Refresh</button>
    </div>

    @if (_entries is null)
    {
        <p style="margin:0;color:var(--db-text-2);">Loading…</p>
    }
    else if (_entries.Count == 0)
    {
        <p id="identity-audit-empty" style="margin:0;color:var(--db-text-2);">Nothing was recorded on this site in this period.</p>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="db-identity-audit-table" style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr>
                        <th style="text-align:left;">When (UTC)</th>
                        <th style="text-align:left;">Event</th>
                        <th style="text-align:left;">Account</th>
                        <th style="text-align:left;">By</th>
                        <th style="text-align:left;">From</th>
                        <th style="text-align:left;">Detail</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _entries)
                    {
                        <tr>
                            <td>@entry.OccurredOnUtc.ToString("u")</td>
                            <td>@entry.Event</td>
                            <td>@(string.IsNullOrEmpty(entry.SubjectName) ? (entry.SubjectUserId is null ? "(unknown account)" : $"#{entry.SubjectUserId}") : entry.SubjectName)</td>
                            <td>@(entry.ActorUserId is null ? "—" : $"#{entry.ActorUserId}")</td>
                            <td>@(string.IsNullOrEmpty(entry.RemoteAddress) ? "—" : entry.RemoteAddress)</td>
                            <td style="color:var(--db-text-2);">@(string.IsNullOrEmpty(entry.Detail) ? "—" : entry.Detail)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<IdentityAuditEntryView> _entries;
    private int _days = 30;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _entries = await AuditService.GetRecentAsync(_days);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Could not load the identity audit ledger.");
            _entries = new List<IdentityAuditEntryView>();
        }
        finally
        {
            _busy = false;
        }
    }
}
