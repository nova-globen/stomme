@namespace Stomme.Modules.Admin.SystemInfo
@inherits ModuleBase
@inject ISystemService SystemService
@inject IInstallationService InstallationService
@inject IMigrationHistoryService MigrationHistoryService
@inject ITenantService TenantService
@inject IStringLocalizer<Index> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer

@if (_initialized)
{
    <TabStrip>
        <TabPanel Name="Info" Heading="Info" ResourceKey="Info">
            <div class="db-fields">
                <div class="db-field">
                    <Label For="version" HelpText="Framework version" ResourceKey="FrameworkVersion">Framework version</Label>
                    <div class="db-field-control">
                        <input id="version" class="db-input" @bind="@_version" readonly />
                    </div>
                </div>
                <div class="db-field">
                    <Label For="clrversion" HelpText="Common language runtime version" ResourceKey="CLRVersion">CLR version</Label>
                    <div class="db-field-control">
                        <input id="clrversion" class="db-input" @bind="@_clrversion" readonly />
                    </div>
                </div>
                <div class="db-field">
                    <Label For="osversion" HelpText="Operating system version" ResourceKey="OSVersion">OS version</Label>
                    <div class="db-field-control">
                        <input id="osversion" class="db-input" @bind="@_osversion" readonly />
                    </div>
                </div>
                <div class="db-field">
                    <Label For="process" HelpText="Indicates if the current process is 32 bit or 64 bit" ResourceKey="Process">Process</Label>
                    <div class="db-field-control">
                        <input id="process" class="db-input" @bind="@_process" readonly />
                    </div>
                </div>
                <div class="db-field">
                    <Label For="machinename" HelpText="Machine name of the server" ResourceKey="MachineName">Server</Label>
                    <div class="db-field-control">
                        <input id="machinename" class="db-input" @bind="@_machinename" readonly />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_instance))
                {
                    <div class="db-field">
                        <Label For="instance" HelpText="Instance" ResourceKey="Instance">Instance</Label>
                        <div class="db-field-control">
                            <input id="instance" class="db-input" @bind="@_instance" readonly />
                        </div>
                    </div>
                }
                <div class="db-field">
                    <Label For="ipaddress" HelpText="Server IP address" ResourceKey="IPAddress">IP address</Label>
                    <div class="db-field-control">
                        <input id="ipaddress" class="db-input" @bind="@_ipaddress" readonly />
                    </div>
                </div>
                <div class="db-field">
                    <Label For="environment" HelpText="Environment name" ResourceKey="Environment">Environment</Label>
                    <div class="db-field-control">
                        <input id="environment" class="db-input" @bind="@_environment" readonly />
                    </div>
                </div>
                <div class="db-field">
                    <Label For="contentrootpath" HelpText="Root path" ResourceKey="ContentRootPath">Root path</Label>
                    <div class="db-field-control">
                        <input id="contentrootpath" class="db-input" @bind="@_contentrootpath" readonly />
                    </div>
                </div>
                <div class="db-field">
                    <Label For="webrootpath" HelpText="Web path" ResourceKey="WebRootPath">Web path</Label>
                    <div class="db-field-control">
                        <input id="webrootpath" class="db-input" @bind="@_webrootpath" readonly />
                    </div>
                </div>
                <div class="db-field">
                    <Label For="servertime" HelpText="Server date/time (in UTC)" ResourceKey="ServerTime">Server date/time</Label>
                    <div class="db-field-control">
                        <input id="servertime" class="db-input" @bind="@_servertime" readonly />
                    </div>
                </div>
                <div class="db-field">
                    <Label For="workingset" HelpText="Memory allocation of service (in MB)" ResourceKey="WorkingSet">Memory allocation</Label>
                    <div class="db-field-control">
                        <input id="workingset" class="db-input" @bind="@_workingset" readonly />
                    </div>
                </div>
                <div class="db-field">
                    <Label For="installationid" HelpText="The unique identifier for your installation" ResourceKey="InstallationId">Installation ID</Label>
                    <div class="db-field-control">
                        <input id="installationid" class="db-input" @bind="@_installationid" readonly />
                    </div>
                </div>
            </div>
            <br /><br />
            <ActionDialog Header="Restart application" Message="Are You Sure You Wish To Restart The Application?" Action="Restart Application" Security="SecurityAccessLevel.Host" Class="db-btn db-btn-danger" OnClick="@(async () => await RestartApplication())" ResourceKey="RestartApplication" />
        </TabPanel>
        <TabPanel Name="Options" Heading="Options" ResourceKey="Options">
            <div class="db-fields">
                <div class="db-field">
                    <Label For="detailederrors" HelpText="Specify if detailed errors are enabled for Blazor. This option should not be enabled in production." ResourceKey="DetailedErrors">Detailed errors?</Label>
                    <div class="db-field-control">
                        <select id="detailederrors" class="db-select" @bind="@_detailederrors">
                            <option value="true">@SharedLocalizer["True"]</option>
                            <option value="false">@SharedLocalizer["False"]</option>
                        </select>
                    </div>
                </div>
                <div class="db-field">
                    <Label For="logginglevel" HelpText="The minimum logging level for the event log. This option can be used to control the volume of items stored in your event log." ResourceKey="LoggingLevel">Logging level</Label>
                    <div class="db-field-control">
                        <select id="logginglevel" class="db-select" @bind="@_logginglevel">
                            <option value="Trace">@Localizer["Trace"]</option>
                            <option value="Debug">@Localizer["Debug"]</option>
                            <option value="Information">@Localizer["Information"]</option>
                            <option value="Warning">@Localizer["Warning"]</option>
                            <option value="Error">@Localizer["Error"]</option>
                            <option value="Critical">@Localizer["Critical"]</option>
                            <option value="None">@Localizer["None"]</option>
                        </select>
                    </div>
                </div>
                <div class="db-field">
                    <Label For="notificationlevel" HelpText="The minimum logging level for which notifications should be sent to Host users" ResourceKey="NotificationLevel">Notification level</Label>
                    <div class="db-field-control">
                        <select id="notificationlevel" class="db-select" @bind="@_notificationlevel">
                            <option value="Trace">@Localizer["Trace"]</option>
                            <option value="Debug">@Localizer["Debug"]</option>
                            <option value="Information">@Localizer["Information"]</option>
                            <option value="Warning">@Localizer["Warning"]</option>
                            <option value="Error">@Localizer["Error"]</option>
                            <option value="Critical">@Localizer["Critical"]</option>
                            <option value="None">@Localizer["None"]</option>
                        </select>
                    </div>
                </div>
                <div class="db-field">
                    <Label For="broadcast" HelpText="The minimum logging level for which events should be broadcast to Registered logging providers" ResourceKey="Broadcast">Broadcast level</Label>
                    <div class="db-field-control">
                        <select id="broadcast" class="db-select" @bind="@_broadcast">
                            <option value="Trace">@Localizer["Trace"]</option>
                            <option value="Debug">@Localizer["Debug"]</option>
                            <option value="Information">@Localizer["Information"]</option>
                            <option value="Warning">@Localizer["Warning"]</option>
                            <option value="Error">@Localizer["Error"]</option>
                            <option value="Critical">@Localizer["Critical"]</option>
                            <option value="None">@Localizer["None"]</option>
                        </select>
                    </div>
                </div>
                <div class="db-field">
                    <Label For="swagger" HelpText="Specify if Swagger is enabled for your server API" ResourceKey="Swagger">Swagger enabled?</Label>
                    <div class="db-field-control">
                        <select id="swagger" class="db-select" @bind="@_swagger">
                            <option value="true">@SharedLocalizer["True"]</option>
                            <option value="false">@SharedLocalizer["False"]</option>
                        </select>
                    </div>
                </div>
                <br />
                <Section Name="Caching" Heading="Caching" ResourceKey="Caching">
                    <div class="db-fields">
                        <div class="db-field">
                            <Label For="cacheduration" HelpText="The amount of time (in minutes) when a cache item is considered to be expired" ResourceKey="CacheDuration">Cache duration</Label>
                            <div class="db-field-control">
                                <input id="cacheduration" class="db-input" @bind="@_cacheduration" />
                            </div>
                        </div>
                        <div class="db-field">
                            <Label For="failsafe" HelpText="Specify if you wish to temporarily reuse an expired value if a problem occurs when loading data" ResourceKey="FailSafe">Use fail safe?</Label>
                            <div class="db-field-control">
                                <select id="failsafe" class="db-select" @bind="@_failsafe">
                                    <option value="true">@SharedLocalizer["Yes"]</option>
                                    <option value="false">@SharedLocalizer["No"]</option>
                                </select>
                            </div>
                        </div>
                        <div class="db-field">
                            <Label For="distributedcache" HelpText="Specify if you are using a distributed cache service" ResourceKey="DistributedCache">Using distributed cache?</Label>
                            <div class="db-field-control">
                                <select id="distributedcache" class="db-select" value="@_distributedcache" @onchange="(e => DistributedCacheChanged(e))">
                                    <option value="true">@SharedLocalizer["Yes"]</option>
                                    <option value="false">@SharedLocalizer["No"]</option>
                                </select>
                            </div>
                        </div>
                        <div class="db-field">
                            <Label For="scaleout" HelpText="Specify if you are using a scale out approach which includes multiple web instances. A distributed cache service is required for synchronization in this scenario." ResourceKey="ScaleOut">Using scale out?</Label>
                            <div class="db-field-control">
                                <select id="scaleout" class="db-select" value="@_scaleout" @onchange="(e => ScaleOutChanged(e))">
                                    <option value="true">@SharedLocalizer["Yes"]</option>
                                    <option value="false">@SharedLocalizer["No"]</option>
                                </select>
                            </div>
                        </div>
                        @if (_distributedcache == "true" || _scaleout == "true")
                        {
                            <div class="db-field">
                                <Label For="distributedconnection" HelpText="Provide the connection string for the distributed cache service" ResourceKey="DistributedConnection">Connection string</Label>
                                <div class="db-field-control">
                                    <div class="db-input-group">
                                        <input id="distributedconnection" type="@_distributedconnectiontype" class="db-input" @bind="@_distributedconnection" />
                                        <button type="button" class="db-btn db-btn-neutral" @onclick="@ToggleDistributedConnection" tabindex="-1">@_toggledistributedconnection</button>
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="db-field">
                            <Label For="cachecontrol" HelpText="Provide a cache-control directive for static assets. For example 'public, max-age=60' indicates that static assets should be cached for 60 seconds. A blank value indicates caching for static assets is not enabled." ResourceKey="CacheControl">Static asset cache-control</Label>
                            <div class="db-field-control">
                                <input id="cachecontrol" class="db-input" @bind="@_cachecontrol" />
                            </div>
                        </div>
                    </div>
                    <br />
                    <ActionDialog Header="Clear cache" Message="Are You Sure You Wish To Clear The Entire Cache? Every Cached Value Is Removed And Reloaded On Next Use." Action="Clear All" Security="SecurityAccessLevel.Host" Class="db-btn db-btn-danger" OnClick="@(async () => await ClearCache())" ResourceKey="ClearCache" />
                </Section>
                <br />
                <Section Name="Marketplace" Heading="Marketplace" ResourceKey="Marketplace">
                    <div class="db-fields">
                        <div class="db-field">
                            <Label For="packageregistryurl" HelpText="Specify the URL of the package manager service for installing modules, themes, and translations. If this field is blank it means the package manager service is disabled for this installation." ResourceKey="PackageManager">Package manager URL</Label>
                            <div class="db-field-control">
                                <input id="packageregistryurl" class="db-input" @bind="@_packageregistryurl" />
                            </div>
                        </div>
                        <div class="db-field">
                            <Label For="packageregistryemail" HelpText="Specify the email address of the user account used for interacting with the package manager service. This account is used for managing packages across multiple installations." ResourceKey="PackageManagerEmail">Package manager email</Label>
                            <div class="db-field-control">
                                <input id="packageregistryemail" class="db-input" @bind="@_packageregistryemail" />
                            </div>
                        </div>
                    </div>
                </Section>
            </div>
            <br /><br />
            <button type="button" class="db-btn" @onclick="SaveConfig">@SharedLocalizer["Save"]</button>&nbsp;
            <ActionDialog Header="Restart application" Message="Are You Sure You Wish To Restart The Application?" Action="Restart Application" Security="SecurityAccessLevel.Host" Class="db-btn db-btn-danger" OnClick="@(async () => await RestartApplication())" ResourceKey="RestartApplication" />
            <br /><br />
            <a class="db-btn" href="/openapi/v1.json" target="_new">@Localizer["OpenApi"]</a>&nbsp;
            <a class="db-btn db-btn-neutral" href="api/endpoint" target="_new">@Localizer["Endpoints"]</a>
        </TabPanel>
        <TabPanel Name="Log" Heading="Log" ResourceKey="Log">
            <div class="db-fields">
                <div class="db-field">
                    <Label For="log" HelpText="System log information for current day" ResourceKey="Log">Log</Label>
                    <div class="db-field-control">
                        <textarea id="log" class="db-input" rows="10" @bind="@_log" readonly />
                    </div>
                </div>
            </div>
            <br /><br />
            <button type="button" class="db-btn db-btn-danger" @onclick="ClearLog">@Localizer["Clear"]</button>
        </TabPanel>
        <TabPanel Name="Migrations" Heading="Migrations" ResourceKey="Migrations">
            <div class="db-fields">
                <div class="db-field">
                    <Label For="tenant" HelpText="The name of the current database. Note that this is not the physical database name but rather the tenant name which is used within the framework to identify a database." ResourceKey="Tenant">Database</Label>
                    <div class="db-field-control">
                        <input id="tenant" class="db-input" @bind="@_tenant" readonly />
                    </div>
                </div>
            </div>
            <br />
            <Pager Items="@_history" SearchProperties="MigrationId">
                <Header>
                    <th>@Localizer["Migration"]</th>
                    <th>@Localizer["Date"]</th>
                    <th>@Localizer["Version"]</th>
                </Header>
                <Row>
                    <td>@context.MigrationId</td>
                    <td>@UtcToLocal(context.AppliedDate)</td>
                    <td>@context.AppliedVersion</td>
                </Row>
            </Pager>
        </TabPanel>
    </TabStrip>
    <br /><br />
}

@code {
    public override SecurityAccessLevel SecurityAccessLevel => SecurityAccessLevel.Host;

    private bool _initialized = false;

    private string _version = string.Empty;
    private string _clrversion = string.Empty;
    private string _osversion = string.Empty;
    private string _process = string.Empty;
    private string _machinename = string.Empty;
    private string _instance = string.Empty;
    private string _ipaddress = string.Empty;
    private string _environment = string.Empty;
    private string _contentrootpath = string.Empty;
    private string _webrootpath = string.Empty;
    private string _servertime = string.Empty;
    private string _workingset = string.Empty;
    private string _installationid = string.Empty;

    private string _detailederrors = string.Empty;
    private string _logginglevel = string.Empty;
    private string _notificationlevel = string.Empty;
    private string _broadcast = string.Empty;
    private string _swagger = string.Empty;

    private string _cacheduration = string.Empty;
    private string _failsafe = "true";
    private string _distributedcache = "false";
    private string _scaleout = "false";
    private string _distributedconnection = string.Empty;
    private string _distributedconnectiontype = "password";
    private string _toggledistributedconnection = string.Empty;
    private string _cachecontrol = string.Empty;

    private string _packageregistryurl = string.Empty;
    private string _packageregistryemail = string.Empty;

    private string _log = string.Empty;

    private string _tenant = string.Empty;
    private List<MigrationHistory> _history;

    protected override async Task OnInitializedAsync()
    {
        _version = Constants.PackageVersion;

        var systeminfo = await SystemService.GetSystemInfoAsync("environment");
        if (systeminfo != null)
        {
            _clrversion = systeminfo["CLRVersion"].ToString();
            _osversion = systeminfo["OSVersion"].ToString();
            _process = systeminfo["Process"].ToString();
            _machinename = systeminfo["MachineName"].ToString();
            _instance = systeminfo["Instance"].ToString();
            _ipaddress = systeminfo["IPAddress"].ToString();
            _environment = systeminfo["Environment"].ToString();
            _contentrootpath = systeminfo["ContentRootPath"].ToString();
            _webrootpath = systeminfo["WebRootPath"].ToString();
            _servertime = systeminfo["ServerTime"].ToString() + " UTC";
            _workingset = (Convert.ToInt64(systeminfo["WorkingSet"].ToString()) / 1000000).ToString() + " MB";
        }

        systeminfo = await SystemService.GetSystemInfoAsync("configuration");
        if (systeminfo != null)
        {
            _installationid = systeminfo["InstallationId"].ToString();
            _detailederrors = systeminfo["DetailedErrors"].ToString();
            _logginglevel = systeminfo["Logging:LogLevel:Default"].ToString();
            _notificationlevel = systeminfo["Logging:LogLevel:Notify"].ToString();
            _broadcast = systeminfo["Logging:LogLevel:Broadcast"].ToString();
            _swagger = systeminfo["UseSwagger"].ToString();

            _cacheduration = systeminfo["Caching:Duration"].ToString();
            _distributedcache = systeminfo["Caching:Distributed"].ToString();
            _failsafe = systeminfo["Caching:FailSafe"].ToString();
            _scaleout = systeminfo["Caching:ScaleOut"].ToString();
            _distributedconnection = systeminfo[$"ConnectionStrings:{SettingKeys.DistributedCacheKey}"].ToString();
            _toggledistributedconnection = SharedLocalizer["ShowPassword"];
            _cachecontrol = systeminfo["Caching:Cache-Control"].ToString();

            _packageregistryurl = systeminfo["PackageRegistryUrl"].ToString();
            _packageregistryemail = systeminfo["PackageRegistryEmail"].ToString();
        }

        systeminfo = await SystemService.GetSystemInfoAsync("log");
        if (systeminfo != null)
        {
            _log = systeminfo["Log"].ToString();
        }

        var tenants = await TenantService.GetTenantsAsync();
        _tenant = tenants.Find(item => item.TenantId == PageState.Alias.TenantId).Name;
        _history = await MigrationHistoryService.GetMigrationHistoryAsync();

        _initialized = true;
    }

    private async Task SaveConfig()
    {
        try
        {
            var settings = new Dictionary<string, object>();

            settings.Add("DetailedErrors", _detailederrors);
            settings.Add("Logging:LogLevel:Default", _logginglevel);
            settings.Add("Logging:LogLevel:Notify", _notificationlevel);
            settings.Add("Logging:LogLevel:Broadcast", _broadcast);
            settings.Add("UseSwagger", _swagger);

            settings.Add("Caching:Duration", _cacheduration);
            settings.Add("Caching:FailSafe", _failsafe);
            settings.Add("Caching:Distributed", (_distributedcache == "true" && !string.IsNullOrEmpty(_distributedconnection)) ? "true" : "false");
            settings.Add("Caching:ScaleOut", (_scaleout == "true" && !string.IsNullOrEmpty(_distributedconnection)) ? "true" : "false");
            settings.Add($"ConnectionStrings:{SettingKeys.DistributedCacheKey}", _distributedconnection);
            settings.Add("Caching:Cache-Control", _cachecontrol);

            settings.Add("PackageRegistryUrl", _packageregistryurl);
            settings.Add("PackageRegistryEmail", _packageregistryemail);

            await SystemService.UpdateSystemInfoAsync(settings);
            AddModuleMessage(Localizer["Success.UpdateConfig.Restart"], MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Saving Configuration");
            AddModuleMessage(Localizer["Error.UpdateConfig"], MessageType.Error);
        }
    }

    private void ToggleDistributedConnection()
    {
        if (_distributedconnectiontype == "password")
        {
            _distributedconnectiontype = "text";
            _toggledistributedconnection = SharedLocalizer["HidePassword"];
        }
        else
        {
            _distributedconnectiontype = "password";
            _toggledistributedconnection = SharedLocalizer["ShowPassword"];
        }
    }

    private async Task ClearLog()
    {
        try
        {
            var settings = new Dictionary<string, object>();
            settings.Add("clearlog", "true");
            await SystemService.UpdateSystemInfoAsync(settings);
            _log = string.Empty;
            AddModuleMessage(Localizer["Success.ClearLog"], MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Clearing Log");
            AddModuleMessage(Localizer["Error.ClearLog"], MessageType.Error);
        }
    }

    private async Task ClearCache()
    {
        try
        {
            await SystemService.ClearCacheAsync();
            AddModuleMessage(Localizer["Success.ClearCache"], MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Clearing Cache");
            AddModuleMessage(Localizer["Error.ClearCache"], MessageType.Error);
        }
    }

    private async Task RestartApplication()
    {
        try
        {
            ShowProgressIndicator();
            var interop = new Interop(JSRuntime);
            await interop.RedirectBrowser(NavigateUrl(""), 20);
            await InstallationService.RestartAsync();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Restarting Application");
        }
    }

    private void DistributedCacheChanged(ChangeEventArgs e)
    {
        _distributedcache = (string)e.Value;
        StateHasChanged();
    }

    private void ScaleOutChanged(ChangeEventArgs e)
    {
        _scaleout = (string)e.Value;
        StateHasChanged();
    }
}