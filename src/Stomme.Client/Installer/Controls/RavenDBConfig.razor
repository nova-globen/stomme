@namespace Stomme.Installer.Controls
@implements Stomme.Interfaces.IDatabaseConfigControl

<div class="db-field">
    <Label For="server" HelpText="Enter the RavenDB server host (without scheme)" ResourceKey="Server">Server:</Label>
    <div class="db-field-control">
        <input id="server" type="text" class="db-input" @bind="@_server" />
    </div>
</div>
<div class="db-field">
    <Label For="port" HelpText="Enter the port RavenDB listens on" ResourceKey="Port">Port:</Label>
    <div class="db-field-control">
        <input id="port" type="text" class="db-input" @bind="@_port" />
    </div>
</div>
<div class="db-field">
    <Label For="scheme" HelpText="Select the connection scheme" ResourceKey="Scheme">Scheme:</Label>
    <div class="db-field-control">
        <select id="scheme" class="db-select" @bind="@_scheme">
            <option value="http" selected>http</option>
            <option value="https">https</option>
        </select>
    </div>
</div>
<div class="db-field">
    <Label For="database" HelpText="Enter the name of the database" ResourceKey="Database">Database:</Label>
    <div class="db-field-control">
        <input id="database" type="text" class="db-input" @bind="@_database" />
    </div>
</div>

@code {
    // A RavenDB single-node endpoint. The server-side store parser (StommeServiceCollectionExtensions,
    // ParseRavenConnectionString) reads free-form `Url=`/`Urls=` + `Database=`/`Name=` pairs, so the descriptor
    // this emits mirrors the automated-install shape driven. Multi-node URL lists and client
    // certificates are out of scope here (a later enhancement) — the common dev/single-node case is Url + Database.
    private string _server = "127.0.0.1";
    private string _port = "8080";
    private string _scheme = "http";
    private string _database = "Stomme-" + DateTime.UtcNow.ToString("yyyyMMddHHmm");

    public string GetConnectionString()
    {
        if (String.IsNullOrEmpty(_server) || String.IsNullOrEmpty(_port) || String.IsNullOrEmpty(_database))
        {
            return String.Empty;
        }

        return $"Url={_scheme}://{_server}:{_port};Database={_database};";
    }
}
