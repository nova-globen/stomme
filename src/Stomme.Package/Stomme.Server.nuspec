    <file src="..\Stomme.Server\obj\Release\net10.0\staticwebassets\msbuild.buildTransitive.Stomme.Server.props" target="buildTransitive\Stomme.Server.props" />
    <file src="..\Stomme.Server\wwwroot\**\*" exclude="..\Stomme.Server\wwwroot\Modules\Templates\**;..\Stomme.Server\wwwroot\Themes\Templates\**" target="staticwebassets" />
    <file src="icon.png" target="" />
    <file src="readme.md" target="" />
