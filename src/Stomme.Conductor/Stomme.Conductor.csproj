<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The general engine (ADR 0018 in docs/import-engine/adr): runs a playbook with context. It knows playbooks, phases, units,
    inputs, proposals, decisions, questions and budgets, and nothing of what a host's inputs are; a test in
    Stomme.Conductor.Tests scans this folder for the words that belong to a host. Version, licence and authorship come
    from the root Directory.Build.props; the build settings below are the ones the engine was written under.
  -->
  <PropertyGroup>
    <RootNamespace>Stomme.Conductor</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsPackable>true</IsPackable>
    <PackageId>Stomme.Conductor</PackageId>
    <Description>A general engine that runs a playbook with context: units of work, a resumable run state, readers and a judge, a reply cache, spending ceilings, questions for a person, and a decision log with evidence.</Description>
    <PackageTags>playbook;engine;llm;judge</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Central transitive pinning is OFF: the SQLite bundle is pinned by a direct reference, as everywhere else. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Stomme.Conductor.Tests" />
  </ItemGroup>
</Project>
