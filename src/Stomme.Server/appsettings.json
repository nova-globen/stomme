{
  "RenderMode": "Static",
  "Runtime": "Server",
  "Database": {
    "DefaultDBType": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Installation": {
    "DefaultAlias": "",
    "HostPassword": "",
    "HostEmail": "",
    "SiteTemplate": "",
    "DefaultTheme": "",
    "DefaultContainer": ""
  },
  "Localization": {
    "DefaultCulture": "en"
  },
  "Transport": {
    "Grpc": {
      "Enabled": false
    },
    "SignalR": {
      "Enabled": false
    }
  },
  "Mcp": {
    "Enabled": false,
    "Server": {
      "Enabled": false,
      "Path": "/mcp/v1",
      "RequestsPerMinute": 60
    },
    "Client": {
      "HostAllowlist": []
    }
  },
  "DataExport": {
    "Enabled": false,
    "MaxArtifactBytes": 268435456,
    "JobTimeoutMinutes": 60,
    "LeaseMinutes": 10,
    "HeartbeatRows": 10000,
    "FolderCapacityMb": 1024,
    "RetentionDays": 7,
    "AuditRetentionDays": 90
  },
  "Metering": {
    "Enabled": false,
    "AiPricing": {}
  },
  "Health": {
    "Enabled": true,
    "Alerting": false
  },
  "AvailableDatabases": [
    {
      "Name": "LocalDB",
      "ControlType": "Stomme.Installer.Controls.LocalDBConfig, Stomme.Client",
      "DBType": "Stomme.Database.SqlServer.SqlServerDatabase, Stomme.Server"
    },
    {
      "Name": "SQL Server",
      "ControlType": "Stomme.Installer.Controls.SqlServerConfig, Stomme.Client",
      "DBType": "Stomme.Database.SqlServer.SqlServerDatabase, Stomme.Server"
    },
    {
      "Name": "SQLite",
      "ControlType": "Stomme.Installer.Controls.SqliteConfig, Stomme.Client",
      "DBType": "Stomme.Database.Sqlite.SqliteDatabase, Stomme.Server"
    },
    {
      "Name": "PostgreSQL",
      "ControlType": "Stomme.Installer.Controls.PostgreSQLConfig, Stomme.Client",
      "DBType": "Stomme.Database.PostgreSQL.PostgreSQLDatabase, Stomme.Server"
    },
    {
      "Name": "Azure SQL",
      "ControlType": "Stomme.Installer.Controls.AzureSqlConfig, Stomme.Client",
      "DBType": "Stomme.Database.SqlServer.SqlServerDatabase, Stomme.Server"
    },
    {
      "Name": "RavenDB",
      "ControlType": "Stomme.Installer.Controls.RavenDBConfig, Stomme.Client",
      "DBType": "Stomme.Database.RavenDb.RavenDatabase, Stomme.Server"
    }
  ],
  "Logging": {
    "FileLogger": {
      "LogLevel": {
        "Default": "Error"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "ZiggyCreatures.Caching.Fusion": "Warning",
      "Microsoft.AspNetCore.Components.WebAssembly.Server.WebAssemblyComponentsEndpointOptions": "Error",
      "Notify": "Error",
      "Broadcast": "None"
    }
  }
}
