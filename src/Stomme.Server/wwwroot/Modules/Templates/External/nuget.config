<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The module restores Stomme.* from ONE feed - the framework's package feed (nuget.org), or for a module generated
    against the local framework ("local") the slim SDK packed from that source tree - and everything else from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="stomme" value="[StommeFeed]" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="stomme">
      <package pattern="Stomme.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
