<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The SHARED layer: the wire models, the permission keys and the service contract, used by the server AND streamed to a
    WebAssembly browser. It references no server-only assembly.
    INDEPENDENT (D81/D82): Stomme arrives only through the Stomme.Sdk.Slim package - no source or project reference.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>[Owner].Module.[Module].Shared.Stomme</AssemblyName>
    <RootNamespace>[Owner].Module.[Module]</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>[Owner]</Authors>
    <Company>[Owner]</Company>
    <Product>[Owner].Module.[Module]</Product>
    <Description>[Description]</Description>
    <Copyright>[Owner]</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stomme.Sdk.Slim" Version="[FrameworkVersion]" />
  </ItemGroup>

  <!-- WASM safety (BL-13): the ASP.NET OpenApi source generator arrives with the shared framework and injects server-only
       references; a browser-bound assembly must not carry it, or Assembly.GetTypes() throws in the browser. -->
  <Target Name="RemoveOpenApiSourceGenerator" AfterTargets="ResolveReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Analyzer.Identity)').Contains('Microsoft.AspNetCore.OpenApi.SourceGenerators'))" />
    </ItemGroup>
  </Target>

</Project>
