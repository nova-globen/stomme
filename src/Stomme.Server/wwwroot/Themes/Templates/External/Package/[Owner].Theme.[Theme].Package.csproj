<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packs the theme: `dotnet pack` builds the Client project (the reference below orders the build) and packs the nuspec,
    so no tool outside the .NET SDK is needed. The package is what an operator installs - dropped into a host's Packages
    folder, or through the host's theme management - and what an app may reference as a PackageReference.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NuspecFile>[Owner].Theme.[Theme].nuspec</NuspecFile>
    <NuspecProperties>configuration=$(Configuration)</NuspecProperties>
    <PackageOutputPath>$(MSBuildProjectDirectory)</PackageOutputPath>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client\[Owner].Theme.[Theme].Client.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>