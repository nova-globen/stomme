<Project>
  <!-- The theme pins its own package versions (Stomme.Sdk.Slim on its Client project), as a downstream app does. This file also
       stops the walk: an enclosing repository's central package management does not reach the theme. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
