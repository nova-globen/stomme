<Project>
  <!--
    TEST-HOST THROTTLE: parallel `dotnet test` runs across several worktrees on one 31 GB laptop exhausted its RAM.
    Every test project compiles
    test/TestHostLock/MachineWideTestHostLock.cs, whose module initializer takes the named mutex
    Global\Stomme.TestHost before the first test runs, so only ONE test host executes tests at a time,
    machine-wide. Other test hosts (any worktree, any run) wait; the OS releases the mutex when the owning process
    exits, so a killed run cannot wedge the queue. Nothing is skipped: every suite still runs, one after another.
    Skipped automatically when CI=true (isolated CI containers); opt out locally with STOMME_TEST_PARALLEL=1.
    Each acquisition appends one line to %TEMP%\stomme-test-lock.log. Verified with two concurrent runs of
    Stomme.FeatureManagement.Tests: the second host acquired the lock 3.07 s later, when the first exited; both passed.
  -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true' and '$(Language)' == 'C#'">
    <Compile Include="$(MSBuildThisFileDirectory)test/TestHostLock/MachineWideTestHostLock.cs" Link="Properties/MachineWideTestHostLock.cs" Visible="false" />
    <!-- The sweep of earlier runs' leftovers, run by the lock once it is held. -->
    <Compile Include="$(MSBuildThisFileDirectory)test/TestHostLock/TestScratchSweep.cs" Link="Properties/TestScratchSweep.cs" Visible="false" />
    <!-- The sweep also removes test databases that earlier runs left on a loopback RavenDB. -->
    <Compile Include="$(MSBuildThisFileDirectory)test/TestHostLock/RavenTestDatabaseSweep.cs" Link="Properties/RavenTestDatabaseSweep.cs" Visible="false" />
  </ItemGroup>
</Project>
