<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <RootNamespace>Stomme.Persistence.Raven.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    Live provider smoke test for Stomme.Persistence.RavenDb. GATED in Stomme.slnx since BL-15
    (2026-08-03), fail-not-skip per D46: it needs a live RavenDB server and FAILS loudly when the one
    named by RAVENDB_TEST_URL (default: the infra UAT tier, http://192.168.10.20:8081) is unreachable —
    a suite that quietly shrinks reports green while proving nothing.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Stomme.Persistence.RavenDb\Stomme.Persistence.RavenDb.csproj" />
    <!-- BL-100 O2: DeadLetterSweeper, driven over the real RavenDB dead-letter queue by RavenDeadLetterSweepLiveTests. -->
    <ProjectReference Include="..\..\src\Stomme.Infrastructure.EventBus\Stomme.Infrastructure.EventBus.csproj" />
    <ProjectReference Include="..\..\src\Stomme.Persistence.Abstractions\Stomme.Persistence.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Stomme.SharedKernel\Stomme.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Stomme.Tenancy.Domain\Stomme.Tenancy.Domain.csproj" />
    <ProjectReference Include="..\..\src\Stomme.Tenancy.Abstractions\Stomme.Tenancy.Abstractions.csproj" />
  </ItemGroup>

</Project>
