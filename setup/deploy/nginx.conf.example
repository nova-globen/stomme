# Example nginx reverse proxy for Nova Globen Stomme (TLS terminates here; Kestrel listens on 127.0.0.1:5000).
# Replace example.com + the certificate paths. Stomme resolves the tenant by the incoming Host header
# (Alias -> Site -> Tenant), so proxy_set_header Host is REQUIRED and must carry the public hostname.
# When the OpenIddict IdP is enabled, the authority infers its issuer from the forwarded host too, so the
# X-Forwarded-* headers below must be present for the /connect/* and /.well-known/* endpoints to advertise
# the correct https issuer.

server {
    listen 80;
    server_name example.com;
    # Redirect all HTTP to HTTPS.
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    # Blazor / SignalR needs upgrade + long-lived connections.
    location / {
        proxy_pass         http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 100s;
    }
}

# Required for the Upgrade/Connection dance above:
#   map $http_upgrade $connection_upgrade { default upgrade; '' close; }
# Place that map in the http { } block (e.g. /etc/nginx/nginx.conf).
